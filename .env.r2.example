# Copy to .env.r2.local (gitignored). Never commit real values.
# These are server-side only — never PUBLIC_* for secrets.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_BASE_URL=
R2_ALLOWED_PREFIXES=assets/,thory/,photos/,rebel/,assets/rebel/

# Separate from R2 credentials. Used only to authorize the MCP endpoint.
MCP_REBEL_TOKEN=
