{
  "name": "rebel-web-astro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "node --import tsx scripts/test-laser-offer.ts && astro check && astro build && node scripts/audit-human-copy.mjs && node scripts/upload-rebel-r2.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test:r2-mcp": "node --import tsx --test scripts/rebel-r2-mcp.test.mjs",
    "check:r2-assets": "node scripts/upload-rebel-r2.mjs",
    "sync:r2-assets": "node scripts/upload-rebel-r2.mjs --confirm",
    "sync:r2-assets:deploy": "node scripts/upload-rebel-r2.mjs --confirm-if-configured",
    "audit:copy": "node scripts/audit-human-copy.mjs",
    "test:laser-offer": "node --import tsx scripts/test-laser-offer.ts",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.4",
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.1",
    "@astrojs/vercel": "^8.0.4",
    "@aws-sdk/client-s3": "^3.1104.0",
    "@aws-sdk/s3-request-presigner": "^3.1104.0",
    "@fontsource/manrope": "^5.1.1",
    "@fontsource/playfair-display": "^5.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "astro": "^5.1.0",
    "gsap": "^3.12.5",
    "lenis": "^1.1.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.23.9"
  }
}
