---
// Two slow-drifting violet halos, sitting under everything else.
// Heavy `filter: blur` is GPU-accelerated; cost is one composite layer.
---
<div class="stage-ambient" aria-hidden="true">
  <span class="stage-ambient__halo stage-ambient__halo--a"></span>
  <span class="stage-ambient__halo stage-ambient__halo--b"></span>
</div>
