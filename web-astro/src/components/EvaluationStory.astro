---
import { media } from "@/lib/page-media";
const moments=[
 {title:"Prima, ti ascoltiamo.",text:"Partiamo dal risultato che desideri e dal tempo che vuoi dedicarti. Osserviamo la pelle o la zona da trattare, le abitudini e i trattamenti già provati.",image:media.laser.consult,caption:"Il momento della valutazione, illustrato."},
 {title:"Poi, scegliamo insieme.",text:"Manualità, attivi ed eventuali tecnologie: ti spieghiamo la proposta, il calendario e il prezzo prima di iniziare. Se scegli il percorso proposto, la valutazione iniziale è gratuita.",image:media.viso.texture,caption:"La cura della pelle, da vicino · Scena illustrativa."},
];
---
<div class="evaluation-story">
 {moments.map((m,i)=><section class="evaluation-section"><div class:list={["evaluation-shell evaluation-chapter",{"evaluation-chapter--reverse":i%2===1}]}><figure><img src={m.image.src} alt={m.image.alt} width={m.image.width??1536} height={m.image.height??1024} loading="lazy" decoding="async"/><figcaption>{m.caption}</figcaption></figure><div><p class="evaluation-kicker">0{i+1} / Il tuo percorso REBEL</p><h2>{m.title}</h2><p>{m.text}</p>{i===1&&<p class="evaluation-note">Gli eventuali prodotti consigliati per casa non sono inclusi.</p>}</div></div></section>)}
 <section class="evaluation-section evaluation-studio"><div class="evaluation-shell evaluation-chapter"><div><p class="evaluation-kicker">Uno spazio per te</p><h2>Ci vediamo<br/><em>da REBEL.</em></h2><p>Ti aspettiamo in Viale Barbaroux 20, a Carmagnola, dal martedì al sabato. Prima di raggiungerci concordiamo insieme il giorno e l’orario.</p><a href="/contatti">Orari e indicazioni <span aria-hidden="true">↗</span></a></div><figure><img src="/img/studio-treatwell/15432078.jpg" alt="Spazio consulenza e accoglienza dello studio REBEL a Carmagnola" width="1080" height="720" loading="lazy" decoding="async"/><figcaption>Lo studio REBEL · Fotografia della sede.</figcaption></figure></div></section>
</div>
<style>
 .evaluation-story{background:#fffdf9;color:#301a3a}.evaluation-shell{width:min(1280px,calc(100% - 2 * clamp(1.1rem,3.4vw,4rem)));margin-inline:auto}.evaluation-section{padding-block:clamp(3rem,7vw,7rem)}.evaluation-section:nth-child(even){background:#f8f3ed}.evaluation-chapter{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(2rem,6vw,6rem);align-items:center}.evaluation-chapter--reverse>figure{order:2}.evaluation-chapter figure{margin:0;min-width:0}.evaluation-chapter img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:40px 5px 5px 5px}.evaluation-chapter figcaption{font-size:.67rem;line-height:1.7;color:#786581;margin-top:.7rem}.evaluation-kicker{color:#a32f68!important;font:750 .7rem/1.6 var(--font-body);text-transform:uppercase;letter-spacing:.14em;margin:0 0 1rem!important}.evaluation-chapter h2{font:500 clamp(2.4rem,4.4vw,4.5rem)/1.1 var(--font-display);letter-spacing:-.045em;color:#301a3a;margin:0 0 1.5rem}.evaluation-chapter h2 em{color:#793c86;font-weight:400}.evaluation-chapter p{color:#685471;line-height:1.8;font-size:1rem}.evaluation-chapter .evaluation-note{font-size:.8rem}.evaluation-chapter a{display:inline-flex;min-height:44px;align-items:center;gap:1rem;color:#71367a;font-weight:700;font-size:.85rem;text-underline-offset:.3em}.evaluation-studio{border-top:1px solid #e2d6e1}@media(max-width:760px){.evaluation-chapter{grid-template-columns:minmax(0,1fr)}.evaluation-chapter--reverse>figure{order:0}.evaluation-studio figure{grid-row:1}}
</style>
