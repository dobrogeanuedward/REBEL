---
import { clarifyCopy } from "@/lib/copy-clarity";

interface Props {
  items: Array<{ q: string; a: string }>;
  kicker?: string;
}
const { items, kicker = "Domande frequenti" } = Astro.props;
const clearKicker = clarifyCopy(kicker);
const clearItems = items.map((item) => ({ q: clarifyCopy(item.q), a: clarifyCopy(item.a) }));
---
<section class="faq" aria-label="Domande frequenti">
  {clearItems.map((item, i) => (
    <details class="faq__item" data-reveal style={`--reveal-delay: ${i * 50}ms;`}>
      <summary class="faq__summary">
        <span class="faq__kicker">{clearKicker} · {String(i + 1).padStart(2, "0")}</span>
        <span class="faq__q">{item.q}</span>
        <span class="faq__icon" aria-hidden="true">+</span>
      </summary>
      <div class="faq__a"><p>{item.a}</p></div>
    </details>
  ))}
</section>

<style>
  .faq { display: grid; gap: 0.6rem; }
  .faq__item {
    background: linear-gradient(180deg, #fff, #faf6fc);
    border: 1px solid #e1d6e7;
    border-radius: var(--r-md);
    padding: 1.1rem 1.3rem;
    transition: border-color var(--t-base) var(--ease-soft), background var(--t-base) var(--ease-soft);
    overflow: hidden;
  }
  .faq__item[open] {
    border-color: #bc9bce;
    background: linear-gradient(180deg, #fff, #f3eaf8);
  }
  .faq__summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.25rem);
    line-height: 1.2;
    color: #301b3d;
    letter-spacing: var(--tracking-editorial);
  }
  .faq__summary::-webkit-details-marker { display: none; }
  .faq__kicker {
    font-family: var(--font-body);
    font-size: var(--t-micro);
    letter-spacing: var(--tracking-micro);
    text-transform: uppercase;
    color: #784592;
    font-weight: 600;
    align-self: center;
    white-space: nowrap;
  }
  .faq__q { color: #301b3d; }
  .faq__icon {
    font-family: var(--font-display);
    font-size: 1.4rem;
    line-height: 1;
    color: #784592;
    transition: transform var(--t-base) var(--ease-cinema);
    align-self: center;
  }
  .faq__item[open] .faq__icon { transform: rotate(45deg); }
  .faq__a p { color: #695774; }
  .faq__summary:focus-visible { outline: 2px solid #80509b; outline-offset: 5px; }
  .faq__a {
    margin-top: 0.9rem;
    color: #695774;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    max-width: 70ch;
  }
  :global(.scene-ivory) .faq__item {
    background: linear-gradient(180deg, rgba(255,255,255,0.92), rgba(244, 238, 227, 0.96));
    border-color: var(--line-on-light);
  }
  :global(.scene-ivory) .faq__item[open] { background: linear-gradient(180deg, #fff, rgba(244, 238, 227, 0.98)); }
  :global(.scene-ivory) .faq__q { color: var(--on-light); }
  :global(.scene-ivory) .faq__a { color: var(--on-light-muted); }
  :global(.scene-ivory) .faq__kicker,
  :global(.scene-ivory) .faq__icon { color: var(--violet-mid); }
  @media (max-width: 680px) {
    .faq__summary { grid-template-columns: 1fr auto; }
    .faq__kicker { grid-column: 1 / -1; white-space: normal; }
  }
</style>
