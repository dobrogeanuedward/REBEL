---
const whatsapp = "https://wa.me/393516919416?text=" + encodeURIComponent("Ciao REBEL, vorrei prenotare il trattamento viso Glow in promo a 49 €.");
---
<section class="glow-news" aria-labelledby="glow-news-title" id="news-glow">
  <div class="glow-news__inner">
    <a class="glow-news__visual" href="/news/trattamento-viso-glow-carmagnola" aria-label="Scopri la novità Glow">
      <img src="/img/news/glow-settembre-2026/glow-1.webp" width="1080" height="1350" loading="lazy" alt="Cambia stagione. Ritrova il tuo Glow. La nuova promozione viso REBEL." />
    </a>
    <div class="glow-news__copy">
      <p class="glow-news__eyebrow">News REBEL · Viso</p>
      <h2 id="glow-news-title">Cambia stagione.<br /><em>Ritrova il tuo Glow.</em></h2>
      <p>Un’attenzione in più per la tua pelle: scopri il trattamento viso dedicato a luminosità, freschezza e uniformità, personalizzato sulle tue esigenze.</p>
      <div class="glow-news__price"><del>100 €</del> <strong>49 €</strong><span>Posti limitati</span></div>
      <div class="glow-news__actions">
        <a class="btn btn--primary btn--halo" href={whatsapp}>Prenota subito</a>
        <a class="glow-news__read" href="/news/trattamento-viso-glow-carmagnola">Leggi la news <span aria-hidden="true">↗</span></a>
      </div>
      <p class="glow-news__contact">Telefono e WhatsApp <a href="tel:+393516919416">351 691 9416</a></p>
    </div>
  </div>
</section>
<style>
  .glow-news{padding:clamp(32px,6vw,88px) 24px;background:radial-gradient(ellipse at 92% 15%,#e4d7ee 0,transparent 55%),radial-gradient(ellipse at 5% 95%,#f3dce7 0,transparent 55%),#faf6ef;color:#351c3e}
  .glow-news__inner{max-width:1160px;margin:auto;display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1fr);gap:clamp(32px,6vw,90px);align-items:center}
  .glow-news__visual{display:block;max-width:440px;box-shadow:0 24px 70px #53316118;border-radius:4px;overflow:hidden}
  .glow-news__visual img{display:block;width:100%;height:auto}
  .glow-news__eyebrow{font-size:12px;text-transform:uppercase;letter-spacing:.18em;font-weight:700;margin:0 0 24px}
  h2{font-family:'Playfair Display',Georgia,serif;font-size:clamp(34px,4vw,56px);font-weight:500;line-height:1.13;letter-spacing:-.035em;margin:0 0 24px;color:#351c3e}
  h2 em{font-weight:500;color:#774787}
  .glow-news__copy>p:not(.glow-news__eyebrow):not(.glow-news__contact){font-size:17px;line-height:1.8;max-width:510px}
  .glow-news__price{display:flex;align-items:baseline;flex-wrap:wrap;gap:16px;margin:24px 0}
  .glow-news__price del{font-size:24px;color:#796982}.glow-news__price strong{font-family:'Playfair Display',Georgia,serif;font-size:64px;font-weight:500;line-height:1.1}.glow-news__price span{font-size:11px;text-transform:uppercase;letter-spacing:.13em;border:1px solid #c9b7d1;border-radius:100px;padding:7px 12px}
  .glow-news__actions{display:flex;align-items:center;flex-wrap:wrap;gap:24px}.glow-news__read{color:#351c3e;text-decoration:underline;text-underline-offset:5px;font-size:14px}
  .glow-news__contact{font-size:13px;margin-top:24px;line-height:1.8}.glow-news__contact a{color:inherit;font-weight:600;white-space:nowrap}
  @media(max-width:700px){.glow-news__inner{grid-template-columns:1fr}.glow-news__visual{max-width:100%;width:100%}.glow-news__copy{padding:4px 0 12px}}
</style>
