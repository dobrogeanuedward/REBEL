---
import PageHero from "./PageHero.astro";
import { competencePages } from "@/lib/seo-content-refined";
import { photographs } from "@/lib/catalog-visuals";
import { media } from "@/lib/page-media";
const groups = [
  { id:"laser",name:"Laser",copy:"Zone, preparazione, sole e ricrescita.",photo:photographs["laser-gamba"] },
  { id:"viso",name:"Viso e pelle",copy:"Conoscere la pelle, scegliere la cura.",photo:photographs["viso-manualita"] },
  { id:"beauty",name:"Mani, piedi e sguardo",copy:"Colore, forma e piccoli gesti quotidiani.",photo:photographs["laminazione-ritratto"] },
  { id:"corpo",name:"Corpo e benessere",copy:"Manualità, tempo e attenzioni dopo la seduta.",photo:photographs["massaggio-spalle"] },
  { id:"metodo",name:"Il mondo REBEL",copy:"Come lavoriamo e da dove cominciare.",photo:photographs["viso-preparazione"] },
];
const groupFor = (slug:string) => /laser|peli-incarniti/.test(slug) ? "laser" : /manicure|semipermanente|unghie|pedicure|piedi|talloni|laminazione|ciglia|sopracciglia/.test(slug) ? "beauty" : /massaggio|linfodren|pressomass|pressoterapia|scrub-corpo|corpo|cervicale/.test(slug) ? "corpo" : /viso|pelle|occhi|tono|ovale|opaca|matura|pulizia/.test(slug) ? "viso" : "metodo";
const populated = groups.map(g=>({...g,guides:competencePages.filter(p=>groupFor(p.slug)===g.id)})).filter(g=>g.guides.length);
---
<div class="guide-library">
  <PageHero image={media.laser.consult} imageCaption="Il momento della scelta, illustrato." kicker="Le guide REBEL · Carmagnola" title="Le risposte che cerchi. _Prima di scegliere_." lead="Preparazione, durata, cura dopo la seduta. Parti dalla tua domanda e prenditi il tempo per conoscere il trattamento." ctaPrimary={{label:"Scegli un argomento",href:"#argomenti"}} ctaSecondary={{label:"Esplora i servizi",href:"/servizi"}} meta={["Viso, corpo, laser e beauty","REBEL · Viale Barbaroux 20"]} />
  <section class="library-section" id="argomenti" aria-labelledby="library-title"><div class="library-shell">
    <header class="library-heading"><p class="library-kicker">Da dove vuoi iniziare?</p><h2 id="library-title">Una domanda.<br/><em>Il tuo prossimo passo.</em></h2></header>
    <nav class="library-topics" aria-label="Argomenti delle guide">{populated.map((g,i)=><a href={`#guide-${g.id}`}><figure><img src={g.photo.preview} width="480" height={Math.round(480*g.photo.height/g.photo.width)} alt={g.photo.alt} loading="lazy" decoding="async"/><span aria-hidden="true">↘</span></figure><small>{String(i+1).padStart(2,"0")} / {g.guides.length} guide</small><h3>{g.name}</h3><p>{g.copy}</p></a>)}</nav>
  </div></section>
  {populated.map(g=><section class="library-section library-section--paper" id={`guide-${g.id}`} aria-labelledby={`library-${g.id}`}><div class="library-shell library-group">
    <figure class="library-group__photo"><img src={g.photo.src} width={g.photo.width} height={g.photo.height} alt={g.photo.alt} loading="lazy" decoding="async"/><figcaption>Il mondo dei trattamenti REBEL · Scena illustrativa</figcaption></figure>
    <div><p class="library-kicker">Le tue letture</p><h2 id={`library-${g.id}`}>{g.name}</h2><p class="library-group__intro">{g.copy}</p><ul>{g.guides.map(guide=><li><a href={`/competenze/${guide.slug}`}><h3>{guide.title}</h3><p>{guide.shortDescription}</p><span aria-hidden="true">↗</span></a></li>)}</ul></div>
  </div></section>)}
  <section class="library-section library-closing"><div class="library-shell"><p class="library-kicker">Dalle parole al tuo appuntamento</p><h2>Ora, <em>parliamone.</em></h2><p>Raccontaci cosa desideri. Ti aiutiamo a scegliere un servizio o a organizzare la valutazione REBEL di 30–40 minuti.</p><a class="btn btn--primary" href="/contatti">Parlane con REBEL ↗</a><a class="library-link" href="/servizi">Esplora tutti i servizi →</a></div></section>
</div>
<style>
 .guide-library{background:#f8f3ed;color:#301a3a}.library-shell{width:min(1320px,calc(100% - 2 * clamp(1.1rem,3.4vw,4rem)));margin-inline:auto}.library-section{padding-block:clamp(3.5rem,7vw,7rem);scroll-margin-top:6rem}.library-section--paper{background:#fffdf9;border-top:1px solid #e7dfe7}.library-section :is(h2,h3,p,figure,ul){margin:0}.library-kicker{font:750 .7rem/1.6 var(--font-body);letter-spacing:.14em;text-transform:uppercase;color:#a32f68;margin-bottom:1rem!important}.library-section h2{font:500 clamp(2.5rem,4.4vw,4.5rem)/1.1 var(--font-display);letter-spacing:-.045em;color:#301a3a}.library-section h2 em{color:#793c86;font-weight:400}.library-section p{color:#685471;line-height:1.8}.library-heading{margin-bottom:2.5rem}.library-topics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2.5rem 1.5rem}.library-topics>a{color:inherit;text-decoration:none;min-width:0}.library-topics figure{position:relative;overflow:hidden;border-radius:28px 5px 5px 5px}.library-topics img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;transition:transform .3s}.library-topics a:hover img{transform:scale(1.025)}.library-topics figure span{position:absolute;right:1rem;bottom:1rem;width:40px;height:40px;display:grid;place-items:center;background:#fffdf9ed;border-radius:50%}.library-topics small{display:block;font-size:.63rem;letter-spacing:.08em;color:#a32f68;margin-top:1rem}.library-topics h3{font:500 1.9rem/1.2 var(--font-display);color:#301a3a;margin-top:.5rem}.library-topics p{font-size:.87rem;margin-top:.5rem}.library-group{display:grid;grid-template-columns:minmax(0,.85fr) minmax(0,1.15fr);gap:clamp(2rem,6vw,6rem);align-items:start}.library-group__photo{position:sticky;top:8rem}.library-group__photo img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:5px 40px 5px 5px}.library-group__photo figcaption{font-size:.66rem;color:#786581;line-height:1.7;margin-top:.7rem}.library-group__intro{margin-top:1rem!important}.library-group ul{padding:0;list-style:none;margin-top:1.6rem!important;border-top:1px solid #e2d6e1}.library-group li{border-bottom:1px solid #e2d6e1}.library-group li a{position:relative;display:block;padding:1.5rem 2rem 1.5rem 0;min-height:44px;color:inherit;text-decoration:none}.library-group li h3{font:500 clamp(1.25rem,2vw,1.7rem)/1.35 var(--font-display);color:#301a3a}.library-group li p{font-size:.82rem;margin-top:.7rem;max-width:60ch}.library-group li span{position:absolute;right:0;top:1.5rem;color:#a32f68}.library-group a:hover h3{color:#8b3e90}.library-closing{text-align:center;background:#f3eaf2}.library-closing p:not(.library-kicker){max-width:38rem;margin:1.4rem auto 1.8rem}.library-link{display:inline-flex;align-items:center;min-height:44px;margin-left:1.5rem;color:#71367a;text-underline-offset:.3em;font-size:.85rem}.guide-library a:focus-visible{outline:3px solid #8941b0;outline-offset:5px}@media(max-width:760px){.library-topics{grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 1rem}.library-topics h3{font-size:1.5rem}.library-group{grid-template-columns:minmax(0,1fr)}.library-group__photo{position:static}.library-group__photo img{aspect-ratio:16/10}.library-link{display:flex;justify-content:center;margin:1rem 0 0}.library-topics p{font-size:.8rem}}@media(max-width:380px){.library-topics{grid-template-columns:minmax(0,1fr)}}@media(prefers-reduced-motion:reduce){.library-topics img{transition:none}}
</style>
