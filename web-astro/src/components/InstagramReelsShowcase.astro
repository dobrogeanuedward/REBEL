---
import { extractInstagramId } from "@/lib/instagram-config";
import { siteConfig } from "@/lib/site-config";

interface Props {
  reels: string[];
}
const { reels } = Astro.props;

function toReelPermalink(input: string): string {
  if (input.startsWith("http")) {
    const cleaned = input.split("?")[0];
    if (cleaned.includes("/reel/")) return cleaned.endsWith("/") ? cleaned : `${cleaned}/`;
    return `https://www.instagram.com/reel/${extractInstagramId(input)}/`;
  }
  return `https://www.instagram.com/reel/${extractInstagramId(input)}/`;
}
---
<section class="instagram-group instagram-reels-rebuild">
  <div class="instagram-group__head">
    <h3 class="instagram-group__title">Reel in evidenza</h3>
    <a
      href={siteConfig.social.instagram}
      target="_blank"
      rel="noreferrer"
      class="instagram-group__link"
    >
      Vedi tutti <span>→</span>
    </a>
  </div>

  <div class="instagram-reels-grid">
    {reels.map((reel) => {
      const permalink = toReelPermalink(reel);
      return (
        <article class="instagram-reel-card">
          <blockquote
            class="instagram-media instagram-reel-embed"
            data-instgrm-permalink={permalink}
            data-instgrm-version="14"
            data-instgrm-captioned="false"
          >
            <a href={permalink} target="_blank" rel="noreferrer">
              Guarda il reel su Instagram
            </a>
          </blockquote>
        </article>
      );
    })}
  </div>
</section>

<script>
  // Loads the official Instagram embed script once and (re-)processes after View Transitions.
  function processEmbeds() {
    const w = window as any;
    w.instgrm?.Embeds?.process?.();
  }
  function ensureScript() {
    if (document.getElementById("instagram-embed-script")) {
      processEmbeds();
      return;
    }
    const s = document.createElement("script");
    s.id = "instagram-embed-script";
    s.src = "https://www.instagram.com/embed.js";
    s.async = true;
    s.defer = true;
    s.onload = () => processEmbeds();
    document.body.appendChild(s);
  }
  ensureScript();
  document.addEventListener("astro:page-load", () => {
    setTimeout(processEmbeds, 80);
  });
</script>
