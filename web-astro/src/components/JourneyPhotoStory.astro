---
import type { JourneyPhotograph } from "@/lib/journey-photographs";
interface Props { photographs: JourneyPhotograph[] }
const { photographs } = Astro.props;
---
<div class="journey-photo-story">
  {photographs.map(photo => <figure>
    <a href={photo.src} aria-label={`Apri immagine: ${photo.title}`}><img src={photo.src} srcset={`${photo.preview} 640w, ${photo.src} ${photo.width}w`} sizes="(max-width:720px) 92vw, 46vw" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></a>
    <figcaption><strong>{photo.title}</strong><p>{photo.caption}</p></figcaption>
  </figure>)}
</div>
<p class="journey-photo-story__note">Immagini illustrative del percorso · <a href="/gallery">Esplora la gallery REBEL →</a></p>
<style>
.journey-photo-story{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(1rem,3vw,2.5rem);align-items:start;margin-top:3rem}.journey-photo-story figure{margin:0}.journey-photo-story figure:nth-child(2){margin-top:4.5rem}.journey-photo-story img{display:block;width:100%;height:auto;object-fit:contain;border-radius:.4rem}.journey-photo-story figcaption{padding-top:1.2rem}.journey-photo-story strong{font:500 clamp(1.5rem,2.5vw,2.4rem)/1.2 var(--font-display);color:#36213f}.journey-photo-story p{line-height:1.65;color:#6d5b75;max-width:35rem}.journey-photo-story__note{font-size:.75rem;color:#76677c;margin:1.4rem 0 0}.journey-photo-story__note a{color:#793e9b}.journey-photo-story a:focus-visible{outline:3px solid #8040c1;outline-offset:5px}@media(max-width:720px){.journey-photo-story{grid-template-columns:1fr}.journey-photo-story figure:nth-child(2){margin-top:.5rem}.journey-photo-story__note{line-height:1.6}}
</style>
