---
/**
 * MediaFigure — editorial image with optional caption.
 *
 * The workhorse for breaking text monotony inside a `.container`. Keeps a
 * violet placeholder background so a not-yet-generated asset still looks
 * intentional (images are produced asynchronously by image subagents).
 *
 * `ratio` controls the crop box (object-fit: cover). Use "eager" only for
 * the first image above the fold on a page.
 */
interface Props {
  src: string;
  alt: string;
  caption?: string;
  /** CSS aspect-ratio, e.g. "16/9", "4/3", "3/4", "1/1". Default "16/9". */
  ratio?: string;
  /** "framed" (rounded, bordered) | "plain". Default "framed". */
  variant?: "framed" | "plain";
  priority?: boolean;
  width?: number;
  height?: number;
}

const {
  src,
  alt,
  caption,
  ratio = "16/9",
  variant = "framed",
  priority = false,
  width = 1600,
  height = 900,
} = Astro.props;
---
<figure class={`media-figure media-figure--${variant}`} data-reveal>
  <div class="media-figure__frame" style={`--ratio:${ratio};`}>
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={priority ? "eager" : "lazy"}
      decoding="async"
      fetchpriority={priority ? "high" : "auto"}
    />
  </div>
  {caption ? <figcaption class="media-figure__caption">{caption}</figcaption> : null}
</figure>

<style>
  .media-figure {
    margin: 0;
    display: grid;
    gap: 0.7rem;
  }
  .media-figure__frame {
    position: relative;
    aspect-ratio: var(--ratio, 16 / 9);
    overflow: hidden;
    background:
      radial-gradient(120% 100% at 20% 0%, rgba(91, 43, 216, 0.30), transparent 60%),
      linear-gradient(180deg, rgba(31, 26, 58, 0.9), rgba(20, 16, 42, 0.9));
  }
  .media-figure--framed .media-figure__frame {
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-md);
  }
  .media-figure__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .media-figure__caption {
    font-size: var(--t-small);
    color: var(--text-faint);
    letter-spacing: 0.01em;
    max-width: 70ch;
  }
  .scene-ivory .media-figure__caption { color: var(--on-light-faint); }
</style>
