---
import SectionHead from "@/components/SectionHead.astro";
import { localAreaPages } from "@/lib/local-pages";
import { clarifyCopy } from "@/lib/copy-clarity";

interface Props {
  serviceLabel: string;
  kicker?: string;
  anchorPattern?: (serviceLabel: string, city: string) => string;
  limit?: number;
  clusters?: Array<"asse-carmagnola" | "torino-sud" | "cuneo">;
  hrefOverrides?: Record<string, string>;
}

const {
  serviceLabel,
  kicker = "Come raggiungerci dai comuni vicini",
  anchorPattern = (s: string, c: string) => `${s} per chi arriva da ${c}`,
  limit = 8,
  clusters,
  hrefOverrides = {},
} = Astro.props as Props;

const clearServiceLabel = clarifyCopy(serviceLabel);
const clearKicker = clarifyCopy(kicker);
const filtered = clusters
  ? localAreaPages.filter((area) => clusters.includes(area.cluster) && area.slug !== "carmagnola")
  : localAreaPages.filter((area) => area.slug !== "carmagnola");

const order: Record<string, number> = {
  "asse-carmagnola": 0,
  "torino-sud": 1,
  "cuneo": 2,
};
const cities = [...filtered]
  .sort((a, b) => (order[a.cluster] ?? 9) - (order[b.cluster] ?? 9))
  .slice(0, limit);
---

<section class="section near-me-section" aria-label={`${clearServiceLabel}: indicazioni dai comuni vicini`}>
  <div class="container">
    <SectionHead
      kicker={clearKicker}
      title={`${clearServiceLabel}: mappe e informazioni per chi arriva da altri comuni.`}
      lead="Apri la tua località per trovare indicazioni verso Viale Barbaroux 20 a Carmagnola e collegamenti a servizi, prezzi e prenotazione."
    />
    <ul class="near-me-list" role="list">
      {cities.map((city) => {
        const href = hrefOverrides[city.slug] ?? `/localita/${city.slug}`;
        const isDedicated = Boolean(hrefOverrides[city.slug]);
        return (
          <li class="near-me-item">
            <a class="near-me-link" href={href}>
              <span class="near-me-link__service">{clarifyCopy(anchorPattern(clearServiceLabel, city.city))}</span>
              <span class="near-me-link__hint">{isDedicated ? `Servizio e prezzi · ${city.city}` : `Mappa e indicazioni · ${city.city}`}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .near-me-section { padding-block: clamp(3rem, 6vw, 5rem); }
  .near-me-list {
    list-style: none;
    margin: clamp(1.4rem, 3vw, 2rem) 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .near-me-link {
    display: grid;
    gap: 0.2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--surface, transparent);
    color: var(--text);
    text-decoration: none;
    transition: border-color var(--t-fast) var(--ease-soft),
      transform var(--t-fast) var(--ease-soft),
      background-color var(--t-fast) var(--ease-soft);
  }
  .near-me-link:hover,
  .near-me-link:focus-visible {
    border-color: var(--cyan-tech, currentColor);
    transform: translateY(-1px);
  }
  .near-me-link__service {
    font-weight: 600;
    font-size: 0.98rem;
    line-height: 1.25;
  }
  .near-me-link__hint {
    font-size: 0.78rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
</style>
