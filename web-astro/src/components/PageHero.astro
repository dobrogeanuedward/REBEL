---
import { clarifyCopy } from "@/lib/copy-clarity";

interface CtaSpec { label: string; href: string; halo?: boolean; }

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  meta?: string[];
  ctaPrimary?: CtaSpec;
  ctaSecondary?: CtaSpec;
  image?: { src: string; srcMobile?: string; alt: string; width?: number; height?: number };
  bullets?: string[];
}

const { kicker, title, lead, meta = [], ctaPrimary, ctaSecondary, image, bullets = [] } = Astro.props;

const clearKicker = clarifyCopy(kicker);
const clearTitle = clarifyCopy(title);
const clearLead = lead ? clarifyCopy(lead) : undefined;
const clearMeta = meta.map(clarifyCopy);
const clearBullets = bullets.map(clarifyCopy);
const clearPrimary = ctaPrimary ? { ...ctaPrimary, label: clarifyCopy(ctaPrimary.label) } : undefined;
const clearSecondary = ctaSecondary ? { ...ctaSecondary, label: clarifyCopy(ctaSecondary.label) } : undefined;
const renderedTitle = clearTitle.replace(/_([^_]+)_/g, (_, inner) => `<em>${inner}</em>`);
---
<section class={`page-hero ${image ? "page-hero--media" : ""}`}>
  <div class="page-hero__bg" aria-hidden="true"></div>
  {image ? (
    <>
      <picture>
        {image.srcMobile ? <source media="(max-width: 860px) and (orientation: portrait)" srcset={image.srcMobile} /> : null}
        <img
          class="page-hero__photo"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="page-hero__veil" aria-hidden="true"></div>
    </>
  ) : null}
  <div class="container">
    <div class="page-hero__inner">
      <p class="page-hero__kicker" data-reveal>{clearKicker}</p>
      <h1 class="page-hero__title" data-reveal style="--reveal-delay: 40ms;" set:html={renderedTitle} />
      {clearLead ? (
        <p class="page-hero__lead" data-reveal style="--reveal-delay: 120ms;">{clearLead}</p>
      ) : null}

      {(clearPrimary || clearSecondary) ? (
        <div class="page-hero__cta cluster cluster--stack-mobile" data-reveal style="--reveal-delay: 150ms;">
          {clearPrimary ? (
            <a class={`btn btn--primary ${clearPrimary.halo ? "btn--halo" : ""}`} href={clearPrimary.href}>{clearPrimary.label}</a>
          ) : null}
          {clearSecondary ? (
            <a class="btn btn--secondary" href={clearSecondary.href}>{clearSecondary.label}</a>
          ) : null}
        </div>
      ) : null}

      {clearBullets.length > 0 ? (
        <ul class="page-hero__bullets" data-reveal style="--reveal-delay: 180ms;">
          {clearBullets.map((b) => <li>{b}</li>)}
        </ul>
      ) : null}

      {clearMeta.length > 0 ? (
        <div class="page-hero__meta" data-reveal style="--reveal-delay: 210ms;">
          {clearMeta.map((m) => <span>{m}</span>)}
        </div>
      ) : null}
    </div>
  </div>

  <div class="page-hero__scroll" aria-hidden="true">Scorri</div>
</section>

<style>
  /* Geometry lives beside the markup: global theme patches must not set
     competing viewport heights or force long titles outside the hero. */
  .page-hero {
    --text: #301b3e;
    --text-strong: #27142f;
    --text-muted: #685471;
    --text-faint: #786581;
    --line: rgba(39, 20, 47, .13);
    --line-strong: rgba(39, 20, 47, .25);
    min-height: 0;
    height: auto;
    padding-block: clamp(8rem, 11vw, 10.5rem) clamp(3rem, 6vw, 5rem);
    align-items: center;
    overflow: visible;
    color: var(--text);
    color-scheme: light;
    background: #fffdf9;
  }
  .page-hero__bg { display: none; }
  .page-hero__inner { min-width: 0; gap: clamp(1rem, 2vw, 1.5rem); }
  .page-hero__title {
    max-width: 18ch;
    font-size: clamp(2.8rem, 6.8vw, 6.8rem);
    line-height: 1.02;
    letter-spacing: -.045em;
    color: var(--text-strong);
    overflow-wrap: break-word;
  }
  .page-hero__title :global(em) {
    background: none;
    color: #784795;
    -webkit-text-fill-color: currentColor;
  }
  .page-hero__kicker { color: #a32f68; }
  .page-hero__kicker::before { background: currentColor; }
  .page-hero__lead { color: var(--text-muted); }
  .page-hero__meta { color: var(--text-muted); margin-top: .2rem; }
  .page-hero__meta span::before { background: #a32f68; box-shadow: none; }
  .page-hero__cta { min-width: 0; }
  .page-hero__cta .btn { min-height: 44px; max-width: 100%; white-space: normal; text-align: center; }
  .page-hero:not(.page-hero--media) .btn--secondary {
    color: #5c3572;
    border-color: rgba(92, 53, 114, .3);
    background: rgba(255, 255, 255, .72);
  }
  .page-hero:not(.page-hero--media) .btn--secondary:hover { background: #f3eaf7; }
  .page-hero__scroll { display: none; }
  .page-hero--media {
    --text: #f4eee3;
    --text-strong: #fffdf9;
    --text-muted: rgba(244, 238, 227, .76);
    --text-faint: rgba(244, 238, 227, .6);
    --line: rgba(255, 255, 255, .16);
    --line-strong: rgba(255, 255, 255, .3);
    min-height: min(78svh, 800px);
    color-scheme: dark;
    background: #27142f;
  }
  .page-hero--media .page-hero__kicker { color: #f1b4d0; }
  .page-hero--media .page-hero__title :global(em) { color: #f1b4d0; }
  .page-hero--media .page-hero__meta span::before { background: #f1b4d0; }
  .page-hero > picture {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 60% at 22% 28%, rgba(46, 16, 101, 0.52), transparent 62%),
      linear-gradient(180deg, rgba(7, 5, 14, 0.58) 0%, rgba(7, 5, 14, 0.32) 38%, rgba(7, 5, 14, 0.90) 96%);
  }
  .page-hero--media .page-hero__bg { display: none; }
  .page-hero__bullets {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  .page-hero__bullets li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--t-body);
    color: var(--text);
  }
  .page-hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: #a32f68;
    font-weight: 700;
  }
  .page-hero--media .page-hero__bullets li::before { color: #f1b4d0; }

  @media (min-width: 861px) and (max-height: 800px) {
    .page-hero {
      min-height: 0;
      padding-block: clamp(7.5rem, 16svh, 9rem) 3rem;
    }
    .page-hero__title { font-size: clamp(2.8rem, 5.8vw, 5.6rem); }
    .page-hero__inner { gap: 1rem; }
  }
  @media (max-width: 860px) {
    .page-hero {
      min-height: 0;
      padding-block: max(7.5rem, calc(5.75rem + env(safe-area-inset-top, 0px))) 3rem;
    }
    .page-hero > .container { width: calc(100% - 2rem); padding-inline: 0; }
    .page-hero__inner { gap: 1rem; }
    .page-hero__title { font-size: clamp(2.4rem, 10.8vw, 4.8rem); line-height: 1.04; }
    .page-hero__lead { font-size: 1rem; line-height: 1.6; }
    .page-hero__meta { gap: .55rem 1rem; font-size: .82rem; }
    .page-hero__bullets { gap: .6rem 1rem; }
    .page-hero__bullets li { font-size: .9rem; }
  }
  @media (max-width: 540px) {
    .page-hero__cta { width: 100%; }
    .page-hero__cta .btn { width: 100%; }
  }
  @media (max-width: 1024px) and (orientation: landscape) and (max-height: 620px) {
    .page-hero { min-height: 0; padding-block: 7.5rem 2.5rem; }
    .page-hero__title { font-size: clamp(2.4rem, 5.5vw, 3.8rem); }
  }
</style>
