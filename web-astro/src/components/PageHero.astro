---
import { clarifyCopy } from "@/lib/copy-clarity";

interface CtaSpec { label: string; href: string; halo?: boolean; }

interface Props {
  kicker: string;
  title: string;
  lead?: string;
  meta?: string[];
  ctaPrimary?: CtaSpec;
  ctaSecondary?: CtaSpec;
  image?: { src: string; srcMobile?: string; alt: string; width?: number; height?: number };
  bullets?: string[];
}

const { kicker, title, lead, meta = [], ctaPrimary, ctaSecondary, image, bullets = [] } = Astro.props;

const clearKicker = clarifyCopy(kicker);
const clearTitle = clarifyCopy(title);
const clearLead = lead ? clarifyCopy(lead) : undefined;
const clearMeta = meta.map(clarifyCopy);
const clearBullets = bullets.map(clarifyCopy);
const clearPrimary = ctaPrimary ? { ...ctaPrimary, label: clarifyCopy(ctaPrimary.label) } : undefined;
const clearSecondary = ctaSecondary ? { ...ctaSecondary, label: clarifyCopy(ctaSecondary.label) } : undefined;
const renderedTitle = clearTitle.replace(/_([^_]+)_/g, (_, inner) => `<em>${inner}</em>`);
---
<section class={`page-hero ${image ? "page-hero--media" : ""}`}>
  <div class="page-hero__bg" aria-hidden="true"></div>
  {image ? (
    <>
      <picture>
        {image.srcMobile ? <source media="(max-width: 860px) and (orientation: portrait)" srcset={image.srcMobile} /> : null}
        <img
          class="page-hero__photo"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="page-hero__veil" aria-hidden="true"></div>
    </>
  ) : null}
  <div class="container">
    <div class="page-hero__inner">
      <p class="page-hero__kicker" data-reveal>{clearKicker}</p>
      <h1 class="page-hero__title" data-reveal style="--reveal-delay: 40ms;" set:html={renderedTitle} />
      {clearLead ? (
        <p class="page-hero__lead" data-reveal style="--reveal-delay: 120ms;">{clearLead}</p>
      ) : null}

      {(clearPrimary || clearSecondary) ? (
        <div class="page-hero__cta cluster cluster--stack-mobile" data-reveal style="--reveal-delay: 150ms;">
          {clearPrimary ? (
            <a class={`btn btn--primary ${clearPrimary.halo ? "btn--halo" : ""}`} href={clearPrimary.href}>{clearPrimary.label}</a>
          ) : null}
          {clearSecondary ? (
            <a class="btn btn--secondary" href={clearSecondary.href}>{clearSecondary.label}</a>
          ) : null}
        </div>
      ) : null}

      {clearBullets.length > 0 ? (
        <ul class="page-hero__bullets" data-reveal style="--reveal-delay: 180ms;">
          {clearBullets.map((b) => <li>{b}</li>)}
        </ul>
      ) : null}

      {clearMeta.length > 0 ? (
        <div class="page-hero__meta" data-reveal style="--reveal-delay: 210ms;">
          {clearMeta.map((m) => <span>{m}</span>)}
        </div>
      ) : null}
    </div>
  </div>

  <div class="page-hero__scroll" aria-hidden="true">Scroll</div>
</section>

<style>
  .page-hero--media {
    --text: #f4eee3;
    --text-strong: #fffdf9;
    --text-muted: rgba(244, 238, 227, .76);
    min-height: clamp(560px, 82svh, 880px);
    color-scheme: dark;
  }
  .page-hero > picture {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .page-hero__photo {
    position: absolute;
    inset: 0;
    z-index: auto;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 60% at 22% 28%, rgba(46, 16, 101, 0.52), transparent 62%),
      linear-gradient(180deg, rgba(7, 5, 14, 0.58) 0%, rgba(7, 5, 14, 0.32) 38%, rgba(7, 5, 14, 0.90) 96%);
  }
  .page-hero--media .page-hero__bg { display: none; }
  .page-hero__bullets {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  .page-hero__bullets li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--t-body);
    color: var(--text);
  }
  .page-hero__bullets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    top: 0;
    color: var(--mauve);
    font-weight: 700;
  }
</style>
