---
/**
 * PromoBanner — First-visit promo: free 15-minute consultation + a small
 * complimentary gesture chosen by the visitor. The three options deeplink
 * to /contatti?ritual=... so the ContactForm prefills the dropdown.
 *
 * Single CTA per page rule: this banner counts as the page-level call to
 * action when present. Don't pair with another `btn--halo` in the same
 * viewport.
 */
const rituals = [
  {
    key: "mani",
    title: "Mini-rituale mani",
    body: "Lima, cura cuticole e smalto rapido a finire. Quindici minuti, mani in ordine.",
  },
  {
    key: "viso-marbellas",
    title: "Massaggio viso Marbellas",
    body: "Breve trattamento viso con la linea epigenetica: pelle più luminosa appena uscita.",
  },
  {
    key: "sopracciglia",
    title: "Disegno sopracciglia",
    body: "Studio della forma e rifinitura. Sguardo ordinato, niente stravolgimenti.",
  },
];
---
<aside class="promo" data-reveal>
  <div class="promo__bg" aria-hidden="true"></div>
  <div class="promo__inner">
    <header class="promo__head">
      <p class="promo__kicker">Prima visita · Carmagnola</p>
      <h2 class="promo__title">
        Quindici minuti per conoscerci, gratis. <span>E un piccolo regalo a tua scelta.</span>
      </h2>
      <p class="promo__lead">
        Vieni in studio, ci dici cosa vorresti fare e leggiamo pelle / zona /
        obiettivo. Decidiamo insieme se ha senso iniziare un percorso. In
        regalo, scegli uno dei tre rituali qui sotto.
      </p>
    </header>

    <ul class="promo__rituals">
      {rituals.map((r) => (
        <li class="promo__ritual">
          <h3 class="promo__ritual-title">{r.title}</h3>
          <p class="promo__ritual-body">{r.body}</p>
          <a class="promo__ritual-cta" href={`/contatti?ritual=${r.key}`}>
            Prenoto questo →
          </a>
        </li>
      ))}
    </ul>

    <div class="promo__foot">
      <a class="btn btn--primary btn--halo" href="/contatti">
        Prenota la prima visita gratuita
      </a>
      <p class="promo__small">
        Nessun obbligo di acquisto. La proposta nasce dal confronto, non da un pacchetto preconfezionato.
      </p>
    </div>
  </div>
</aside>

<style>
  .promo {
    position: relative;
    border-radius: var(--r-lg);
    border: 1px solid var(--line-strong);
    overflow: hidden;
    isolation: isolate;
  }
  .promo__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(80% 60% at 12% 18%, rgba(91, 43, 216, 0.5), transparent 70%),
      radial-gradient(70% 50% at 90% 90%, rgba(224, 170, 255, 0.22), transparent 70%),
      linear-gradient(180deg, var(--obsidian-3), var(--obsidian-1));
    z-index: -1;
  }
  .promo__inner {
    padding: clamp(1.8rem, 4vw, 3rem);
    display: grid;
    gap: 2rem;
  }
  .promo__head {
    max-width: 720px;
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .promo__kicker {
    font-size: var(--t-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--mauve);
    margin: 0;
  }
  .promo__title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.12;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .promo__title span {
    color: var(--mauve);
    font-style: italic;
  }
  .promo__lead {
    color: var(--text-muted);
    line-height: var(--lh-body);
    max-width: 60ch;
    margin: 0;
  }

  .promo__rituals {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  @media (max-width: 800px) {
    .promo__rituals { grid-template-columns: 1fr; }
  }
  .promo__ritual {
    padding: 1.2rem 1.2rem 1.1rem;
    border-radius: var(--r-md);
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.4);
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    transition: border-color var(--t-fast) var(--ease-soft), transform var(--t-base) var(--ease-cinema);
  }
  .promo__ritual:hover { border-color: var(--mauve); transform: translateY(-2px); }
  .promo__ritual-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--text-strong);
    letter-spacing: var(--tracking-editorial);
    margin: 0;
  }
  .promo__ritual-body {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.55;
    margin: 0;
  }
  .promo__ritual-cta {
    margin-top: auto;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--mauve);
    border-bottom: 1px solid transparent;
    padding-bottom: 0.18rem;
    width: max-content;
    transition: border-color var(--t-fast) var(--ease-soft);
  }
  .promo__ritual-cta:hover { border-color: var(--mauve); }

  .promo__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.4rem;
  }
  .promo__small {
    font-size: var(--t-small);
    color: var(--text-faint);
    margin: 0;
    max-width: 50ch;
  }
</style>
