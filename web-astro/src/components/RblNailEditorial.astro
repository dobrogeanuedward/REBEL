---
import { rblCollections, rblOfficial, rblShades, type RblNailVariant } from "@/lib/rbl-nails";

interface Props {
  variant?: RblNailVariant;
  bookingHref?: string;
  area?: "mani" | "piedi";
}
const { variant: requestedVariant, bookingHref, area = "mani" } = Astro.props;
const variant = requestedVariant ?? (area === "mani" ? "manicure" : "piedi");
const full = variant === "manicure";
const compact = variant === "confronto" || variant === "classico";
const prefix = `rbl-${variant}`;
const selectedCollection = rblCollections[variant === "classico" ? 1 : 0];
const semiHref = "/servizi/pedicure-semipermanente-carmagnola";
const bookHref = bookingHref ?? `/contatti?source=servizio&trattamento=${full ? "manicure-semipermanente-carmagnola" : "pedicure-semipermanente-carmagnola"}#prenota`;
---

<section id="rbl-colori" class:list={["rbl-story", `rbl-story--${variant}`, { "rbl-story--compact": compact }]} aria-labelledby={`${prefix}-title`}>
  <div class="rbl-shell">
    {compact ? (
      <div class="rbl-teaser">
        <figure class="rbl-teaser__photo">
          <a href={`${rblOfficial}/collezioni/${selectedCollection.slug}`} aria-label={`Esplora i colori della collezione RBL ${selectedCollection.name}`}>
            <img src={selectedCollection.tips} alt={`TIP della collezione ufficiale RBL ${selectedCollection.name}`} width="1600" height="900" loading="lazy" decoding="async" />
          </a>
          <figcaption>Collezione gel RBL {selectedCollection.name}.</figcaption>
        </figure>
        <div class="rbl-teaser__copy">
          <p class="rbl-kicker">Il colore, da REBEL</p>
          <h2 id={`${prefix}-title`}>{variant === "classico" ? <>La sfumatura giusta.<br /><em>Il finish che ami.</em></> : <>Tradizionale o gel?<br /><em>Parti dal tuo stile.</em></>}</h2>
          <p>{variant === "classico" ? "Un tono discreto o un colore che si fa notare: per lo smalto tradizionale scegliamo insieme la tonalità e la finitura, in studio." : "Il pedicure cambia con le tue abitudini. Esplora le opzioni di cura dei piedi e, se ami il semipermanente, lasciati ispirare dalle collezioni RBL."}</p>
          <a class="rbl-text-link" href={semiHref}>{variant === "classico" ? "Preferisci il semipermanente? Scoprilo" : "Esplora il pedicure semipermanente"}<span aria-hidden="true">↗</span></a>
          <p class="rbl-note">Le TIP fotografate appartengono alla linea gel RBL; sono un’ispirazione cromatica, non campioni di smalto tradizionale.</p>
        </div>
      </div>
    ) : (
      <>
        <header class="rbl-intro">
          <div><p class="rbl-kicker">REBEL × RBL Nails</p><h2 id={`${prefix}-title`}>{full ? <>Il colore che scegli.<br /><em>Il carattere che hai.</em></> : <>Anche ai piedi,<br /><em>il colore è tuo.</em></>}</h2></div>
          <div class="rbl-intro__copy">
            <p>{full ? <>Un nude luminoso. Il tuo rosso. Una sfumatura che non avevi ancora considerato. <strong>138 cromie di semipermanente RBL</strong>, da esplorare e interpretare insieme a Carmagnola.</> : "Tono su tono, in contrasto con le mani o pronto per i sandali. Parti dai campioni della linea gel RBL e trova la direzione del tuo prossimo pedicure semipermanente."}</p>
            <a class="rbl-text-link" href={`${rblOfficial}/colori`}>Tutto il mondo colore RBL<span aria-hidden="true">↗</span></a>
          </div>
        </header>

        {full ? (
          <figure class="rbl-feature">
            <img src="/img/rbl-official/rosa-in-polvere.webp" srcset="/img/rbl-official/rosa-in-polvere-800.webp 800w, /img/rbl-official/rosa-in-polvere.webp 1536w" sizes="(max-width: 1300px) 100vw, 1280px" width="1536" height="1024" loading="lazy" decoding="async" alt="Manicure rosa, nude e malva nella fotografia ufficiale RBL Rosa in Polvere" />
            <figcaption><span>Rosa in Polvere</span><strong>Delicatezza, con personalità.</strong><a href={`${rblOfficial}/collezioni/rosa-in-polvere`}>Entra nella collezione <span aria-hidden="true">↗</span></a></figcaption>
          </figure>
        ) : (
          <figure class="rbl-feet-palette"><img src={rblCollections[0].tips} width="1600" height="900" loading="lazy" decoding="async" alt="Cinque TIP nude, rosa e malva della collezione gel RBL Rosa in Polvere" /><figcaption>Rosa in Polvere · i campioni della linea gel RBL, da cui prendere ispirazione.</figcaption></figure>
        )}

        <div class="rbl-picker">
          <div class="rbl-section-heading"><p class="rbl-kicker">Sei colori, sei direzioni</p><h3>Scegli una sfumatura.<br /><em>Guardala da vicino.</em></h3><p>Seleziona il colore per aprire la sua scheda ufficiale.</p></div>
          <fieldset class="rbl-shades"><legend class="rbl-sr-only">Scegli il colore RBL da esplorare</legend>
            {rblShades.map((shade, index) => <>
              <input class="rbl-radio" type="radio" id={`${prefix}-shade-${shade.code}`} name={`${prefix}-shade`} value={shade.code} checked={index === 0} aria-controls={`${prefix}-sheet-${shade.code}`} />
              <label for={`${prefix}-shade-${shade.code}`} style={`--shade: ${shade.hex}`}><span class="rbl-swatch" aria-hidden="true"></span><span>{shade.name}<small>RBL-{shade.code}</small></span></label>
            </>)}
          </fieldset>
          <div class="rbl-colour-stage">
            {rblShades.map((shade, index) => <figure class:list={["rbl-sheet", { "rbl-sheet--first": index === 0 }]} data-shade={shade.code} id={`${prefix}-sheet-${shade.code}`}>
              <a class="rbl-sheet__image" href={shade.image} target="_blank" rel="noreferrer" aria-label={`Ingrandisci il colore ${shade.name}`}><img src={shade.image} width={shade.width} height={shade.height} alt={`Scheda ufficiale RBL-${shade.code} ${shade.name}: manicure, flacone e TIP del colore`} loading="lazy" decoding="async" /></a>
              <figcaption><div><small>RBL-{shade.code}</small><h4>{shade.name}</h4><p>{shade.description}</p></div><a class="rbl-text-link" href={shade.href}>Scheda colore RBL<span aria-hidden="true">↗</span></a></figcaption>
            </figure>)}
          </div>
          <p class="rbl-note">Tocca la fotografia per vederla intera a piena dimensione. Luce e schermo possono cambiare la percezione del colore: scegliamo il campione insieme in studio.{!full && " Le schede ufficiali mostrano il colore sulle mani, come riferimento per la tinta."}</p>
        </div>

        {full && <div class="rbl-collections">
          <div class="rbl-section-heading"><p class="rbl-kicker">Le collezioni</p><h3>Una palette.<br /><em>Più modi di sentirla.</em></h3></div>
          <fieldset class="rbl-collection-tabs"><legend class="rbl-sr-only">Scegli la collezione RBL</legend>
            {rblCollections.map((collection, index) => <><input class="rbl-radio" type="radio" id={`${prefix}-collection-${collection.slug}`} name={`${prefix}-collection`} value={collection.slug} checked={index === 0} aria-controls={`${prefix}-collection-panel-${collection.slug}`} /><label for={`${prefix}-collection-${collection.slug}`}>{collection.name}<span aria-hidden="true">↗</span></label></>)}
          </fieldset>
          {rblCollections.map((collection, index) => <div class:list={["rbl-collection", { "rbl-collection--first": index === 0 }]} data-collection={collection.slug} id={`${prefix}-collection-panel-${collection.slug}`}>
            <figure class="rbl-collection__hands"><img src={collection.hands} width="1536" height="1024" loading="lazy" decoding="async" alt={`Interpretazione ufficiale sulle mani della collezione RBL ${collection.name}`} /><figcaption>{collection.name}, sulle mani.</figcaption></figure>
            <div class="rbl-collection__palette"><figure><img src={collection.tips} width="1600" height="900" loading="lazy" decoding="async" alt={`La palette completa di TIP della collezione RBL ${collection.name}`} /></figure><div><h4>{collection.name}</h4><p>{collection.description}</p><a class="rbl-text-link" href={`${rblOfficial}/collezioni/${collection.slug}`}>Esplora la collezione<span aria-hidden="true">↗</span></a></div></div>
          </div>)}
        </div>}

        {!full && <figure class="rbl-second-palette"><img src={rblCollections[1].tips} width="1600" height="900" loading="lazy" decoding="async" alt="TIP della collezione gel RBL Argento Vivo" /><figcaption>Argento Vivo · se cerchi una luce diversa. <a href={`${rblOfficial}/collezioni/argento-vivo`}>Esplora la collezione ↗</a></figcaption></figure>}

        <div class="rbl-formula">
          <div class="rbl-section-heading"><p class="rbl-kicker">La linea gel colore RBL</p><h3>Il colore conta.<br /><em>Anche la formula.</em></h3></div>
          <ul class="rbl-formula__words" aria-label="Caratteristiche dichiarate da RBL per la propria linea gel"><li>Vegan<span>La scelta della linea.</span></li><li>HEMA <em>free</em><span>Una formula senza HEMA.</span></li><li>TPO <em>free</em><span>Una formula senza TPO.</span></li></ul>
          <div class="rbl-formula__copy"><p>RBL dichiara la propria linea gel <strong>vegan, HEMA free, TPO free e 6 toxins free</strong>. Sono caratteristiche della linea gel colore: preparazione, applicazione e rimozione completano il trattamento.</p><a class="rbl-text-link" href={`${rblOfficial}/about`}>Conosci la linea RBL<span aria-hidden="true">↗</span></a></div>
          <p class="rbl-note">Queste caratteristiche riguardano la linea gel RBL, non lo smalto tradizionale né automaticamente tutti i prodotti utilizzati durante il servizio. Se hai già avuto sensibilità a prodotti per unghie, raccontacelo prima dell’applicazione.</p>
        </div>

        {full && <div class="rbl-atelier">
          <figure class="rbl-atelier__red"><img src="/img/rbl-official/hands-studio-rosso.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="Manicure rossa nella fotografia ufficiale della collezione RBL Studio Rosso" /><figcaption>Studio Rosso · l’ispirazione RBL.</figcaption></figure>
          <div class="rbl-atelier__gesture"><img src="/img/rbl-official/atelier-work.webp" width="1122" height="1402" loading="lazy" decoding="async" alt="Applicazione professionale del gel al banco di lavoro nel racconto ufficiale RBL" /><div><p class="rbl-kicker">Dal colore al gesto</p><h3>Il dettaglio<br /><em>fa la differenza.</em></h3><p>Forma, preparazione, finitura. Da REBEL il tuo colore prende forma con attenzione, dall’inizio all’ultimo passaggio.</p></div></div>
        </div>}
        <div class="rbl-booking"><p>{full ? "Hai trovato il tuo colore?" : "Il prossimo colore, lo scegliamo insieme."}</p><a class="rbl-booking__button" href={bookHref}>{full ? "Scegli la tua manicure REBEL" : "Parliamo del tuo pedicure"}<span aria-hidden="true">↗</span></a></div>
      </>
    )}
    <p class="rbl-credits">Fotografie e schede ufficiali <a href={rblOfficial}>RBL Nails</a>: ispirazioni di prodotto e collezione, non risultati su clienti REBEL.</p>
  </div>
</section>

<style>
  .rbl-story { --rbl-ink: #301a3a; --rbl-muted: #685471; --rbl-rose: #a32f68; --rbl-line: #e2d6e1; background: #fffdf9; color: var(--rbl-ink); padding-block: clamp(3rem,6vw,6rem); scroll-margin-top: 6rem; font-family: var(--font-body); color-scheme: light; }
  .rbl-shell { width: min(1280px,calc(100% - 3rem)); margin-inline: auto; }
  .rbl-story :is(h2,h3,h4,p,figure,fieldset,ul) { margin: 0; }
  .rbl-story :is(h2,h3,h4) { font-family: var(--font-display); font-weight: 500; letter-spacing: -.045em; line-height: 1.08; color: var(--rbl-ink); }
  .rbl-story h2 { font-size: clamp(2.3rem,4.4vw,4.7rem); }
  .rbl-story h3 { font-size: clamp(2rem,3.4vw,3.5rem); }
  .rbl-story h4 { font-size: clamp(1.8rem,2.8vw,3rem); }
  .rbl-story :is(h2,h3) em { font-weight: 400; color: #784795; }
  .rbl-story p { color: var(--rbl-muted); font-size: .98rem; line-height: 1.8; }
  .rbl-story strong { color: var(--rbl-ink); }
  .rbl-story img { display: block; width: 100%; height: auto; }
  .rbl-story figure { min-width: 0; }
  .rbl-story a { color: var(--rbl-ink); text-underline-offset: .3em; }
  .rbl-story a:focus-visible { outline: 3px solid #7047ff; outline-offset: 5px; }
  .rbl-story .rbl-kicker { color: var(--rbl-rose); font-size: .72rem; font-weight: 750; letter-spacing: .15em; line-height: 1.5; text-transform: uppercase; margin-bottom: 1rem; }
  .rbl-intro { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(1.5rem,4vw,4rem); align-items: end; }
  .rbl-intro__copy { max-width: 47ch; }
  .rbl-text-link { display: inline-flex; min-height: 44px; align-items: center; gap: .8rem; font-size: .83rem; font-weight: 700; line-height: 1.6; padding-block: .5rem; text-decoration: underline; }
  .rbl-intro__copy .rbl-text-link { margin-top: .7rem; }
  .rbl-feature { position: relative; margin-top: clamp(2rem,4vw,4rem) !important; overflow: hidden; border-radius: 5px 48px 5px 32px; }
  .rbl-feature > img { aspect-ratio: 3/2; object-fit: cover; }
  .rbl-feature figcaption { position: absolute; inset: auto 0 0; padding: clamp(1.4rem,4vw,3rem); display: grid; gap: .5rem; background: linear-gradient(transparent,#28152fd9); color: #fffdf9; }
  .rbl-feature figcaption > span { font-size: .7rem; letter-spacing: .15em; text-transform: uppercase; }
  .rbl-feature figcaption strong { color: #fffdf9; font: 500 clamp(1.8rem,3vw,3rem)/1.1 var(--font-display); }
  .rbl-feature figcaption a { color: #fffdf9; justify-self: start; min-height: 44px; align-content: center; text-decoration: underline; font-size: .82rem; }
  .rbl-section-heading { max-width: 43rem; }
  .rbl-section-heading > p:last-child:not(.rbl-kicker) { margin-top: 1rem; }
  .rbl-picker { margin-top: clamp(3rem,6vw,6rem); }
  .rbl-shades { min-width: 0; border: 0; padding: 0; display: grid; grid-template-columns: repeat(6,minmax(0,1fr)); gap: .6rem; margin-top: 1.7rem !important; }
  .rbl-radio { position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none; }
  .rbl-shades label { min-width: 0; min-height: 90px; display: flex; align-items: center; gap: .7rem; padding: 1rem .7rem; border: 1px solid var(--rbl-line); border-radius: 7px 20px 7px 20px; background: #fff; color: var(--rbl-ink); cursor: pointer; font-size: .76rem; font-weight: 650; line-height: 1.4; }
  .rbl-shades label small { display: block; color: var(--rbl-muted); font-size: .65rem; font-weight: 450; letter-spacing: .04em; margin-top: .3rem; }
  .rbl-swatch { flex: 0 0 22px; width: 22px; height: 34px; border-radius: 40% 40% 35% 35%; background: var(--shade); border: 1px solid #301a3a26; }
  .rbl-radio:checked + label { background: #f5edf7; border-color: #895f99; box-shadow: inset 0 0 0 1px #895f99; }
  .rbl-radio:focus-visible + label { outline: 3px solid #7047ff; outline-offset: 3px; }
  .rbl-colour-stage { margin-top: 1.3rem; }
  .rbl-sheet { display: none; }
  .rbl-sheet--first { display: block; }
  .rbl-sheet__image { display: block; border: 1px solid var(--rbl-line); border-radius: 22px 5px; overflow: hidden; background: #f2e8e1; }
  .rbl-sheet__image img { object-fit: contain; }
  .rbl-sheet figcaption { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem; padding-block: 1.2rem; border-bottom: 1px solid var(--rbl-line); }
  .rbl-sheet figcaption small { display: block; color: var(--rbl-rose); font-size: .72rem; letter-spacing: .1em; margin-bottom: .4rem; }
  .rbl-sheet figcaption p { margin-top: .5rem; font-size: .9rem; }
  .rbl-story .rbl-note { font-size: .75rem; line-height: 1.75; margin-top: 1rem; max-width: 100ch; }
  .rbl-collections { margin-top: clamp(3rem,6vw,6rem); }
  .rbl-collection-tabs { border: 0; min-width: 0; padding: 0; display: flex; gap: .6rem; flex-wrap: wrap; margin-top: 1.5rem !important; }
  .rbl-collection-tabs label { display: flex; align-items: center; justify-content: space-between; gap: 2rem; min-height: 50px; padding: .8rem 1.2rem; border: 1px solid var(--rbl-line); border-radius: 5px 16px; cursor: pointer; font-size: .88rem; font-weight: 650; }
  .rbl-collection { display: none; grid-template-columns: 1.05fr 1fr; gap: clamp(1rem,2vw,2rem); align-items: start; margin-top: 1.5rem; }
  .rbl-collection--first { display: grid; }
  .rbl-collection img { border-radius: 5px 30px 5px 20px; }
  .rbl-collection__hands figcaption { font-size: .75rem; line-height: 1.7; color: var(--rbl-muted); margin-top: .7rem; }
  .rbl-collection__palette > div { padding-top: 1.3rem; }
  .rbl-collection__palette p { font-size: .9rem; margin-top: .6rem; }
  .rbl-formula { margin-top: clamp(3rem,6vw,6rem); padding-block: clamp(2rem,4vw,3.5rem); border-block: 1px solid var(--rbl-line); }
  .rbl-formula__words { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 1.6rem; padding: 0; list-style: none; margin-block: 2rem !important; }
  .rbl-formula__words li { min-width: 0; color: #713e8b; font: 500 clamp(2rem,4.8vw,4.8rem)/1.08 var(--font-display); letter-spacing: -.05em; }
  .rbl-formula__words em { font-weight: 400; }
  .rbl-formula__words span { display: block; margin-top: .7rem; color: var(--rbl-muted); font: 500 .75rem/1.7 var(--font-body); letter-spacing: 0; }
  .rbl-formula__copy { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem 2rem; }
  .rbl-formula__copy p { max-width: 77ch; font-size: .9rem; }
  .rbl-atelier { margin-top: clamp(3rem,6vw,6rem); display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(1.4rem,3vw,3rem); align-items: center; }
  .rbl-atelier__red img { border-radius: 30px 5px; }
  .rbl-atelier__red figcaption { color: var(--rbl-muted); font-size: .75rem; margin-top: .7rem; }
  .rbl-atelier__gesture { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1fr); align-items: center; gap: 1.3rem; }
  .rbl-atelier__gesture img { border-radius: 5px 24px; }
  .rbl-atelier__gesture h3 { font-size: clamp(1.65rem,2.3vw,2.3rem); }
  .rbl-atelier__gesture p:not(.rbl-kicker) { font-size: .85rem; margin-top: .8rem; }
  .rbl-booking { margin-top: 3rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 1.5rem; border-block: 1px solid var(--rbl-line); }
  .rbl-booking p { font: 500 clamp(1.5rem,2.5vw,2rem)/1.2 var(--font-display); color: var(--rbl-ink); }
  .rbl-booking__button { display: inline-flex; align-items: center; justify-content: center; gap: 1rem; min-height: 50px; max-width: 100%; padding: .9rem 1.2rem; border-radius: 18px 6px; color: #fff !important; background: linear-gradient(130deg,#32163d,#7047ff 65%,#ad386e); font-size: .85rem; font-weight: 700; text-align: center; }
  .rbl-story .rbl-credits { padding-top: 1.3rem; margin-top: 1.7rem; color: var(--rbl-muted); font-size: .7rem; line-height: 1.7; }
  .rbl-credits a { display: inline-flex; align-items: center; min-height: 44px; text-decoration: underline; }
  .rbl-feet-palette { margin-top: 2rem !important; }
  .rbl-feet-palette img { border-radius: 5px 38px; }
  .rbl-feet-palette figcaption, .rbl-second-palette figcaption { margin-top: .7rem; color: var(--rbl-muted); font-size: .75rem; line-height: 1.7; }
  .rbl-second-palette { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; margin-top: 3rem !important; }
  .rbl-second-palette img { border-radius: 25px 5px; }
  .rbl-second-palette figcaption a { display: inline-flex; min-height: 44px; align-items: center; color: var(--rbl-ink); text-decoration: underline; }
  .rbl-teaser { display: grid; grid-template-columns: 1.1fr 1fr; gap: clamp(1.5rem,4vw,4rem); align-items: center; }
  .rbl-teaser__photo img { border-radius: 5px 35px; }
  .rbl-teaser__photo figcaption { margin-top: .7rem; color: var(--rbl-muted); font-size: .73rem; }
  .rbl-teaser__copy > p:not(.rbl-kicker) { margin-top: 1rem; }
  .rbl-teaser__copy .rbl-text-link { margin-top: .7rem; }
  .rbl-sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @supports selector(:has(input:checked)) {
    .rbl-picker:has(input:checked) .rbl-sheet { display: none; }
    .rbl-picker:has(input[value="007"]:checked) [data-shade="007"],
    .rbl-picker:has(input[value="009"]:checked) [data-shade="009"],
    .rbl-picker:has(input[value="003"]:checked) [data-shade="003"],
    .rbl-picker:has(input[value="026"]:checked) [data-shade="026"],
    .rbl-picker:has(input[value="080"]:checked) [data-shade="080"],
    .rbl-picker:has(input[value="001"]:checked) [data-shade="001"] { display: block; }
    .rbl-collections:has(input:checked) .rbl-collection { display: none; }
    .rbl-collections:has(input[value="rosa-in-polvere"]:checked) [data-collection="rosa-in-polvere"],
    .rbl-collections:has(input[value="argento-vivo"]:checked) [data-collection="argento-vivo"] { display: grid; }
  }
  @media (max-width: 1000px) {
    .rbl-shades { grid-template-columns: repeat(3,minmax(0,1fr)); }
    .rbl-atelier { grid-template-columns: 1fr; }
    .rbl-atelier__gesture { grid-template-columns: minmax(0,.55fr) minmax(0,1fr); }
    .rbl-atelier__gesture img { max-height: 300px; width: auto; }
  }
  @media (max-width: 700px) {
    .rbl-shell { width: calc(100% - 2rem); }
    .rbl-intro, .rbl-teaser, .rbl-collection { grid-template-columns: minmax(0,1fr); gap: 1.5rem; }
    .rbl-intro__copy { max-width: none; }
    .rbl-feature { border-radius: 5px 28px; }
    .rbl-feature figcaption { position: static; background: #f7f0e9; color: var(--rbl-ink); padding: 1.2rem; }
