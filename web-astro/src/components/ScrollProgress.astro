---
// Cinema scroll bar — vanilla TS, no React, ~0.4kb gzipped.
---
<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress__bar" id="scroll-progress-bar"></div>
</div>

<script>
  type ProgressWindow = Window & {
    __rebelScrollProgressCleanup?: () => void;
    __rebelScrollProgressLifecycle?: AbortController;
  };

  const progressWindow = window as ProgressWindow;
  progressWindow.__rebelScrollProgressLifecycle?.abort();
  const lifecycle = new AbortController();
  progressWindow.__rebelScrollProgressLifecycle = lifecycle;

  const init = () => {
    progressWindow.__rebelScrollProgressCleanup?.();
    const bar = document.getElementById("scroll-progress-bar");
    if (!bar) return;
    let raf = 0;
    const update = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
      bar.style.setProperty("--progress", `${pct}%`);
      raf = 0;
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", update, { passive: true });

    const cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      window.removeEventListener("resize", update);
      if (raf) cancelAnimationFrame(raf);
      if (progressWindow.__rebelScrollProgressCleanup === cleanup) {
        progressWindow.__rebelScrollProgressCleanup = undefined;
      }
    };
    progressWindow.__rebelScrollProgressCleanup = cleanup;
  };

  init();
  document.addEventListener("astro:page-load", init, { signal: lifecycle.signal });
  document.addEventListener("astro:before-swap", () => progressWindow.__rebelScrollProgressCleanup?.(), { signal: lifecycle.signal });
</script>
