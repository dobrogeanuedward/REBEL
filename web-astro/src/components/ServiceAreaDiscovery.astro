---
import SectionHead from "@/components/SectionHead.astro";
import { localAreaGroups, localAreaPages } from "@/lib/local-pages";
import { media } from "@/lib/page-media";

interface Props {
  id?: string;
}
const { id = "raggiungerci" } = Astro.props;
const studioPhoto = media.studio.realExterior;
const featured: Record<string, string[]> = {
  "asse-carmagnola": ["carignano", "racconigi", "poirino", "villastellone"],
  "torino-sud": ["torino", "moncalieri", "nichelino", "vinovo"],
  cuneo: ["ceresole-d-alba", "bra", "canale", "savigliano"],
};
---
<section class="section service-area-discovery" id={id} aria-label="Da dove raggiungere lo studio REBEL">
  <div class="container">
    <div class="service-area-discovery__intro">
      <SectionHead
        kicker="Il tuo appuntamento REBEL"
        title="Ci trovi a _Carmagnola_."
        lead="Tutti i trattamenti si svolgono in Viale Barbaroux 20. Se arrivi da un altro comune, scegli il servizio e concorda l’appuntamento: trovi qui le indicazioni per preparare la visita."
      />
      <a class="service-area-discovery__photo" href="/localita/carmagnola#come-arrivare">
        <picture>{studioPhoto.srcMobile && <source media="(max-width:600px)" srcset={studioPhoto.srcMobile} />}<img src={studioPhoto.src} alt="Riconosci l’ingresso dello studio REBEL in Viale Barbaroux 20 a Carmagnola" width="1672" height="941" loading="lazy" decoding="async" /></picture>
        <span>L’ingresso dello studio <span aria-hidden="true">↗</span></span>
      </a>
    </div>
    <div class="service-area-discovery__grid">
      {localAreaGroups.map((group, i) => (
        <article class="service-area-discovery__card">
          <span class="service-area-discovery__number" aria-hidden="true">0{i + 1}</span>
          <h3>{group.name}</h3>
          <p>{group.description}</p>
          <ul aria-label={`Indicazioni: ${group.name}`}>
            {featured[group.key].map((slug) => {
              const area = localAreaPages.find((item) => item.slug === slug)!;
              return <li><a href={`/localita/${area.slug}`}>Da {area.city}<span aria-hidden="true"> ↗</span></a></li>;
            })}
          </ul>
        </article>
      ))}
    </div>
    <p class="service-area-discovery__footer"><a href="/localita">Scegli un’altra partenza <span aria-hidden="true">→</span></a><a href="/contatti">Contatti e orari dello studio <span aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .service-area-discovery { color-scheme: light; --text: #301b3e; --text-strong: #211427; --text-muted: #62506e; --mauve: #6c2f70; --line: rgba(48, 27, 62, 0.16); color: var(--text); background: #fffdf9; }
  .service-area-discovery :global(.section__title) { color: var(--text-strong); }
  .service-area-discovery :global(.section__lead) { color: var(--text-muted); }
  .service-area-discovery :global(.kicker) { color: var(--mauve); }
  .service-area-discovery__intro { display: grid; grid-template-columns: 1.5fr .7fr; align-items: center; gap: clamp(1.5rem,4vw,4rem); margin-bottom: 2rem; }
  .service-area-discovery__intro :global(.section__head) { margin-bottom: 0; }
  .service-area-discovery__photo { display: block; min-width: 0; color: #70428b; text-decoration: none; }
  .service-area-discovery__photo picture { display: block; overflow: hidden; border-radius: 2rem .4rem 2rem .4rem; background: #ede1e9; }
  .service-area-discovery__photo img { display: block; width: 100%; height: auto; aspect-ratio: 4/3; object-fit: cover; }
  .service-area-discovery__photo>span { display: flex; justify-content: space-between; align-items: center; gap: .5rem; min-height: 44px; font-size: .8rem; }
  .service-area-discovery__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
  .service-area-discovery__card { padding: clamp(1.5rem, 3vw, 2.4rem); border: 1px solid var(--line); border-radius: 2rem .4rem 2rem .4rem; background: linear-gradient(140deg, #f5edf6, #fffdf9); color: #301b3e; }
  .service-area-discovery__card:nth-child(even) { border-radius: .4rem 2rem .4rem 2rem; }
  .service-area-discovery__number { color: var(--mauve); font-size: 0.75rem; letter-spacing: 0.16em; }
  .service-area-discovery__card h3 { margin: 1rem 0; color: #301b3e; font-family: var(--font-display); font-size: clamp(1.5rem, 2.1vw, 2rem); line-height: 1.2; }
  .service-area-discovery__card p { font-size: 0.95rem; line-height: 1.7; color: var(--text); }
  .service-area-discovery__card ul { list-style: none; margin: 1.4rem 0 0; padding: 0; display: grid; gap: 0.2rem; }
  .service-area-discovery__card a { display: flex; align-items: center; justify-content: space-between; min-height: 44px; border-bottom: 1px solid var(--line); color: var(--text); text-decoration: none; font-size: 0.9rem; }
  .service-area-discovery__card a:hover { color: var(--mauve); }
  .service-area-discovery__card a:focus-visible, .service-area-discovery__footer a:focus-visible { outline: 2px solid var(--mauve); outline-offset: 4px; }
  .service-area-discovery__footer { margin-top: 1.6rem; display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 2rem; }
  .service-area-discovery__footer a { color: var(--text); text-underline-offset: 0.3em; display: inline-flex; align-items: center; min-height: 44px; font-size: .9rem; }
  @media (max-width: 900px) { .service-area-discovery__grid { grid-template-columns: 1fr; } }
  @media (max-width: 600px) { .service-area-discovery__intro { grid-template-columns: 1fr; } .service-area-discovery__photo img { aspect-ratio: 16/9; } }
</style>
