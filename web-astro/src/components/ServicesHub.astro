---
import ServiceAreaDiscovery from "./ServiceAreaDiscovery.astro";
import { photographs } from "@/lib/catalog-visuals";
import { serviceCategoryDestinations } from "@/lib/service-navigation";
import { serviceCategories } from "@/lib/service-categories";
import { servicePages, competencePages } from "@/lib/seo-content-refined";
import { protocolCards } from "@/lib/content";
import { laserOffer } from "@/lib/laser-offer";

const categories = [
  { id:"viso", title:"Viso", eyebrow:"La tua pelle", copy:"Pulizia, idratazione, luminosità. La cura comincia da ciò che la tua pelle racconta.", photo:photographs["viso-manualita"], wide:true },
  { id:"laser-treatwell", title:"Epilazione laser", eyebrow:"La tua libertà", copy:"Viso e corpo, donna e uomo. Scopri le zone e il comfort di ICE Polar.", photo:photographs["laser-gamba"], wide:true },
  { id:"mani", title:"Mani e colore", eyebrow:"REBEL × RBL Nails", copy:"La forma che ami. Il nude che senti tuo. Il colore che ti somiglia.", photo:{ src:"/img/rbl-official/rosa-in-polvere.webp", preview:"/img/rbl-official/rosa-in-polvere-800.webp", width:1536, height:1024, alt:"Manicure rosa e nude della collezione ufficiale RBL Nails Rosa in Polvere" }, wide:false },
  { id:"sguardo", title:"Ciglia e sopracciglia", eyebrow:"Dettagli che parlano", copy:"Laminazione ciglia, sopracciglia o combinata. Scegli come valorizzare lo sguardo.", photo:photographs["laminazione-sopracciglia"], wide:false },
  { id:"piedi", title:"Cura dei piedi", eyebrow:"Cura e leggerezza", copy:"Pedicure, forma e colore. Un appuntamento dedicato ai tuoi piedi.", photo:photographs["pedicure-cura"], wide:false },
  { id:"corpo", title:"Corpo", eyebrow:"Il tuo tempo", copy:"Scrub, cosmetici e tecnologie. Scegli una seduta o costruisci il tuo percorso.", photo:photographs["scrub-gamba"], wide:true },
  { id:"massaggi", title:"Massaggi", eyebrow:"Il valore di un gesto", copy:"Rilassante, linfodrenante e altre manualità. Trova il tempo che vuoi dedicarti.", photo:{ src:"/img/rebel-r2/rebel/services/massage/hero-desktop.webp", width:1536, height:1024, alt:"Professionista durante un massaggio sulle spalle di una cliente coperta" }, wide:true },
  { id:"ceretta-donna", title:"Ceretta donna", eyebrow:"La pelle, da vicino", copy:"Dal viso al corpo, dalla singola zona al Total Body. Scopri tutte le proposte.", photo:photographs["cera-preparazione"], wide:false },
  { id:"ceretta-uomo", title:"Ceretta uomo", eyebrow:"La tua scelta", copy:"Schiena, petto, braccia, gambe. Scegli le zone che desideri trattare.", photo:photographs["cera-gamba"], wide:false },
  { id:"pressomassaggio", title:"Pressomassaggio", eyebrow:"Una pausa per te", copy:"Sedute, durate e abbinamenti con bendaggi. Confronta le proposte del menu.", photo:photographs["percorso-forma"], wide:false },
];
const allServices = [...servicePages,...serviceCategories];
const detailGroups = [
  { title:"Viso", slugs:["trattamenti-viso-carmagnola","pulizia-viso-carmagnola"] },
  { title:"Corpo e pressomassaggio", slugs:["trattamenti-corpo-carmagnola","scrub-corpo-carmagnola","pressomassaggio-carmagnola"] },
  { title:"Massaggi", slugs:["massaggi-carmagnola","massaggio-rilassante-carmagnola","massaggio-linfodrenante-carmagnola"] },
  { title:"Mani e sguardo", slugs:["manicure-semipermanente-carmagnola","laminazione-ciglia-sopracciglia-carmagnola"] },
  { title:"Piedi", slugs:["pedicure-carmagnola","pedicure-estetico-carmagnola","pedicure-estetico-con-smalto-carmagnola","pedicure-semipermanente-carmagnola","taglio-unghie-piedi-carmagnola"] },
  { title:"Laser e ceretta", slugs:["epilazione-laser-viso-carmagnola","epilazione-laser-corpo-carmagnola","epilazione-laser-viso-uomo-carmagnola","epilazione-laser-corpo-uomo-carmagnola","ceretta-carmagnola"] },
].map(group=>({...group,items:allServices.filter(service=>group.slugs.includes(service.slug)).sort((a,b)=>group.slugs.indexOf(a.slug)-group.slugs.indexOf(b.slug))}));
const guides = [
  { slug:"pulizia-viso-carmagnola-frequenza-benefici", title:"Quando fare la pulizia viso?", topic:"Viso", image:photographs["viso-detersione"] },
  { slug:"manicure-semipermanente-carmagnola-durata-rimozione", title:"Semipermanente: durata e rimozione.", topic:"Mani", image:photographs["mani-smalto"] },
  { slug:"laminazione-ciglia-sopracciglia-carmagnola-durata-cura", title:"Come prendersi cura della laminazione.", topic:"Sguardo", image:photographs["laminazione-ciglia"] },
  { slug:"epilazione-laser-estate-sole-carmagnola", title:"Laser e sole: come organizzarsi.", topic:"Laser", image:photographs["percorso-liberta"] },
].filter(guide=>competencePages.some(page=>page.slug===guide.slug));
---
<div class="services-hub">
  <section class="hub-hero" aria-labelledby="services-title">
    <div class="hub-shell">
      <nav class="hub-breadcrumb" aria-label="Percorso di navigazione"><a href="/">REBEL</a><span aria-hidden="true">/</span><span>Servizi</span></nav>
      <div class="hub-hero__grid">
        <div class="hub-hero__copy">
          <p class="hub-kicker">Estetica epigenetica · Carmagnola</p>
          <h1 id="services-title">Il tempo per te.<br />Il trattamento<br />che <em>scegli.</em></h1>
          <p class="hub-hero__lead">Viso, corpo, laser e beauty. Un gesto di cura, un colore, un nuovo inizio: trova il tuo appuntamento REBEL.</p>
          <div class="hub-actions"><a class="hub-button hub-button--primary" href="#menu-completo">Esplora i trattamenti <span aria-hidden="true">↘</span></a><a class="hub-link" href="/listino-estetica-laser">Trattamenti e prezzi <span aria-hidden="true">↗</span></a></div>
          <p class="hub-hero__signature">Attivi. Manualità. Attenzione a te.</p>
        </div>
        <div class="hub-collage" aria-label="Il mondo dei trattamenti REBEL">
          <figure class="hub-collage__portrait"><img src="/img/catalogo/viso-manualita-rebel.webp" srcset="/img/catalogo/viso-manualita-rebel-480.webp 480w, /img/catalogo/viso-manualita-rebel.webp 1440w" sizes="(max-width:760px) 56vw, 34vw" alt="Manualità sulle guance durante un trattamento viso" width="1440" height="810" loading="eager" fetchpriority="high" decoding="async" /><figcaption>Il valore di un gesto.</figcaption></figure>
          <a class="hub-collage__detail" href="/epilazione-laser-carmagnola"><img src="/img/catalogo/laser-gamba-rebel-480.webp" alt="Manipolo laser a contatto con la gamba" width="480" height="270" loading="eager" decoding="async" /><span>La tua libertà. <span aria-hidden="true">↗</span></span></a>
          <a class="hub-collage__colour" href={serviceCategoryDestinations.mani}><img src="/img/rbl-official/rosa-in-polvere-800.webp" alt="Rosa e nude della collezione ufficiale RBL Nails" width="800" height="533" loading="eager" decoding="async" /><span>Il tuo colore. <span aria-hidden="true">↗</span></span></a>
        </div>
      </div>
      <nav class="hub-quicknav" aria-label="Scegli come esplorare i servizi"><a href="#menu-completo"><small>01 / Lasciati ispirare</small><strong>Trova il trattamento <span aria-hidden="true">↓</span></strong></a><a href="#estetica"><small>02 / Sai già cosa cerchi?</small><strong>Vai al tuo servizio <span aria-hidden="true">↓</span></strong></a><a href="/contatti#prenota"><small>03 / Scegliamo insieme</small><strong>Parlane con REBEL <span aria-hidden="true">↗</span></strong></a></nav>
    </div>
  </section>

  <section class="hub-section hub-section--white" id="menu-completo" aria-labelledby="services-menu-title"><div class="hub-shell">
    <div class="hub-heading"><div><p class="hub-kicker">I servizi REBEL</p><h2 id="services-menu-title">Da dove vuoi <em>cominciare?</em></h2></div><p>Scegli una categoria. Trovi le proposte, i dettagli del trattamento e il modo di prenotare.</p></div>
    <div class="hub-worlds">{categories.map((category,index)=><article class:list={["hub-world",{"hub-world--wide":category.wide}]} id={`categoria-${category.id}`}>
      <a class="hub-world__image" href={serviceCategoryDestinations[category.id]} aria-label={`Scopri ${category.title}`}><img src={category.photo.src} srcset={"preview" in category.photo ? `${category.photo.preview} ${category.id==="mani"?800:480}w, ${category.photo.src} ${category.photo.width}w` : undefined} sizes={category.wide?"(max-width:760px) 100vw, 50vw":"(max-width:420px) 100vw, (max-width:760px) 50vw, 33vw"} alt={category.photo.alt} width={category.photo.width} height={category.photo.height} loading="lazy" decoding="async" /><span class="hub-world__number" aria-hidden="true">{String(index+1).padStart(2,"0")}</span><span class="hub-world__arrow" aria-hidden="true">↗</span></a>
      <div class="hub-world__copy"><p class="hub-kicker">{category.eyebrow}</p><h3><a href={serviceCategoryDestinations[category.id]}>{category.title}</a></h3><p>{category.copy}</p><a class="hub-link" href={serviceCategoryDestinations[category.id]}>Esplora {category.title.toLocaleLowerCase("it")} <span aria-hidden="true">→</span></a></div>
    </article>)}</div>
    <p class="hub-image-note">Scene illustrative dei trattamenti. Le fotografie di collezione RBL Nails raccontano il mondo colore della linea.</p>
  </div></section>

  <section class="hub-section hub-colour" aria-labelledby="services-colour-title"><div class="hub-shell hub-colour__grid">
    <div class="hub-colour__pictures"><img class="hub-colour__hands" src="/img/rbl-official/hands-studio-rosso.webp" width="1536" height="1024" loading="lazy" decoding="async" alt="Manicure rossa nella fotografia ufficiale RBL Nails" /><figure><img src="/img/rbl-official/collection-rosa-in-polvere-tips.webp" width="1600" height="900" loading="lazy" decoding="async" alt="Tips rosa e nude della collezione ufficiale RBL Rosa in Polvere, con flacone gel" /><figcaption>Rosa in Polvere · RBL Nails</figcaption></figure></div>
    <div class="hub-colour__copy"><p class="hub-kicker">REBEL × RBL Nails</p><h2 id="services-colour-title">Il tuo colore.<br /><em>Il tuo modo di essere.</em></h2><p>Dal nude che si fa sussurro al rosso che si prende la scena. Esplora le collezioni, confronta le tips e trova la tua sfumatura tra le <strong>138 cromie gel RBL.</strong></p><div class="hub-colour__chips" aria-label="Linea gel RBL"><span>Vegan</span><span>HEMA free</span><span>TPO free</span></div><div class="hub-colour__links"><a class="hub-button hub-button--plum" href={serviceCategoryDestinations.mani}>Scegli la tua manicure <span aria-hidden="true">↗</span></a><a class="hub-link" href={serviceCategoryDestinations.piedi}>Cura e colore per i piedi <span aria-hidden="true">→</span></a></div><p class="hub-credit">Fotografie ufficiali RBL Nails. Caratteristiche riferite alla linea gel colore.</p></div>
  </div></section>

  <section class="hub-section hub-section--white" id="estetica" aria-labelledby="services-details-title"><div class="hub-shell">
    <div class="hub-heading"><div><p class="hub-kicker">Il tuo servizio, nel dettaglio</p><h2 id="services-details-title">Sai già <em>cosa cerchi?</em></h2></div><a class="hub-link" href="/listino-estetica-laser">Apri il listino completo <span aria-hidden="true">↗</span></a></div>
    <div class="hub-details">{detailGroups.map(group=><div class="hub-detail-group"><h3>{group.title}</h3><ul>{group.items.map(service=><li><a href={`/servizi/${service.slug}`}>{service.name.replace(/ a Carmagnola$| Carmagnola$/,"")}<span aria-hidden="true">↗</span></a></li>)}</ul></div>)}</div>
  </div></section>

  <section class="hub-section hub-laser" id="laser" aria-labelledby="services-laser-title"><div class="hub-shell hub-laser__grid">
    <div class="hub-laser__copy"><p class="hub-kicker">La promozione laser REBEL</p><h2 id="services-laser-title">La libertà<br /><em>comincia qui.</em></h2><p>Lumina X1 Pro con raffreddamento ICE Polar. Scegli le zone e concorda la tua valutazione nello studio di Carmagnola.</p><dl class="hub-laser__prices"><div><dt>Una zona · una seduta</dt><dd>{laserOffer.zone.price}</dd></div><div><dt>Total Body · 10 zone · una seduta</dt><dd>{laserOffer.totalBody.price}</dd></div></dl><p class="hub-laser__note">L’inguine conta come 2 zone. Zone e condizioni confermate prima di iniziare. {laserOffer.validity.label}</p><a class="hub-button hub-button--primary" href={laserOffer.landingPath}>Scopri la promozione <span aria-hidden="true">↗</span></a></div>
    <figure><img src="/img/catalogo/laser-gamba-rebel.webp" srcset="/img/catalogo/laser-gamba-rebel-480.webp 480w, /img/catalogo/laser-gamba-rebel.webp 1440w" sizes="(max-width:760px) 100vw, 50vw" alt="Dettaglio del manipolo durante un trattamento laser sulla gamba" width="1440" height="810" loading="lazy" decoding="async" /><figcaption>Il trattamento, da vicino. · Scena illustrativa</figcaption></figure>
  </div></section>

  <section class="hub-section hub-section--white" id="epigenetica" aria-labelledby="services-path-title"><div class="hub-shell hub-path">
    <figure><img src="/img/shooting-rebel/glow-trattamento-rebel-carmagnola.webp" srcset="/img/shooting-rebel/glow-trattamento-rebel-carmagnola-640.webp 640w, /img/shooting-rebel/glow-trattamento-rebel-carmagnola.webp 1600w" sizes="(max-width:760px) 100vw, 45vw" alt="Un gesto manuale lungo il contorno del viso durante un trattamento" width="1600" height="900" loading="lazy" decoding="async" /><figcaption>Attivi e manualità, scelti per la pelle. · Scena illustrativa</figcaption></figure>
    <div><p class="hub-kicker">Dal gesto al percorso</p><h2 id="services-path-title">La cura prende<br /><em>la tua direzione.</em></h2><p>Un singolo trattamento o un percorso con continuità: partiamo dalla valutazione e scegliamo insieme attivi, manualità e tecnologie.</p><a class="hub-link" href="/percorsi">Esplora i percorsi REBEL <span aria-hidden="true">↗</span></a><div class="hub-protocols"><span>Oppure scopri un protocollo</span>{protocolCards.slice(0,6).map(protocol=><a href={`/protocolli/${protocol.slug}`}>{protocol.name}<span aria-hidden="true">↗</span></a>)}</div></div>
  </div></section>

  <section class="hub-section hub-studio" aria-labelledby="services-studio-title"><div class="hub-shell hub-studio__grid">
    <div><p class="hub-kicker">Il tuo appuntamento, a Carmagnola</p><h2 id="services-studio-title">Entra <em>da REBEL.</em></h2><p>Ti aspettiamo in Viale Barbaroux 20. Uno spazio dedicato alla cura, al colore e al tempo che scegli di riservarti.</p><a class="hub-link" href="/chi-siamo">Scopri lo studio e il team <span aria-hidden="true">↗</span></a><a class="hub-link" href="/contatti">Orari e contatti <span aria-hidden="true">→</span></a></div>
    <figure><img src="/img/studio-treatwell/15432056.jpg" alt="L’accoglienza dello studio REBEL di Carmagnola, con vetrina e marchio" width="1080" height="720" loading="lazy" decoding="async" /><figcaption>Lo studio REBEL · Viale Barbaroux 20, Carmagnola</figcaption></figure>
  </div></section>

  <section class="hub-section hub-section--white" id="guide" aria-labelledby="services-guides-title"><div class="hub-shell">
    <div class="hub-heading"><div><p class="hub-kicker">Prima e dopo l’appuntamento</p><h2 id="services-guides-title">Le risposte <em>che cerchi.</em></h2></div><p>Preparazione, durata e cura a casa: qualche lettura per scegliere con più chiarezza.</p></div>
    <div class="hub-guides">{guides.map(guide=><a class="hub-guide" href={`/competenze/${guide.slug}`}><img src={guide.image.preview} alt={guide.image.alt} width="480" height={Math.round(480*guide.image.height/guide.image.width)} loading="lazy" decoding="async" /><div><span>{guide.topic}</span><h3>{guide.title}</h3><span class="hub-guide__arrow" aria-hidden="true">↗</span></div></a>)}</div>
  </div></section>

  <ServiceAreaDiscovery />
  <section class="hub-section hub-closing" aria-labelledby="services-closing-title"><div class="hub-shell"><p class="hub-kicker">Scegliamo insieme</p><h2 id="services-closing-title">Il prossimo gesto di cura?<br /><em>Comincia da te.</em></h2><p>Raccontaci cosa desideri. Ti aiutiamo a scegliere il servizio o a prenotare la valutazione REBEL di 30–40 minuti.</p><div class="hub-actions"><a class="hub-button hub-button--primary" href="/contatti#prenota">Parlane con REBEL <span aria-hidden="true">↗</span></a><a class="hub-link" href="https://wa.me/393516919416">Scrivici su WhatsApp <span aria-hidden="true">↗</span></a></div><p class="hub-credit">Se inizi il percorso proposto, la valutazione iniziale è gratuita.</p></div></section>
</div>

<style>
.services-hub{--hub-ink:#2b1833;--hub-muted:#67566d;--hub-rose:#a72c68;--hub-paper:#fffdf9;--hub-line:#e5d9e2;color-scheme:light;color:var(--hub-ink);background:var(--hub-paper);font-family:var(--font-body)}
.services-hub :is(h1,h2,h3,p,figure,dl,dd,ul){margin:0}.services-hub :is(h1,h2,h3){color:var(--hub-ink);font-family:var(--font-body);font-weight:600;letter-spacing:-.055em;text-wrap:balance}.services-hub :is(h1,h2) em{color:#7d3985;font-family:var(--font-display);font-weight:400;letter-spacing:-.055em}.services-hub h2{font-size:clamp(2.15rem,4.1vw,4.5rem);line-height:1.13}.services-hub p{color:var(--hub-muted);font-size:1rem;line-height:1.8}.services-hub strong{color:var(--hub-ink)}.services-hub img{display:block;max-width:100%;height:auto}.services-hub a{color:inherit;text-decoration:none}.services-hub a:focus-visible{outline:3px solid #8941b0;outline-offset:5px;border-radius:4px}
.hub-shell{width:min(1320px,calc(100% - 4rem));margin-inline:auto}.hub-section{padding-block:clamp(4.5rem,8vw,8rem);scroll-margin-top:6rem}.hub-section--white{background:#fff}.services-hub .hub-kicker{color:var(--hub-rose);font-size:.65rem;line-height:1.6;font-weight:750;text-transform:uppercase;letter-spacing:.16em;margin-bottom:1rem}.hub-heading{display:flex;justify-content:space-between;align-items:end;gap:2.5rem;margin-bottom:2.6rem}.hub-heading>p{max-width:26rem;font-size:.95rem}.hub-actions{display:flex;flex-wrap:wrap;align-items:center;gap:1rem 1.6rem;margin-top:2rem}
.hub-button{display:inline-flex;justify-content:center;align-items:center;gap:1.3rem;min-height:54px;padding:.95rem 1.5rem;border-radius:99px;font-size:.83rem;font-weight:700;line-height:1.5;transition:transform .2s ease,box-shadow .2s ease}.services-hub .hub-button--primary{background:linear-gradient(110deg,#b52b72,#773eb9 62%,#496ca9);color:#fff;box-shadow:0 8px 24px #71377d1c}.services-hub .hub-button--plum{background:#402249;color:#fff}.hub-button:hover{transform:translateY(-2px);box-shadow:0 10px 30px #71377d29}.services-hub .hub-link{display:inline-flex;justify-content:space-between;align-items:center;gap:1.2rem;min-height:44px;color:#71367a;font-size:.82rem;font-weight:700;text-decoration:underline;text-decoration-color:#71367a45;text-underline-offset:.4em}.hub-link:hover{text-decoration-color:currentColor}
.hub-hero{padding-top:clamp(7rem,10vw,9rem);background:radial-gradient(ellipse at 95% 10%,#efddf465,transparent 55%),var(--hub-paper)}.hub-breadcrumb{display:flex;align-items:center;gap:.7rem;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:#806d85;margin-bottom:2.1rem}.hub-breadcrumb a{min-height:28px;display:inline-flex;align-items:center;color:#7b3c83}.hub-hero__grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(0,1.08fr);gap:clamp(2rem,4vw,5rem);align-items:center;padding-bottom:3.4rem}.hub-hero h1{font-size:clamp(3rem,5.4vw,6.1rem);line-height:1.04}.hub-hero__lead{max-width:29rem;margin-top:1.6rem!important;font-size:clamp(1rem,1.25vw,1.15rem)!important}.services-hub .hub-hero__signature{font-size:.65rem;color:#8a748d;letter-spacing:.08em;margin-top:2rem}
.hub-collage{display:grid;grid-template-columns:1.32fr 1fr;gap:.9rem;align-items:stretch}.hub-collage__portrait{grid-row:span 2;align-self:stretch;display:flex;flex-direction:column}.hub-collage__portrait img{flex:1;width:100%;height:100%;min-height:0;aspect-ratio:3/4;object-fit:cover;object-position:52% 48%;border-radius:65px 5px 5px 5px}.hub-collage__portrait figcaption{font-size:.62rem;line-height:1.5;margin-top:.8rem}.hub-collage>a{display:flex;flex-direction:column;align-self:start;min-width:0}.hub-collage>a>img{width:100%;aspect-ratio:1;object-fit:cover}.hub-collage__detail{padding-top:2.7rem}.hub-collage__detail img{border-radius:5px 38px 5px 5px;object-position:65% 50%}.hub-collage__colour img{border-radius:5px 5px 35px 5px;object-position:58% 45%}.hub-collage>a>span{display:flex;justify-content:space-between;gap:.4rem;font-size:.63rem;font-weight:650;line-height:1.6;margin-top:.6rem;color:#664b6e}
.hub-quicknav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--hub-line)}.hub-quicknav>a{padding:1.6rem 1.8rem 1.6rem 0;border-right:1px solid var(--hub-line)}.hub-quicknav>a+a{padding-left:1.8rem}.hub-quicknav>a:last-child{border-right:0}.hub-quicknav small{display:block;color:#937e96;font-size:.58rem;text-transform:uppercase;letter-spacing:.09em;margin-bottom:.6rem}.hub-quicknav strong{display:flex;justify-content:space-between;gap:.8rem;font-size:.83rem;font-weight:650}.hub-quicknav a:hover strong{color:#a72c68}
