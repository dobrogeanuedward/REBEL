---
import { siteConfig } from "@/lib/site-config";

const primary = [
  { href: "/metodo-rebel", label: "Come scegliamo i trattamenti" },
  { href: "/percorsi", label: "Percorsi viso, corpo e laser" },
  { href: "/tecnologie-rebel", label: "Tecnologie disponibili" },
  { href: "/epilazione-laser-carmagnola", label: "Epilazione laser: prezzi e zone" },
  { href: "/listino-estetica-laser", label: "Listino completo" },
  { href: "/chi-siamo", label: "Studio Rebel" },
  { href: "/contatti", label: "Contatti e valutazione" },
];

const days = [
  { day: "Lun", value: "Chiuso", closed: true },
  { day: "Mar", value: "9–19" },
  { day: "Mer", value: "14–19" },
  { day: "Gio", value: "9–19" },
  { day: "Ven", value: "9–19" },
  { day: "Sab", value: "9–14" },
  { day: "Dom", value: "Chiuso", closed: true },
];
---
<footer class="site-footer rebel-site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <img src={siteConfig.assets.logoLight} alt="Rebel Estetica Epigenetica" class="site-footer__logo" width="1366" height="577" decoding="async" loading="lazy" />
        <h2 class="site-footer__tagline">Viso, corpo, laser e beauty a Carmagnola.</h2>
        <p class="site-footer__copy">
          Trattamenti estetici, protocolli epigenetici e tecnologie professionali in Viale Barbaroux 20. La valutazione REBEL dura 30–40 minuti. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.
        </p>
        <div class="rebel-site-footer__signatures"><span>Be Beautiful. Be Rebel.</span></div>
        <div class="cluster" style="margin-top:1.5rem;">
          <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
          <a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">WhatsApp</a>
        </div>
      </div>

      <nav aria-label="Pagine principali">
        <p class="site-footer__title">Pagine principali</p>
        <ul class="site-footer__list">{primary.map((it) => (<li><a href={it.href}>{it.label}</a></li>))}</ul>
      </nav>

      <address class="site-footer__contact">
        <p class="site-footer__title">Contatti</p>
        <div class="site-footer__contact-row"><span>Indirizzo</span><a href={siteConfig.social.maps} target="_blank" rel="noreferrer">{siteConfig.address.streetAddress}, {siteConfig.address.locality}</a></div>
        <div class="site-footer__contact-row"><span>Telefono</span><a href={`tel:${siteConfig.phoneRaw}`}>{siteConfig.phoneDisplay}</a></div>
        <div class="site-footer__contact-row"><span>WhatsApp</span><a href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Apri la chat</a></div>
        <div class="site-footer__contact-row"><span>Email</span><a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a></div>
        <p class="site-footer__title" style="margin-top:1.6rem;">Orari</p>
        <ul class="site-footer__hours">{days.map((d) => (<li class={d.closed ? "is-closed" : ""}><span>{d.day}</span><span>{d.value}</span></li>))}</ul>
      </address>
    </div>

    <div class="site-footer__network" aria-label="Network professionale">
      <span class="site-footer__network-label">Tecnologie e formazione professionale</span>
      <div class="site-footer__network-row">{siteConfig.network.map((n) => (<a class="site-footer__network-link" href={n.url} target="_blank" rel="noreferrer"><span class="site-footer__network-name">{n.label}</span><span class="site-footer__network-note">{n.note}</span></a>))}</div>
    </div>

    <div class="site-footer__bottom">
      <span class="site-footer__copy-line">© {new Date().getFullYear()} {siteConfig.name} — Carmagnola (TO)</span>
      <a class="site-footer__credit" href="https://www.dogostudio.it/case-studies/rebel" target="_blank" rel="noopener" aria-label="Scopri il progetto Rebel realizzato da DOGO Studio"><span class="site-footer__credit-dot" aria-hidden="true"></span>Sito e identità · DOGO Studio</a>
    </div>
  </div>
</footer>

<style>
  .site-footer__hours { list-style:none; margin:.5rem 0 0; padding:0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.25rem 1.4rem; }
  .site-footer__hours li { display:flex; justify-content:space-between; font-size:.82rem; padding-block:.15rem; }
  .site-footer__hours li span:last-child { font-variant-numeric:tabular-nums; }
  .site-footer__network { margin-top:2.4rem; padding-top:1.4rem; border-top:1px solid var(--line); display:flex; flex-direction:column; gap:.6rem; }
  .site-footer__network-label { font-size:var(--t-kicker); letter-spacing:var(--tracking-kicker); text-transform:uppercase; color:var(--text-faint); }
  .site-footer__network-row { display:flex; flex-wrap:wrap; gap:1rem 1.6rem; }
  .site-footer__network-link { display:inline-flex; flex-direction:column; gap:.1rem; text-decoration:none; border-bottom:1px solid transparent; padding-bottom:.15rem; }
  .site-footer__network-name { font-size:.92rem; letter-spacing:.02em; }
  .site-footer__network-note { font-size:.72rem; letter-spacing:.06em; text-transform:uppercase; }
  .site-footer__credit { display:inline-flex; align-items:center; gap:.45rem; font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; color:var(--rebel-cyan); text-decoration:none; }
  .site-footer__credit-dot { width:6px; height:6px; border-radius:999px; background:var(--rebel-cyan); box-shadow:0 0 10px rgba(37,200,209,.55); }
</style>
