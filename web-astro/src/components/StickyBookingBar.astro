---
/**
 * StickyBookingBar — mobile-only sticky conversion bar.
 *
 * Fixed to the bottom of the viewport on small screens so the primary
 * action (book / WhatsApp) is always one tap away. Appears after the user
 * scrolls past the hero. Hidden entirely on desktop, where inline CTAs and
 * the header already cover the job.
 */
import { siteConfig } from "@/lib/site-config";

interface Cta { label: string; href: string }
interface Props {
  priceHint?: string;
  primary?: Cta;
  whatsappHref?: string;
  promo?: boolean;
}

const {
  priceHint,
  primary = { label: "Prenota la valutazione", href: "/contatti" },
  whatsappHref = siteConfig.social.whatsapp,
  promo = false,
} = Astro.props;
---
<div class:list={["sticky-book", { "sticky-book--promo": promo }]} data-sticky-book data-visible="false" aria-hidden="true" inert>
  {priceHint ? <span class="sticky-book__price">{priceHint}</span> : null}
  <div class="sticky-book__actions">
    <a class="sticky-book__wa" href={whatsappHref} target="_blank" rel="noreferrer" aria-label="Scrivici su WhatsApp">
      <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
        <path d="M.06 24l1.7-6.2A11.9 11.9 0 1 1 12 24a11.9 11.9 0 0 1-5.7-1.46L.06 24zM6.6 20.1l.37.22a9.9 9.9 0 0 0 5.03 1.38 9.9 9.9 0 1 0-8.38-4.6l.24.38-1 3.65 3.74-1.03zM17.9 14.3c-.1-.17-.37-.27-.78-.48-.4-.2-2.37-1.17-2.74-1.3-.37-.14-.64-.2-.9.2-.27.4-1.04 1.3-1.27 1.57-.24.27-.47.3-.87.1-.4-.2-1.7-.62-3.23-2-1.2-1.06-2-2.37-2.24-2.77-.23-.4-.02-.62.18-.82.18-.18.4-.47.6-.7.2-.24.27-.4.4-.67.14-.27.07-.5-.03-.7-.1-.2-.9-2.17-1.24-2.97-.32-.78-.65-.67-.9-.68l-.76-.01c-.27 0-.7.1-1.07.5-.37.4-1.4 1.37-1.4 3.34 0 1.97 1.43 3.87 1.63 4.14.2.27 2.82 4.3 6.83 6.03.95.4 1.7.65 2.28.84.96.3 1.83.26 2.52.16.77-.12 2.37-.97 2.7-1.9.34-.94.34-1.74.24-1.9z"/>
      </svg>
      <span>WhatsApp</span>
    </a>
    <a class="sticky-book__primary btn btn--primary" href={primary.href}>{primary.label}</a>
  </div>
</div>

<style>
  .sticky-book {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: var(--z-overlay);
    display: none;
    align-items: center;
    gap: 0.7rem;
    padding: 0.7rem clamp(0.9rem, 4vw, 1.2rem);
    padding-bottom: calc(0.7rem + env(safe-area-inset-bottom, 0px));
    background: rgba(11, 8, 23, 0.92);
    border-top: 1px solid var(--line-strong);
    backdrop-filter: blur(12px);
    transform: translateY(120%);
    visibility: hidden;
    pointer-events: none;
    transition:
      transform var(--t-base) var(--ease-cinema),
      visibility 0s linear var(--t-base);
  }
  .sticky-book[data-visible="true"] {
    transform: translateY(0);
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }
  .sticky-book__price {
    font-size: var(--t-small);
    color: var(--text);
    font-weight: 600;
    white-space: nowrap;
  }
  .sticky-book__actions {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: auto;
    flex: 1;
    justify-content: flex-end;
  }
  .sticky-book__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    border-radius: var(--r-pill);
    border: 1px solid rgba(37, 211, 102, 0.55);
    color: #25D366;
    text-decoration: none;
    font-size: var(--t-small);
    font-weight: 600;
    white-space: nowrap;
  }
  .sticky-book__primary { flex: 1; text-align: center; white-space: nowrap; }
  @media (max-width: 860px) {
    .sticky-book { display: flex; }
  }
  @media (max-width: 640px) {
    .sticky-book {
      display: grid;
      gap: 0.45rem;
      padding-inline: 0.75rem;
    }
    .sticky-book__price {
      text-align: center;
      white-space: normal;
    }
    .sticky-book__actions {
      width: 100%;
      min-width: 0;
      margin-left: 0;
    }
    .sticky-book__wa { flex: 0 0 auto; }
    .sticky-book__primary {
      min-width: 0;
      padding-inline: 0.75rem;
      line-height: 1.15;
      white-space: normal;
    }
    .sticky-book--promo {
      display: flex;
      gap: 0;
    }
    .sticky-book--promo .sticky-book__price { display: none; }
  }
</style>

<script>
  type StickyWindow = Window & {
    __rebelStickyBookCleanup?: () => void;
    __rebelStickyBookLifecycle?: AbortController;
  };

  const stickyWindow = window as StickyWindow;
  stickyWindow.__rebelStickyBookLifecycle?.abort();
  const lifecycle = new AbortController();
  stickyWindow.__rebelStickyBookLifecycle = lifecycle;

  function initStickyBook() {
    stickyWindow.__rebelStickyBookCleanup?.();
    const bar = document.querySelector<HTMLElement>("[data-sticky-book]");
    if (!bar) return;

    let raf = 0;
    const update = () => {
      const show = window.scrollY > 520;
      bar.dataset.visible = show ? "true" : "false";
      bar.inert = !show;
      bar.setAttribute("aria-hidden", show ? "false" : "true");
      if (show) document.body.dataset.bookingBarVisible = "true";
      else delete document.body.dataset.bookingBarVisible;
      raf = 0;
    };

    const onScroll = () => {
      if (!raf) raf = window.requestAnimationFrame(update);
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    update();

    const cleanup = () => {
      window.removeEventListener("scroll", onScroll);
      if (raf) window.cancelAnimationFrame(raf);
      delete document.body.dataset.bookingBarVisible;
      if (stickyWindow.__rebelStickyBookCleanup === cleanup) {
        stickyWindow.__rebelStickyBookCleanup = undefined;
      }
    };
    stickyWindow.__rebelStickyBookCleanup = cleanup;
  }

  initStickyBook();
  document.addEventListener("astro:page-load", initStickyBook, { signal: lifecycle.signal });
  document.addEventListener("astro:before-swap", () => stickyWindow.__rebelStickyBookCleanup?.(), { signal: lifecycle.signal });
</script>
