---
import "@/styles/technology-theatre.css";

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const chapters = [
  {
    id: "reading",
    number: "01",
    eyebrow: "Prima della seduta",
    title: "Prima di iniziare osserviamo pelle, pelo e zona.",
    body: "Area, fototipo, caratteristiche del pelo e sensibilità ci aiutano a definire parametri e calendario.",
    readout: "Pelle · pelo · zona",
    mediaSlot: "services.method.consultation.mobile",
    mediaAlt: "Professionista REBEL e cliente durante la valutazione iniziale",
    mediaWidth: 1122,
    mediaHeight: 1402,
  },
  {
    id: "spectrum",
    number: "02",
    eyebrow: "Lumina X1 Pro",
    title: "Quattro lunghezze d’onda, impostate in base a pelle, pelo e zona.",
    body: "Lumina X1 Pro integra 755, 808, 940 e 1064 nm. Energia, frequenza e durata dell’impulso vengono impostate dalla professionista in relazione a ciò che ha osservato.",
    readout: "755 · 808 · 940 · 1064 nm",
    mediaSlot: "home.hero.laser.desktop",
    mediaAlt: "Professionista REBEL durante una seduta laser con la cliente",
    mediaWidth: 1536,
    mediaHeight: 1024,
  },
  {
    id: "comfort",
    number: "03",
    eyebrow: "ICE Polar",
    title: "Raffreddamento a contatto fin dal primo passaggio.",
    body: "Il manipolo raffredda la pelle mentre tratta la zona. Ti chiediamo come lo percepisci e adattiamo i parametri quando necessario.",
    readout: "Contatto in zaffiro",
    mediaSlot: "services.laser.handpiece.desktop",
    mediaAlt: "Manipolo con raffreddamento a contatto durante una seduta laser",
    mediaWidth: 1536,
    mediaHeight: 1024,
  },
  {
    id: "control",
    number: "04",
    eyebrow: "Controllo REBEL",
    title: "Controlliamo pelle e ricrescita a ogni appuntamento.",
    body: "Osserviamo la pelle, l’andamento della ricrescita e le tue sensazioni. Se serve, aggiorniamo parametri o intervalli tra le sedute.",
    readout: "Seduta · verifica · controllo",
    mediaSlot: "journeys.liberta.hero.desktop",
    mediaAlt: "Cliente durante un controllo successivo alla seduta laser",
    mediaWidth: 1536,
    mediaHeight: 1024,
  },
];
---

<section class="technology-theatre" data-technology-theatre aria-labelledby="laser-showcase-title">
  <div class="rebel-container">
    <header class="technology-theatre__head">
      <div>
        <p class="rebel-kicker">Epilazione & comfort · percorso Libertà</p>
        <h2 class="rebel-title" id="laser-showcase-title">Come si svolge una seduta laser, dalla valutazione ai controlli.</h2>
      </div>
      <p>Segui le quattro fasi del percorso: valutazione, impostazione dei parametri, raffreddamento a contatto e controlli successivi.</p>
    </header>

    <nav class="technology-theatre__index" aria-label="I quattro momenti del percorso laser">
      {chapters.map((chapter, index) => (
        <a href={`#tech-${chapter.id}`} data-tech-nav={index} aria-current={index === 0 ? "step" : undefined}>
          <span>{chapter.number}</span>{chapter.eyebrow}
        </a>
      ))}
    </nav>

    <div class="technology-theatre__layout">
      <div class="technology-theatre__visual" data-tech-visual data-active="0">
        <div class="technology-theatre__halo" aria-hidden="true"></div>
        <div class="technology-theatre__media-stack">
          {chapters.map((chapter, index) => (
            <img
              src={siteAsset(chapter.mediaSlot)}
              alt={chapter.mediaAlt}
              width={chapter.mediaWidth}
              height={chapter.mediaHeight}
              loading={index === 0 ? "eager" : "lazy"}
              decoding="async"
              data-tech-media={index}
            />
          ))}
        </div>
        <div class="technology-theatre__readouts" aria-hidden="true">
          {chapters.map((chapter, index) => <span data-tech-readout={index}>{chapter.readout}</span>)}
        </div>
        <p class="technology-theatre__caption">Lumina X1 Pro · ICE Polar · Metodo REBEL</p>
      </div>

      <div class="technology-theatre__chapters">
        {chapters.map((chapter, index) => (
          <article id={`tech-${chapter.id}`} data-tech-chapter={index}>
            <span>{chapter.number}</span>
            <p class="rebel-kicker">{chapter.eyebrow}</p>
            <h3>{chapter.title}</h3>
            <p>{chapter.body}</p>
          </article>
        ))}
        <details class="technology-theatre__specs">
          <summary>Vuoi capire meglio Lumina X1 Pro?</summary>
          <dl>
            <div><dt>Lunghezze d’onda</dt><dd>755 + 808 + 940 + 1064 nm</dd></div>
            <div><dt>Frequenza regolabile</dt><dd>1–10 Hz</dd></div>
            <div><dt>Durata impulso</dt><dd>1–400 ms</dd></div>
            <div><dt>Spot</dt><dd>13 × 30 mm · opzionale 13 × 40 mm</dd></div>
            <div><dt>Raffreddamento</dt><dd>Acqua + TEC + aria + contatto in zaffiro</dd></div>
          </dl>
          <p>Questi sono i dati tecnici di Lumina X1 Pro. I parametri della tua seduta vengono scelti dopo la valutazione.</p>
        </details>
      </div>
    </div>
  </div>
</section>

<script>
  const initTechnologyTheatres = () => {
    document.querySelectorAll<HTMLElement>("[data-technology-theatre]").forEach((root) => {
      if (root.dataset.ready === "true") return;
      root.dataset.ready = "true";
      const visual = root.querySelector<HTMLElement>("[data-tech-visual]");
      const chapters = Array.from(root.querySelectorAll<HTMLElement>("[data-tech-chapter]"));
      const nav = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-tech-nav]"));
      if (!visual || chapters.length === 0) return;

      const activate = (index: number) => {
        visual.dataset.active = String(index);
        nav.forEach((button, buttonIndex) => {
          if (buttonIndex === index) button.setAttribute("aria-current", "step");
          else button.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        activate(Number((visible.target as HTMLElement).dataset.techChapter ?? 0));
      }, { rootMargin: "-24% 0px -43%", threshold: [0, .25, .55, .8] });

      chapters.forEach((chapter) => observer.observe(chapter));
      nav.forEach((button, index) => button.addEventListener("click", (event) => {
        event.preventDefault();
        chapters[index]?.scrollIntoView({
          behavior: matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          block: "center",
        });
      }));
      activate(0);
      document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
    });
  };
  initTechnologyTheatres();
  document.addEventListener("astro:page-load", initTechnologyTheatres);
</script>
