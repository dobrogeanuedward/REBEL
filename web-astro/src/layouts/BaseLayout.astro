---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { PageMeta } from "@/lib/seo";
import {
  buildLocalBusinessSchema,
  buildOrganizationSchema,
  buildWebsiteSchema,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

import SeoHead from "@/components/SeoHead.astro";
import JsonLd from "@/components/JsonLd.astro";
import AmbientLayer from "@/components/AmbientLayer.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import Reveal from "@/components/Reveal.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsappLive from "@/components/WhatsappLive.astro";
import SiteHeader from "@/components/SiteHeader.tsx";
import manropeLatin400 from "@fontsource/manrope/files/manrope-latin-400-normal.woff2?url";
import playfairLatin500 from "@fontsource/playfair-display/files/playfair-display-latin-500-normal.woff2?url";
import playfairLatin500Italic from "@fontsource/playfair-display/files/playfair-display-latin-500-italic.woff2?url";

interface Props {
  meta: PageMeta;
  bodyClass?: string;
}

const { meta, bodyClass = "" } = Astro.props;
const orgSchema = buildOrganizationSchema();
const webSchema = buildWebsiteSchema();
const localSchema = buildLocalBusinessSchema();
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#07050E" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" type="image/png" href={siteConfig.assets.logoLight} />

    <link rel="preload" href={manropeLatin400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairLatin500} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={playfairLatin500Italic} as="font" type="font/woff2" crossorigin />

    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google.com" />
    {pathname === "/" ? (
      <>
        <link
          rel="preload"
          as="image"
          href="/api/site-asset?slot=home.hero.method.mobile"
          media="(max-width: 860px) and (orientation: portrait)"
          fetchpriority="high"
        />
        <link
          rel="preload"
          as="image"
          href="/api/site-asset?slot=home.hero.method.desktop"
          media="(min-width: 861px), (orientation: landscape)"
          fetchpriority="high"
        />
      </>
    ) : null}

    <SeoHead meta={meta} />
    <JsonLd data={orgSchema} />
    <JsonLd data={webSchema} />
    <JsonLd data={localSchema} />

    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass}>
    <a href="#content" class="sr-only" data-skip-link>Salta al contenuto</a>

    <AmbientLayer />
    <ScrollProgress />
    <SmoothScroll />
    <Reveal />

    <SiteHeader pathname={pathname} client:load />

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <SiteFooter />
    <WhatsappLive />
    {pathname === "/" ? <script src="/scripts/living-hero.js?v=15" data-astro-rerun is:inline></script> : null}
    <script is:inline data-astro-rerun>
      (() => {
        const link = document.querySelector("[data-skip-link]");
        const content = document.getElementById("content");
        if (!(link instanceof HTMLAnchorElement) || !(content instanceof HTMLElement)) return;
        link.addEventListener("click", () => requestAnimationFrame(() => content.focus()));
      })();
    </script>
  </body>
</html>
