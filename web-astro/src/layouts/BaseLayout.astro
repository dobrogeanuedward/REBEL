---
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { PageMeta } from "@/lib/seo";
import {
  buildLocalBusinessSchema,
  buildOrganizationSchema,
  buildWebsiteSchema,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

import SeoHead from "@/components/SeoHead.astro";
import JsonLd from "@/components/JsonLd.astro";
import AmbientLayer from "@/components/AmbientLayer.astro";
import ScrollProgress from "@/components/ScrollProgress.astro";
import SmoothScroll from "@/components/SmoothScroll.astro";
import Reveal from "@/components/Reveal.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import WhatsappLive from "@/components/WhatsappLive.astro";
import SiteHeader from "@/components/SiteHeader.tsx";

interface Props {
  meta: PageMeta;
  bodyClass?: string;
}

const { meta, bodyClass = "" } = Astro.props;
const orgSchema = buildOrganizationSchema();
const webSchema = buildWebsiteSchema();
const localSchema = buildLocalBusinessSchema();
const pathname = Astro.url.pathname;
---
<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#07050E" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://www.google.com" />

    <SeoHead meta={meta} />
    <JsonLd data={orgSchema} />
    <JsonLd data={webSchema} />
    <JsonLd data={localSchema} />

    <ClientRouter fallback="swap" />
  </head>
  <body class={bodyClass}>
    <a href="#content" class="sr-only">Salta al contenuto</a>

    <AmbientLayer />
    <ScrollProgress />
    <SmoothScroll />
    <Reveal />

    <SiteHeader pathname={pathname} client:load />

    <main id="content">
      <slot />
    </main>

    <SiteFooter />
    <WhatsappLive />
    {pathname === "/" ? <script src="/scripts/living-hero.js?v=7" is:inline></script> : null}
  </body>
</html>
