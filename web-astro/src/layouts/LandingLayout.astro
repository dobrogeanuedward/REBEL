---
/**
 * LandingLayout — slim layout for conversion-oriented landing pages.
 *
 * Differences vs BaseLayout:
 * - No main site navigation (only logo + WhatsApp pill in the header).
 * - No SiteFooter — only an essential trust line at the bottom.
 * - Sticky bottom CTA bar on mobile (Prenota + WhatsApp).
 * - Optional `noindex` for ads landings that should not compete on SEO with
 *   the main pages (e.g. /prenota cold lead-gen).
 *
 * Use for /prima-visita-gratuita, /epilazione-laser-prova, /protocollo-viso,
 * /prenota and similar.
 */
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import type { PageMeta } from "@/lib/seo";
import {
  buildLocalBusinessSchema,
  buildOrganizationSchema,
  buildWebsiteSchema,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

import SeoHead from "@/components/SeoHead.astro";
import JsonLd from "@/components/JsonLd.astro";
import Reveal from "@/components/Reveal.astro";

interface Props {
  meta: PageMeta;
  bodyClass?: string;
  /** Anchor / href used by the sticky CTA "Prenota" button. Defaults to #form. */
  ctaHref?: string;
  /** Label for the primary sticky CTA. Defaults to "Prenota". */
  ctaLabel?: string;
}

const { meta, bodyClass = "", ctaHref = "#form", ctaLabel = "Prenota" } = Astro.props;

const orgSchema = buildOrganizationSchema();
const webSchema = buildWebsiteSchema();
const localSchema = buildLocalBusinessSchema();
---
<!doctype html>
<html lang={siteConfig.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content="#07050E" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://imagedelivery.net" crossorigin />
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />

    <SeoHead meta={meta} />
    <JsonLd data={orgSchema} />
    <JsonLd data={webSchema} />
    <JsonLd data={localSchema} />

    <ClientRouter fallback="swap" />
  </head>
  <body class={`page-landing ${bodyClass}`}>
    <a href="#content" class="sr-only">Salta al contenuto</a>

    <Reveal />

    <header class="landing-header">
      <div class="container landing-header__inner">
        <a href="/" class="landing-header__brand" aria-label="Rebel — torna al sito">
          <img
            src={siteConfig.assets.logoLight}
            alt="Rebel"
            width="120"
            height="41"
            decoding="async"
            loading="eager"
          />
        </a>
        <div class="landing-header__cta">
          <a
            class="landing-header__phone"
            href={`tel:${siteConfig.phoneRaw}`}
            aria-label={`Chiama ${siteConfig.phoneDisplay}`}
          >
            <span aria-hidden="true">☎</span>
            <span class="landing-header__phone-text">{siteConfig.phoneDisplay}</span>
          </a>
          <a
            class="landing-header__whatsapp btn btn--secondary btn--sm"
            href={siteConfig.social.whatsapp}
            target="_blank"
            rel="noreferrer"
          >
            WhatsApp
          </a>
        </div>
      </div>
    </header>

    <main id="content" class="landing-main">
      <slot />
    </main>

    <footer class="landing-foot">
      <div class="container landing-foot__inner">
        <p class="landing-foot__line">
          <strong>{siteConfig.name}</strong> · {siteConfig.address.streetAddress},
          {siteConfig.address.postalCode} {siteConfig.address.locality} ({siteConfig.address.region})
        </p>
        <p class="landing-foot__line landing-foot__line--muted">
          {siteConfig.openingHours.map((h, i) => (
            <span>{i > 0 ? " · " : ""}{h.replace("Mo", "Lun").replace("Tu", "Mar").replace("We", "Mer").replace("Th", "Gio").replace("Fr", "Ven").replace("Sa", "Sab").replace("Su", "Dom")}</span>
          ))}
        </p>
        <p class="landing-foot__line landing-foot__line--micro">
          <a href="/">Torna al sito completo</a> · <a href="/contatti">Contatti</a>
        </p>
      </div>
    </footer>

    <aside class="landing-sticky" aria-label="Azioni rapide">
      <a class="landing-sticky__btn landing-sticky__btn--whatsapp" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">
        WhatsApp
      </a>
      <a class="landing-sticky__btn landing-sticky__btn--primary" href={ctaHref}>
        {ctaLabel}
      </a>
    </aside>
  </body>
</html>
