---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { editorialImageAssets, servicePages } from "@/lib/seo-content";
import { localAreaPages } from "@/lib/local-pages";

const meta = createPageMeta({
  title: "Centro Estetico a Carmagnola — Rebel | Viale Barbaroux 20",
  description:
    "Centro estetico a Carmagnola, Viale Barbaroux 20. Pulizia viso, manicure semipermanente, laminazione ciglia, ceretta, massaggi ed epilazione laser Ice Polar. Prima visita gratuita.",
  path: "/centro-estetico-carmagnola",
  keywords: [
    "centro estetico Carmagnola",
    "centro estetico vicino a me",
    "centro estetico vicino a me Carmagnola",
    "estetista Carmagnola",
    "estetista vicino a me",
    "miglior centro estetico Carmagnola",
    "centro estetico Carmagnola Viale Barbaroux",
    "centro estetico Carmagnola prezzi",
    "pulizia viso Carmagnola",
    "manicure Carmagnola",
    "manicure semipermanente Carmagnola",
    "laminazione ciglia Carmagnola",
    "epilazione laser Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Centro estetico Carmagnola", path: "/centro-estetico-carmagnola" },
]);

const webPage = buildWebPageSchema({
  name: "Centro estetico a Carmagnola | Rebel",
  description:
    "Pagina dedicata al centro estetico Rebel a Carmagnola: trattamenti più richiesti, listino e percorsi locali.",
  path: "/centro-estetico-carmagnola",
});

type QueryTarget = {
  label: string;
  href: string;
  description: string;
  image: { src: string; alt: string };
};
const queryTargets: QueryTarget[] = [
  {
    label: "Pulizia viso",
    href: "/servizi/pulizia-viso-carmagnola",
    description: "Detersione profonda, estrazione e maschera. La base mensile per una pelle in ordine.",
    image: { src: editorialImageAssets.puliziaViso, alt: "Pulizia viso professionale Rebel" },
  },
  {
    label: "Manicure semipermanente",
    href: "/servizi/manicure-semipermanente-carmagnola",
    description: "Mani curate, smalto RBL, finish naturale e tenuta lunga.",
    image: { src: editorialImageAssets.manicureSemipermanente, alt: "Manicure semipermanente naturale" },
  },
  {
    label: "Epilazione laser",
    href: "/epilazione-laser-carmagnola",
    description: "Diodo Thory + Ice Polar. Comodo anche su ascelle e inguine.",
    image: { src: editorialImageAssets.laserCorpo, alt: "Epilazione laser corpo a Carmagnola" },
  },
  {
    label: "Pedicure",
    href: "/servizi/pedicure-carmagnola",
    description: "Piedi puliti, talloni morbidi, pelle ordinata. Per la vita di tutti i giorni.",
    image: { src: editorialImageAssets.pedicure, alt: "Pedicure professionale a Carmagnola" },
  },
  {
    label: "Laminazione ciglia & sopracciglia",
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    description: "Sguardo definito senza extension. Effetto naturale che dura settimane.",
    image: { src: editorialImageAssets.laminazione, alt: "Laminazione ciglia e sopracciglia" },
  },
  {
    label: "Scrub corpo",
    href: "/servizi/scrub-corpo-carmagnola",
    description: "Pelle pulita, levigata e luminosa. Ideale prima di un protocollo o dopo l'inverno.",
    image: { src: editorialImageAssets.scrubCorpo, alt: "Scrub corpo Rebel a Carmagnola" },
  },
  {
    label: "Massaggio rilassante",
    href: "/servizi/massaggio-rilassante-carmagnola",
    description: "Schiena e spalle finalmente sciolte. Un'ora solo per te.",
    image: { src: editorialImageAssets.massaggioRilassante, alt: "Massaggio rilassante a Carmagnola" },
  },
  {
    label: "Massaggio linfodrenante",
    href: "/servizi/massaggio-linfodrenante-carmagnola",
    description: "Per gonfiore, ritenzione e pesantezza alle gambe. Su ciclo di sedute.",
    image: { src: editorialImageAssets.linfodrenante, alt: "Massaggio linfodrenante in studio" },
  },
];

const querySchema = buildItemListSchema({
  name: "Ricerche frequenti centro estetico Carmagnola",
  path: "/centro-estetico-carmagnola",
  items: queryTargets.map((it) => ({ name: it.label, path: it.href })),
});

const featuredAreas = localAreaPages
  .filter((a) => a.cluster === "asse-carmagnola")
  .slice(0, 8);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Dove si trova il centro estetico Rebel a Carmagnola?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Lo studio è in Viale Barbaroux 20 a Carmagnola (TO), in zona facile da raggiungere con parcheggio nelle vicinanze. Gli orari sono Mar-Sab; lunedì e domenica chiuso.",
      },
    },
    {
      "@type": "Question",
      name: "Cosa offre Rebel oltre all'epilazione laser?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tutta l'estetica classica (pulizia viso, manicure, pedicure, ceretta, massaggi, laminazione) e protocolli avanzati viso e corpo con linee Marbellas ed Eberlin. Il laser Ice Polar è uno dei servizi, non l'unico.",
      },
    },
    {
      "@type": "Question",
      name: "I prezzi sono chiari?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì, il listino è sempre online con prezzi indicati per ogni servizio. La prima visita di 15 minuti è gratuita e include un piccolo regalo a tua scelta.",
      },
    },
    {
      "@type": "Question",
      name: "Lavorate solo con clienti di Carmagnola?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "No: molte clienti arrivano da Carignano, Racconigi, Carmagnola e tutta la zona di Torino Sud. Abbiamo pagine locali dedicate per orientarti.",
      },
    },
  ],
};

const keySlugs = [
  "pedicure-carmagnola",
  "scrub-corpo-carmagnola",
  "epilazione-laser-corpo-carmagnola",
  "epilazione-laser-viso-carmagnola",
];
const keyServices = keySlugs
  .map((slug) => servicePages.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={querySchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    kicker="Centro estetico · Carmagnola"
    title="Il tuo _centro estetico_ in Viale Barbaroux 20."
    lead="Pulizia viso, manicure, ceretta, massaggi, epilazione laser Ice Polar e protocolli viso/corpo. Tutta l'estetica che ti serve, fatta con metodo. La prima visita è gratuita."
    meta={["Viale Barbaroux 20 · Carmagnola (TO)", "Mar–Sab su appuntamento", "Da 25,90 €"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vedi listino", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="I servizi più richiesti"
        title="Cosa _facciamo_ in cabina."
        lead="Otto schede concrete: ognuna con prezzi, durata e quando ha senso. Apri quella che ti interessa."
      />
      <div class="image-grid">
        {queryTargets.map((it) => (
          <a class="image-card" href={it.href} data-reveal>
            <figure class="image-card__media">
              <img src={it.image.src} alt={it.image.alt} loading="lazy" decoding="async" />
            </figure>
            <div class="image-card__body">
              <h3 class="image-card__title">{it.label}</h3>
              <p class="image-card__lead">{it.description}</p>
              <span class="image-card__cta" aria-hidden="true">Apri →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Primo passo"
        title="Da dove iniziano _la maggior parte_ delle clienti."
        lead="Quattro punti d'ingresso pratici: pulizia mensile, mantenimento mani-piedi e percorso laser viso/corpo."
      />
      <div class="card-grid card-grid--2">
        {keyServices.map((s) => (
          <FeatureCard
            kicker={s.priceHint}
            title={s.name}
            body={s.shortDescription}
            href={`/servizi/${s.slug}`}
            variant="feature"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vieni da fuori Carmagnola?"
        title="_Pagine dedicate_ per i comuni vicini."
        lead="Distanza, indicazioni e primo passo più sensato per la tua zona. Carignano, Racconigi, Torino Sud e altri."
      />
      <div class="card-grid card-grid--3">
        {featuredAreas.map((area) => (
          <FeatureCard
            kicker={area.cluster.replace(/-/g, " ")}
            title={area.city}
            body={area.description}
            href={`/localita/${area.slug}`}
            variant="quiet"
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top: 2rem;">
        <a class="btn btn--secondary" href="/localita">Vedi tutte le località</a>
        <a class="btn btn--primary btn--halo" href="/contatti">Contatti, mappa & WhatsApp</a>
      </div>
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Centro estetico"
    kicker="Centro estetico vicino a te"
    anchorPattern={(s, c) => `${s} per chi cerca da ${c}`}
    clusters={["asse-carmagnola", "torino-sud"]}
    limit={10}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Quindici minuti per _capirci_, senza impegno."
        lead="Vieni in studio, ci dici cosa vorresti fare, leggiamo pelle e zona. Decidiamo insieme se ha senso iniziare e con cosa. In regalo, scegli un piccolo rituale a tua scelta."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  .image-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-md);
    overflow: hidden;
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.7), rgba(20, 16, 42, 0.85));
    border: 1px solid var(--line);
    color: var(--text);
    transition:
      transform var(--t-base) var(--ease-cinema),
      border-color var(--t-base) var(--ease-soft);
    text-decoration: none;
  }
  .image-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .image-card__media {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    position: relative;
  }
  .image-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(7, 5, 14, 0.6) 100%);
    pointer-events: none;
  }
  .image-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-cinema);
  }
  .image-card:hover .image-card__media img { transform: scale(1.04); }
  .image-card__body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .image-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .image-card__lead {
    font-size: var(--t-small);
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
  .image-card__cta {
    margin-top: 0.5rem;
    color: var(--mauve);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
