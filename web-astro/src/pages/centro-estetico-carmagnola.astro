---
import FaqAccordion from "@/components/FaqAccordion.astro";
import { siteConfig } from "@/lib/site-config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { editorialImageAssets, servicePages } from "@/lib/seo-content-refined";
import { localAreaPages } from "@/lib/local-pages";
import { photographs } from "@/lib/catalog-visuals";
import { serviceCategories } from "@/lib/service-categories";
import { media } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Centro estetico Carmagnola | REBEL · Servizi e prezzi",
  description:
    "Viso, corpo, manicure, pedicure, massaggi e laser a Carmagnola. Scopri servizi e prezzi REBEL, in Viale Barbaroux 20. Prenota su WhatsApp.",
  path: "/centro-estetico-carmagnola",
  keywords: [
    "centro estetico Carmagnola",
    "centro estetico vicino a me",
    "centro estetico vicino a me Carmagnola",
    "estetista Carmagnola",
    "estetista vicino a me",
    "centro estetico Carmagnola Viale Barbaroux",
    "centro estetico Carmagnola prezzi",
    "pulizia viso Carmagnola",
    "manicure Carmagnola",
    "manicure semipermanente Carmagnola",
    "laminazione ciglia Carmagnola",
    "epilazione laser Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Centro estetico Carmagnola", path: "/centro-estetico-carmagnola" },
]);

const webPage = buildWebPageSchema({
  name: "Centro estetico a Carmagnola | Rebel",
  description:
    "Servizi, prezzi, orari e contatti del centro estetico Rebel in Viale Barbaroux 20 a Carmagnola.",
  path: "/centro-estetico-carmagnola",
});

type QueryTarget = {
  label: string;
  href: string;
  description: string;
  image: { src: string; alt: string };
};
const queryTargets: QueryTarget[] = [
  {
    label: "Pulizia viso",
    href: "/servizi/pulizia-viso-carmagnola",
    description: "Detersione, eventuale estrazione e maschera finale. Trovi online prezzo e durata indicativa.",
    image: { src: editorialImageAssets.puliziaViso, alt: "Pulizia viso professionale Rebel" },
  },
  {
    label: "Unghie, manicure e colore RBL",
    href: "/servizi/manicure-semipermanente-carmagnola",
    description: "Preparazione dell’unghia, applicazione del colore RBL Nails e finitura. Trovi online prezzo e durata.",
    image: { src: editorialImageAssets.manicureSemipermanente, alt: "Manicure semipermanente naturale" },
  },
  {
    label: "Epilazione laser",
    href: "/epilazione-laser-carmagnola",
    description: "Lumina X1 Pro di THORY a quattro lunghezze d’onda, con raffreddamento a contatto ICE Polar per le zone di viso e corpo.",
    image: { src: editorialImageAssets.laserCorpo, alt: "Epilazione laser corpo a Carmagnola" },
  },
  {
    label: "Pedicure",
    href: "/servizi/pedicure-carmagnola",
    description: "Confronta pedicure estetico, colore, VIP con scrub e taglio unghie: scegli la cura che cerchi per i piedi.",
    image: { src: editorialImageAssets.pedicure, alt: "Pedicure professionale a Carmagnola" },
  },
  {
    label: "Laminazione ciglia e sopracciglia",
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    description: "Trattamento per curvatura, ordine e definizione di ciglia e sopracciglia senza extension.",
    image: { src: editorialImageAssets.laminazione, alt: "Laminazione ciglia e sopracciglia" },
  },
  {
    label: "Scrub corpo",
    href: "/servizi/scrub-corpo-carmagnola",
    description: "Esfoliazione professionale per levigare la superficie cutanea e preparare la pelle ad altri trattamenti.",
    image: { src: editorialImageAssets.scrubCorpo, alt: "Scrub corpo Rebel a Carmagnola" },
  },
  {
    label: "Massaggi estetici e di benessere",
    href: "/servizi/massaggi-carmagnola",
    description: "Massaggio dedicato al relax e al benessere generale, con durata e prezzo consultabili online.",
    image: { src: editorialImageAssets.massaggioRilassante, alt: "Massaggio rilassante a Carmagnola" },
  },
  {
    label: "Massaggio linfodrenante",
    href: "/servizi/massaggio-linfodrenante-carmagnola",
    description: "Manualità delicate dedicate alla sensazione di gonfiore e pesantezza. La sensazione dopo la seduta varia da persona a persona.",
    image: { src: editorialImageAssets.linfodrenante, alt: "Massaggio linfodrenante in studio" },
  },
];

for (const category of serviceCategories.filter(c => c.key !== "massaggi")) {
  const photo = photographs[category.heroPhoto];
  queryTargets.push({ label: category.name.replace(" a Carmagnola", ""), href: `/servizi/${category.slug}`, description: category.metaDescription, image: { src: photo.src, alt: photo.alt } });
}
queryTargets.push({ label: "Ceretta donna e uomo", href: "/servizi/ceretta-carmagnola", description: "Epilazione a cera di viso e corpo: zone, varianti e informazioni per il tuo appuntamento.", image: { src: photographs["cera-gamba"].src, alt: photographs["cera-gamba"].alt } });

const localQueryPhotos: Record<string, {src: string; alt: string}> = {
  "/servizi/pulizia-viso-carmagnola": photographs["viso-manualita"],
  "/servizi/manicure-semipermanente-carmagnola": {src: "/img/rbl-official/rosa-in-polvere.webp", alt: "Manicure rosa della collezione ufficiale RBL Nails"},
  "/epilazione-laser-carmagnola": photographs["laser-gamba"],
  "/servizi/pedicure-carmagnola": photographs["pedicure-cura"],
  "/servizi/laminazione-ciglia-sopracciglia-carmagnola": photographs["laminazione-sopracciglia"],
  "/servizi/scrub-corpo-carmagnola": photographs["scrub-gamba"],
};
const featuredTargets = queryTargets.slice(0,4).map(item => ({...item,image: localQueryPhotos[item.href] ?? item.image}));
const otherTargets = queryTargets.slice(4);
const areaOrder = {"asse-carmagnola": 0, "torino-sud": 1, cuneo: 2};
const nearbyAreas = [...localAreaPages.filter(area => area.slug !== "carmagnola")].sort((a,b) => areaOrder[a.cluster] - areaOrder[b.cluster]).slice(0,14);
const dayNames: Record<string,string> = {Tu:"Martedì",We:"Mercoledì",Th:"Giovedì",Fr:"Venerdì",Sa:"Sabato"};
const openingHours = siteConfig.openingHours.map(entry => {const [day,time] = entry.split(" "); return {day:dayNames[day],time:time.replace("-","–")};});

const querySchema = buildItemListSchema({
  name: "Servizi e trattamenti del centro estetico REBEL a Carmagnola",
  path: "/centro-estetico-carmagnola",
  items: queryTargets.map((it) => ({ name: it.label, path: it.href })),
});


const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Dove si trova il centro estetico Rebel a Carmagnola?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Lo studio è in Viale Barbaroux 20 a Carmagnola (TO). Riceve da martedì a sabato su appuntamento; lunedì e domenica è chiuso.",
      },
    },
    {
      "@type": "Question",
      name: "Quali trattamenti offre Rebel?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Rebel offre pulizia viso, manicure, pedicure, ceretta, massaggi, laminazione, trattamenti viso e corpo, protocolli epigenetici ed epilazione laser con ICE Polar.",
      },
    },
    {
      "@type": "Question",
      name: "Dove posso vedere i prezzi?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Il listino online riporta i prezzi dei servizi e delle zone laser. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale di 30–40 minuti è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
      },
    },
    {
      "@type": "Question",
      name: "Posso venire anche da un comune vicino?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì. Lo studio accoglie clienti da Carignano, Racconigi, Poirino, Villastellone, Torino Sud e altri comuni della zona.",
      },
    },
  ],
};

const faqs = faqSchema.mainEntity.map(item => ({q: item.name, a: item.acceptedAnswer.text}));

const keySlugs = [
  "pedicure-carmagnola",
  "scrub-corpo-carmagnola",
  "epilazione-laser-corpo-carmagnola",
  "epilazione-laser-viso-carmagnola",
];
const keyServices = keySlugs
  .map((slug) => servicePages.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-centro-estetico">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={querySchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={media.studio.reception}
    imageCaption="Lo studio REBEL · Viale Barbaroux 20, Carmagnola"
    kicker="REBEL · Estetica Epigenetica"
    title="Il tuo centro estetico _a Carmagnola_."
    lead="Un appuntamento beauty, una seduta viso o il primo passo di un percorso. Parti da quello che desideri: ci trovi in Viale Barbaroux 20."
    bullets={["Viso, corpo, laser e beauty", "Servizi singoli e percorsi dedicati"]}
    meta={["Viale Barbaroux 20 · Carmagnola", "Da martedì a sabato · su appuntamento"]}
    ctaPrimary={{ label: "Scegli il tuo trattamento", href: "#trattamenti" }}
    ctaSecondary={{ label: "Organizza la visita", href: "#studio" }}
  />

  <div class="studio-page">
    <section class="studio-section" id="trattamenti" aria-labelledby="studio-services-title"><div class="studio-shell">
      <div class="studio-heading-row"><div><p class="studio-kicker">Il tuo tempo REBEL</p><h2 id="studio-services-title">Piccoli gesti beauty.<br /><em>Nuove abitudini di cura.</em></h2></div><p>Il colore che senti tuo, una pelle da ascoltare, il trattamento che cercavi. Scopri da dove iniziare: ogni scheda ti accompagna alla scelta della seduta.</p></div>
      <div class="studio-services">{featuredTargets.map((item,i) => <a href={item.href}><div class="studio-services__photo"><img src={item.image.src} alt={item.image.alt} width="1440" height="900" loading="lazy" decoding="async" /></div><div class="studio-services__copy"><span class="studio-kicker">0{i+1} · Beauty REBEL</span><h3>{item.label}<span aria-hidden="true">↗</span></h3><p>{item.description}</p></div></a>)}</div>
      <p class="studio-photo-note">Immagini illustrative dei trattamenti e immagini ufficiali RBL Nails per l’ispirazione colore.</p>
      <div class="studio-other-services"><div><p class="studio-kicker">E poi, tutto il resto</p><h3>Trova la tua idea <em>di cura.</em></h3><a class="studio-link" href="/servizi">Esplora servizi e trattamenti <span aria-hidden="true">↗</span></a></div><nav aria-label="Altri servizi REBEL">{otherTargets.map(item => <a href={item.href}>{item.label}<span aria-hidden="true">↗</span></a>)}</nav></div>
      <div class="studio-prices"><p><strong>Il listino, prima dell’appuntamento.</strong><br />Confronta le proposte e le durate; per prenotare, indicaci servizio e disponibilità.</p><a class="btn btn--secondary" href="/listino-estetica-laser">Consulta il listino <span aria-hidden="true">↗</span></a></div>
    </div></section>

    <section class="studio-section studio-section--paper" id="studio" aria-labelledby="studio-visit-title"><div class="studio-shell">
      <div class="studio-visit"><figure><picture>{media.studio.realExterior.srcMobile && <source media="(max-width:600px)" srcset={media.studio.realExterior.srcMobile} />}<img src={media.studio.realExterior.src} alt="L’ingresso dello studio REBEL in Viale Barbaroux 20 a Carmagnola" width="1672" height="941" loading="lazy" decoding="async" /></picture><figcaption>La nostra sede, a Carmagnola.</figcaption></figure><div><p class="studio-kicker">Il tuo appuntamento, qui</p><h2 id="studio-visit-title">Viale Barbaroux 20.<br /><em>Ti aspettiamo da REBEL.</em></h2><p>Lo studio accoglie i tuoi appuntamenti viso, corpo, laser e beauty a Carmagnola. Prima di venire, concordiamo il servizio e il tempo da dedicarti.</p><address>Viale Barbaroux 20<br />10022 Carmagnola (TO)</address><div class="studio-actions"><a class="btn btn--primary" href={siteConfig.social.maps} target="_blank" rel="noreferrer">Apri le indicazioni <span aria-hidden="true">↗</span></a><a class="studio-link" href={`tel:${siteConfig.phoneRaw}`}>{siteConfig.phoneDisplay}</a></div></div></div>
      <div class="studio-opening"><div><p class="studio-kicker">Organizziamo la visita</p><h3>Gli orari<br /><em>dello studio.</em></h3><p>Riceviamo su appuntamento.<br />Lunedì e domenica lo studio è chiuso.</p><a class="studio-link" href="/contatti">Contatti e prenotazioni <span aria-hidden="true">↗</span></a></div><dl>{openingHours.map(entry => <div><dt>{entry.day}</dt><dd>{entry.time}</dd></div>)}</dl></div>
    </div></section>

    <section class="studio-section studio-section--method" aria-labelledby="studio-method-title"><div class="studio-shell">
      <div class="studio-heading-row"><div><p class="studio-kicker">Da dove cominciare</p><h2 id="studio-method-title">Un servizio preciso.<br /><em>O una scelta da fare insieme.</em></h2></div><p>Puoi richiedere una singola seduta oppure partire dalla valutazione REBEL per confrontare obiettivi, trattamenti e frequenza.</p></div>
      <ol class="studio-steps"><li><span aria-hidden="true">01</span><h3>Raccontaci ciò che cerchi.</h3><p>Indicaci il servizio, il risultato che desideri e quando vorresti venire. Ti aiutiamo a orientarti tra le proposte.</p></li><li><span aria-hidden="true">02</span><h3>Concordiamo il tuo appuntamento.</h3><p>Per la singola seduta confermiamo variante, durata e prezzo. Per un percorso puoi richiedere una valutazione di 30–40 minuti.</p></li><li><span aria-hidden="true">03</span><h3>La cura continua, se lo desideri.</h3><p>Se inizi il percorso proposto, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.</p></li></ol>
      <div class="studio-actions"><a class="btn btn--primary" href="/contatti">Parlane con REBEL <span aria-hidden="true">↗</span></a><a class="studio-link" href={siteConfig.social.whatsapp}>Scrivici su WhatsApp</a></div>
    </div></section>

    <section class="studio-section studio-section--paper" aria-labelledby="studio-faq-title"><div class="studio-shell studio-questions"><header><p class="studio-kicker">Prima della visita</p><h2 id="studio-faq-title">Le informazioni<br /><em>che ti servono.</em></h2></header><div><FaqAccordion items={faqs} kicker="Domande su REBEL" /></div></div></section>

    <section class="studio-section" aria-labelledby="studio-local-title"><div class="studio-shell"><div class="studio-heading-row"><div><p class="studio-kicker">Carmagnola e dintorni</p><h2 id="studio-local-title">Il punto di partenza<br /><em>lo scegli tu.</em></h2></div><p>Arrivi da un altro comune? Trovi mappe e indicazioni verso la nostra unica sede in Viale Barbaroux 20. Scegli prima il servizio e concorda l’appuntamento.</p></div><nav class="studio-localities" aria-label="Indicazioni dai comuni vicini">{nearbyAreas.map(area => <a href={`/localita/${area.slug}`}>Da {area.city}<span aria-hidden="true">↗</span></a>)}</nav><p class="studio-localities__more"><a class="studio-link" href="/localita">Vedi tutte le località <span aria-hidden="true">→</span></a><a class="studio-link" href="/contatti">Contatti e indicazioni <span aria-hidden="true">↗</span></a></p></div></section>

    <section class="studio-section studio-section--links" aria-labelledby="studio-details-title"><div class="studio-shell"><div><p class="studio-kicker">Un dettaglio in più</p><h2 id="studio-details-title">Conosci meglio<br /><em>il trattamento.</em></h2></div><nav aria-label="Servizi nel dettaglio">{keyServices.map(service => <a href={`/servizi/${service.slug}`}><h3>{service.name.replace(/ a Carmagnola$/i,"")}</h3><span aria-hidden="true">↗</span></a>)}</nav></div></section>
  </div>
  <StickyBookingBar primary={{label:"Chiedi un appuntamento",href:"/contatti"}} whatsappHref={siteConfig.social.whatsapp} />
</BaseLayout>

<style>
  .studio-page { color-scheme: light; --text:#301b3e; --text-strong:#301b3e; --text-muted:#685471; --line:#e2d6e7; background:#f8f3ed; color:#301b3e; }
  .studio-shell { width:min(1240px,calc(100% - 2 * clamp(1.2rem,4vw,3.5rem))); margin-inline:auto; }
  .studio-page :is(h2,h3,p,figure,ol,dl,dd) { margin:0; }
  .studio-page :is(h2,h3) { color:#301b3e; overflow-wrap:normal; }
  .studio-page h2 { font:500 clamp(2.15rem,4.1vw,3.9rem)/1.1 var(--font-display); letter-spacing:-.035em; }
  .studio-page em { color:#70428b; font-weight:400; }
  .studio-page p { color:#685471; line-height:1.8; }
  .studio-page .studio-kicker { display:block; color:#a51e58; font:650 .72rem/1.6 var(--font-body); letter-spacing:.13em; text-transform:uppercase; margin-bottom:1rem; }
  .studio-section { padding-block:clamp(3.5rem,7vw,6.5rem); scroll-margin-top:6rem; }
  .studio-section--paper { background:#fffdf9; }
  .studio-heading-row { display:grid; grid-template-columns:1.15fr .85fr; gap:clamp(1.5rem,5vw,5rem); align-items:end; margin-bottom:clamp(2rem,4vw,3.5rem); }
  .studio-heading-row>p { max-width:58ch; }
  .studio-services { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:2rem 1.7rem; }
  .studio-services>a { display:block; color:inherit; text-decoration:none; min-width:0; }
  .studio-services__photo { overflow:hidden; border-radius:2.5rem .4rem 2.5rem .4rem; background:#e9dfec; }
  .studio-services__photo img { width:100%; height:auto; aspect-ratio:16/10; object-fit:cover; display:block; transition:transform .45s ease; }
  .studio-services a:hover img { transform:scale(1.025); }
  .studio-services__copy { padding-block:1.3rem; }
  .studio-services__copy .studio-kicker { margin-bottom:.6rem; }
  .studio-services__copy h3 { font:500 clamp(1.5rem,2.6vw,2.25rem)/1.2 var(--font-display); display:flex; justify-content:space-between; gap:.75rem; }
  .studio-services__copy>p:last-child { font-size:.9rem; margin-top:.8rem; max-width:58ch; }
  .studio-page .studio-photo-note { color:#786981; font-size:.7rem; margin-top:.5rem; }
  .studio-other-services { display:grid; grid-template-columns:.8fr 1.2fr; gap:clamp(2rem,5vw,5rem); align-items:start; border-top:1px solid #d6c4de; padding-top:2.5rem; margin-top:3rem; }
  .studio-other-services h3 { font:500 clamp(1.6rem,3vw,2.5rem)/1.2 var(--font-display); }
  .studio-other-services>div>a { margin-top:1rem; }
  .studio-other-services nav { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.25rem 2rem; }
  .studio-other-services nav a { display:flex; align-items:center; justify-content:space-between; gap:.8rem; color:#70428b; min-height:60px; padding-block:.75rem; border-bottom:1px solid #dfd0e6; font-size:.85rem; line-height:1.55; text-decoration:none; }
  .studio-page .studio-link { display:inline-flex; align-items:center; gap:.7rem; min-height:44px; color:#70428b; font-size:.83rem; font-weight:650; text-underline-offset:.3em; }
  .studio-prices { display:flex; justify-content:space-between; gap:1.5rem; align-items:center; flex-wrap:wrap; margin-top:2.5rem; padding:1.5rem 0; border-block:1px solid #dfd0e6; }
  .studio-prices p { font-size:.85rem; }
  .studio-prices strong { color:#301b3e; }
  .studio-prices .btn { gap:.8rem; }
  .studio-visit { display:grid; grid-template-columns:1fr 1fr; gap:clamp(2rem,5vw,5rem); align-items:center; }
  .studio-visit figure { min-width:0; }
  .studio-visit picture { display:block; border-radius:.4rem 3rem .4rem 3rem; overflow:hidden; }
  .studio-visit img { display:block; width:100%; height:auto; aspect-ratio:4/5; object-fit:cover; }
  .studio-visit figcaption { color:#786981; font-size:.72rem; margin-top:.7rem; }
  .studio-visit>div>p:not(.studio-kicker) { margin-top:1.5rem; }
  .studio-visit address { color:#70428b; font-size:1rem; font-style:normal; line-height:1.8; margin-top:1.5rem; padding-left:1.2rem; border-left:2px solid #cdb6d9; }
  .studio-actions { display:flex; flex-wrap:wrap; align-items:center; gap:1rem 1.7rem; margin-top:1.7rem; }
  .studio-actions .btn { gap:.8rem; }
  .studio-opening { display:grid; grid-template-columns:1fr 1fr; align-items:start; gap:clamp(2rem,5vw,5rem); margin-top:clamp(3rem,6vw,5rem); border-top:1px solid #dfd0e6; padding-top:2rem; }
  .studio-opening h3 { font:500 clamp(1.7rem,3vw,2.5rem)/1.2 var(--font-display); }
  .studio-opening p:not(.studio-kicker) { font-size:.9rem; margin-top:1.2rem; }
  .studio-opening dl { min-width:0; }
  .studio-opening dl>div { display:flex; justify-content:space-between; gap:1.5rem; border-bottom:1px solid #dfd0e6; padding-block:1rem; font-size:.9rem; }
  .studio-opening dt { color:#685471; }
  .studio-opening dd { color:#70428b; font-weight:650; }
  .studio-section--method { background:#eee4f0; }
  .studio-steps { list-style:none; padding:0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(1.5rem,4vw,3rem); }
  .studio-steps li { border-top:1px solid #cbb2d7; padding-top:1.5rem; }
  .studio-steps li>span { color:#a51e58; font-size:.75rem; letter-spacing:.13em; }
  .studio-steps h3 { font:500 clamp(1.35rem,2.1vw,1.8rem)/1.2 var(--font-display); margin-block:1rem; }
  .studio-steps p { font-size:.9rem; }
  .studio-questions { display:grid; grid-template-columns:.75fr 1.25fr; align-items:start; gap:clamp(2rem,6vw,6rem); }
  .studio-questions>div { min-width:0; }
  .studio-localities { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.4rem 2rem; }
  .studio-localities a { display:flex; justify-content:space-between; align-items:center; min-height:48px; gap:.7rem; color:#70428b; text-decoration:none; border-bottom:1px solid #dfd0e6; font-size:.86rem; }
  .studio-localities__more { display:flex; flex-wrap:wrap; gap:.5rem 2rem; margin-top:1.5rem!important; }
