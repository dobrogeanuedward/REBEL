---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { editorialImageAssets, servicePages } from "@/lib/seo-content";
import { localAreaPages } from "@/lib/local-pages";
import { media } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Centro Estetico a Carmagnola — Rebel | Viale Barbaroux 20",
  description:
    "Centro estetico a Carmagnola per pulizia viso, manicure, pedicure, laminazione, ceretta, massaggi, trattamenti corpo ed epilazione Laser Ice Polar. Prima visita gratuita.",
  path: "/centro-estetico-carmagnola",
  keywords: [
    "centro estetico Carmagnola",
    "centro estetico vicino a me",
    "centro estetico vicino a me Carmagnola",
    "estetista Carmagnola",
    "estetista vicino a me",
    "miglior centro estetico Carmagnola",
    "centro estetico Carmagnola Viale Barbaroux",
    "centro estetico Carmagnola prezzi",
    "pulizia viso Carmagnola",
    "manicure Carmagnola",
    "manicure semipermanente Carmagnola",
    "laminazione ciglia Carmagnola",
    "epilazione laser Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Centro estetico Carmagnola", path: "/centro-estetico-carmagnola" },
]);

const webPage = buildWebPageSchema({
  name: "Centro estetico a Carmagnola | Rebel",
  description:
    "Servizi, prezzi, orari e contatti del centro estetico Rebel in Viale Barbaroux 20 a Carmagnola.",
  path: "/centro-estetico-carmagnola",
});

type QueryTarget = {
  label: string;
  href: string;
  description: string;
  image: { src: string; alt: string };
};
const queryTargets: QueryTarget[] = [
  {
    label: "Pulizia viso",
    href: "/servizi/pulizia-viso-carmagnola",
    description: "Detersione, estrazione quando indicata e maschera finale. Apri la scheda per prezzo e durata.",
    image: { src: editorialImageAssets.puliziaViso, alt: "Pulizia viso professionale Rebel" },
  },
  {
    label: "Manicure semipermanente",
    href: "/servizi/manicure-semipermanente-carmagnola",
    description: "Preparazione dell’unghia, applicazione colore RBL Nails e finitura. Prezzo e durata nella scheda.",
    image: { src: editorialImageAssets.manicureSemipermanente, alt: "Manicure semipermanente naturale" },
  },
  {
    label: "Epilazione laser",
    href: "/epilazione-laser-carmagnola",
    description: "Laser Thory a tre lunghezze d’onda con raffreddamento Ice Polar per viso e corpo.",
    image: { src: editorialImageAssets.laserCorpo, alt: "Epilazione laser corpo a Carmagnola" },
  },
  {
    label: "Pedicure",
    href: "/servizi/pedicure-carmagnola",
    description: "Trattamento estetico di unghie, cuticole e pelle del piede. Prezzo e durata nella scheda.",
    image: { src: editorialImageAssets.pedicure, alt: "Pedicure professionale a Carmagnola" },
  },
  {
    label: "Laminazione ciglia e sopracciglia",
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    description: "Trattamento per curvatura, ordine e definizione di ciglia e sopracciglia senza extension.",
    image: { src: editorialImageAssets.laminazione, alt: "Laminazione ciglia e sopracciglia" },
  },
  {
    label: "Scrub corpo",
    href: "/servizi/scrub-corpo-carmagnola",
    description: "Esfoliazione professionale per levigare la superficie cutanea e preparare la pelle ad altri trattamenti.",
    image: { src: editorialImageAssets.scrubCorpo, alt: "Scrub corpo Rebel a Carmagnola" },
  },
  {
    label: "Massaggio rilassante",
    href: "/servizi/massaggio-rilassante-carmagnola",
    description: "Massaggio dedicato a rilassamento e benessere generale. Apri la scheda per durata e prezzo.",
    image: { src: editorialImageAssets.massaggioRilassante, alt: "Massaggio rilassante a Carmagnola" },
  },
  {
    label: "Massaggio linfodrenante",
    href: "/servizi/massaggio-linfodrenante-carmagnola",
    description: "Manualità dedicate a drenaggio, gonfiore e sensazione di pesantezza, anche in cicli di sedute.",
    image: { src: editorialImageAssets.linfodrenante, alt: "Massaggio linfodrenante in studio" },
  },
];

const querySchema = buildItemListSchema({
  name: "Servizi più cercati del centro estetico Rebel a Carmagnola",
  path: "/centro-estetico-carmagnola",
  items: queryTargets.map((it) => ({ name: it.label, path: it.href })),
});

const featuredAreas = localAreaPages
  .filter((a) => a.cluster === "asse-carmagnola")
  .slice(0, 8);

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Dove si trova il centro estetico Rebel a Carmagnola?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Lo studio è in Viale Barbaroux 20 a Carmagnola (TO). Riceve da martedì a sabato su appuntamento; lunedì e domenica è chiuso.",
      },
    },
    {
      "@type": "Question",
      name: "Quali trattamenti offre Rebel?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Rebel offre pulizia viso, manicure, pedicure, ceretta, massaggi, laminazione, trattamenti viso e corpo, protocolli epigenetici ed epilazione Laser Ice Polar.",
      },
    },
    {
      "@type": "Question",
      name: "Dove posso vedere i prezzi?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Il listino online riporta i prezzi dei servizi e delle zone laser. Per i percorsi personalizzati è disponibile una prima visita gratuita di circa 15 minuti.",
      },
    },
    {
      "@type": "Question",
      name: "Posso venire anche da un comune vicino?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì. Lo studio accoglie clienti da Carignano, Racconigi, Poirino, Villastellone, Torino Sud e altri comuni della zona.",
      },
    },
  ],
};

const keySlugs = [
  "pedicure-carmagnola",
  "scrub-corpo-carmagnola",
  "epilazione-laser-corpo-carmagnola",
  "epilazione-laser-viso-carmagnola",
];
const keyServices = keySlugs
  .map((slug) => servicePages.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={querySchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={media.studio.reception}
    kicker="Centro estetico · Carmagnola"
    title="Viso, corpo, laser e beauty in _Viale Barbaroux 20_."
    lead="Da Rebel puoi prenotare pulizia viso, manicure, pedicure, ceretta, massaggi, laminazione, trattamenti corpo, protocolli viso ed epilazione Laser Ice Polar."
    bullets={["Listino online", "Prima visita gratuita", "Da martedì a sabato"]}
    meta={["Viale Barbaroux 20 · Carmagnola", "Viso, corpo, laser e beauty"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta il listino", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Servizi più richiesti"
        title="Prezzi e informazioni sui principali trattamenti."
        lead="Apri la scheda del servizio che ti interessa per leggere prezzo, durata indicativa, modalità e informazioni prima dell’appuntamento."
      />
      <div class="image-grid">
        {queryTargets.map((it) => (
          <a class="image-card" href={it.href} data-reveal>
            <figure class="image-card__media">
              <img src={it.image.src} alt={it.image.alt} loading="lazy" decoding="async" />
            </figure>
            <div class="image-card__body">
              <h3 class="image-card__title">{it.label}</h3>
              <p class="image-card__lead">{it.description}</p>
              <span class="image-card__cta" aria-hidden="true">Apri la scheda →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Quattro servizi da conoscere"
        title="Pedicure, scrub corpo e Laser Ice Polar per viso e corpo."
        lead="Queste schede raccolgono prezzo, durata e informazioni pratiche su quattro servizi frequentemente prenotati."
      />
      <div class="card-grid card-grid--2">
        {keyServices.map((s) => (
          <FeatureCard
            kicker={s.priceHint}
            title={s.name}
            body={s.shortDescription}
            href={`/servizi/${s.slug}`}
            variant="feature"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come raggiungerci"
        title="Indicazioni per chi arriva dai comuni vicini."
        lead="Consulta la pagina del tuo comune per trovare distanza, percorso verso Viale Barbaroux 20 e servizi disponibili nello studio."
      />
      <div class="card-grid card-grid--3">
        {featuredAreas.map((area) => (
          <FeatureCard
            kicker={area.cluster.replace(/-/g, " ")}
            title={area.city}
            body={area.description}
            href={`/localita/${area.slug}`}
            variant="quiet"
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top: 2rem;">
        <a class="btn btn--secondary" href="/localita">Vedi tutte le località</a>
        <a class="btn btn--primary btn--halo" href="/contatti">Mappa e contatti</a>
      </div>
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Centro estetico"
    kicker="Centro estetico vicino a te"
    anchorPattern={(s, c) => `${s} per chi cerca da ${c}`}
    clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
    limit={14}
    hrefOverrides={{
      alba: "/localita/alba",
      bra: "/localita/bra",
      canale: "/localita/canale",
    }}
  />

  <FullBleedBand
    image={media.studio.cabin}
    height="md"
    align="center"
    kicker="Studio Rebel · Carmagnola"
    quote="Quattro cabine per trattamenti viso, corpo, laser e beauty."
    cta={{ label: "Prenota la prima visita", href: "/contatti" }}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Ricevi indicazioni su trattamento, _frequenza e prezzo_."
        lead="L’appuntamento dura circa quindici minuti. Valutiamo la zona interessata e ti presentiamo una proposta prima di prenotare il trattamento."
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Prima visita gratuita" primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  .image-card {
    display: flex;
    flex-direction: column;
    border-radius: var(--r-md);
    overflow: hidden;
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.7), rgba(20, 16, 42, 0.85));
    border: 1px solid var(--line);
    color: var(--text);
    transition:
      transform var(--t-base) var(--ease-cinema),
      border-color var(--t-base) var(--ease-soft);
    text-decoration: none;
  }
  .image-card:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }
  .image-card__media {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    position: relative;
  }
  .image-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(7, 5, 14, 0.6) 100%);
    pointer-events: none;
  }
  .image-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-cinema);
  }
  .image-card:hover .image-card__media img { transform: scale(1.04); }
  .image-card__body {
    padding: 1.4rem 1.5rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .image-card__title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    line-height: 1.15;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .image-card__lead {
    font-size: var(--t-small);
    color: var(--text-muted);
    line-height: 1.55;
    margin: 0;
  }
  .image-card__cta {
    margin-top: 0.5rem;
    color: var(--mauve);
    font-size: 0.9rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
