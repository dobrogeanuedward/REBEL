---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import BrandStrip from "@/components/BrandStrip.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Chi siamo — Rebel, centro estetico a Carmagnola",
  description:
    "Rebel è un centro estetico a Carmagnola in Viale Barbaroux 20: 4 cabine, tecnologia laser Thory Ice Polar, pressoterapia, tecar e fotobiostimolazione, con linee professionali Marbellas ed Eberlin e formazione continua su Thory Academy.",
  path: "/chi-siamo",
  openGraphType: "article",
  keywords: [
    "chi siamo centro estetico Carmagnola",
    "Rebel estetica Carmagnola",
    "centro estetico nuovo Carmagnola",
    "estetista Carmagnola",
    "pressoterapia Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Chi siamo", path: "/chi-siamo" },
]);
const webPage = buildWebPageSchema({
  name: "Chi siamo · Rebel Carmagnola",
  description:
    "Chi è Rebel: centro estetico aperto a Carmagnola con 4 cabine, tecnologie laser, tecar, pressoterapia e fotobiostimolazione, brand professionali e formazione continua.",
  path: "/chi-siamo",
});
const article = buildArticleSchema({
  headline: "Chi siamo — Rebel, centro estetico a Carmagnola",
  description:
    "Identità Rebel: studio nuovo a Carmagnola con 4 cabine, tecnologia laser Thory Ice Polar, pressoterapia, tecar e fotobiostimolazione, prodotti professionali e formazione continua.",
  path: "/chi-siamo",
  keywords: [
    "chi siamo Rebel",
    "centro estetico Carmagnola",
    "Thory Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
  section: "Chi siamo",
});

const ways = [
  {
    kicker: "Ascolto",
    title: "Si parte sempre da una domanda",
    body: "“Cosa vorresti vedere cambiato?” è la prima cosa che ti chiediamo. Da lì decidiamo come muoverci, non prima.",
  },
  {
    kicker: "Tecnica",
    title: "Strumenti e prodotti professionali",
    body: "Laser Thory con manipolo Ice Polar, linee Marbellas ed Eberlin per viso e corpo, smalti RBL Nails per la cabina mani.",
  },
  {
    kicker: "Trasparenza",
    title: "Prezzi chiari, niente sorprese",
    body: "Listino sempre online, prima visita gratuita, nessun upsell forzato. Se un trattamento non ha senso per te, te lo diciamo.",
  },
];

const paths = [
  {
    kicker: "Trattamenti",
    title: "Listino completo",
    body: "Viso, corpo, mani, ceretta, massaggi e laser: prezzi e durata indicativa per ogni servizio.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Laser",
    title: "Epilazione laser",
    body: "Tecnologia Thory + Ice Polar. Valutazione iniziale gratuita, calendario costruito sul tuo ciclo follicolare.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    kicker: "Prima visita",
    title: "Prenota in trenta secondi",
    body: "Quindici minuti gratis, un piccolo regalo a tua scelta, nessun obbligo di acquisto.",
    href: "/contatti",
  },
];

const studio = [
  {
    kicker: "Spazi",
    title: "Quattro cabine dedicate",
    body: "Quattro cabine più area accoglienza e postazione mani: viso, corpo, laser e benessere lavorano in parallelo, senza sovrapposizioni e con i tempi giusti per ogni trattamento.",
  },
  {
    kicker: "Laser",
    title: "Thory con manipolo Ice Polar",
    body: "Laser a diodo con punta raffreddata Ice Polar: epilazione progressiva e confortevole su viso e corpo, con calendario costruito sul tuo ciclo follicolare.",
  },
  {
    kicker: "Corpo",
    title: "Pressoterapia, tecar e fotobiostimolazione",
    body: "Pressoterapia per gambe pesanti e drenaggio, tecarterapia per tono e recupero dei tessuti, fotobiostimolazione a supporto di pelle e inestetismi: tecnologie che si combinano nei percorsi corpo.",
  },
  {
    kicker: "Cosmetica",
    title: "Linee Marbellas ed Eberlin",
    body: "Cosmetica professionale e biocosmetica epigenetica per i percorsi viso e corpo più avanzati, scelte una a una e usate davvero in cabina.",
  },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <PageHero
    image={media.studio.reception}
    kicker="Chi siamo · Carmagnola"
    title="Un centro estetico nuovo, in _Viale Barbaroux 20_."
    lead="Rebel ha aperto da poco a Carmagnola, ma non improvvisiamo. Lavoriamo con tecnologia professionale, prodotti seri e formazione continua. Quello che vedi è quello che porti a casa."
    bullets={["Studio nuovo · 4 cabine", "Laser, tecar, pressoterapia, fotobiostimolazione", "Prima visita gratuita"]}
    meta={["Aperto dal 2025", "Studio nuovo · 4 cabine", "Mar–Sab su appuntamento"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Come lavoriamo", href: "/metodo-rebel" }}
  />

  <section class="section">
    <div class="container grid-2">
      <article class="card card--feature">
        <p class="card__kicker">Cosa siamo</p>
        <h2 class="card__title">Centro estetico classico, avanzato ed epigenetico.</h2>
        <p class="card__body">
          A Carmagnola facciamo quello che ti aspetti da un buon centro estetico:
          pulizia viso, manicure, pedicure, ceretta, massaggi, laser. In più,
          su 4 cabine, mettiamo tecnologie che qui non si trovano spesso: laser
          Thory con manipolo Ice Polar, pressoterapia, tecar e fotobiostimolazione,
          insieme a una linea cosmetica epigenetica per i percorsi viso e corpo
          più avanzati.
        </p>
      </article>
      <article class="card">
        <p class="card__kicker">Cosa non siamo</p>
        <h2 class="card__title">Un centro che vende pacchetti a chi entra.</h2>
        <p class="card__body">
          Non ti diciamo che servono dieci sedute se ne bastano tre. Non ti
          proponiamo un protocollo viso da cinquecento euro per una pelle che
          ha solo bisogno di pulizia e idratazione. Lavoriamo per restare,
          non per chiudere una vendita oggi.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Lo studio & le tecnologie"
        title="Quattro cabine, _strumenti veri_."
        lead="Non è solo questione di spazi: ogni cabina ha la tecnologia giusta per il suo percorso. Ecco cosa trovi a Carmagnola, in Viale Barbaroux 20."
      />
      <div class="card-grid card-grid--2">
        {studio.map((s, i) => (
          <FeatureCard
            kicker={s.kicker}
            title={s.title}
            body={s.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead
        kicker="Come ragioniamo"
        title="Tre _criteri_ che reggono ogni seduta."
      />
      <div class="card-grid card-grid--3">
        {ways.map((w, i) => (
          <FeatureCard
            kicker={w.kicker}
            title={w.title}
            body={w.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Brand & tecnologie"
        title="Le firme con cui _lavoriamo davvero_."
        lead="Niente improvvisazione: tecnologie e linee professionali precise, scelte una a una."
      />
      <BrandStrip />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Da dove iniziare"
        title="Tre _porte_ d'ingresso."
        lead="Scegli quella più vicina a quello che vuoi fare. Il resto si decide insieme alla prima visita."
      />
      <div class="card-grid card-grid--3">
        {paths.map((p) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            href={p.href}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="left"
    kicker="Da Rebel, a Carmagnola"
    quote="Lavoriamo per restare, non per chiudere una vendita oggi."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Pronta a iniziare"
        title="Prenota la _prima visita_, scegli il tuo regalo."
        lead="Quindici minuti per conoscerci. Da lì decidiamo insieme se ha senso partire e con cosa."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>
