---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import BrandStrip from "@/components/BrandStrip.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Studio Rebel — Centro estetico a Carmagnola",
  description:
    "Rebel è un centro estetico in Viale Barbaroux 20 a Carmagnola con 4 cabine per viso, corpo, laser e beauty, tecnologie professionali e prima visita gratuita.",
  path: "/chi-siamo",
  openGraphType: "article",
  keywords: [
    "chi siamo centro estetico Carmagnola",
    "Rebel estetica Carmagnola",
    "centro estetico nuovo Carmagnola",
    "estetista Carmagnola",
    "pressoterapia Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Studio Rebel", path: "/chi-siamo" },
]);
const webPage = buildWebPageSchema({
  name: "Studio Rebel · Centro estetico a Carmagnola",
  description:
    "Quattro cabine per trattamenti viso, corpo, epilazione laser e beauty, con tecnologie professionali e prodotti Marbellas, Eberlin e RBL Nails.",
  path: "/chi-siamo",
});
const article = buildArticleSchema({
  headline: "Studio Rebel — centro estetico in Viale Barbaroux 20 a Carmagnola",
  description:
    "Spazi, servizi, tecnologie e prodotti professionali disponibili nello studio Rebel di Carmagnola.",
  path: "/chi-siamo",
  keywords: [
    "chi siamo Rebel",
    "centro estetico Carmagnola",
    "Thory Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
  section: "Chi siamo",
});

const ways = [
  {
    kicker: "Valutazione",
    title: "Ti spieghiamo che cosa vediamo",
    body: "Osserviamo la zona interessata, ascoltiamo il tuo obiettivo e ti indichiamo quali trattamenti possono essere adatti, con tempi e costi indicativi.",
  },
  {
    kicker: "Trattamento",
    title: "Utilizziamo prodotti e tecnologie professionali",
    body: "THORY Lumina X1 Pro con manipolo ICE Polar, Tecar, LPG, pressomassaggio, crioterapia, linee Marbellas ed Eberlin e prodotti RBL Nails.",
  },
  {
    kicker: "Controlli",
    title: "Verifichiamo i risultati durante il percorso",
    body: "Agli appuntamenti controlliamo la risposta e aggiorniamo frequenza, intensità o combinazioni quando necessario.",
  },
];

const paths = [
  {
    kicker: "Prezzi",
    title: "Consulta il listino completo",
    body: "Trovi prezzi e schede di viso, corpo, mani, ceretta, massaggi, laser e protocolli epigenetici.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Epilazione",
    title: "Scopri il Laser Ice Polar",
    body: "Leggi come funziona, quali zone trattiamo, i prezzi e come prenotare la valutazione gratuita.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    kicker: "Consulenza",
    title: "Prenota la prima visita gratuita",
    body: "In circa quindici minuti valutiamo la zona e ti presentiamo un programma con trattamento, frequenza e prezzo.",
    href: "/contatti",
  },
];

const studio = [
  {
    kicker: "Spazi",
    title: "Quattro cabine e una postazione mani",
    body: "Lo studio comprende area accoglienza, quattro cabine dedicate e una postazione per manicure, semipermanente e trattamenti nails.",
  },
  {
    kicker: "Laser",
    title: "Thory con manipolo Ice Polar",
    body: "Laser a diodo con tre lunghezze d’onda e raffreddamento attivo per epilazione progressiva di viso e corpo.",
  },
  {
    kicker: "Corpo",
    title: "LPG, pressomassaggio, Tecar e crioterapia",
    body: "Tecnologie disponibili nei programmi dedicati a drenaggio, pesantezza, tonicità, compattezza e rimodellamento corpo.",
  },
  {
    kicker: "Viso",
    title: "Cosmetica professionale ed epigenetica",
    body: "Linee Marbellas ed Eberlin utilizzate nei trattamenti per idratazione, luminosità, uniformità, tono, pelle matura e contorno occhi.",
  },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <PageHero
    image={media.studio.reception}
    kicker="Studio Rebel · Carmagnola"
    title="Centro estetico per _viso, corpo, laser e beauty_."
    lead="In Viale Barbaroux 20 trovi quattro cabine, una postazione mani, tecnologie professionali e trattamenti personalizzati. Riceviamo da martedì a sabato su appuntamento."
    bullets={["4 cabine e postazione nails", "Viso, corpo, laser e beauty", "Prima visita gratuita"]}
    meta={["Viale Barbaroux 20", "Mar–Sab su appuntamento", "Carmagnola"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta il listino", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container grid-2">
      <article class="card card--feature">
        <p class="card__kicker">Servizi</p>
        <h2 class="card__title">Trattamenti estetici quotidiani e programmi avanzati.</h2>
        <p class="card__body">
          Da Rebel puoi prenotare pulizia viso, manicure, pedicure, ceretta,
          massaggi, laminazione ed epilazione laser. Per obiettivi più specifici
          proponiamo percorsi viso e corpo con cosmetica epigenetica e tecnologie professionali.
        </p>
      </article>
      <article class="card">
        <p class="card__kicker">Prima visita</p>
        <h2 class="card__title">Valutazione gratuita con indicazioni, tempi e prezzi.</h2>
        <p class="card__body">
          Ci racconti che cosa vuoi migliorare, osserviamo la zona interessata
          e ti presentiamo un programma chiaro. Sai quali trattamenti proponiamo,
          con quale frequenza e a quale costo prima di decidere.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Spazi e tecnologie"
        title="Quattro cabine dedicate a _viso, corpo e laser_."
        lead="Ogni area dello studio è organizzata per una famiglia di trattamenti e dispone degli strumenti professionali necessari."
      />
      <div class="card-grid card-grid--2">
        {studio.map((s, i) => (
          <FeatureCard
            kicker={s.kicker}
            title={s.title}
            body={s.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead
        kicker="Come lavoriamo"
        title="Valutazione, trattamento e controllo dei risultati."
      />
      <div class="card-grid card-grid--3">
        {ways.map((w, i) => (
          <FeatureCard
            kicker={w.kicker}
            title={w.title}
            body={w.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Prodotti, tecnologie e formazione"
        title="I marchi utilizzati _nei trattamenti Rebel_."
        lead="Qui trovi le tecnologie, le linee cosmetiche e i partner di formazione presenti nello studio."
      />
      <BrandStrip />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Informazioni utili"
        title="Prezzi, Laser Ice Polar e prenotazione."
        lead="Consulta il listino, approfondisci l’epilazione laser oppure prenota una valutazione gratuita in studio."
      />
      <div class="card-grid card-grid--3">
        {paths.map((p) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            href={p.href}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="left"
    kicker="Rebel · Carmagnola"
    quote="Quattro cabine per trattamenti viso, corpo, laser e beauty."
    cite="Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Valutiamo la zona e ti presentiamo una _proposta chiara_."
        lead="L’appuntamento dura circa quindici minuti e comprende indicazioni sul trattamento consigliato, frequenza iniziale e prezzo."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>
