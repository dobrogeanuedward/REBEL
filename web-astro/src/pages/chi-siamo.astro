---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import BrandStrip from "@/components/BrandStrip.astro";
import StudioAtlas from "@/components/StudioAtlas.astro";
import StoreGallery from "@/components/StoreGallery.tsx";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { storeGalleryImages } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Studio Rebel — Centro estetico a Carmagnola",
  description:
    "Rebel è un centro estetico in Viale Barbaroux 20 a Carmagnola con 4 cabine per viso, corpo, laser e beauty e valutazione REBEL di 30–40 minuti.",
  path: "/chi-siamo",
  openGraphType: "article",
  keywords: [
    "chi siamo centro estetico Carmagnola",
    "Rebel estetica Carmagnola",
    "centro estetico nuovo Carmagnola",
    "estetista Carmagnola",
    "LPG Carmagnola",
    "ICE Polar Carmagnola",
    "Lumina X1 Pro Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Studio Rebel", path: "/chi-siamo" },
]);
const webPage = buildWebPageSchema({
  name: "Studio Rebel · Centro estetico a Carmagnola",
  description:
    "Quattro cabine per trattamenti viso, corpo, epilazione laser e beauty, con tecnologie professionali e un metodo di lavoro personalizzato.",
  path: "/chi-siamo",
});
const article = buildArticleSchema({
  headline: "Studio Rebel — centro estetico in Viale Barbaroux 20 a Carmagnola",
  description:
    "Spazi, servizi, tecnologie e prodotti professionali disponibili nello studio Rebel di Carmagnola.",
  path: "/chi-siamo",
  keywords: [
    "chi siamo Rebel",
    "centro estetico Carmagnola",
    "Thory Carmagnola",
    "LPG Carmagnola",
    "Lumina X1 Pro Carmagnola",
  ],
  section: "Chi siamo",
});

const ways = [
  {
    kicker: "Valutazione",
    title: "Ti spieghiamo che cosa vediamo",
    body: "Osserviamo la zona interessata, ascoltiamo il tuo obiettivo e ti indichiamo quali trattamenti possono essere adatti, con tempi e costi indicativi.",
  },
  {
    kicker: "Trattamento",
    title: "Utilizziamo prodotti e tecnologie professionali",
    body: "Utilizziamo Lumina X1 Pro di THORY, ICE Polar, LPG e cosmetica professionale solo dopo aver definito zona, priorità e obiettivo.",
  },
  {
    kicker: "Controlli",
    title: "Osserviamo i cambiamenti durante il percorso",
    body: "Agli appuntamenti osserviamo i cambiamenti e aggiorniamo frequenza, intensità o combinazioni quando necessario.",
  },
];

const paths = [
  {
    kicker: "Prezzi",
    title: "Consulta il listino completo",
    body: "Trovi prezzi e schede di viso, corpo, mani, ceretta, massaggi, laser e protocolli epigenetici.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Epilazione",
    title: "Scopri Lumina X1 Pro e il comfort ICE Polar",
    body: "Leggi come funziona il percorso laser, quali zone trattiamo, i prezzi e come prenotare la valutazione.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    kicker: "Valutazione",
    title: "Prenota la valutazione REBEL",
    body: "La valutazione REBEL dura 30–40 minuti. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
    href: "/contatti",
  },
];
// Atlas already presents the three R2 studio scenes. Keep the distinct,
// authentic Treatwell photographs in a compact optional album instead.
const studioDetails = storeGalleryImages.filter(image => image.src.startsWith("/img/studio-treatwell/"));

---
<BaseLayout meta={meta} bodyClass="page-studio">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <PageHero
    image={media.studio.professional}
    kicker="Studio Rebel · Carmagnola"
    title="Scopri lo studio e _come lavoriamo_."
    lead="In Viale Barbaroux 20 trovi quattro cabine, una postazione manicure, tecnologie professionali e trattamenti personalizzati. Riceviamo da martedì a sabato su appuntamento."
    bullets={["4 cabine e postazione manicure", "Viso, corpo, laser e servizi beauty", "Valutazione REBEL · 30–40 min"]}
    meta={["Viale Barbaroux 20", "Mar–Sab su appuntamento", "Carmagnola"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta il listino", href: "/listino-estetica-laser" }}
  />

  <StudioAtlas />

  <section class="studio-details" aria-label="Altre fotografie autentiche dello studio"><div class="container">
    <details>
      <summary><span class="studio-details__kicker">Dentro REBEL, ancora più da vicino</span><strong>Postazioni, cabine e dettagli.</strong><span class="studio-details__hint">Apri l’album · {studioDetails.length} fotografie dello studio</span><span class="studio-details__icon" aria-hidden="true">+</span></summary>
      <div class="studio-details__body"><p>Accoglienza, manicure, pedicure, consulenza e cabine: fotografie autentiche dello studio di Viale Barbaroux 20, anche dal nostro profilo Treatwell.</p><StoreGallery client:visible images={studioDetails} /><a href="/contatti">Vieni a conoscere REBEL <span aria-hidden="true">↗</span></a></div>
    </details>
  </div></section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead
        kicker="Come lavoriamo"
        title="Valutazione, trattamento e controlli."
      />
      <div class="card-grid card-grid--3">
        {ways.map((w, i) => (
          <FeatureCard
            kicker={w.kicker}
            title={w.title}
            body={w.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Prodotti, tecnologie e formazione"
        title="I marchi utilizzati _nei trattamenti Rebel_."
        lead="Qui trovi le tecnologie, le linee cosmetiche e i percorsi di formazione che sostengono il nostro lavoro."
      />
      <BrandStrip />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Informazioni utili"
        title="Prezzi, percorso laser e prenotazione."
        lead="Consulta il listino, approfondisci l’epilazione laser oppure prenota una valutazione REBEL di 30–40 minuti."
      />
      <div class="card-grid card-grid--3">
        {paths.map((p) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            href={p.href}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti · Viale Barbaroux 20"
        title="Valutiamo la zona e ti spieghiamo _come possiamo lavorare_."
        lead="Valutiamo insieme la zona e il risultato che desideri. Poi ti spieghiamo il trattamento consigliato, la frequenza, il prezzo e le possibili alternative. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .studio-details { padding:0 0 clamp(2.5rem,5vw,5rem);color:#301a3a;background:#fffdf9; }
  .studio-details details { border-block:1px solid #dfd1df; }
  .studio-details summary { position:relative;display:grid;gap:.6rem;list-style:none;cursor:pointer;padding:1.5rem 4rem 1.5rem 0; }
  .studio-details summary::-webkit-details-marker { display:none; }
  .studio-details__kicker { color:#914476;font:700 .65rem/1.6 var(--font-body);letter-spacing:.12em;text-transform:uppercase; }
  .studio-details summary strong { color:#301a3a;font:500 clamp(1.5rem,2.8vw,2.5rem)/1.2 var(--font-display);letter-spacing:-.025em; }
  .studio-details__hint { color:#7b6781;font-size:.75rem;line-height:1.7; }
  .studio-details__icon { position:absolute;right:0;top:50%;display:grid;place-items:center;width:44px;height:44px;margin-top:-22px;border:1px solid #d8c3d7;border-radius:50%;color:#85497c;font:400 1.5rem/1 var(--font-body);transition:transform .2s ease; }
  .studio-details details[open] .studio-details__icon { transform:rotate(45deg); }
  .studio-details__body { padding-bottom:1.5rem; }
  .studio-details__body > p { max-width:65ch;margin:0 0 1.5rem;color:#705c79;font-size:.85rem;line-height:1.85; }
  .studio-details__body > a { display:inline-flex;align-items:center;gap:1.3rem;min-height:44px;margin-top:1rem;color:#814480;font-size:.85rem;font-weight:700;text-decoration:none; }
  .studio-details :is(summary,a):focus-visible { outline:3px solid #8040c1;outline-offset:5px; }
  @media(prefers-reduced-motion:reduce) { .studio-details__icon { transition:none; } }
</style>
