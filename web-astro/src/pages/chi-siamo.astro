---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import BrandStrip from "@/components/BrandStrip.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Chi siamo — Rebel, centro estetico a Carmagnola",
  description:
    "Rebel è un centro estetico a Carmagnola in Viale Barbaroux 20: 4 cabine, tecnologia laser Thory Ice Polar, pressoterapia, tecar e fotobiostimolazione, con linee professionali Marbellas ed Eberlin e formazione continua su Thory Academy.",
  path: "/chi-siamo",
  openGraphType: "article",
  keywords: [
    "chi siamo centro estetico Carmagnola",
    "Rebel estetica Carmagnola",
    "centro estetico nuovo Carmagnola",
    "estetista Carmagnola",
    "pressoterapia Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Chi siamo", path: "/chi-siamo" },
]);
const webPage = buildWebPageSchema({
  name: "Chi siamo · Rebel Carmagnola",
  description:
    "Chi è Rebel: centro estetico aperto a Carmagnola con 4 cabine, tecnologie laser, tecar, pressoterapia e fotobiostimolazione, brand professionali e formazione continua.",
  path: "/chi-siamo",
});
const article = buildArticleSchema({
  headline: "Chi siamo — Rebel, centro estetico a Carmagnola",
  description:
    "Identità Rebel: studio nuovo a Carmagnola con 4 cabine, tecnologia laser Thory Ice Polar, pressoterapia, tecar e fotobiostimolazione, prodotti professionali e formazione continua.",
  path: "/chi-siamo",
  keywords: [
    "chi siamo Rebel",
    "centro estetico Carmagnola",
    "Thory Carmagnola",
    "tecar Carmagnola",
    "fotobiostimolazione Carmagnola",
  ],
  section: "Chi siamo",
});

const ways = [
  {
    kicker: "Ascolto",
    title: "Partiamo da ciò che vuoi migliorare",
    body: "Ti chiediamo cosa desideri vedere cambiare e osserviamo pelle, corpo e abitudini prima di proporti un trattamento.",
  },
  {
    kicker: "Competenza",
    title: "Tecnologie e prodotti professionali",
    body: "Laser Thory con manipolo Ice Polar, linee Marbellas ed Eberlin per viso e corpo, smalti RBL Nails per la cabina mani.",
  },
  {
    kicker: "Chiarezza",
    title: "Un percorso spiegato bene",
    body: "Prezzi online, prima visita gratuita e indicazioni semplici su tempi, frequenza e risultati realistici.",
  },
];

const paths = [
  {
    kicker: "Trattamenti",
    title: "Scopri il listino",
    body: "Viso, corpo, mani, ceretta, massaggi e laser: trovi prezzi e durata indicativa per ogni servizio.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Laser",
    title: "Epilazione Laser Ice Polar",
    body: "Valutazione iniziale gratuita e calendario costruito sulla zona e sul ciclo del pelo.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    kicker: "Prima visita",
    title: "Vieni a conoscerci",
    body: "Quindici minuti per parlare delle tue esigenze e capire insieme da dove iniziare.",
    href: "/contatti",
  },
];

const studio = [
  {
    kicker: "Spazi",
    title: "Quattro cabine dedicate",
    body: "Quattro cabine, area accoglienza e postazione mani: ogni trattamento ha il suo spazio e il tempo necessario.",
  },
  {
    kicker: "Laser",
    title: "Thory con manipolo Ice Polar",
    body: "Laser a diodo con raffreddamento attivo per un’epilazione progressiva e più confortevole su viso e corpo.",
  },
  {
    kicker: "Corpo",
    title: "Pressoterapia, Tecar e fotobiostimolazione",
    body: "Tecnologie dedicate a leggerezza, tono, qualità dei tessuti e percorsi corpo personalizzati.",
  },
  {
    kicker: "Cosmetica",
    title: "Linee Marbellas ed Eberlin",
    body: "Cosmetica professionale e biocosmetica epigenetica selezionate per i percorsi viso e corpo.",
  },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <PageHero
    image={media.studio.reception}
    kicker="Lo studio · Carmagnola"
    title="Uno spazio pensato per _farti stare bene_."
    lead="Quattro cabine, tecnologie selezionate e professioniste che seguono ogni percorso con attenzione. Rebel ti accoglie in Viale Barbaroux 20, a Carmagnola."
    bullets={["Studio nuovo · 4 cabine", "Viso, corpo, laser e benessere", "Prima visita gratuita"]}
    meta={["Viale Barbaroux 20", "Mar–Sab su appuntamento", "Formazione continua"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scopri il Metodo", href: "/metodo-rebel" }}
  />

  <section class="section">
    <div class="container grid-2">
      <article class="card card--feature">
        <p class="card__kicker">Rebel</p>
        <h2 class="card__title">Estetica, tecnologia e percorsi su misura.</h2>
        <p class="card__body">
          Da Rebel trovi trattamenti viso e corpo, manicure, pedicure, ceretta,
          massaggi ed epilazione laser. Quando serve, integriamo tecnologie e
          cosmetica epigenetica per costruire percorsi più completi e mirati.
        </p>
      </article>
      <article class="card">
        <p class="card__kicker">Il nostro modo di lavorare</p>
        <h2 class="card__title">Prima ascoltiamo. Poi scegliamo.</h2>
        <p class="card__body">
          Ogni percorso parte da una valutazione. Ti spieghiamo cosa consigliamo,
          perché lo consigliamo e come può evolvere nel tempo. La decisione resta
          sempre tua.
        </p>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Lo studio & le tecnologie"
        title="Tutto ciò che serve, _nel posto giusto_."
        lead="Spazi, tecnologie e prodotti professionali scelti per offrire trattamenti precisi, confortevoli e coerenti con il tuo percorso."
      />
      <div class="card-grid card-grid--2">
        {studio.map((s, i) => (
          <FeatureCard
            kicker={s.kicker}
            title={s.title}
            body={s.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <SectionHead
        kicker="Come lavoriamo"
        title="Tre principi semplici."
      />
      <div class="card-grid card-grid--3">
        {ways.map((w, i) => (
          <FeatureCard
            kicker={w.kicker}
            title={w.title}
            body={w.body}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Brand & tecnologie"
        title="I marchi che trovi _in cabina_."
        lead="Tecnologie e linee professionali selezionate per qualità, affidabilità e coerenza con i nostri percorsi."
      />
      <BrandStrip />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Da dove iniziare"
        title="Scegli il tuo primo passo."
        lead="Puoi partire dal listino, dal laser oppure da una prima visita in studio."
      />
      <div class="card-grid card-grid--3">
        {paths.map((p) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            href={p.href}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="left"
    kicker="Rebel · Carmagnola"
    quote="Ogni percorso inizia dall’ascolto."
    cite="Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita"
        title="Vieni a _conoscerci_."
        lead="Quindici minuti per parlare delle tue esigenze e capire insieme da dove iniziare."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la visita", href: "/contatti" }} />
</BaseLayout>
