---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import {
  competencePages,
  servicePages,
} from "@/lib/seo-content-refined";
import { protocolPages } from "@/lib/protocol-pages";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return competencePages.map((c) => ({
    params: { slug: c.slug },
    props: { competence: c },
  }));
}

const { competence } = Astro.props;
const compactTitle = competence.title.replace(/\s+a Carmagnola$/i, "").trim();
const formatPrice = (value: string) =>
  value
    .replace(/\bEUR\s*(\d+(?:[.,]\d+)?)/gi, "€$1")
    .replace(/€\s+(\d+(?:[.,]\d+)?)/g, "€$1")
    .replace(/(\d+)\.(\d{2})\b/g, "$1,$2")
    .replace(/(€\d+(?:,\d+)?)\s+a\s+(\d+(?:,\d+)?)(?!\s*€)/g, "$1 a €$2")
    .replace(/\s*\/\s*/g, " / ")
    .replace(/\s{2,}/g, " ")
    .trim();

const resolveTheme = (slug: string): { hero: ImageAsset; mood: ImageAsset; editorial: readonly ImageAsset[] } => {
  if (/laser|peli-incarniti/.test(slug)) {
    return { hero: media.laser.hero, mood: media.laser.mood, editorial: [media.laser.handpiece, media.laser.consult] };
  }
  if (/laminazione|ciglia|sopracciglia/.test(slug)) {
    return { hero: media.lamina.hero, mood: media.lamina.mood, editorial: [media.lamina.detail, media.lamina.hero] };
  }
  if (/pedicure|piedi|talloni/.test(slug)) {
    return { hero: media.pedicure.hero, mood: media.pedicure.mood, editorial: [media.pedicure.detail, media.pedicure.hero] };
  }
  if (/semipermanente|manicure|unghie/.test(slug)) {
    return { hero: media.manicure.hero, mood: media.manicure.mood, editorial: [media.manicure.detail, media.manicure.hero] };
  }
  if (/linfodrenante|drenaggio|drenante|pressomassaggio/.test(slug)) {
    return { hero: media.drenante.hero, mood: media.drenante.mood, editorial: [media.drenante.detail, media.drenante.hero] };
  }
  if (/massaggio|cervicale/.test(slug)) {
    return { hero: media.massaggio.hero, mood: media.massaggio.mood, editorial: [media.massaggio.detail, media.massaggio.hero] };
  }
  if (/scrub-corpo/.test(slug)) {
    return { hero: media.corpo.hero, mood: media.corpo.mood, editorial: [media.corpo.detail, media.corpo.hero] };
  }
  if (/viso|pelle|contorno-occhi|tono|ovale|opaca|matura|pulizia/.test(slug)) {
    return { hero: media.viso.hero, mood: media.viso.mood, editorial: [media.viso.texture, media.viso.products] };
  }
  return {
    hero: media.studio.cabin,
    mood: media.studio.reception,
    editorial: [media.studio.professional, media.studio.reception],
  };
};
const theme = resolveTheme(competence.slug);
const competenceMetaDescription = competence.shortDescription.length >= 105
  ? competence.shortDescription
  : `${competence.shortDescription} Indicazioni utili prima della valutazione a Carmagnola.`;

const meta = createPageMeta({
  title: competence.title,
  description: competenceMetaDescription,
  path: `/competenze/${competence.slug}`,
  keywords: competence.keywords,
  openGraphType: "article",
  image: competence.heroImage?.src,
});

const toWords = (v: string) => v.trim().split(/\s+/).filter(Boolean);
const readingMinutes = Math.max(
  2,
  Math.round(
    toWords(
      [
        competence.longDescription,
        competence.shortDescription,
        competence.localAngle,
        competence.benefits.join(" "),
        competence.faqs.map((f) => `${f.q} ${f.a}`).join(" "),
        (competence.editorialSections ?? []).flatMap((s) => s.paragraphs).join(" "),
      ].join(" "),
    ).length / 190,
  ),
);
const updatedLabel = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(`${siteConfig.lastUpdated}T12:00:00Z`));

const slugifyId = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[’']/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, "-")
    .replace(/-+/g, "-")
    .replace(/(^-|-$)/g, "");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Guide", path: "/competenze" },
  { name: competence.title, path: `/competenze/${competence.slug}` },
]);
const webPage = buildWebPageSchema({
  name: competence.title,
  description: competenceMetaDescription,
  path: `/competenze/${competence.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: competence.title,
  description: competence.longDescription,
  path: `/competenze/${competence.slug}`,
  keywords: competence.keywords,
  section: competence.intent === "commercial" ? "Guide a servizi e prenotazione" : "Guide pratiche",
  image: competence.heroImage?.src,
});
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: competence.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const relatedServices = servicePages.filter((s) =>
  competence.relatedServiceSlugs.includes(s.slug),
);
const relatedProtocols = (competence.relatedProtocolSlugs ?? [])
  .map((sl) => protocolPages.find((p) => p.slug === sl))
  .filter((p): p is (typeof protocolPages)[number] => Boolean(p))
  .slice(0, 6);
const siblingCompetences = competencePages
  .filter((i) => i.slug !== competence.slug)
  .map((i) => ({
    item: i,
    score:
      (i.intent === competence.intent ? 3 : 0) +
      i.relatedServiceSlugs.filter((rs) =>
        competence.relatedServiceSlugs.includes(rs),
      ).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ item }) => item);
const curatedCompetences = (competence.relatedCompetenceSlugs ?? [])
  .map((sl) => competencePages.find((c) => c.slug === sl))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c))
  .filter((c) => c.slug !== competence.slug)
  .slice(0, 6);
const relatedCompetences = curatedCompetences.length > 0 ? curatedCompetences : siblingCompetences;

const featuredAreas = localAreaPages.filter((a) => a.cluster === "asse-carmagnola").slice(0, 4);

const relatedServicesSchema =
  relatedServices.length > 0
    ? buildItemListSchema({
        name: `Servizi collegati a ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedServices.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })),
      })
    : null;
const relatedCompetencesSchema =
  relatedCompetences.length > 0
    ? buildItemListSchema({
        name: `Altre guide su ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedCompetences.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
      })
    : null;
const relatedProtocolsSchema =
  relatedProtocols.length > 0
    ? buildItemListSchema({
        name: `Protocolli professionali collegati a ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedProtocols.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
      })
    : null;
const featuredAreasSchema =
  featuredAreas.length > 0
    ? buildItemListSchema({
        name: `Indicazioni dai comuni vicini per ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: featuredAreas.map((a) => ({ name: a.city, path: `/localita/${a.slug}` })),
      })
    : null;

const editorialSections = competence.editorialSections ?? [];
const sourceLinks = competence.sourceLinks ?? [];

const tocItems = [
  { id: "punti-chiave", label: "Informazioni principali" },
  ...(editorialSections.length > 0 ? [{ id: "guida", label: "Come si svolge" }] : []),
  { id: "faq", label: "Domande frequenti" },
  ...(relatedServices.length > 0 ? [{ id: "servizi", label: "Servizi collegati" }] : []),
  ...(sourceLinks.length > 0 ? [{ id: "fonti", label: "Fonti" }] : []),
  ...(relatedProtocols.length > 0 ? [{ id: "protocolli", label: "Percorsi REBEL" }] : []),
  ...(relatedCompetences.length > 0 ? [{ id: "correlate", label: "Altri approfondimenti" }] : []),
  ...(featuredAreas.length > 0 ? [{ id: "localita", label: "Come raggiungerci" }] : []),
];
---
<BaseLayout meta={meta} bodyClass={`page-competenza-detail page-competenza-${competence.intent === "commercial" ? "commercial" : "informational"}`}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />
  {relatedServicesSchema ? <JsonLd data={relatedServicesSchema} /> : null}
  {relatedCompetencesSchema ? <JsonLd data={relatedCompetencesSchema} /> : null}
  {relatedProtocolsSchema ? <JsonLd data={relatedProtocolsSchema} /> : null}
  {featuredAreasSchema ? <JsonLd data={featuredAreasSchema} /> : null}

  <PageHero
    image={theme.hero}
    kicker={competence.intent === "commercial" ? "Servizi, prezzi e prenotazione" : "Guida pratica Rebel"}
    title={compactTitle.replace(/(\b\w+\b)$/, "_$1_")}
    lead={competence.longDescription}
    meta={[
      competence.localAngle,
      `${readingMinutes} min di lettura`,
      `Aggiornato il ${updatedLabel}`,
    ]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container detail-grid">
      <article class="detail-main">
        <div id="punti-chiave">
          <SectionHead
            kicker={competence.intent === "commercial" ? "Informazioni prima di prenotare" : "Informazioni principali"}
            title={`Che cosa sapere su _${compactTitle}_.`}
          />
          {competence.heroImage ? (
            <div class="detail-cover">
              <img
                src={competence.heroImage.src}
                alt={competence.heroImage.alt}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : null}
          <p class="detail-lead">{competence.shortDescription}</p>
          <KeyPointsGrid title="In breve" points={competence.benefits} />
        </div>

        {editorialSections.length > 0 ? (
          <div id="guida" class="detail-section">
            <SectionHead
              kicker="Come si svolge"
              title={`Preparazione, trattamento e indicazioni su _${compactTitle}_.`}
              lead="Trovi modalità, tempi, precauzioni e indicazioni utili per dopo l’appuntamento."
            />
            <div class="editorial-flow">
              {editorialSections.map((s, i) => {
                const mediaIndex = Math.floor(i / 2);
                const sectionMedia = i % 2 === 0
                  ? theme.editorial[mediaIndex % theme.editorial.length]
                  : undefined;
                return (
                  <EditorialSection
                    id={slugifyId(s.heading)}
                    heading={s.heading}
                    paragraphs={s.paragraphs}
                    level={3}
                    media={sectionMedia}
                    mediaSide={mediaIndex % 2 === 0 ? "end" : "start"}
                  />
                );
              })}
            </div>
          </div>
        ) : null}

        <div id="faq" class="detail-section">
          <SectionHead
            kicker="Domande frequenti"
            title={`Le domande più comuni su _${compactTitle}_.`}
          />
          <FaqAccordion items={competence.faqs} kicker={`Domande su ${compactTitle}`} />
        </div>

        {sourceLinks.length > 0 ? (
          <div id="fonti" class="detail-section">
            <SectionHead
              kicker="Fonti e riferimenti"
              title="Le fonti consultate per le informazioni tecniche."
            />
            <ul class="source-list">
              {sourceLinks.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noreferrer">{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {relatedServices.length > 0 ? (
          <div id="servizi" class="detail-section">
            <SectionHead
              kicker="Servizi collegati"
              title={`Trattamenti Rebel collegati a _${compactTitle}_.`}
              lead="In ogni scheda trovi descrizione, prezzo, durata e indicazioni utili prima di prenotare."
            />
            <div class="card-grid card-grid--2">
              {relatedServices.map((s, i) => (
                <FeatureCard
                  kicker={formatPrice(s.priceHint)}
                  title={s.name}
                  body={s.shortDescription}
                  href={`/servizi/${s.slug}`}
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}

        {relatedProtocols.length > 0 ? (
          <div id="protocolli" class="detail-section">
            <SectionHead
              kicker="Percorsi REBEL"
              title="Trattamenti professionali per esigenze specifiche di viso o corpo."
              lead="In ogni scheda trovi obiettivo, prezzo, modalità e indicazioni utili prima di prenotare."
            />
            <div class="card-grid card-grid--2">
              {relatedProtocols.map((p, i) => (
                <FeatureCard
                  kicker={formatPrice(p.price)}
                  title={p.name}
                  body={p.shortDescription}
                  href={`/protocolli/${p.slug}`}
                  variant="feature"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}

        {relatedCompetences.length > 0 ? (
          <div id="correlate" class="detail-section">
            <SectionHead
              kicker="Altri approfondimenti utili"
              title="Guide su servizi ed esigenze collegate."
            />
            <div class="card-grid card-grid--2">
              {relatedCompetences.map((c, i) => (
                <FeatureCard
                  kicker="Guida"
                  title={c.title}
                  body={c.shortDescription}
                  href={`/competenze/${c.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}

        {featuredAreas.length > 0 ? (
          <div id="localita" class="detail-section">
            <SectionHead
              kicker="Come raggiungerci"
              title="Indicazioni per chi arriva dai comuni vicini."
              lead="Apri la pagina del tuo comune per vedere la mappa e il percorso verso Viale Barbaroux 20 a Carmagnola."
            />
            <div class="card-grid card-grid--2">
              {featuredAreas.map((a, i) => (
                <FeatureCard
                  kicker="Località"
                  title={a.city}
                  body={`Indicazioni e contatti per organizzare la visita da ${a.city}.`}
                  href={`/localita/${a.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}
      </article>

      <aside class="detail-aside">
        <TableOfContents items={tocItems} />
        <InlineCta
          kicker="Valutazione REBEL · 30–40 minuti"
          title="Vuoi capire quale trattamento può essere adatto a te?"
          lead="Durante la valutazione parliamo del risultato che desideri, osserviamo la pelle o la zona da trattare e ti spieghiamo opzioni, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
          primaryHref="/contatti"
          primaryLabel="Prenota la valutazione"
          secondaryHref="/listino-estetica-laser"
          secondaryLabel="Consulta il listino"
        />
      </aside>
    </div>
  </section>

  <FullBleedBand
    image={theme.mood}
    height="sm"
    align="left"
    kicker={`${compactTitle} · Rebel Carmagnola`}
    quote="Hai ancora un dubbio? Parliamone durante la valutazione REBEL."
    cite="Studio Rebel · Viale Barbaroux 20"
    cta={{ label: "Prenota la valutazione", href: "/contatti" }}
  />

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { order: -1; }
  }
  .detail-main { min-width: 0; }
  .detail-section { margin-top: clamp(3rem, 6vw, 5rem); }
  .detail-cover {
    margin: 1.4rem 0;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .detail-cover img { width: 100%; height: auto; display: block; }
  .detail-lead {
    font-size: var(--t-lead);
    color: var(--text-muted);
    line-height: var(--leading-body);
    max-width: 64ch;
    margin: 1rem 0 0;
  }
  .editorial-flow { display: grid; gap: clamp(2.6rem, 6vw, 5rem); margin-top: 1.6rem; }
  .source-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .source-list a {
    color: var(--text);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
    display: inline-block;
    transition: color var(--t-fast) var(--ease-soft), border-color var(--t-fast) var(--ease-soft);
  }
  .source-list a:hover {
    color: var(--ivory-1);
    border-bottom-color: var(--mauve);
  }
  .detail-aside { display: grid; gap: 1.4rem; }
</style>
