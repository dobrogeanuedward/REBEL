---
import { servicePhotography } from "@/lib/beauty-editorial";
import { photographs } from "@/lib/catalog-visuals";
import { guideCommercialDestinations } from "@/lib/service-navigation";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import {
  competencePages,
  servicePages,
} from "@/lib/seo-content-refined";
import { protocolPages } from "@/lib/protocol-pages";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return competencePages.map((c) => ({
    params: { slug: c.slug },
    props: { competence: c },
  }));
}

const { competence } = Astro.props;
const compactTitle = competence.title.replace(/\s+a Carmagnola$/i, "").trim();
const formatPrice = (value: string) =>
  value
    .replace(/\bEUR\s*(\d+(?:[.,]\d+)?)/gi, "€$1")
    .replace(/€\s+(\d+(?:[.,]\d+)?)/g, "€$1")
    .replace(/(\d+)\.(\d{2})\b/g, "$1,$2")
    .replace(/(€\d+(?:,\d+)?)\s+a\s+(\d+(?:,\d+)?)(?!\s*€)/g, "$1 a €$2")
    .replace(/\s*\/\s*/g, " / ")
    .replace(/\s{2,}/g, " ")
    .trim();

const resolveTheme = (slug: string): { hero: ImageAsset; mood: ImageAsset; editorial: readonly ImageAsset[] } => {
  if (/laser|peli-incarniti/.test(slug)) {
    return { hero: media.laser.hero, mood: media.laser.mood, editorial: [media.laser.handpiece, media.laser.consult] };
  }
  if (/laminazione|ciglia|sopracciglia/.test(slug)) {
    return { hero: media.lamina.hero, mood: media.lamina.mood, editorial: [media.lamina.detail, media.lamina.hero] };
  }
  if (/pedicure|piedi|talloni/.test(slug)) {
    return { hero: media.pedicure.hero, mood: media.pedicure.mood, editorial: [media.pedicure.detail, media.pedicure.hero] };
  }
  if (/semipermanente|manicure|unghie/.test(slug)) {
    return { hero: media.manicure.hero, mood: media.manicure.mood, editorial: [media.manicure.detail, media.manicure.hero] };
  }
  if (/linfodrenante|drenaggio|drenante|pressomassaggio/.test(slug)) {
    return { hero: media.drenante.hero, mood: media.drenante.mood, editorial: [media.drenante.detail, media.drenante.hero] };
  }
  if (/massaggio|cervicale/.test(slug)) {
    return { hero: media.massaggio.hero, mood: media.massaggio.mood, editorial: [media.massaggio.detail, media.massaggio.hero] };
  }
  if (/scrub-corpo/.test(slug)) {
    return { hero: media.corpo.hero, mood: media.corpo.mood, editorial: [media.corpo.detail, media.corpo.hero] };
  }
  if (/viso|pelle|contorno-occhi|tono|ovale|opaca|matura|pulizia/.test(slug)) {
    return { hero: media.viso.hero, mood: media.viso.mood, editorial: [media.viso.texture, media.viso.products] };
  }
  return {
    hero: media.studio.cabin,
    mood: media.studio.reception,
    editorial: [media.studio.professional, media.studio.reception],
  };
};
const theme = resolveTheme(competence.slug);
const photoForService = (slug: string, fallback?: ImageAsset) => {
  const key = servicePhotography[slug]?.[0];
  return key ? photographs[key] : fallback;
};
const commercialDestination = guideCommercialDestinations[competence.slug];
const competenceMetaDescription = competence.shortDescription.length >= 105
  ? competence.shortDescription
  : `${competence.shortDescription} Indicazioni utili prima della valutazione a Carmagnola.`;

const meta = createPageMeta({
  title: competence.title,
  description: competenceMetaDescription,
  path: `/competenze/${competence.slug}`,
  keywords: competence.keywords,
  openGraphType: "article",
  image: competence.heroImage?.src,
});

const toWords = (v: string) => v.trim().split(/\s+/).filter(Boolean);
const readingMinutes = Math.max(
  2,
  Math.round(
    toWords(
      [
        competence.longDescription,
        competence.shortDescription,
        competence.localAngle,
        competence.benefits.join(" "),
        competence.faqs.map((f) => `${f.q} ${f.a}`).join(" "),
        (competence.editorialSections ?? []).flatMap((s) => s.paragraphs).join(" "),
      ].join(" "),
    ).length / 190,
  ),
);
const updatedLabel = new Intl.DateTimeFormat("it-IT", {
  day: "numeric",
  month: "long",
  year: "numeric",
}).format(new Date(`${siteConfig.lastUpdated}T12:00:00Z`));

const slugifyId = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[’']/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, "-")
    .replace(/-+/g, "-")
    .replace(/(^-|-$)/g, "");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Guide", path: "/competenze" },
  { name: competence.title, path: `/competenze/${competence.slug}` },
]);
const webPage = buildWebPageSchema({
  name: competence.title,
  description: competenceMetaDescription,
  path: `/competenze/${competence.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: competence.title,
  description: competence.longDescription,
  path: `/competenze/${competence.slug}`,
  keywords: competence.keywords,
  section: competence.intent === "commercial" ? "Guide a servizi e prenotazione" : "Guide pratiche",
  image: competence.heroImage?.src,
});
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: competence.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const relatedServices = servicePages.filter((s) =>
  competence.relatedServiceSlugs.includes(s.slug),
);
const relatedProtocols = (competence.relatedProtocolSlugs ?? [])
  .map((sl) => protocolPages.find((p) => p.slug === sl))
  .filter((p): p is (typeof protocolPages)[number] => Boolean(p))
  .slice(0, 6);
const siblingCompetences = competencePages
  .filter((i) => i.slug !== competence.slug)
  .map((i) => ({
    item: i,
    score:
      (i.intent === competence.intent ? 3 : 0) +
      i.relatedServiceSlugs.filter((rs) =>
        competence.relatedServiceSlugs.includes(rs),
      ).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ item }) => item);
const curatedCompetences = (competence.relatedCompetenceSlugs ?? [])
  .map((sl) => competencePages.find((c) => c.slug === sl))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c))
  .filter((c) => c.slug !== competence.slug)
  .slice(0, 6);
const relatedCompetences = curatedCompetences.length > 0 ? curatedCompetences : siblingCompetences;

const featuredAreas = localAreaPages.filter((a) => a.cluster === "asse-carmagnola").slice(0, 4);

const relatedServicesSchema =
  relatedServices.length > 0
    ? buildItemListSchema({
        name: `Servizi collegati a ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedServices.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })),
      })
    : null;
const relatedCompetencesSchema =
  relatedCompetences.length > 0
    ? buildItemListSchema({
        name: `Altre guide su ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedCompetences.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
      })
    : null;
const relatedProtocolsSchema =
  relatedProtocols.length > 0
    ? buildItemListSchema({
        name: `Protocolli professionali collegati a ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: relatedProtocols.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
      })
    : null;
const featuredAreasSchema =
  featuredAreas.length > 0
    ? buildItemListSchema({
        name: `Indicazioni dai comuni vicini per ${competence.title}`,
        path: `/competenze/${competence.slug}`,
        items: featuredAreas.map((a) => ({ name: a.city, path: `/localita/${a.slug}` })),
      })
    : null;

const editorialSections = competence.editorialSections ?? [];
const sourceLinks = competence.sourceLinks ?? [];

const tocItems = [
  { id: "punti-chiave", label: "Informazioni principali" },
  ...(editorialSections.length > 0 ? [{ id: "guida", label: "Leggi la guida" }] : []),
  { id: "faq", label: "Domande frequenti" },
  ...(relatedServices.length > 0 ? [{ id: "servizi", label: "Servizi collegati" }] : []),
  ...(sourceLinks.length > 0 ? [{ id: "fonti", label: "Fonti" }] : []),
  ...(relatedProtocols.length > 0 ? [{ id: "protocolli", label: "Percorsi REBEL" }] : []),
  ...(relatedCompetences.length > 0 ? [{ id: "correlate", label: "Altri approfondimenti" }] : []),
  ...(featuredAreas.length > 0 ? [{ id: "localita", label: "Come raggiungerci" }] : []),
];
---
<BaseLayout meta={meta} bodyClass={`rebel-rebrand rebel-shell page-competenza-detail page-competenza-${competence.intent === "commercial" ? "commercial" : "informational"}`}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />
  {relatedServicesSchema ? <JsonLd data={relatedServicesSchema} /> : null}
  {relatedCompetencesSchema ? <JsonLd data={relatedCompetencesSchema} /> : null}
  {relatedProtocolsSchema ? <JsonLd data={relatedProtocolsSchema} /> : null}
  {featuredAreasSchema ? <JsonLd data={featuredAreasSchema} /> : null}

  <PageHero
    image={theme.hero}
    kicker="Il journal REBEL · Guida pratica"
    title={compactTitle.replace(/(\b\w+\b)$/, "_$1_")}
    lead={competence.shortDescription}
    meta={[`${readingMinutes} min di lettura`, `Aggiornato il ${updatedLabel}`, "REBEL · Carmagnola"]}
    ctaPrimary={{ label: "Leggi la guida", href: "#punti-chiave" }}
    ctaSecondary={commercialDestination ? { label: commercialDestination.label, href: commercialDestination.href } : { label: "Tutte le guide", href: "/competenze" }}
    imageCaption="Immagine editoriale illustrativa del trattamento."
  />

  <div class="guide-editorial">
    <div class="guide-shell guide-navigation"><nav class="guide-jumpnav" aria-label="Indice della guida"><span>In questa guida</span>{tocItems.map(item => <a href={`#${item.id}`}>{item.label}</a>)}</nav></div>

    <section class="guide-section guide-section--intro" id="punti-chiave" aria-labelledby="guide-intro-title"><div class="guide-shell guide-intro">
      <div><p class="guide-kicker">Cominciamo da qui</p><h2 id="guide-intro-title">Capire il trattamento.<br /><em>Scegliere con calma.</em></h2><p class="guide-intro__lead">{competence.longDescription}</p><p class="guide-local">{competence.localAngle}</p></div>
      <div class="guide-summary"><p class="guide-kicker">Da tenere a mente</p><KeyPointsGrid points={competence.benefits} variant="quiet" /></div>
    </div></section>

    {editorialSections.length > 0 && <section id="guida" class="guide-section guide-section--paper" aria-labelledby="guide-content-title"><div class="guide-shell">
      <header class="guide-heading"><p class="guide-kicker">La guida REBEL</p><h2 id="guide-content-title">Dal primo dubbio<br /><em>ai dettagli che contano.</em></h2></header>
      <div class="guide-flow">{editorialSections.map((s, i) => <EditorialSection id={slugifyId(s.heading)} heading={s.heading} paragraphs={s.paragraphs} level={3} sequence={i + 1} media={i % 2 === 0 ? theme.editorial[Math.floor(i / 2) % theme.editorial.length] : undefined} mediaSide={Math.floor(i / 2) % 2 === 0 ? "end" : "start"} />)}</div>
    </div></section>}

    <section id="faq" class="guide-section" aria-labelledby="guide-faq-title"><div class="guide-shell guide-questions">
      <header><p class="guide-kicker">Un dubbio in più?</p><h2 id="guide-faq-title">Le risposte,<br /><em>da vicino.</em></h2><p>Preparazione, frequenza e cura dopo la seduta: le domande più comuni su {compactTitle.toLocaleLowerCase("it-IT")}.</p></header>
      <div><FaqAccordion items={competence.faqs} kicker="Domande e risposte" /></div>
    </div></section>

    {sourceLinks.length > 0 && <section id="fonti" class="guide-section guide-section--sources" aria-labelledby="guide-sources-title"><div class="guide-shell"><details class="guide-sources"><summary id="guide-sources-title">Fonti e riferimenti della guida <span aria-hidden="true">＋</span></summary><p>Le fonti consultate per le informazioni tecniche.</p><ul>{sourceLinks.map(s => <li><a href={s.url} target="_blank" rel="noreferrer">{s.label} <span aria-hidden="true">↗</span></a></li>)}</ul></details></div></section>}

    {relatedServices.length > 0 && <section id="servizi" class="guide-section guide-section--paper" aria-labelledby="guide-services-title"><div class="guide-shell">
      <div class="guide-heading-row"><div><p class="guide-kicker">Dalla guida all’appuntamento</p><h2 id="guide-services-title">Il servizio<br /><em>che cerchi.</em></h2></div><p>Se vuoi passare alla scelta del trattamento, queste schede raccolgono le proposte REBEL, le varianti e le modalità di prenotazione.</p></div>
      <div class="guide-services">{relatedServices.map(s => { const photo = photoForService(s.slug, s.heroImage); const hidePrice = ["pedicure-estetico-con-smalto-carmagnola","pedicure-semipermanente-carmagnola"].includes(s.slug); return <a href={`/servizi/${s.slug}`}>{photo && <div class="guide-services__photo"><img src={photo.src} alt={photo.alt} width={photo.width ?? 1200} height={photo.height ?? 800} loading="lazy" decoding="async" /></div>}<div class="guide-services__copy"><p class="guide-kicker">{hidePrice ? "Cura e colore" : formatPrice(s.priceHint)}</p><h3>{s.name.replace(/ a Carmagnola$/i, "")} <span aria-hidden="true">↗</span></h3><p>{s.shortDescription}</p></div></a>; })}</div>
      {commercialDestination && <p class="guide-commercial-link"><a href={commercialDestination.href}>{commercialDestination.label} <span aria-hidden="true">↗</span></a></p>}
    </div></section>}

    {relatedProtocols.length > 0 && <section id="protocolli" class="guide-section" aria-labelledby="guide-protocols-title"><div class="guide-shell">
      <header class="guide-heading"><p class="guide-kicker">Percorsi di cura</p><h2 id="guide-protocols-title">Esigenze diverse.<br /><em>Protocolli dedicati.</em></h2></header>
      <div class="guide-protocols">{relatedProtocols.map((p, i) => <a href={`/protocolli/${p.slug}`}><span class="guide-kicker">{String(i+1).padStart(2,"0")} · {formatPrice(p.price)}</span><h3>{p.name}</h3><p>{p.shortDescription}</p><span class="guide-link">Conosci il protocollo <span aria-hidden="true">↗</span></span></a>)}</div>
    </div></section>}

    {relatedCompetences.length > 0 && <section id="correlate" class="guide-section guide-section--paper" aria-labelledby="guide-related-title"><div class="guide-shell guide-reading">
      <header><p class="guide-kicker">Continua a leggere</p><h2 id="guide-related-title">Altre prospettive<br /><em>sulla tua cura.</em></h2></header>
      <div class="guide-reading__list">{relatedCompetences.map((c,i) => <a href={`/competenze/${c.slug}`}><span class="guide-reading__index">{String(i+1).padStart(2,"0")}</span><div><h3>{c.title}</h3><p>{c.shortDescription}</p></div><span aria-hidden="true">↗</span></a>)}</div>
    </div></section>}

    <section class="guide-section guide-section--visit" aria-labelledby="guide-visit-title"><div class="guide-shell guide-visit">
      <div><p class="guide-kicker">Il dialogo, prima di tutto</p><h2 id="guide-visit-title">Hai ancora<br /><em>una domanda?</em></h2></div>
      <div><p>Raccontaci che cosa desideri e quale dubbio vorresti chiarire. Se serve una valutazione REBEL, dedichiamo 30–40 minuti a osservare pelle o zona, confrontare le opzioni e spiegare frequenza e prezzo.</p><p>Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.</p><div class="guide-actions"><a class="btn btn--primary" href="/contatti">Parlane con REBEL <span aria-hidden="true">↗</span></a><a class="guide-link" href={siteConfig.social.whatsapp}>Scrivici su WhatsApp</a></div></div>
    </div></section>

    {featuredAreas.length > 0 && <section id="localita" class="guide-section guide-section--local" aria-labelledby="guide-local-title"><div class="guide-shell"><div><p class="guide-kicker">Ci trovi a Carmagnola</p><h2 id="guide-local-title">La tua visita,<br /><em>da dove parti.</em></h2><p>Tutti i trattamenti si svolgono in Viale Barbaroux 20. Scegli la partenza per vedere mappa e indicazioni.</p></div><nav aria-label="Indicazioni dai comuni vicini">{featuredAreas.map(a => <a href={`/localita/${a.slug}`}>Da {a.city} <span aria-hidden="true">↗</span></a>)}<a href="/localita">Tutte le località <span aria-hidden="true">→</span></a></nav></div></section>}
  </div>
</BaseLayout>

<style>
  .guide-editorial { color-scheme: light; --text: #301b3e; --text-strong: #301b3e; --text-muted: #685471; --line: #e2d6e7; color: #301b3e; background: #f8f3ed; }
  .guide-shell { width: min(1240px,calc(100% - 2 * clamp(1.2rem,4vw,3.5rem))); margin-inline: auto; }
  .guide-editorial :is(h2,h3,p) { margin: 0; }
  .guide-editorial :is(h2,h3) { color: #301b3e; overflow-wrap: normal; }
  .guide-editorial h2 { font: 500 clamp(2.15rem,4vw,3.7rem)/1.1 var(--font-display); letter-spacing: -.035em; }
  .guide-editorial em { color: #70428b; font-weight: 400; }
  .guide-editorial p { color: #685471; line-height: 1.8; }
  .guide-editorial .guide-kicker { display: block; color: #a51e58; font: 650 .72rem/1.6 var(--font-body); letter-spacing: .13em; text-transform: uppercase; margin-bottom: 1rem; }
  .guide-navigation { padding-block: 1rem; }
  .guide-jumpnav { display: flex; align-items: center; gap: .6rem 1.35rem; overflow-x: auto; padding-bottom: .35rem; border-bottom: 1px solid #dfd0e6; }
  .guide-jumpnav>span { color: #a51e58; font-size: .68rem; white-space: nowrap; letter-spacing: .1em; text-transform: uppercase; }
  .guide-jumpnav a { flex-shrink: 0; display: inline-flex; align-items: center; min-height: 44px; color: #70428b; font-size: .78rem; text-decoration: none; }
  .guide-jumpnav a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .guide-section { padding-block: clamp(3.5rem,7vw,6rem); scroll-margin-top: 6rem; }
  .guide-section--paper { background: #fffdf9; }
  .guide-section--intro { padding-top: clamp(2rem,4vw,4rem); }
  .guide-intro { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem,6vw,6rem); align-items: center; }
  .guide-intro__lead { margin-top: 1.5rem!important; font-size: 1.02rem; }
  .guide-editorial .guide-local { color: #786981; font-size: .78rem; margin-top: 1.2rem; }
  .guide-summary { border-top: 2px solid #b8a1c9; padding: clamp(1.5rem,3vw,2.5rem); background: #f2eaf4; border-radius: .4rem 2rem .4rem 2rem; min-width: 0; }
  .guide-heading { max-width: 800px; margin-bottom: clamp(2rem,4vw,3.5rem); }
  .guide-heading-row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem,5vw,5rem); align-items: end; margin-bottom: 2.5rem; }
  .guide-heading-row>p { max-width: 58ch; }
  .guide-flow { display: grid; gap: clamp(2.5rem,6vw,5.5rem); }
  .guide-questions { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(2rem,6vw,6rem); align-items: start; }
  .guide-questions header>p:last-child { margin-top: 1.5rem; font-size: .92rem; }
  .guide-questions>div { min-width: 0; }
  .guide-section--sources { padding-top: 0; }
  .guide-sources { border-block: 1px solid #dfd0e6; padding-block: .7rem; }
  .guide-sources summary { color: #70428b; display: flex; justify-content: space-between; align-items: center; min-height: 44px; gap: 1rem; cursor: pointer; font-size: .88rem; list-style: none; }
  .guide-sources summary::-webkit-details-marker { display: none; }
  .guide-sources[open] summary>span { transform: rotate(45deg); }
  .guide-sources>p { font-size: .8rem; margin-block: .8rem; }
  .guide-sources ul { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem 2rem; padding: 0; margin: 0 0 .5rem; }
  .guide-sources a { color: #70428b; font-size: .78rem; display: inline-flex; align-items: center; gap: .6rem; min-height: 44px; text-underline-offset: .3em; }
  .guide-services { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2rem 1.5rem; }
  .guide-services>a { display: block; color: inherit; text-decoration: none; min-width: 0; }
  .guide-services__photo { overflow: hidden; border-radius: 2rem .4rem 2rem .4rem; background: #e9dfec; }
  .guide-services__photo img { width: 100%; height: auto; aspect-ratio: 16/10; object-fit: cover; display: block; transition: transform .45s ease; }
  .guide-services a:hover img { transform: scale(1.025); }
  .guide-services__copy { padding-block: 1.25rem; }
  .guide-services__copy .guide-kicker { margin-bottom: .5rem; }
  .guide-services__copy h3 { font: 500 clamp(1.45rem,2.7vw,2rem)/1.2 var(--font-display); display: flex; justify-content: space-between; gap: .75rem; }
  .guide-services__copy>p:last-child { font-size: .88rem; margin-top: .8rem; max-width: 56ch; }
  .guide-commercial-link { border-top: 1px solid #dfd0e6; padding-top: 1rem; margin-top: 1rem!important; }
  .guide-commercial-link a,.guide-editorial .guide-link { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; color: #70428b; font-size: .83rem; font-weight: 650; text-underline-offset: .3em; }
  .guide-protocols { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2rem; }
  .guide-protocols>a { display: block; padding-block: 1.5rem; border-top: 1px solid #cdb6d9; text-decoration: none; min-width: 0; }
  .guide-protocols h3 { font: 500 clamp(1.5rem,2.5vw,2.2rem)/1.2 var(--font-display); }
  .guide-protocols p { margin-top: 1rem; font-size: .92rem; max-width: 60ch; }
  .guide-protocols .guide-link { margin-top: 1rem; }
  .guide-reading { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem,6vw,6rem); align-items: start; }
  .guide-reading__list { min-width: 0; }
