---
import GuidesLibrary from "@/components/GuidesLibrary.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { competencePages } from "@/lib/seo-content-refined";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Guide su laser, viso, corpo e beauty | Rebel Carmagnola",
  description:
    "Guide pratiche su epilazione laser, pulizia viso, manicure, laminazione, pedicure, massaggi e trattamenti corpo: durata, frequenza, preparazione e indicazioni.",
  path: "/competenze",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/8d07afc2-b036-4eff-d34e-523a6c656d00/public",
  keywords: [
    "guide centro estetico Carmagnola",
    "guida epilazione laser Carmagnola",
    "guida pulizia viso Carmagnola",
    "approfondimenti estetica Carmagnola",
    "estetica avanzata Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Guide", path: "/competenze" },
]);
const competenceListSchema = buildItemListSchema({
  name: "Guide pratiche Rebel",
  path: "/competenze",
  items: competencePages.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
});
const webPageSchema = buildWebPageSchema({
  name: "Guide pratiche Rebel",
  description: "Informazioni su modalità, durata, frequenza, prezzi e indicazioni dei trattamenti Rebel.",
  path: "/competenze",
});
---
<BaseLayout meta={meta} bodyClass="page-competenze rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={competenceListSchema} />
  <JsonLd data={webPageSchema} />
  <GuidesLibrary />
  <StickyBookingBar primary={{ label: "Parlane con REBEL", href: "/contatti" }} />
</BaseLayout>
