---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { competencePages } from "@/lib/seo-content";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Guide e Approfondimenti Beauty — Centro Estetico Carmagnola",
  description:
    "Guide pratiche su epilazione laser, pulizia viso, manicure, contorno occhi e trattamenti corpo: cosa aspettarsi, ogni quanto farli, come scegliere a Carmagnola.",
  path: "/competenze",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/8d07afc2-b036-4eff-d34e-523a6c656d00/public",
  keywords: [
    "guide centro estetico Carmagnola",
    "guida epilazione laser Carmagnola",
    "guida pulizia viso Carmagnola",
    "approfondimenti estetica Carmagnola",
    "estetica avanzata Carmagnola",
  ],
});

const compactTitle = (v: string) => v.replace(/\s+a Carmagnola$/i, "").trim();

const featuredSlugs = [
  "pulizia-viso-carmagnola-frequenza-benefici",
  "pedicure-carmagnola-ogni-quanto-talloni",
  "pressoterapia-carmagnola",
  "epilazione-laser-ascelle-carmagnola",
  "epilazione-laser-inguine-carmagnola",
  "laser-uomo-carmagnola",
  "peli-incarniti-laser-carmagnola",
  "manicure-semipermanente-carmagnola-durata-rimozione",
  "pelle-opaca-grana-irregolare-carmagnola",
  "contorno-occhi-gonfiore-occhiaie-carmagnola",
];
const featuredGuides = featuredSlugs
  .map((s) => competencePages.find((c) => c.slug === s))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c));

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Competenze", path: "/competenze" },
]);
const competenceListSchema = buildItemListSchema({
  name: "Guide e competenze Rebel",
  path: "/competenze",
  items: competencePages.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
});
const webPageSchema = buildWebPageSchema({
  name: "Guide e competenze Rebel",
  description: "Guide beauty su laser, viso e corpo per scegliere il trattamento più adatto.",
  path: "/competenze",
});
---
<BaseLayout meta={meta} bodyClass="page-competenze">
  <JsonLd data={breadcrumb} />
  <JsonLd data={competenceListSchema} />
  <JsonLd data={webPageSchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Guide & approfondimenti"
    title="Tutto quello che serve _sapere prima_."
    lead="Guide pratiche su laser, viso, corpo e routine: cosa fa il trattamento, ogni quanto si fa, cosa aspettarsi davvero. Scritte da chi lo fa in cabina, non da un copy."
    bullets={["Letture brevi e pratiche", "Scritte da chi lavora in cabina", "Senza claim gonfiati"]}
    meta={["Letture brevi", "Aggiornate periodicamente", "Senza claim gonfiati"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vedi tutti i trattamenti", href: "/listino-estetica-laser" }}
  />

  {featuredGuides.length > 0 ? (
    <section class="section">
      <div class="container">
        <SectionHead
          kicker="Le più lette"
          title="Le guide _più richieste_ in studio."
          lead="Sono le domande che ci fanno più spesso: cosa cambia, ogni quanto, cosa aspettarsi. Risposte chiare, senza giri."
        />
        <div class="card-grid card-grid--2">
          {featuredGuides.map((g, i) => (
            <FeatureCard
              kicker="Guida"
              title={compactTitle(g.title)}
              body={g.shortDescription}
              href={`/competenze/${g.slug}`}
              variant="feature"
              index={i + 1}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Tutte le guide"
        title="L'_archivio completo_ degli approfondimenti."
        lead="Una pagina per ogni tema: cosa cambia, quando ha senso, come si combina con il resto del percorso."
      />
      <div class="card-grid card-grid--2">
        {competencePages.map((c, i) => (
          <FeatureCard
            kicker={c.intent === "commercial" ? "Percorso" : "Guida"}
            title={c.title}
            body={c.shortDescription}
            href={`/competenze/${c.slug}`}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Da Rebel, a Carmagnola"
    quote="Hai letto, hai capito. Il passo successivo è semplice: vieni a provarlo."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Dalla guida alla prenotazione"
        title="Hai letto, hai capito: _vieni a provarlo_."
        lead="La prima visita è gratuita. Quindici minuti per trasformare quello che hai letto in un piano concreto, costruito sulla tua pelle."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita gratuita"
        secondaryHref="/listino-estetica-laser"
        secondaryLabel="Vedi listino e prezzi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>
