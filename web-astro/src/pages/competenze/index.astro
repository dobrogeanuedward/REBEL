---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { competencePages } from "@/lib/seo-content-refined";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Guide su laser, viso, corpo e beauty | Rebel Carmagnola",
  description:
    "Guide pratiche su epilazione laser, pulizia viso, manicure, laminazione, pedicure, massaggi e trattamenti corpo: durata, frequenza, preparazione e indicazioni.",
  path: "/competenze",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/8d07afc2-b036-4eff-d34e-523a6c656d00/public",
  keywords: [
    "guide centro estetico Carmagnola",
    "guida epilazione laser Carmagnola",
    "guida pulizia viso Carmagnola",
    "approfondimenti estetica Carmagnola",
    "estetica avanzata Carmagnola",
  ],
});

const compactTitle = (v: string) => v.replace(/\s+a Carmagnola$/i, "").trim();

const featuredSlugs = [
  "pulizia-viso-carmagnola-frequenza-benefici",
  "pedicure-carmagnola-ogni-quanto-talloni",
  "pressoterapia-carmagnola",
  "epilazione-laser-ascelle-carmagnola",
  "epilazione-laser-inguine-carmagnola",
  "laser-uomo-carmagnola",
  "peli-incarniti-laser-carmagnola",
  "manicure-semipermanente-carmagnola-durata-rimozione",
  "pelle-opaca-grana-irregolare-carmagnola",
  "contorno-occhi-gonfiore-occhiaie-carmagnola",
];
const featuredGuides = featuredSlugs
  .map((s) => competencePages.find((c) => c.slug === s))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c));

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Guide", path: "/competenze" },
]);
const competenceListSchema = buildItemListSchema({
  name: "Guide pratiche Rebel",
  path: "/competenze",
  items: competencePages.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
});
const webPageSchema = buildWebPageSchema({
  name: "Guide pratiche Rebel",
  description: "Informazioni su modalità, durata, frequenza, prezzi e indicazioni dei trattamenti Rebel.",
  path: "/competenze",
});
---
<BaseLayout meta={meta} bodyClass="page-competenze">
  <JsonLd data={breadcrumb} />
  <JsonLd data={competenceListSchema} />
  <JsonLd data={webPageSchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Guide pratiche · Rebel Carmagnola"
    title="Durata, frequenza e indicazioni _prima del trattamento_."
    lead="Le guide spiegano come funziona ogni servizio, come prepararsi, che cosa aspettarsi durante la seduta e quali attenzioni seguire dopo."
    bullets={["Laser, viso, corpo e beauty", "Indicazioni pratiche", "Collegamenti a prezzi e prenotazione"]}
    meta={["Guide aggiornate", "Servizi disponibili a Carmagnola", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta il listino", href: "/listino-estetica-laser" }}
  />

  {featuredGuides.length > 0 ? (
    <section class="section">
      <div class="container">
        <SectionHead
          kicker="Domande frequenti in studio"
          title="Laser, pulizia viso, manicure, pedicure e trattamenti corpo."
          lead="Una selezione delle guide più consultate, con risposte su tempi, modalità, preparazione e mantenimento."
        />
        <div class="card-grid card-grid--2">
          {featuredGuides.map((g, i) => (
            <FeatureCard
              kicker="Guida pratica"
              title={compactTitle(g.title)}
              body={g.shortDescription}
              href={`/competenze/${g.slug}`}
              variant="feature"
              index={i + 1}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Tutte le guide"
        title="Informazioni su servizi, tecnologie e cura dopo la seduta."
        lead="Apri una guida per leggere indicazioni specifiche e trovare i collegamenti alla scheda del servizio, al prezzo e alla prenotazione."
      />
      <div class="card-grid card-grid--2">
        {competencePages.map((c, i) => (
          <FeatureCard
            kicker={c.intent === "commercial" ? "Servizio e prenotazione" : "Guida pratica"}
            title={c.title}
            body={c.shortDescription}
            href={`/competenze/${c.slug}`}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Prima visita gratuita"
    quote="Valutiamo la zona e ti comunichiamo trattamento, frequenza e prezzo."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Hai ancora un dubbio?"
        title="Spiegaci quale zona o risultato ti _interessa_."
        lead="In circa quindici minuti valutiamo le informazioni utili e ti indichiamo il servizio più adatto, con prezzo e frequenza."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita"
        secondaryHref="/listino-estetica-laser"
        secondaryLabel="Consulta il listino"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>
