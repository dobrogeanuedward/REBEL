---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-alba");

const meta = createPageMeta({
  title: "Epilazione laser per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Da Rebel a Carmagnola impostiamo il laser come un piano sostenibile: Lumina X1 Pro di THORY, comfort ICE Polar e calendario disegnato sulla tua agenda.",
  path: "/epilazione-laser-alba",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Alba",
    "laser Alba",
    "epilazione laser Langhe",
    "centro laser Alba",
    "laser diodo Alba",
    "epilazione laser vicino Alba",
    "laser viso Alba",
    "laser corpo Alba",
    "laser ascelle Alba",
    "laser inguine Alba",
    "laser gambe Alba",
    "Rebel epilazione laser Alba",
    "epilazione laser Alba CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Alba e Langhe", path: "/epilazione-laser-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Epilazione laser per chi viene da Alba e dalle Langhe",
  description: meta.description,
  path: "/epilazione-laser-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/epilazione-laser-alba",
  keywords: [
    "epilazione laser Alba",
    "laser Alba",
    "epilazione laser Langhe",
    "laser diodo Alba",
  ],
  section: "Laser",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
});

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser per chi viene da Alba",
  "Percorso di epilazione laser per clienti provenienti da Alba e dalle Langhe: Lumina X1 Pro di THORY con comfort Ice Polar, valutazione iniziale e piano personalizzato.",
  "/epilazione-laser-alba",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Alba",
      "epilazione laser Langhe",
      "laser Alba CN",
      "laser diodo Alba",
      "Ice Polar Alba",
    ],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-alba#service-geo`,
  name: "Epilazione laser per chi viene da Alba",
  serviceType: "Laser hair removal",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Provincia di Cuneo",
      },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 44.7008,
        longitude: 8.0354,
      },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "25.90",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci metto da Alba a Rebel?",
    a: "Circa trenta minuti via A33 con uscita Marene, poi SP661 fino a Carmagnola. Sono 33 chilometri. Lo studio è in centro, Viale Barbaroux 20, con possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Posso iniziare il laser se mi espongo spesso al sole?",
    a: "Dipende da esposizione, abbronzatura, zona e condizioni della pelle. Prima di ogni seduta controlliamo la zona e decidiamo se procedere o riprogrammare l'appuntamento.",
  },
  {
    q: "Da quante zone conviene partire la prima volta?",
    a: "Il numero di zone viene scelto durante la valutazione in base a pelle, caratteristiche del pelo, tempi della seduta e tue priorità. Puoi iniziare da poche zone e aggiungerne altre in seguito.",
  },
  {
    q: "Posso fare il laser e un altro trattamento (pulizia viso, manicure, laminazione) nello stesso giorno?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità, soprattutto se il laser interessa il viso.",
  },
  {
    q: "Quanto costa un percorso completo? Posso avere un'idea prima di venire?",
    a: "Sì. Mandaci su WhatsApp le zone che vuoi trattare: il riferimento di partenza è 25,90 € a zona; il totale dipende da estensione, numero di sedute e zone abbinate.",
  },
  {
    q: "Si paga seduta per seduta o serve un anticipo?",
    a: "Le modalità di pagamento e la frequenza vengono spiegate durante la valutazione, in base alle zone da trattare.",
  },
  {
    q: "Come prenoto da Alba? Posso scegliere il giorno della settimana?",
    a: "Scrivici su WhatsApp indicando le zone di interesse e il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const principles = [
  {
    kicker: "01 · Valutazione reale",
    title: "Si parte dalla pelle, dall'agenda, dalla vita.",
    body: "Valutiamo fototipo, zona, caratteristiche del pelo, esposizione solare e abitudini. Da qui definiamo parametri e calendario iniziali.",
  },
  {
    kicker: "02 · Lumina X1 Pro · comfort ICE Polar",
    title: "La tecnologia usata durante la seduta.",
    body: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm e il raffreddamento a contatto in zaffiro Ice Point Cooling. Durante la valutazione ti spieghiamo impostazioni e comfort ICE Polar.",
  },
  {
    kicker: "03 · Calendario sulla tua agenda",
    title: "Il percorso si costruisce intorno a te.",
    body: "Ci racconti periodi di viaggio, esposizione solare e impegni già previsti; organizziamo il calendario tenendo conto della tua disponibilità.",
  },
  {
    kicker: "04 · Comunicazione diretta",
    title: "Dubbi tra le sedute? WhatsApp.",
    body: "Rispondere in modo concreto è parte del lavoro. Scrivici: non hai bisogno di aspettare la prossima seduta per avere una risposta sensata.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Informazioni su valutazione iniziale, preparazione e indicazioni tra le sedute per la zona ascelle.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Informazioni su valutazione iniziale, preparazione e indicazioni tra le sedute per la zona inguine.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Superficie ampia, calendario più disteso, mantenimento ragionato nel tempo.",
  },
  {
    href: "/servizi/epilazione-laser-viso-carmagnola",
    title: "Laser viso (baffetti, mento, basette)",
    body: "Per baffetti, mento e basette valutiamo pelle, pelo e impostazioni prima di iniziare.",
  },
  {
    href: "/competenze/laser-barba-collo-carmagnola",
    title: "Laser uomo barba e collo",
    body: "Informazioni per chi vuole valutare barba e collo durante la prima visita.",
  },
  {
    href: "/competenze/peli-incarniti-laser-carmagnola",
    title: "Peli incarniti e laser",
    body: "Guida alla preparazione della zona e alla valutazione iniziale in caso di peli incarniti.",
  },
];

const seasonCards = [
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno: cosa valutare",
    body: "L'inverno può essere più semplice per alcune zone esposte, ma la scelta dipende da pelle, abitudini e calendario personale.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser ed esposizione solare",
    body: "Prima di ogni seduta controlliamo la pelle e ti spieghiamo quando procedere, quali precauzioni seguire o se è meglio riprogrammare.",
  },
];

const combos = [
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Laser corpo + manicure semipermanente",
    body: "Se vuoi abbinare laser e manicure, verifichiamo disponibilità, tempi e zone prima di fissare l'appuntamento.",
  },
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Laser viso + laminazione",
    body: "Se hai in programma il laser viso, valutiamo se la laminazione possa essere organizzata nello stesso giorno o vada distanziata.",
  },
  {
    href: "/protocolli/collagen-code",
    title: "Laser + Collagen Code",
    body: "Se ti interessa anche Collagen Code, verifichiamo zone, tempi e compatibilità prima di fissare gli appuntamenti.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/epilazione-laser-bra", desc: "~22 min da Carmagnola, a 20 km." },
  { city: "Canale", href: "/epilazione-laser-canale", desc: "Cuore del Roero, ~30 min." },
  { city: "Ceresole d'Alba", href: "/localita/ceresole-d-alba", desc: "Tra Langhe e Roero." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Laser — da Alba a Carmagnola"
    title="Epilazione laser per chi viene da Alba: un percorso che si _incastra_ nelle tue settimane."
    lead="Da Alba sono trenta minuti via A33. Da Rebel il laser si imposta come una cosa fatta bene: Lumina X1 Pro di THORY, comfort ICE Polar e un calendario costruito sulla tua agenda."
    bullets={["~30 min da Alba via A33", "Lumina X1 Pro · comfort ICE Polar", "Valutazione 30–40 min"]}
    meta={["~33 km da Alba", "Da 25,90 € a zona"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <!-- SEZIONE 1 — Perché chi vive ad Alba sceglie Rebel -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Un metodo, non una promessa"
        title="Perché chi vive ad Alba _viene fino a Carmagnola_."
        lead="Definiamo un calendario compatibile con i tuoi impegni, i periodi di esposizione solare e le zone che vuoi trattare."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — Tecnologia Ice Polar -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Comfort reale"
          title="Il comfort _ICE Polar_ accompagna la seduta."
          body="La percezione cambia da persona a persona e da zona a zona. Durante la valutazione verifichiamo se il trattamento è adatto e definiamo le impostazioni; ti spieghiamo anche il comfort ICE Polar."
          bullets={["Lumina X1 Pro di THORY · quattro lunghezze d’onda", "Ice Point Cooling a contatto in zaffiro", "Idoneità verificata in valutazione"]}
          cta={{ label: "Come funziona il comfort Ice Polar", href: "/epilazione-laser-ice-polar-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Alba a Rebel sono circa 33 chilometri. Il percorso più rapido è
            l'<strong>A33 in direzione Torino</strong>, uscita Marene, poi
            <strong>SP661 fino a Carmagnola</strong>: in condizioni normali si è in studio
            in trenta minuti. In alternativa, chi preferisce la statale, può seguire
            SP7 e SP661 (cinque minuti in più, paesaggio più rilassato fra le colline
            del Roero).
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, in centro a Carmagnola.
            possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Alba in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Alba a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Ottimizzare la giornata da fuori -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Una sola sosta"
        title="Se vieni da fuori: _più cose fatte bene_ in una visita."
        lead="Puoi prenotare solo il laser oppure chiedere di aggiungere un altro servizio. Prima confermiamo disponibilità, tempi e compatibilità."
      />
      <p class="body-p">
        Dicci quali servizi vorresti prenotare insieme. Se il laser interessa il viso,
        controlliamo con particolare attenzione zone e date per decidere se gli appuntamenti
        possano coincidere o vadano distanziati.
      </p>
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Zone più richieste -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Zone e guide"
        title="Da dove conviene partire: _zone richieste_ da chi viene da Alba."
        lead="Non esiste l'ordine giusto in assoluto, ma esiste l'ordine giusto per te. Per ogni zona trovi una guida pratica scritta per farti arrivare già preparata in consulenza."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Langhe -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Dalle Langhe a Carmagnola"
      quote="Il laser non deve fermare la tua vita. Deve incastrarsi dentro."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — Stagionalità nelle Langhe -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Stagionalità"
        title="Quando iniziare: contano _esposizione, abbronzatura e zona_."
        lead="Prima di iniziare valutiamo la pelle, le zone interessate e l'esposizione prevista. Se le condizioni cambiano, possiamo riprogrammare la seduta."
      />
      <div class="card-grid card-grid--2">
        {seasonCards.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 6 — Prezzi -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Prezzi"
        title="Quanto costa il laser da Rebel, _per chi viene da Alba_."
      />
      <p class="body-p">
        Il riferimento di partenza è <strong>25,90 € a zona</strong>. Il prezzo finale
        dipende da estensione e numero di zone. Durante la valutazione ricevi una proposta
        con trattamento, frequenza e prezzo. Nel listino completo trovi tutte le voci, comprese le aree
        ampie corpo, il laser uomo e i protocolli viso da affiancare.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/listino-estetica-laser">Listino completo</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-ice-polar-carmagnola">Comfort Ice Polar</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — La prima valutazione -->
  {m.splitB ? (
    <section class="section">
      <div class="container">
        <SplitFeature
          image={m.splitB}
          side="left"
          kicker="La prima volta"
          title="Prima un piano _scritto_, poi la prima seduta."
          body="La valutazione iniziale dura 30–40 minuti ed è gratuita se inizi il percorso. Osserviamo pelle, fototipo e zone e ti spieghiamo calendario e prezzi prima di decidere."
          bullets={["Gratuita se inizi il percorso", "Prezzi e tempi spiegati prima di iniziare", "Si paga seduta per seduta"]}
          cta={{ label: "Prenota la valutazione", href: "/contatti" }}
          ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 7 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Alba e dalle _Langhe_: le risposte oneste."
      />
      <FaqAccordion items={faqs} kicker="FAQ Laser Alba" />
    </div>
  </section>

  <!-- SEZIONE 8 — Oltre il laser -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Scopri gli altri servizi per chi arriva da _Alba_."
        lead="Trovi trattamenti viso e corpo, pulizia viso e massaggi disponibili per chi arriva da Alba."
        primaryHref="/localita/alba"
        primaryLabel="Scopri tutti i servizi da Alba"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i trattamenti viso e corpo"
      />
    </div>
  </section>

  <!-- SEZIONE 9 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino ad Alba"
        title="Comuni vicini: _pagine dedicate_."
        lead="Spesso chi vive ad Alba si muove anche tra Bra, Canale e i comuni del Roero."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione e analisi"
        title="Prenota la _valutazione laser_: 30–40 minuti."
        lead="Valutiamo zona e caratteristiche della pelle, poi ti spieghiamo trattamento, frequenza e prezzo. La valutazione dura 30–40 minuti."
        primaryLabel="Prenota la valutazione"
        primaryHref="/contatti"
        secondaryLabel="Scrivi su WhatsApp"
        secondaryHref={siteConfig.social.whatsapp}
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
