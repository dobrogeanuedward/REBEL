---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-bra");

const meta = createPageMeta({
  title: "Epilazione laser per chi viene da Bra — Rebel (Carmagnola, ~22 min)",
  description:
    "Da Bra a Rebel sono circa venti-ventidue minuti. Epilazione con Lumina X1 Pro di THORY, comfort ICE Polar, valutazione iniziale e calendario concordato.",
  path: "/epilazione-laser-bra",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/8d07afc2-b036-4eff-d34e-523a6c656d00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Bra",
    "laser Bra",
    "epilazione laser Roero",
    "centro laser Bra",
    "laser diodo Bra",
    "epilazione laser vicino Bra",
    "laser viso Bra",
    "laser corpo Bra",
    "laser ascelle Bra",
    "laser inguine Bra",
    "laser gambe Bra",
    "Rebel epilazione laser Bra",
    "epilazione laser Bra CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Bra", path: "/epilazione-laser-bra" },
]);

const webPage = buildWebPageSchema({
  name: "Epilazione laser per chi viene da Bra",
  description: meta.description,
  path: "/epilazione-laser-bra",
});

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser per chi viene da Bra — Rebel (Carmagnola, ~22 min)",
  description: meta.description,
  path: "/epilazione-laser-bra",
  keywords: [
    "epilazione laser Bra",
    "laser Bra",
    "epilazione laser Roero",
    "laser diodo Bra",
  ],
  section: "Laser",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/8d07afc2-b036-4eff-d34e-523a6c656d00/public",
});

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser per chi viene da Bra",
  "Percorso di epilazione laser per clienti provenienti da Bra: Lumina X1 Pro di THORY con comfort Ice Polar, valutazione iniziale e piano personalizzato.",
  "/epilazione-laser-bra",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Bra",
      "epilazione laser Roero",
      "laser Bra CN",
      "laser diodo Bra",
      "Ice Polar Bra",
    ],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-bra#service-geo`,
  name: "Epilazione laser per chi viene da Bra",
  serviceType: "Laser hair removal",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Bra",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Provincia di Cuneo",
      },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 44.6986,
        longitude: 7.8569,
      },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "25.90",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Da Bra, quanto tempo serve per arrivare a Rebel?",
    a: "Circa ventidue minuti via SP661, venti chilometri in totale. Lo studio è in Viale Barbaroux 20, in centro a Carmagnola, con possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Posso fare il laser anche in primavera o devo aspettare l'autunno?",
    a: "Dipende da esposizione, abbronzatura, zona e condizioni della pelle. Prima di ogni seduta controlliamo la zona e decidiamo se procedere o riprogrammare l'appuntamento.",
  },
  {
    q: "Ho già fatto la luce pulsata in casa per anni: serve a qualcosa il laser professionale adesso?",
    a: "IPL domestica e laser professionale sono tecnologie diverse. Durante la valutazione osserviamo pelle, pelo e zona per capire se il trattamento è adatto e spiegarti cosa aspettarti.",
  },
  {
    q: "Quante sedute servono in media?",
    a: "Il numero e gli intervalli variano in base a zona, pelle e caratteristiche del pelo. Dopo la valutazione ti diamo una stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Come vengono definite pagamento e frequenza?",
    a: "Le modalità di pagamento e la frequenza vengono spiegate durante la valutazione, in base alle zone da trattare.",
  },
  {
    q: "Posso fare laser + un altro trattamento nello stesso giorno?",
    a: "Sì, con criterio. Manicure semipermanente, scrub corpo, laminazione e massaggi si combinano bene. Pulizia viso e protocolli epigenetici sul viso vanno invece pianificati con un po' di distanza rispetto al laser viso. Lo decidiamo insieme.",
  },
  {
    q: "Come prenoto da Bra?",
    a: "Scrivici su WhatsApp indicando le zone di interesse e il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const principles = [
  {
    kicker: "01 · Da Bra a Carmagnola",
    title: "Circa venti-ventidue minuti via SP661.",
    body: "Da Bra raggiungi lo studio in circa venti-ventidue minuti. Gli intervalli vengono definiti in base alla zona e alla ricrescita osservata."
  },
  {
    kicker: "02 · Lumina X1 Pro · comfort ICE Polar",
    title: "La tecnologia usata durante la seduta.",
    body: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm e il raffreddamento a contatto in zaffiro Ice Point Cooling. Durante la valutazione ti spieghiamo impostazioni e comfort ICE Polar.",
  },
  {
    kicker: "03 · Piano scritto, non a voce",
    title: "Zone, calendario e prezzo spiegati prima di iniziare.",
    body: "Durante la valutazione definiamo le zone, una prima stima degli intervalli e il prezzo. Il calendario può cambiare in base alla ricrescita osservata.",
  },
  {
    kicker: "04 · Comunicazione vera",
    title: "Dubbi tra le sedute? Scrivici su WhatsApp.",
    body: "Dubbi su sole, sport, prodotti? Scrivici tra una seduta e l'altra. Rispondere in modo concreto è parte del metodo, non un servizio extra.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Piccola zona, grande ritorno quotidiano: spesso si parte da qui.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Informazioni su valutazione iniziale, preparazione e indicazioni tra le sedute per la zona inguine.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Informazioni su valutazione iniziale, intervalli e indicazioni tra le sedute per la zona gambe.",
  },
  {
    href: "/servizi/epilazione-laser-viso-carmagnola",
    title: "Laser viso baffetti e mento",
    body: "Per baffetti e mento valutiamo pelle, pelo e impostazioni prima di iniziare.",
  },
  {
    href: "/competenze/laser-barba-collo-carmagnola",
    title: "Laser uomo barba e collo",
    body: "Informazioni per chi vuole valutare barba e collo durante la prima visita.",
  },
  {
    href: "/competenze/peli-incarniti-laser-carmagnola",
    title: "Peli incarniti e laser",
    body: "Guida alla preparazione della zona e alla valutazione iniziale in caso di peli incarniti.",
  },
];

const seasonCards = [
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno: cosa valutare",
    body: "L'inverno può essere più semplice per alcune zone esposte, ma la scelta dipende da pelle, abitudini e calendario personale.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser e sole: cosa puoi fare davvero",
    body: "Come gestire esposizione solare, appuntamenti e indicazioni prima e dopo la seduta.",
  },
];

const combos = [
  {
    href: "/servizi/scrub-corpo-carmagnola",
    title: "Laser + scrub corpo",
    body: "Se vuoi abbinare laser e scrub corpo, verifichiamo zone e date prima di fissare gli appuntamenti.",
  },
  {
    href: "/servizi/massaggio-rilassante-carmagnola",
    title: "Laser + massaggio rilassante",
    body: "Se vuoi aggiungere un massaggio di 50 minuti, verifichiamo disponibilità e compatibilità prima dell'appuntamento.",
  },
  {
    href: "/protocolli/eye-genesis",
    title: "Laser + Eye Genesis",
    body: "Se ti interessa anche Eye Genesis, verifichiamo zone, tempi e compatibilità prima di fissare gli appuntamenti.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/epilazione-laser-alba", desc: "Capoluogo Langhe, ~30 min." },
  { city: "Canale", href: "/epilazione-laser-canale", desc: "Cuore del Roero, ~35 min." },
  { city: "Sommariva del Bosco", href: "/localita/sommariva-del-bosco", desc: "Tra Bra e Carmagnola." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Laser — da Bra a Carmagnola"
    title="Epilazione laser per chi viene da Bra: ventidue minuti di strada, un percorso _impostato con calma_."
    lead="Da Bra a Rebel sono circa venti-ventidue minuti via SP661. Dopo la valutazione definiamo zone, impostazioni e una prima stima degli intervalli con Lumina X1 Pro di THORY e comfort ICE Polar."
    bullets={["~22 min da Bra via SP661", "Lumina X1 Pro · comfort ICE Polar", "Valutazione 30–40 min"]}
    meta={["~20 km da Bra", "Da 25,90 € a zona"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <!-- SEZIONE 1 — La vicinanza che cambia il percorso -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino abbastanza"
        title="Vicino abbastanza da farne _una routine_, non un evento."
        lead="Da Bra raggiungi lo studio in circa venti-ventidue minuti. Dopo la valutazione definiamo gli intervalli in base alla zona e alla ricrescita osservata."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — Tecnologia Ice Polar -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Comfort reale"
          title="Il comfort _ICE Polar_ accompagna la seduta."
          body="La percezione cambia da persona a persona e da zona a zona. Durante la valutazione verifichiamo se il trattamento è adatto e definiamo le impostazioni; ti spieghiamo anche il comfort ICE Polar."
          bullets={["Lumina X1 Pro di THORY · quattro lunghezze d’onda", "Ice Point Cooling a contatto in zaffiro", "Idoneità verificata in valutazione"]}
          cta={{ label: "Come funziona il comfort Ice Polar", href: "/epilazione-laser-ice-polar-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Bra a Rebel: il tragitto _più rapido_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Bra a Carmagnola sono circa venti chilometri: la via più veloce è la
            <strong>SP661 (Strada di Cuneo)</strong> in direzione Sommariva del Bosco
            e Carmagnola, con tempo di percorrenza tra i ventidue e i venticinque
            minuti in condizioni di traffico normali. Se vieni dalla zona di Pollenzo
            o dal versante della Madonna dei Fiori, conviene la deviazione iniziale
            per la SP7.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro
            Carmagnola. possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Bra in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Bra&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Bra a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Ritmo del laser da Bra -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Frequenza"
        title="Come definiamo _gli intervalli tra le sedute_."
        lead="La frequenza non è uguale per tutte: dipende dalla zona e dalla ricrescita osservata durante il percorso."
      />
      <p class="body-p" style="max-width:70ch;">
        Dopo la valutazione proponiamo una prima stima del calendario. Gli intervalli vengono
        aggiornati in base alla zona e alla ricrescita osservata; prima di ogni appuntamento
        confermiamo anche le indicazioni su esposizione e preparazione.
      </p>
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Zone più richieste -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Zone e guide"
        title="Da Bra: le zone che ci vengono _chieste più spesso_."
        lead="Apri le guide per conoscere prezzi di partenza e informazioni sulle diverse zone prima della valutazione."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Bra/Roero -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Bra a Carmagnola"
      quote="Vicino abbastanza da farne una routine, non un evento."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — Stagionalità -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Quando partire"
        title="Quando iniziare: contano _esposizione, abbronzatura e zona_."
        lead="Prima di iniziare valutiamo la pelle, le zone interessate e l'esposizione prevista. Se le condizioni cambiano, possiamo riprogrammare la seduta."
      />
      <div class="card-grid card-grid--2">
        {seasonCards.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 6 — Prezzi -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Prezzi"
        title="Quanto costa il laser da Rebel, _per chi viene da Bra_."
      />
      <p class="body-p">
        Partiamo da <strong>25,90 € a zona</strong>. Il prezzo della singola seduta dipende
        dall'estensione dell'area: per le aree più piccole (baffetti, mento, ascelle) si resta
        vicini al riferimento di base; per gambe complete e aree ampie si sale, ma in modo
        trasparente. Durante la valutazione ricevi una proposta con trattamento, frequenza e prezzo.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/listino-estetica-laser">Listino completo</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-ice-polar-carmagnola">Comfort Ice Polar</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — La prima valutazione -->
  {m.splitB ? (
    <section class="section">
      <div class="container">
        <SplitFeature
          image={m.splitB}
          side="left"
          kicker="La prima volta"
          title="Prima un piano _scritto_, poi la prima seduta."
          body="La valutazione iniziale dura 30–40 minuti ed è gratuita se inizi il percorso. Osserviamo pelle, fototipo e zone e ti spieghiamo calendario e prezzi prima di decidere."
          bullets={["Gratuita se inizi il percorso", "Prezzi e tempi spiegati prima di iniziare", "Si paga seduta per seduta"]}
          cta={{ label: "Prenota la valutazione", href: "/contatti" }}
          ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 7 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Bra e dal _Roero_: le risposte oneste."
      />
      <FaqAccordion items={faqs} kicker="FAQ Laser Bra" />
    </div>
  </section>

  <!-- SEZIONE 8 — Oltre il laser -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Il laser non è l'unico motivo per venire a Carmagnola _da Bra_."
        lead="Trovi trattamenti viso e corpo, pulizia viso e massaggi disponibili per chi arriva da Bra."
        primaryHref="/localita/bra"
        primaryLabel="Scopri tutti i servizi da Bra"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i trattamenti viso e corpo"
      />
    </div>
  </section>

  <!-- SEZIONE 9 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino a Bra"
        title="Comuni vicini: _pagine dedicate_."
        lead="Chi vive a Bra si muove spesso tra Alba, Canale e Sommariva del Bosco."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione e analisi"
        title="Prenota la _valutazione laser_: 30–40 minuti."
        lead="Valutiamo zona e caratteristiche della pelle, poi ti spieghiamo trattamento, frequenza e prezzo. La valutazione dura 30–40 minuti."
        primaryLabel="Prenota la valutazione"
        primaryHref="/contatti"
        secondaryLabel="Scrivi su WhatsApp"
        secondaryHref={siteConfig.social.whatsapp}
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
