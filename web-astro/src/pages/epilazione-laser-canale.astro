---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-canale");

const meta = createPageMeta({
  title: "Epilazione laser per chi viene da Canale e dal Roero — Rebel (Carmagnola, ~35 min)",
  description:
    "Vivi a Canale o nel Roero? Da Rebel a Carmagnola trovi Lumina X1 Pro di THORY, comfort ICE Polar e un percorso impostato con calma. Prenotazione su WhatsApp.",
  path: "/epilazione-laser-canale",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/02c98ad7-1a83-4d09-0d43-9b3b2184ac00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Canale",
    "epilazione laser Canale d'Alba",
    "laser Canale",
    "epilazione laser Roero",
    "laser Roero",
    "centro laser Canale",
    "laser diodo Canale",
    "epilazione laser vicino Canale",
    "laser viso Canale",
    "laser corpo Canale",
    "laser uomo Canale",
    "Rebel epilazione laser Canale",
    "epilazione laser Canale CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Canale e Roero", path: "/epilazione-laser-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Epilazione laser per chi viene da Canale e dal Roero",
  description: meta.description,
  path: "/epilazione-laser-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser per chi viene da Canale e dal Roero — Rebel (Carmagnola)",
  description: meta.description,
  path: "/epilazione-laser-canale",
  keywords: [
    "epilazione laser Canale",
    "laser Roero",
    "epilazione laser Canale d'Alba",
    "laser diodo Canale",
  ],
  section: "Laser",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/02c98ad7-1a83-4d09-0d43-9b3b2184ac00/public",
});

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser per chi viene da Canale e dal Roero",
  "Percorso di epilazione laser per clienti provenienti da Canale d'Alba e dal Roero: Lumina X1 Pro di THORY con comfort Ice Polar, valutazione iniziale e piano personalizzato.",
  "/epilazione-laser-canale",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Canale",
      "epilazione laser Roero",
      "laser Canale d'Alba",
      "laser diodo Canale",
      "Ice Polar Canale",
    ],
  },
);

// Extra GeoCircle schema centred on Canale d'Alba
const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-canale#service-geo`,
  name: "Epilazione laser per chi viene da Canale",
  serviceType: "Laser hair removal",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Provincia di Cuneo",
      },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 44.7956,
        longitude: 8.0008,
      },
      geoRadius: "10000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "25.90",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Da Canale a Rebel, quanti minuti realmente?",
    a: "Tra trenta e trentacinque minuti via SP29 + SP661, trentadue chilometri totali. Da Castagnito, Santo Stefano Roero o Castellinaldo i tempi sono molto simili.",
  },
  {
    q: "Come viene impostato il percorso laser da Rebel?",
    a: "Usiamo Lumina X1 Pro di THORY con raffreddamento a contatto ICE Polar. Dopo la valutazione definiamo parametri, zone e calendario e li aggiorniamo in base alla risposta osservata.",
  },
  {
    q: "Posso iniziare il laser se mi espongo spesso al sole?",
    a: "Dipende da esposizione, abbronzatura, zona e condizioni della pelle. Prima di ogni seduta controlliamo la zona e decidiamo se procedere o riprogrammare l'appuntamento.",
  },
  {
    q: "Posso fare laser uomo barba e collo? Ho spesso irritazioni da rasoio.",
    a: "Barba e collo possono essere valutati durante la prima visita, osservando pelle, pelo e zona. Se l'irritazione è persistente o sospetti una follicolite, parlane prima con il medico.",
  },
  {
    q: "Si paga a seduta o serve un pacchetto?",
    a: "Le modalità di pagamento e la frequenza vengono spiegate durante la valutazione, in base alle zone da trattare.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero e gli intervalli variano in base a zona, pelle e caratteristiche del pelo. Dopo la valutazione ti diamo una stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Posso prenotare anche se vengo da Castagnito, Santo Stefano Roero o Priocca?",
    a: "Certo: per noi è la stessa area di gravitazione. Se vieni da uno di questi comuni, i tempi di percorrenza e il percorso (SP29 + SP661) sono praticamente identici a quelli di Canale.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando le zone di interesse e il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const principles = [
  {
    kicker: "01 · Scelta tecnica",
    title: "Lumina X1 Pro con raffreddamento a contatto.",
    body: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm e il raffreddamento a contatto in zaffiro Ice Point Cooling. Il comfort ICE Polar accompagna la seduta come elemento distinto.",
  },
  {
    kicker: "02 · Metodo, non preset",
    title: "Parametri su misura, piano scritto.",
    body: "Nessun protocollo standard copiato per tutti. Valutiamo zona, fototipo, abitudini (quanto sole, che sport, che lavoro). Da lì costruiamo il calendario con tempi reali e regole pratiche tra le sedute.",
  },
  {
    kicker: "03 · Esposizione e calendario",
    title: "Il calendario tiene conto delle tue abitudini.",
    body: "Ci racconti periodi di esposizione solare, viaggi e impegni già previsti; organizziamo gli appuntamenti tenendo conto della tua disponibilità e delle condizioni della pelle.",
  },
  {
    kicker: "04 · Comunicazione diretta",
    title: "WhatsApp, risposte vere.",
    body: "Dubbi tra una seduta e l'altra? Scrivici. Rispondere in modo concreto è parte del lavoro, non un servizio extra.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Piccola zona, grande ritorno quotidiano: spesso il punto di partenza più sensato.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Zona delicata ma molto richiesta: regole semplici, settaggio gentile, calendario disteso.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Superficie ampia: il piano va costruito, non improvvisato. Guida completa su sedute e mantenimento.",
  },
  {
    href: "/competenze/laser-barba-collo-carmagnola",
    title: "Laser uomo barba e collo",
    body: "Informazioni su barba e collo, preparazione della zona e valutazione iniziale. In caso di irritazione persistente, chiedi prima consiglio al medico.",
  },
  {
    href: "/competenze/laser-schiena-carmagnola",
    title: "Laser uomo schiena e torace",
    body: "Aree ampie maschili: strategia, calendario, mantenimento per zone difficili da gestire.",
  },
  {
    href: "/competenze/laser-e-palestra-sport-carmagnola",
    title: "Laser e vita attiva",
    body: "Sport, doccia, calore, sfregamenti: come comportarsi dopo la seduta senza paranoia.",
  },
];

const seasonCards = [
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno: perché conviene partire ora",
    body: "L'inverno può essere più semplice per le zone esposte, ma la scelta dipende da pelle, abitudini e calendario personale.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser ed esposizione solare",
    body: "Prima di ogni seduta controlliamo la pelle e ti spieghiamo quando procedere, quali precauzioni seguire o se è meglio riprogrammare.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/epilazione-laser-alba", desc: "Capoluogo Langhe, ~30 min." },
  { city: "Bra", href: "/epilazione-laser-bra", desc: "Porta del Roero, ~22 min da Carmagnola." },
  { city: "Ceresole d'Alba", href: "/localita/ceresole-d-alba", desc: "Pochi km da Canale." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Laser — da Canale (Roero) a Carmagnola"
    title="Epilazione laser per chi viene da Canale: _valutazione e calendario personalizzati_."
    lead="Da Canale puoi raggiungere REBEL in auto. Consulta Google Maps per percorso, traffico e tempi aggiornati; durante la valutazione definiamo zona, parametri e frequenza con Lumina X1 Pro di THORY e comfort ICE Polar."
    bullets={["~30-35 min via SP29 + SP661", "Lumina X1 Pro · comfort ICE Polar", "Valutazione 30–40 min"]}
    meta={["~32 km da Canale", "Da 25,90 € a zona"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <!-- SEZIONE 1 — Perché venire a Carmagnola dal Roero -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Perché Rebel"
        title="Come impostiamo il _percorso laser_."
        lead="Valutiamo pelle, pelo e zone, poi definiamo parametri, calendario e prezzo prima di iniziare."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="actions cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — Tecnologia Ice Polar -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Comfort reale"
          title="Il comfort _ICE Polar_ accompagna la seduta."
          body="La percezione cambia da persona a persona e da zona a zona. Il comfort ICE Polar accompagna il percorso, mentre la valutazione definisce parametri e pertinenza del trattamento."
          bullets={["Lumina X1 Pro di THORY · quattro lunghezze d’onda", "Ice Point Cooling a contatto in zaffiro", "Idoneità verificata in valutazione"]}
          cta={{ label: "Come funziona il comfort Ice Polar", href: "/epilazione-laser-ice-polar-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 2 — Come arrivare da Canale -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Canale a Rebel: trentacinque minuti _tra colline e pianura_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Canale a Carmagnola sono circa trentadue chilometri. Il tragitto più rapido
            segue la <strong>SP29 in direzione Bra</strong>, poi la <strong>SP661 verso
            Sommariva del Bosco e Carmagnola</strong>: trentacinque minuti scarsi in condizioni
            normali. Se vieni da Castagnito, Santo Stefano Roero o Castellinaldo, il punto
            di innesto sulla SP29 cambia ma il tempo totale resta simile.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro Carmagnola.
            Per indicazioni aggiornate su accesso e parcheggi, consulta Google Maps prima di partire.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Canale in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Canale d'Alba a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Vita outdoor e laser: non un conflitto -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Esposizione e laser"
        title="Prima di ogni seduta _controlliamo la pelle_."
        lead="Esposizione, abbronzatura, zona e condizioni della pelle determinano se possiamo procedere o se è meglio riprogrammare."
      />
      <div class="body-flow">
        <p class="body-p">
          Durante la valutazione ti chiediamo quanto ti esponi al sole, in quali periodi e su
          quali zone. Queste informazioni ci aiutano a scegliere da dove iniziare e a organizzare
          il calendario.
        </p>
        <p class="body-p">
          Prima di ogni appuntamento controlliamo la pelle. Se abbronzatura o esposizione recente
          rendono la seduta non opportuna, la riprogrammiamo e ti spieghiamo le precauzioni da seguire.
        </p>
      </div>
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Linfodrenante"
          body="Quando vuoi anche alleggerire la sensazione di pesantezza alle gambe tra una seduta e l'altra."
          href="/servizi/massaggio-linfodrenante-carmagnola"
          variant="quiet"
        />
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Pulizia viso"
          body="Due servizi da organizzare insieme solo dopo aver verificato zone, tempi e compatibilità."
          href="/servizi/pulizia-viso-carmagnola"
          variant="quiet"
        />
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Collagen Code"
          body="Quando vuoi alzare il livello e lavorare anche sul tono cutaneo, oltre all'epilazione."
          href="/protocolli/collagen-code"
          variant="quiet"
        />
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Zone più richieste -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Zone e guide"
        title="Da Canale: le zone su cui _lavoriamo più spesso_."
        lead="Aprire tutto insieme non è mai la strategia giusta. Qui trovi le zone più richieste con le guide pratiche — leggile prima della consulenza, ti fanno arrivare già preparata."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Roero -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Dal Roero a Carmagnola"
      quote="Il laser va impostato sulla tua vita, non la tua vita sul laser."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — Stagionalità -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Calendario"
        title="Quando iniziare: contano _esposizione, abbronzatura e zona_."
        lead="Prima di iniziare valutiamo la pelle, le zone interessate e l'esposizione prevista. Se le condizioni cambiano, possiamo riprogrammare la seduta."
      />
      <div class="card-grid card-grid--2">
        {seasonCards.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 6 — Prezzi -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Prezzi"
        title="Costo del laser da Rebel, per chi viene _dal Roero_."
      />
      <p class="body-p">
        Riferimento di partenza <strong>25,90 € a zona</strong>. Il totale dipende da
        estensione dell'area e numero di sedute. Durante la valutazione ricevi una proposta
        con trattamento, frequenza e prezzo. Tutte le voci del listino — laser corpo, laser
        viso, laser uomo, protocolli viso da affiancare — sono pubbliche.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/listino-estetica-laser">Listino completo</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-ice-polar-carmagnola">Comfort Ice Polar</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — La prima valutazione -->
  {m.splitB ? (
    <section class="section">
      <div class="container">
        <SplitFeature
          image={m.splitB}
          side="left"
          kicker="La prima volta"
          title="Prima un piano _scritto_, poi la prima seduta."
          body="Valutazione e analisi durano 30–40 minuti e sono gratuite quando finalizzate alla costruzione del Percorso. Osserviamo pelle, fototipo e zone e prepariamo una proposta con calendario e prezzi."
          bullets={["Gratuita se inizi il Percorso", "Prezzi e tempi spiegati prima di iniziare", "Si paga seduta per seduta"]}
          cta={{ label: "Prenota la valutazione", href: "/contatti" }}
          ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 7 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Canale, Castagnito, Santo Stefano Roero e dintorni: _le risposte_.">
      </SectionHead>
      <FaqAccordion items={faqs} kicker="FAQ Laser Canale" />
    </div>
  </section>

  <!-- SEZIONE 8 — Oltre il laser -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi anche viso, corpo o protocolli?"
        title="Scopri gli altri servizi per chi arriva da _Canale_."
        lead="Trovi trattamenti viso e corpo, pulizia viso e massaggi disponibili per chi arriva da Canale."
        primaryHref="/localita/canale"
        primaryLabel="Scopri tutti i servizi da Canale"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i trattamenti viso e corpo"
      />
    </div>
  </section>

  <!-- SEZIONE 9 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Roero e dintorni"
        title="Comuni vicini a _Canale_: pagine dedicate."
        lead="Apri le pagine dedicate per trovare mappe e indicazioni dai comuni vicini."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione e analisi"
        title="Prenota la _valutazione laser_: 30–40 minuti."
        lead="Valutiamo zona e caratteristiche della pelle, poi ti spieghiamo trattamento, frequenza e prezzo. La valutazione dura 30–40 minuti."
        primaryLabel="Prenota la valutazione"
        primaryHref="/contatti"
        secondaryLabel="Scrivi su WhatsApp"
        secondaryHref={siteConfig.social.whatsapp}
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .body-flow { display: grid; gap: 0.25rem; }
