---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-canale");

const meta = createPageMeta({
  title: "Epilazione laser da Canale e Roero | REBEL Carmagnola",
  description:
    "Epilazione laser per chi arriva da Canale e dal Roero: valutazione iniziale, Lumina X1 Pro di THORY, ICE Polar e prezzi da 25,90 € a zona.",
  path: "/epilazione-laser-canale",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/02c98ad7-1a83-4d09-0d43-9b3b2184ac00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Canale",
    "epilazione laser Canale d’Alba",
    "laser Canale",
    "epilazione laser Roero",
    "laser Roero",
    "centro laser Canale",
    "laser diodo Canale",
    "epilazione laser vicino Canale",
    "laser viso Canale",
    "laser corpo Canale",
    "laser uomo Canale",
    "REBEL epilazione laser Canale",
    "epilazione laser Canale CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Canale e Roero", path: "/epilazione-laser-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Epilazione laser per chi arriva da Canale e dal Roero",
  description: meta.description,
  path: "/epilazione-laser-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser per chi arriva da Canale e dal Roero — REBEL Carmagnola",
  description: meta.description,
  path: "/epilazione-laser-canale",
  keywords: [
    "epilazione laser Canale",
    "laser Roero",
    "epilazione laser Canale d’Alba",
    "laser diodo Canale",
  ],
  section: "Laser",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/02c98ad7-1a83-4d09-0d43-9b3b2184ac00/public",
});

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser per chi arriva da Canale e dal Roero",
  "Epilazione laser viso e corpo presso REBEL a Carmagnola, con valutazione iniziale, Lumina X1 Pro di THORY e raffreddamento ICE Polar.",
  "/epilazione-laser-canale",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Canale",
      "epilazione laser Roero",
      "laser Canale d’Alba",
      "laser diodo Canale",
      "ICE Polar Canale",
    ],
  },
);

// Extra GeoCircle schema centred on Canale d’Alba
const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-canale#service-geo`,
  name: "Epilazione laser per chi arriva da Canale",
  serviceType: "Epilazione laser",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Provincia di Cuneo",
      },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 44.7956,
        longitude: 8.0008,
      },
      geoRadius: "10000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "25.90",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Dove si trova REBEL rispetto a Canale?",
    a: "Lo studio è in Viale Barbaroux 20, a Carmagnola. Usa il collegamento a Google Maps presente nella pagina per verificare il percorso e il traffico al momento della partenza.",
  },
  {
    q: "Come viene impostato il percorso laser da REBEL?",
    a: "Usiamo Lumina X1 Pro di THORY con raffreddamento a contatto ICE Polar. Dopo la valutazione definiamo parametri, zone e calendario e li aggiorniamo in base alla ricrescita osservata.",
  },
  {
    q: "Posso iniziare il laser se mi espongo spesso al sole?",
    a: "Dipende da esposizione, abbronzatura, zona e condizioni della pelle. Prima della seduta valutiamo l’area e decidiamo se procedere o riprogrammare l’appuntamento.",
  },
  {
    q: "Posso fare laser uomo barba e collo? Ho spesso irritazioni da rasoio.",
    a: "Barba e collo possono essere valutati durante la prima visita, osservando pelle, pelo e zona. Se l’irritazione è persistente o sospetti una follicolite, parlane prima con il medico.",
  },
  {
    q: "Quanto costa la valutazione?",
    a: "Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero e gli intervalli variano in base a zona, pelle e caratteristiche del pelo. Dopo la valutazione ti diamo una stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Posso prenotare anche se vengo da Castagnito, Santo Stefano Roero o Priocca?",
    a: "Sì. Puoi prenotare tramite il modulo contatti o WhatsApp e usare Google Maps per verificare il percorso dal tuo comune al momento della partenza.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando le zone di interesse e il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const principles = [
  {
    kicker: "01 · Valutazione iniziale",
    title: "Pelle, pelo e zone da trattare.",
    body: "Valutiamo fototipo, caratteristiche del pelo, zone ed esposizione solare. Queste informazioni servono a definire parametri e calendario iniziali.",
  },
  {
    kicker: "02 · Lumina X1 Pro · ICE Polar",
    title: "Tecnologia e raffreddamento a contatto.",
    body: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm. ICE Polar utilizza il raffreddamento a contatto in zaffiro Ice Point Cooling durante la seduta.",
  },
  {
    kicker: "03 · Calendario",
    title: "Intervalli definiti dopo la valutazione.",
    body: "Proponiamo una prima stima degli intervalli e la aggiorniamo in base alla zona e alla ricrescita osservata.",
  },
  {
    kicker: "04 · Contatti",
    title: "Assistenza tra gli appuntamenti.",
    body: "Per dubbi su preparazione, sole o prodotti puoi contattarci su WhatsApp prima dell’appuntamento successivo.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Informazioni su valutazione iniziale, preparazione e indicazioni tra le sedute per la zona ascelle.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Informazioni su valutazione iniziale, preparazione e indicazioni tra le sedute per la zona inguine.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Informazioni su valutazione iniziale, intervalli e indicazioni tra le sedute per la zona gambe.",
  },
  {
    href: "/competenze/laser-barba-collo-carmagnola",
    title: "Laser uomo barba e collo",
    body: "Informazioni su barba e collo, preparazione della zona e valutazione iniziale. In caso di irritazione persistente, chiedi prima consiglio al medico.",
  },
  {
    href: "/competenze/laser-schiena-carmagnola",
    title: "Laser uomo schiena e torace",
    body: "Informazioni su valutazione iniziale, intervalli e indicazioni per schiena e torace.",
  },
  {
    href: "/competenze/laser-e-palestra-sport-carmagnola",
    title: "Laser e vita attiva",
    body: "Indicazioni su sport, doccia, calore e sfregamenti prima e dopo la seduta.",
  },
];

const seasonCards = [
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno: cosa valutare",
    body: "Come organizzare il calendario in inverno e aggiornarlo quando aumenta l’esposizione solare.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser ed esposizione solare",
    body: "Come comunicare esposizione e abbronzatura e quando può essere necessario riprogrammare la seduta.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/epilazione-laser-alba", desc: "Epilazione laser per chi arriva da Alba." },
  { city: "Bra", href: "/epilazione-laser-bra", desc: "Epilazione laser per chi arriva da Bra." },
  { city: "Ceresole d’Alba", href: "/localita/ceresole-d-alba", desc: "Servizi e contatti per chi arriva da Ceresole d’Alba." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Epilazione laser · REBEL Carmagnola"
    title="Epilazione laser per chi arriva da _Canale_."
    lead="Valutiamo pelle, pelo e zone prima di definire parametri, intervalli e prezzo. Utilizziamo Lumina X1 Pro di THORY con raffreddamento ICE Polar."
    bullets={["Studio in Viale Barbaroux 20, Carmagnola", "Lumina X1 Pro · ICE Polar", "Valutazione prima del percorso"]}
    meta={["Epilazione laser viso e corpo", "Da 25,90 € a zona"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <!-- SEZIONE 1 — Il percorso -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il Percorso REBEL"
        title="Come impostiamo il _percorso laser_."
        lead="Valutazione iniziale, parametri, calendario e prezzo vengono spiegati prima di iniziare."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="actions cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — Tecnologia ICE Polar -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Raffreddamento a contatto"
          title="Lumina X1 Pro con _ICE Polar_."
          body="La sensibilità varia tra persone e zone. ICE Polar utilizza Ice Point Cooling a contatto in zaffiro durante la seduta; parametri e modalità vengono definiti dopo la valutazione."
          bullets={["Lumina X1 Pro di THORY", "755, 808, 940 e 1064 nm", "Ice Point Cooling a contatto in zaffiro"]}
          cta={{ label: "Scopri ICE Polar", href: "/epilazione-laser-ice-polar-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 2 — Come arrivare da Canale -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Come raggiungere REBEL da _Canale_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            REBEL si trova in <strong>Viale Barbaroux 20, a Carmagnola</strong>.
          </p>
          <p class="body-p">
            Apri Google Maps per verificare il percorso da Canale, il traffico e i tempi
            aggiornati prima di partire.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Canale in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Indicazioni da Canale a REBEL Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Esposizione e servizi abbinabili -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Esposizione e laser"
        title="Prima della seduta _valutiamo la pelle_."
        lead="Esposizione, abbronzatura, zona e condizioni della pelle aiutano a decidere se procedere o riprogrammare."
      />
      <div class="body-flow">
        <p class="body-p">
          Durante la valutazione ti chiediamo quanto ti esponi al sole, in quali periodi e su
          quali zone. Queste informazioni ci aiutano a scegliere da dove iniziare e a organizzare
          il calendario.
        </p>
        <p class="body-p">
          Prima dell’appuntamento valutiamo la pelle. In base ad abbronzatura ed esposizione
          recente, decidiamo se procedere o riprogrammare e condividiamo le indicazioni da seguire.
        </p>
      </div>
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Linfodrenante"
          body="Se vuoi aggiungere il massaggio linfodrenante, verifichiamo zone, tempi e compatibilità prima degli appuntamenti."
          href="/servizi/massaggio-linfodrenante-carmagnola"
          variant="quiet"
        />
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Pulizia viso"
          body="Due servizi da organizzare insieme solo dopo aver verificato zone, tempi e compatibilità."
          href="/servizi/pulizia-viso-carmagnola"
          variant="quiet"
        />
        <FeatureCard
          kicker="Abbinamento"
          title="Laser + Collagen Code"
          body="Se ti interessa anche Collagen Code, verifichiamo zone, tempi e compatibilità prima degli appuntamenti."
          href="/protocolli/collagen-code"
          variant="quiet"
        />
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Zone più richieste -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Zone e guide"
        title="Guide per scegliere le _zone da trattare_."
        lead="Consulta le informazioni su valutazione, preparazione e indicazioni tra le sedute per ciascuna zona."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Epilazione laser a Carmagnola"
      quote="Zone, calendario e prezzo vengono definiti prima di iniziare."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — Stagionalità -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Stagionalità"
        title="Quando iniziare: contano _esposizione, abbronzatura e zona_."
        lead="Prima di iniziare valutiamo la pelle, le zone interessate e l’esposizione prevista. Se le condizioni cambiano, valutiamo se riprogrammare la seduta."
      />
      <div class="card-grid card-grid--2">
        {seasonCards.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 6 — Prezzi -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Prezzi"
        title="Prezzi dell’epilazione _laser_."
      />
      <p class="body-p">
        Il prezzo parte da <strong>25,90 € a zona</strong> e varia in base all’estensione e
        alle aree scelte. Durante la valutazione ricevi una proposta con trattamento,
        frequenza e prezzo. Consulta il listino completo per tutte le voci.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/listino-estetica-laser">Listino completo</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Scopri il percorso laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-ice-polar-carmagnola">ICE Polar</a>
      </div>
    </div>
  </section>

  <!-- SPLIT — La prima valutazione -->
  {m.splitB ? (
    <section class="section">
      <div class="container">
        <SplitFeature
          image={m.splitB}
          side="left"
          kicker="Valutazione iniziale"
          title="Zone, calendario e _prezzo_."
          body="Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi. Durante la valutazione esaminiamo pelle, pelo e zone e ti spieghiamo parametri, calendario e prezzo."
          bullets={["Pelle, pelo e zone valutati prima di iniziare", "Calendario e prezzo spiegati durante la valutazione", "Eventuali prodotti per casa non inclusi"]}
          cta={{ label: "Prenota la valutazione", href: "/contatti" }}
          ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 7 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Domande sull’_epilazione laser_.">
      </SectionHead>
      <FaqAccordion items={faqs} kicker="FAQ Laser Canale" />
    </div>
  </section>

  <!-- SEZIONE 8 — Oltre il laser -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Altri servizi REBEL"
        title="Trattamenti viso e corpo per chi arriva da _Canale_."
        lead="Consulta i trattamenti viso e corpo disponibili nello studio REBEL di Carmagnola."
        primaryHref="/localita/canale"
        primaryLabel="Scopri tutti i servizi da Canale"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i trattamenti viso e corpo"
      />
    </div>
  </section>

  <!-- SEZIONE 9 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Altre località"
        title="Epilazione laser e servizi nelle _zone vicine_."
        lead="Consulta le informazioni per chi arriva da Alba, Bra e Ceresole d’Alba."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Località"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione iniziale"
        title="Prenota la _valutazione laser_."
        lead="Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
        primaryLabel="Prenota la valutazione"
        primaryHref="/contatti"
        secondaryLabel="Scrivici su WhatsApp"
        secondaryHref={siteConfig.social.whatsapp}
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Epilazione laser da 25,90 € a zona" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .body-flow { display: grid; gap: 0.25rem; }
  .actions { margin-top: 2rem; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
