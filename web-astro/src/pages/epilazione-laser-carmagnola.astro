---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import LaserHub from "@/components/LaserHub.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";
import { laserOffer } from "@/lib/laser-offer";

const m = getPageMedia("/epilazione-laser-carmagnola");

const meta = createPageMeta({
  title: "Epilazione laser ICE Polar a Carmagnola — Viso e corpo",
  description:
    "Epilazione laser con ICE Polar a Carmagnola per viso e corpo. Lumina X1 Pro di THORY, listino ordinario da €25,90 e valutazione REBEL di 30–40 minuti.",
  path: "/epilazione-laser-carmagnola",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Carmagnola",
    "epilazione laser vicino a me",
    "epilazione laser vicino a me Carmagnola",
    "laser vicino a me",
    "depilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "ICE Polar Carmagnola",
    "epilazione laser ascelle Carmagnola",
    "epilazione laser inguine Carmagnola",
    "epilazione laser gambe Carmagnola",
    "epilazione laser uomo Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "epilazione laser Carignano",
    "epilazione laser Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
]);

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser con ICE Polar a Carmagnola",
  "Epilazione laser viso e corpo con Lumina X1 Pro di THORY, quattro lunghezze d’onda, comfort ICE Polar, valutazione iniziale e calendario specifico per ogni zona.",
  "/epilazione-laser-carmagnola",
  {
    keywords: [
      "epilazione laser Carmagnola",
      "epilazione laser vicino a me",
      "laser diodo Carmagnola",
      "ICE Polar Carmagnola",
      "epilazione laser ascelle vicino a me",
      "epilazione laser inguine vicino a me",
      "epilazione laser gambe vicino a me",
      "depilazione laser Carmagnola",
    ],
  },
);

const faqs = [
  {
    q: "Quanto costa l’epilazione laser da Rebel a Carmagnola?",
    a: "Fuori dalla promozione, il prezzo ordinario parte da €25,90 per una singola zona e cambia in base all’estensione. Nel listino online trovi i prezzi per viso e corpo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero varia in base a zona, pelle, caratteristiche del pelo e andamento osservato durante gli appuntamenti. Dopo la valutazione ti diamo una prima stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Il trattamento è doloroso?",
    a: "ICE Polar raffredda la pelle a contatto durante la seduta. La sensazione cambia in base alla zona e alla sensibilità personale; per questo impostiamo i parametri dopo la valutazione e ti chiediamo come li percepisci durante il trattamento.",
  },
  {
    q: "Funziona su tutti i tipi di pelo?",
    a: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm. La possibilità di trattare il pelo dipende da pelle, zona e caratteristiche del pelo; lo valutiamo prima di iniziare.",
  },
  {
    q: "Si può fare in estate o sulla pelle abbronzata?",
    a: "La possibilità dipende dal livello di abbronzatura, dalla zona e dall’esposizione prevista. Prima della seduta controlliamo la pelle e ti indichiamo le precauzioni da seguire prima e dopo il trattamento.",
  },
  {
    q: "Come prenoto la valutazione?",
    a: "Scrivi su WhatsApp o compila il modulo nella pagina contatti. In 30–40 minuti valutiamo pelle, pelo e zone, poi ti spieghiamo parametri, calendario e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localLandingSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#webpage`,
  url: `${siteConfig.siteUrl}/epilazione-laser-carmagnola`,
  name: "Epilazione laser con ICE Polar a Carmagnola",
  description:
    "Prezzi, zone, tecnologia, comfort e prenotazione della valutazione per l’epilazione laser viso e corpo da Rebel a Carmagnola.",
  inLanguage: "it-IT",
  about: [
    "epilazione laser Carmagnola",
    "laser viso Carmagnola",
    "laser corpo Carmagnola",
    "centro estetico Carmagnola",
  ],
  isPartOf: { "@id": `${siteConfig.siteUrl}/#website` },
  mainEntity: {
    "@type": "Service",
    "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#service`,
    name: "Epilazione Laser Ice Polar a Carmagnola",
    provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  },
};
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-laser">
  <JsonLd data={breadcrumb} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={localLandingSchema} />

  <PageHero
    image={m.hero}
    imageCaption="Il trattamento laser, illustrato."
    imagePosition="59% 50%"
    kicker="Epilazione laser · Carmagnola"
    title="Epilazione laser. La tua _libertà._"
    lead="Epilazione laser viso e corpo, donna e uomo. Tecnologia Lumina X1 Pro di THORY e raffreddamento a contatto ICE Polar: il percorso comincia da te."
    bullets={["Viso e corpo · Donna e uomo", "Valutazione REBEL · 30–40 min"]}
    meta={["Lumina X1 Pro · ICE Polar", "Viale Barbaroux 20, Carmagnola"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Esplora zone e prezzi", href: "#laser-zone" }}
  />

  <LaserHub />

  <section class="section laser-faq-section" id="laser-faq">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Scegli con _più chiarezza_."
        lead="Prezzi, numero di sedute, comfort, fototipo e sole: le risposte prima del tuo appuntamento."
      />
      <FaqAccordion items={faqs} kicker="Domande sul laser" />
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Epilazione laser"
    kicker="Epilazione laser vicino a te"
    anchorPattern={(s, c) => `${s} per chi viene da ${c}`}
    clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
    limit={14}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione laser · 30–40 minuti"
        title="La libertà di _cominciare_."
        lead="Valutiamo pelle, pelo e zone e ti spieghiamo parametri, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita."
        primaryLabel="Prenota la valutazione laser"
      />
    </div>
  </section>

  <StickyBookingBar promo priceHint={laserOffer.stickyLabel} primary={{ label: "Richiedi la promo", href: laserOffer.contactPath }} />
</BaseLayout>

<style>
  .laser-faq-section{background:#fff;scroll-margin-top:6rem}
</style>
