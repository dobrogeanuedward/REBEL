---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-carmagnola");

const meta = createPageMeta({
  title: "Epilazione Laser a Carmagnola (vicino a te) — Diodo Ice Polar | Rebel",
  description:
    "Epilazione laser a Carmagnola con diodo Thory e manipolo Ice Polar: ascelle, inguine, gambe, viso, uomo. Valutazione gratuita, prezzi chiari da 25,90 €. Anche da Carignano, Racconigi e Torino Sud.",
  path: "/epilazione-laser-carmagnola",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Carmagnola",
    "epilazione laser vicino a me",
    "epilazione laser vicino a me Carmagnola",
    "laser vicino a me",
    "depilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "Ice Polar Carmagnola",
    "epilazione laser ascelle Carmagnola",
    "epilazione laser inguine Carmagnola",
    "epilazione laser gambe Carmagnola",
    "epilazione laser uomo Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "epilazione laser Carignano",
    "epilazione laser Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
]);

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser a Carmagnola",
  "Percorso di epilazione laser a Carmagnola con tecnologia Thory, valutazione iniziale e piano personalizzato per viso e corpo.",
  "/epilazione-laser-carmagnola",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Carmagnola",
      "epilazione laser vicino a me",
      "laser diodo Carmagnola",
      "Ice Polar Carmagnola",
      "epilazione laser ascelle vicino a me",
      "epilazione laser inguine vicino a me",
      "epilazione laser gambe vicino a me",
      "depilazione laser Carmagnola",
    ],
  },
);

const faqs = [
  {
    q: "Quanto costa l'epilazione laser da Rebel a Carmagnola?",
    a: "I prezzi partono da 25,90 € per area piccola (es. baffetti) e crescono in base alla zona. Il listino completo è sempre online: ascelle, inguine, gambe, schiena, viso, sia donna che uomo. La valutazione iniziale è gratuita.",
  },
  {
    q: "Quante sedute servono per vedere risultati?",
    a: "In media servono 6-10 sedute, distanziate in base alla zona e al ciclo del pelo. Già dopo 2-3 sedute la ricrescita risulta più lenta e il pelo più sottile. Definiamo il calendario in prima visita, gratuitamente.",
  },
  {
    q: "L'epilazione laser fa male?",
    a: "Il manipolo Ice Polar raffredda la pelle in tempo reale, rendendo la seduta sopportabile anche su zone sensibili come ascelle, inguine e baffetti. Non è una carezza, ma è molto più comodo dei laser tradizionali.",
  },
  {
    q: "Funziona anche su pelle scura o pelo chiaro?",
    a: "Il diodo Thory lavora con tre lunghezze d'onda combinate, quindi è efficace su una gamma ampia di fototipi. Sui peli molto chiari (biondi/grigi) il laser ha sempre limiti: te lo diciamo in valutazione, senza vendere illusioni.",
  },
  {
    q: "Si può fare laser d'estate o se sono abbronzata?",
    a: "Si lavora con parametri più cauti su pelle abbronzata e si evita esposizione solare diretta nelle 48 ore prima e dopo. In estate continuiamo con zone non esposte (ascelle, inguine) e riprendiamo le altre quando l'abbronzatura cala.",
  },
  {
    q: "Come prenoto la valutazione gratuita?",
    a: "Scrivici su WhatsApp o compila il form in pagina contatti. Ti rispondiamo entro poche ore con un orario disponibile. La valutazione dura 15 minuti e non c'è obbligo di acquisto.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localLandingSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#webpage`,
  url: `${siteConfig.siteUrl}/epilazione-laser-carmagnola`,
  name: "Epilazione laser a Carmagnola",
  description:
    "Pagina dedicata all'epilazione laser a Carmagnola con percorso personalizzato, comfort evoluto e progressione visibile.",
  inLanguage: "it-IT",
  about: [
    "epilazione laser Carmagnola",
    "laser viso Carmagnola",
    "laser corpo Carmagnola",
    "centro estetico Carmagnola",
  ],
  isPartOf: { "@id": `${siteConfig.siteUrl}/#website` },
  mainEntity: {
    "@type": "Service",
    "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#service`,
    name: "Epilazione laser a Carmagnola",
    provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  },
};

const principles = [
  {
    kicker: "01 · Valutazione gratuita",
    title: "Si parte dalla pelle, non dal pacchetto.",
    body: "In 15 minuti leggiamo zona, fototipo, fase del ciclo del pelo. Da lì costruiamo un piano sensato e ti diciamo prezzi e tempi reali.",
  },
  {
    kicker: "02 · Tecnologia Thory",
    title: "Diodo a tre lunghezze d'onda.",
    body: "755 + 808 + 1064 nm combinati: efficacia su una gamma ampia di fototipi e tipologie di pelo. Non un laser \"universale\" generico.",
  },
  {
    kicker: "03 · Manipolo Ice Polar",
    title: "Raffreddamento attivo durante l'impulso.",
    body: "La pelle viene raffreddata in tempo reale: la seduta resta comoda anche su ascelle, inguine e baffetti. Non zero dolore — molto meno dolore.",
  },
  {
    kicker: "04 · Calendario reale",
    title: "Sedute distanziate sul tuo ciclo.",
    body: "Niente \"vieni ogni 30 giorni\" standard: la cadenza segue zona e velocità di ricrescita. Risultato progressivo, non illusione di seduta singola.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Sedute, comfort, prezzi e ogni quanto rifarlo. La zona da cui parte la maggior parte delle clienti.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Zona delicata: come si lavora, cosa aspettarsi, come gestire il post-seduta in totale serenità.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Stagionalità, numero sedute realistico e mantenimento per gambe lisce a lungo.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser & sole",
    body: "Cosa fare prima e dopo l'esposizione, quali zone si possono trattare anche d'estate.",
  },
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno",
    body: "Il periodo migliore per partire: pelle non abbronzata, zero stop, risultati pronti per la primavera.",
  },
  {
    href: "/competenze/laser-e-palestra-sport-carmagnola",
    title: "Laser & palestra",
    body: "Sport, doccia, sudore: cosa fare nelle 24-48 ore dopo la seduta per non vanificare la resa.",
  },
];

const zoneShortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/servizi/epilazione-laser-viso-uomo-carmagnola", label: "Laser viso uomo" },
  { href: "/servizi/epilazione-laser-corpo-uomo-carmagnola", label: "Laser corpo uomo" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Guida laser uomo" },
  { href: "/competenze/peli-incarniti-laser-carmagnola", label: "Peli incarniti" },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={localLandingSchema} />

  <PageHero
    image={m.hero}
    kicker="Epilazione laser · Carmagnola"
    title="Epilazione laser a Carmagnola con _Ice Polar_."
    lead="Diodo Thory a tre lunghezze d'onda con raffreddamento attivo: efficace su una gamma ampia di pelli e peli, e molto più comodo dei laser tradizionali. Valutazione iniziale gratuita."
    bullets={["Comfort reale con manipolo Ice Polar", "Prezzi chiari da 25,90 €", "Valutazione iniziale gratuita"]}
    meta={["Diodo Thory · Ice Polar", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Listino & prezzi", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come funziona"
        title="Quattro cose che fanno la _differenza_ vera."
        lead="Senza tecnicismi: ecco cosa cambia tra una seduta laser fatta come si deve e una fatta a caso."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="laser-spotlight">
        <figure class="laser-spotlight__media">
          <img
            src="https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public"
            alt="Epilazione laser corpo in cabina Rebel a Carmagnola"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="laser-spotlight__body">
          <p class="kicker">Viso, corpo, donna & uomo</p>
          <h2 class="laser-spotlight__title">Apri direttamente la zona che ti interessa.</h2>
          <p class="laser-spotlight__lead">
            Per ogni zona trovi durata, comfort e prezzo. Senza preventivi opachi e senza chiamate "per sapere quanto costa".
          </p>
          <div class="laser-spotlight__cluster">
            {zoneShortcuts.map((z) => (
              <a class="btn btn--secondary btn--sm" href={z.href}>{z.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Guide pratiche"
        title="Tutto quello che serve _sapere prima_."
        lead="Stagionalità, sport, sole, peli incarniti: risposte concrete alle domande più frequenti, scritte da chi lo fa in cabina."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="In cabina, a Carmagnola"
      quote="Efficace senza farti stringere i denti: è questo il punto."
      cta={{ label: "Prenota la valutazione gratuita", href: "/contatti" }}
    />
  ) : null}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Le _domande_ che ci fate più spesso."
      />
      <FaqAccordion items={faqs} kicker="FAQ Laser" />
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Epilazione laser"
    kicker="Epilazione laser vicino a te"
    anchorPattern={(s, c) => `${s} per chi viene da ${c}`}
    clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
    limit={14}
    hrefOverrides={{
      alba: "/epilazione-laser-alba",
      bra: "/epilazione-laser-bra",
      canale: "/epilazione-laser-canale",
      racconigi: "/epilazione-laser-racconigi",
    }}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Prenota la _valutazione laser_, in 15 minuti."
        lead="Capiamo zona, ciclo e calendario reale. Ti consegniamo una proposta scritta con prezzi e tempi. Senza obbligo di acquisto."
        primaryLabel="Prenota la valutazione gratuita"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Valutazione gratuita", href: "/contatti" }} />
</BaseLayout>

<style>
  .laser-spotlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;
    align-items: stretch;
    padding: 2rem;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.7), rgba(20, 16, 42, 0.95));
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .laser-spotlight::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60%;
    height: 60%;
    background: radial-gradient(closest-side, rgba(91, 43, 216, 0.35), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .laser-spotlight__media {
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .laser-spotlight__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .laser-spotlight__lead {
    color: var(--text-muted);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    margin: 0;
    max-width: 50ch;
  }
  .laser-spotlight__cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 880px) {
    .laser-spotlight {
      grid-template-columns: 1fr;
      padding: 1.4rem;
      gap: 1.6rem;
    }
  }
</style>
