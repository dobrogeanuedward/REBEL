---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-carmagnola");

const meta = createPageMeta({
  title: "Epilazione Laser Ice Polar a Carmagnola — Prezzi, Zone e Sedute | Rebel",
  description:
    "Epilazione Laser Ice Polar a Carmagnola per ascelle, inguine, gambe, viso e corpo. Diodo Thory a tre lunghezze d’onda, raffreddamento attivo, prezzi da 25,90 € e valutazione gratuita.",
  path: "/epilazione-laser-carmagnola",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Carmagnola",
    "epilazione laser vicino a me",
    "epilazione laser vicino a me Carmagnola",
    "laser vicino a me",
    "depilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "Ice Polar Carmagnola",
    "epilazione laser ascelle Carmagnola",
    "epilazione laser inguine Carmagnola",
    "epilazione laser gambe Carmagnola",
    "epilazione laser uomo Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "epilazione laser Carignano",
    "epilazione laser Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
]);

const laserServiceSchema = buildServiceSchema(
  "Epilazione Laser Ice Polar a Carmagnola",
  "Epilazione laser viso e corpo con tecnologia Thory a tre lunghezze d’onda, raffreddamento attivo, valutazione iniziale e calendario specifico per ogni zona.",
  "/epilazione-laser-carmagnola",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Carmagnola",
      "epilazione laser vicino a me",
      "laser diodo Carmagnola",
      "Ice Polar Carmagnola",
      "epilazione laser ascelle vicino a me",
      "epilazione laser inguine vicino a me",
      "epilazione laser gambe vicino a me",
      "depilazione laser Carmagnola",
    ],
  },
);

const faqs = [
  {
    q: "Quanto costa l'epilazione laser da Rebel a Carmagnola?",
    a: "I prezzi partono da 25,90 € per un’area piccola, come i baffetti, e cambiano in base alla zona. Nel listino online trovi i prezzi di ascelle, inguine, gambe, schiena e viso per donna e uomo. La valutazione iniziale è gratuita.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero varia in base a zona, caratteristiche del pelo, fototipo e risposta individuale. Come riferimento generale vengono spesso programmati cicli di 6-10 sedute, con controlli durante il percorso.",
  },
  {
    q: "Il trattamento è doloroso?",
    a: "Il manipolo Ice Polar raffredda la pelle durante gli impulsi e aumenta il comfort, soprattutto su ascelle, inguine e viso. La sensazione può cambiare in base alla zona e alla sensibilità personale.",
  },
  {
    q: "Funziona su tutti i tipi di pelo?",
    a: "Il diodo Thory combina tre lunghezze d’onda e permette di lavorare su diversi fototipi e profondità del follicolo. I peli biondi molto chiari, bianchi o grigi contengono poca melanina e possono rispondere meno: lo valutiamo prima di iniziare.",
  },
  {
    q: "Si può fare in estate o sulla pelle abbronzata?",
    a: "La possibilità dipende dal livello di abbronzatura, dalla zona e dall’esposizione prevista. Prima della seduta controlliamo la pelle e indichiamo le precauzioni da seguire nelle 48 ore precedenti e successive.",
  },
  {
    q: "Come prenoto la valutazione gratuita?",
    a: "Scrivi su WhatsApp o compila il modulo nella pagina contatti. La valutazione dura circa 15 minuti e serve a definire zone, parametri, calendario e prezzo prima della prima seduta.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localLandingSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#webpage`,
  url: `${siteConfig.siteUrl}/epilazione-laser-carmagnola`,
  name: "Epilazione Laser Ice Polar a Carmagnola",
  description:
    "Prezzi, zone, tecnologia, comfort e prenotazione della valutazione per l’epilazione laser viso e corpo da Rebel a Carmagnola.",
  inLanguage: "it-IT",
  about: [
    "epilazione laser Carmagnola",
    "laser viso Carmagnola",
    "laser corpo Carmagnola",
    "centro estetico Carmagnola",
  ],
  isPartOf: { "@id": `${siteConfig.siteUrl}/#website` },
  mainEntity: {
    "@type": "Service",
    "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#service`,
    name: "Epilazione Laser Ice Polar a Carmagnola",
    provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  },
};

const principles = [
  {
    kicker: "01 · Valutazione gratuita",
    title: "Controlliamo zona, fototipo e caratteristiche del pelo.",
    body: "La valutazione dura circa 15 minuti e permette di definire indicazioni, parametri iniziali, frequenza e prezzo prima della prima seduta.",
  },
  {
    kicker: "02 · Tecnologia Thory",
    title: "Tre lunghezze d’onda nello stesso manipolo.",
    body: "755, 808 e 1064 nm lavorano a profondità diverse. I parametri vengono impostati in base alla zona, alla pelle e al pelo osservato.",
  },
  {
    kicker: "03 · Ice Polar",
    title: "Raffreddamento attivo durante gli impulsi.",
    body: "Il manipolo raffredda la superficie cutanea mentre lavora, aumentando il comfort anche su aree sensibili come ascelle, inguine e viso.",
  },
  {
    kicker: "04 · Calendario",
    title: "Ogni zona segue tempi di ricrescita differenti.",
    body: "Ascelle, inguine, viso e gambe possono richiedere intervalli diversi. La data successiva viene indicata in base alla zona e alla ricrescita osservata.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Prezzo, durata indicativa, sensazioni durante la seduta e intervalli tra gli appuntamenti.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Come si svolge la seduta, quali aree si possono trattare e come gestire le ore successive.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Tempi, stagionalità, numero indicativo di sedute e mantenimento per gambe complete o parziali.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser e sole",
    body: "Indicazioni sull’esposizione solare, la pelle abbronzata e le precauzioni prima e dopo la seduta.",
  },
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno",
    body: "Perché i mesi con minore esposizione solare sono spesso comodi per iniziare un ciclo su gambe e zone esposte.",
  },
  {
    href: "/competenze/laser-e-palestra-sport-carmagnola",
    title: "Laser e palestra",
    body: "Sport, doccia, sudore e indicazioni pratiche nelle 24-48 ore successive al trattamento.",
  },
];

const zoneShortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/servizi/epilazione-laser-viso-uomo-carmagnola", label: "Laser viso uomo" },
  { href: "/servizi/epilazione-laser-corpo-uomo-carmagnola", label: "Laser corpo uomo" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Guida laser uomo" },
  { href: "/competenze/peli-incarniti-laser-carmagnola", label: "Peli incarniti" },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={localLandingSchema} />

  <PageHero
    image={m.hero}
    kicker="Epilazione Laser Ice Polar · Carmagnola"
    title="Laser per _viso e corpo_, con raffreddamento attivo."
    lead="Il diodo Thory combina tre lunghezze d’onda. Il manipolo Ice Polar raffredda la pelle durante gli impulsi. La valutazione gratuita definisce zone, parametri, frequenza e prezzo."
    bullets={["Viso, corpo, donna e uomo", "Prezzi da 25,90 €", "Valutazione iniziale gratuita"]}
    meta={["Diodo Thory · 755 / 808 / 1064 nm", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione laser", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta prezzi e zone", href: "/listino-estetica-laser#laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come si svolge il percorso"
        title="Valutazione, tecnologia, raffreddamento e calendario."
        lead="Questi quattro elementi definiscono il trattamento prima della prima seduta e vengono controllati durante gli appuntamenti."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="laser-spotlight">
        <figure class="laser-spotlight__media">
          <img
            src="https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public"
            alt="Epilazione laser corpo in cabina Rebel a Carmagnola"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="laser-spotlight__body">
          <p class="kicker">Zone e prezzi</p>
          <h2 class="laser-spotlight__title">Scegli la zona e apri la scheda dedicata.</h2>
          <p class="laser-spotlight__lead">
            Ogni scheda riporta prezzo, durata indicativa, caratteristiche della zona e informazioni da conoscere prima dell’appuntamento.
          </p>
          <div class="laser-spotlight__cluster">
            {zoneShortcuts.map((z) => (
              <a class="btn btn--secondary btn--sm" href={z.href}>{z.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Guide pratiche"
        title="Ascelle, inguine, gambe, sole e attività sportiva."
        lead="Approfondimenti specifici su prezzi, tempi, preparazione della pelle e indicazioni dopo la seduta."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Ice Polar"
      quote="Il manipolo raffredda la pelle durante ogni impulso."
      cta={{ label: "Prenota la valutazione laser", href: "/contatti" }}
    />
  ) : null}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Prezzi, numero di sedute, comfort, fototipo e sole."
      />
      <FaqAccordion items={faqs} kicker="FAQ Laser" />
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Epilazione laser"
    kicker="Epilazione laser vicino a te"
    anchorPattern={(s, c) => `${s} per chi viene da ${c}`}
    clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
    limit={14}
    hrefOverrides={{
      alba: "/epilazione-laser-alba",
      bra: "/epilazione-laser-bra",
      canale: "/epilazione-laser-canale",
      racconigi: "/epilazione-laser-racconigi",
    }}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione laser gratuita"
        title="Ricevi indicazioni su zone, parametri, _frequenza e prezzo_."
        lead="L’appuntamento dura circa 15 minuti. Valutiamo pelle e pelo, definiamo le zone e ti consegniamo una proposta prima della prima seduta."
        primaryLabel="Prenota la valutazione laser"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Valutazione laser gratuita", href: "/contatti" }} />
</BaseLayout>

<style>
  .laser-spotlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;
    align-items: stretch;
    padding: 2rem;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.7), rgba(20, 16, 42, 0.95));
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .laser-spotlight::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60%;
    height: 60%;
    background: radial-gradient(closest-side, rgba(91, 43, 216, 0.35), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .laser-spotlight__media {
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .laser-spotlight__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .laser-spotlight__lead {
    color: var(--text-muted);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    margin: 0;
    max-width: 50ch;
  }
  .laser-spotlight__cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 880px) {
    .laser-spotlight {
      grid-template-columns: 1fr;
      padding: 1.4rem;
      gap: 1.6rem;
    }
  }
</style>
