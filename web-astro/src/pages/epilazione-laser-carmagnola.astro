---
import LaserCampaignLinks from "@/components/LaserCampaignLinks.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import LaserOffer from "@/components/LaserOffer.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia, media } from "@/lib/page-media";
import { laserOffer } from "@/lib/laser-offer";

const m = getPageMedia("/epilazione-laser-carmagnola");

const meta = createPageMeta({
  title: "Epilazione laser ICE Polar a Carmagnola — Viso e corpo",
  description:
    "Epilazione laser con ICE Polar a Carmagnola per viso e corpo. Lumina X1 Pro di THORY, listino ordinario da €25,90 e valutazione REBEL di 30–40 minuti.",
  path: "/epilazione-laser-carmagnola",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  openGraphType: "article",
  keywords: [
    "epilazione laser Carmagnola",
    "epilazione laser vicino a me",
    "epilazione laser vicino a me Carmagnola",
    "laser vicino a me",
    "depilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "ICE Polar Carmagnola",
    "epilazione laser ascelle Carmagnola",
    "epilazione laser inguine Carmagnola",
    "epilazione laser gambe Carmagnola",
    "epilazione laser uomo Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "epilazione laser Carignano",
    "epilazione laser Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
]);

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser con ICE Polar a Carmagnola",
  "Epilazione laser viso e corpo con Lumina X1 Pro di THORY, quattro lunghezze d’onda, comfort ICE Polar, valutazione iniziale e calendario specifico per ogni zona.",
  "/epilazione-laser-carmagnola",
  {
    keywords: [
      "epilazione laser Carmagnola",
      "epilazione laser vicino a me",
      "laser diodo Carmagnola",
      "ICE Polar Carmagnola",
      "epilazione laser ascelle vicino a me",
      "epilazione laser inguine vicino a me",
      "epilazione laser gambe vicino a me",
      "depilazione laser Carmagnola",
    ],
  },
);

const faqs = [
  {
    q: "Quanto costa l’epilazione laser da Rebel a Carmagnola?",
    a: "Fuori dalla promozione, il prezzo ordinario parte da €25,90 per una singola zona e cambia in base all’estensione. Nel listino online trovi i prezzi per viso e corpo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero varia in base a zona, pelle, caratteristiche del pelo e andamento osservato durante gli appuntamenti. Dopo la valutazione ti diamo una prima stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Il trattamento è doloroso?",
    a: "ICE Polar raffredda la pelle a contatto durante la seduta. La sensazione cambia in base alla zona e alla sensibilità personale; per questo impostiamo i parametri dopo la valutazione e ti chiediamo come li percepisci durante il trattamento.",
  },
  {
    q: "Funziona su tutti i tipi di pelo?",
    a: "Lumina X1 Pro di THORY integra 755, 808, 940 e 1064 nm. La possibilità di trattare il pelo dipende da pelle, zona e caratteristiche del pelo; lo valutiamo prima di iniziare.",
  },
  {
    q: "Si può fare in estate o sulla pelle abbronzata?",
    a: "La possibilità dipende dal livello di abbronzatura, dalla zona e dall’esposizione prevista. Prima della seduta controlliamo la pelle e ti indichiamo le precauzioni da seguire prima e dopo il trattamento.",
  },
  {
    q: "Come prenoto la valutazione?",
    a: "Scrivi su WhatsApp o compila il modulo nella pagina contatti. In 30–40 minuti valutiamo pelle, pelo e zone, poi ti spieghiamo parametri, calendario e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const localLandingSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#webpage`,
  url: `${siteConfig.siteUrl}/epilazione-laser-carmagnola`,
  name: "Epilazione laser con ICE Polar a Carmagnola",
  description:
    "Prezzi, zone, tecnologia, comfort e prenotazione della valutazione per l’epilazione laser viso e corpo da Rebel a Carmagnola.",
  inLanguage: "it-IT",
  about: [
    "epilazione laser Carmagnola",
    "laser viso Carmagnola",
    "laser corpo Carmagnola",
    "centro estetico Carmagnola",
  ],
  isPartOf: { "@id": `${siteConfig.siteUrl}/#website` },
  mainEntity: {
    "@type": "Service",
    "@id": `${siteConfig.siteUrl}/epilazione-laser-carmagnola#service`,
    name: "Epilazione Laser Ice Polar a Carmagnola",
    provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  },
};

const principles = [
  {
    kicker: "01 · Valutazione · 30–40 minuti",
    title: "Controlliamo zona, fototipo e caratteristiche del pelo.",
    body: "In 30–40 minuti valutiamo pelle, pelo e zona. Prima della prima seduta ti spieghiamo parametri iniziali, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita.",
  },
  {
    kicker: "02 · Tecnologia Thory",
    title: "Quattro lunghezze d’onda nello stesso sistema.",
    body: "Lumina X1 Pro integra 755, 808, 940 e 1064 nm. I parametri vengono impostati in base alla zona, alla pelle e al pelo osservato.",
  },
  {
    kicker: "03 · ICE Polar",
    title: "Raffreddamento a contatto durante la seduta.",
    body: "La superficie in zaffiro del manipolo raffredda la pelle a ogni passaggio.",
  },
  {
    kicker: "04 · Calendario",
    title: "Ogni zona segue tempi di ricrescita differenti.",
    body: "Ascelle, inguine, viso e gambe possono richiedere intervalli diversi. La data successiva viene indicata in base alla zona e alla ricrescita osservata.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola",
    title: "Laser ascelle",
    body: "Prezzo, durata indicativa, sensazioni durante la seduta e intervalli tra gli appuntamenti.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola",
    title: "Laser inguine",
    body: "Come si svolge la seduta, quali aree si possono trattare e come gestire le ore successive.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola",
    title: "Laser gambe",
    body: "Tempi, stagionalità, numero indicativo di sedute e mantenimento per gambe complete o parziali.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser e sole",
    body: "Indicazioni sull’esposizione solare, la pelle abbronzata e le precauzioni prima e dopo la seduta.",
  },
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno",
    body: "Perché i mesi con minore esposizione solare sono spesso comodi per iniziare un ciclo su gambe e zone esposte.",
  },
  {
    href: "/competenze/laser-e-palestra-sport-carmagnola",
    title: "Laser e palestra",
    body: "Sport, doccia, sudore e indicazioni pratiche nelle 24-48 ore successive al trattamento.",
  },
];

const zoneShortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/servizi/epilazione-laser-viso-uomo-carmagnola", label: "Laser viso uomo" },
  { href: "/servizi/epilazione-laser-corpo-uomo-carmagnola", label: "Laser corpo uomo" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Guida laser uomo" },
  { href: "/competenze/peli-incarniti-laser-carmagnola", label: "Peli incarniti" },
];
---
<BaseLayout meta={meta} bodyClass="page-laser">
  <JsonLd data={breadcrumb} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={localLandingSchema} />

  <PageHero
    image={m.hero}
    kicker="Epilazione Laser ICE Polar · Carmagnola"
    title="Laser per _viso e corpo_, con raffreddamento attivo."
    lead="Lumina X1 Pro di THORY integra quattro lunghezze d’onda e il raffreddamento a contatto in zaffiro Ice Point Cooling. ICE Polar raffredda la pelle durante la seduta; la valutazione definisce zone, parametri, frequenza e prezzo."
    bullets={["Viso, corpo, donna e uomo", "Listino ordinario da €25,90", "Valutazione REBEL · 30–40 min"]}
    meta={["Lumina X1 Pro · 755 / 808 / 940 / 1064 nm", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione laser", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Consulta prezzi e zone", href: "/listino-estetica-laser#laser" }}
  />

  <section class="section section--tight">
    <div class="container">
      <LaserOffer />
      <LaserCampaignLinks />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come si svolge il percorso"
        title="Valutazione, tecnologia, raffreddamento e calendario."
        lead="Prima di iniziare definiamo zona, parametri, raffreddamento e calendario; poi li controlliamo durante il percorso."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="laser-spotlight">
        <figure class="laser-spotlight__media">
          <picture>
            {media.studio.cabin.srcMobile ? <source media="(max-width: 880px) and (orientation: portrait)" srcset={media.studio.cabin.srcMobile} /> : null}
            <img
              src={media.studio.cabin.src}
              alt={media.studio.cabin.alt}
              width="1672"
              height="941"
              loading="lazy"
              decoding="async"
            />
          </picture>
        </figure>
        <div class="laser-spotlight__body">
          <p class="kicker">Zone e prezzi</p>
          <h2 class="laser-spotlight__title">Scegli la zona e consulta la scheda dedicata.</h2>
          <p class="laser-spotlight__lead">
            Ogni scheda riporta prezzo, durata indicativa, caratteristiche della zona e informazioni da conoscere prima dell’appuntamento.
          </p>
          <div class="laser-spotlight__cluster">
            {zoneShortcuts.map((z) => (
              <a class="btn btn--secondary btn--sm" href={z.href}>{z.label}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Guide pratiche"
        title="Ascelle, inguine, gambe, sole e attività sportiva."
        lead="Approfondimenti specifici su prezzi, tempi, preparazione della pelle e indicazioni dopo la seduta."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="ICE Polar"
      quote="Il manipolo raffredda la pelle durante ogni impulso."
      cta={{ label: "Prenota la valutazione laser", href: "/contatti" }}
    />
  ) : null}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Prezzi, numero di sedute, comfort, fototipo e sole."
      />
      <FaqAccordion items={faqs} kicker="Domande sul laser" />
    </div>
  </section>

  <NearMeBlock
    serviceLabel="Epilazione laser"
    kicker="Epilazione laser vicino a te"
    anchorPattern={(s, c) => `${s} per chi viene da ${c}`}
    clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
    limit={14}
    hrefOverrides={{
      alba: "/epilazione-laser-alba",
      bra: "/epilazione-laser-bra",
      canale: "/epilazione-laser-canale",
      racconigi: "/epilazione-laser-racconigi",
    }}
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione laser · 30–40 minuti"
        title="Ricevi indicazioni su zone, parametri, _frequenza e prezzo_."
        lead="In 30–40 minuti valutiamo pelle, pelo e zone e ti spieghiamo parametri, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita."
        primaryLabel="Prenota la valutazione laser"
      />
    </div>
  </section>

  <StickyBookingBar promo priceHint={laserOffer.stickyLabel} primary={{ label: "Richiedi la promo", href: laserOffer.contactPath }} />
</BaseLayout>

<style>
  .laser-spotlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.4rem;
    align-items: stretch;
    padding: 2rem;
    border-radius: var(--r-lg);
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.7), rgba(20, 16, 42, 0.95));
    border: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .laser-spotlight::before {
    content: "";
    position: absolute;
    inset: -40% -10% auto auto;
    width: 60%;
    height: 60%;
    background: radial-gradient(closest-side, rgba(91, 43, 216, 0.35), transparent 70%);
    filter: blur(40px);
    pointer-events: none;
  }
  .laser-spotlight__media {
    margin: 0;
    border-radius: var(--r-md);
    overflow: hidden;
    aspect-ratio: 4 / 3;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__media picture,
  .laser-spotlight__media img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .laser-spotlight__media img {
    object-fit: cover;
  }
  .laser-spotlight__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    position: relative;
    z-index: 1;
  }
  .laser-spotlight__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.15;
    letter-spacing: var(--tracking-editorial);
    color: var(--text-strong);
    margin: 0;
  }
  .laser-spotlight__lead {
    color: var(--text-muted);
    font-size: var(--t-body);
    line-height: var(--lh-body);
    margin: 0;
    max-width: 50ch;
  }
  .laser-spotlight__cluster {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  @media (max-width: 880px) {
    .laser-spotlight {
      grid-template-columns: 1fr;
      padding: 1.4rem;
      gap: 1.6rem;
    }
  }
</style>
