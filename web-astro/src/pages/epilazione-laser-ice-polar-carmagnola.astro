---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-ice-polar-carmagnola");

const meta = createPageMeta({
  title: "Laser Ice Polar a Carmagnola — Manipolo con Raffreddamento Attivo",
  description:
    "Cos'è Ice Polar e perché rende l'epilazione laser più comoda anche su ascelle e inguine. Manipolo con raffreddamento attivo, in cabina da Rebel a Carmagnola.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  openGraphType: "article",
  keywords: [
    "Ice Polar Carmagnola",
    "laser Ice Polar Carmagnola",
    "manipolo Ice Polar",
    "laser con raffreddamento Carmagnola",
    "epilazione laser comoda Carmagnola",
    "diodo Thory Ice Polar",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Ice Polar", path: "/epilazione-laser-ice-polar-carmagnola" },
]);

const serviceSchema = buildServiceSchema(
  "Epilazione laser con manipolo Ice Polar a Carmagnola",
  "Approfondimento sul comfort del laser: cosa fa Ice Polar, perché è utile e come impostiamo un percorso coerente per viso e corpo.",
  "/epilazione-laser-ice-polar-carmagnola",
);

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser con Ice Polar a Carmagnola",
  description:
    "Una guida chiara sul manipolo Ice Polar: comfort, metodo e consigli pratici prima di iniziare un percorso laser.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  keywords: ["Ice Polar", "laser con raffreddamento", "epilazione laser Carmagnola", "comfort laser"],
  section: "Laser",
});

const faqs = [
  {
    q: "Cos'è esattamente Ice Polar?",
    a: "È il manipolo del laser diodo Thory con raffreddamento attivo integrato: durante l'impulso laser la punta a contatto con la pelle resta a bassa temperatura. Risultato: la sensazione di calore/dolore è molto inferiore rispetto ai laser tradizionali.",
  },
  {
    q: "Ice Polar rende il laser indolore?",
    a: "Non parliamo di zero dolore, parliamo di molto meno dolore. Su zone sensibili (ascelle, inguine, baffetti) la differenza è evidente: la seduta resta gestibile e finisce in pochi minuti.",
  },
  {
    q: "Su quali zone si nota di più la differenza?",
    a: "Soprattutto su ascelle, inguine, baffetti e contorno labbra: zone con pelle sottile e terminazioni nervose ravvicinate. Anche sulla schiena e sulle gambe la seduta resta più confortevole, ma lì la differenza è meno marcata.",
  },
  {
    q: "Ice Polar basta da solo per avere un buon risultato?",
    a: "No. Il comfort è importante, ma la differenza la fanno parametri impostati bene, lettura corretta del fototipo e calendario delle sedute. Il manipolo è un mezzo, non il risultato.",
  },
  {
    q: "Posso provarlo prima di iniziare un percorso?",
    a: "Sì: in valutazione gratuita possiamo fare un piccolo test su una zona limitata, così senti tu stessa la differenza. Senza obbligo di acquisto.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const principles = [
  {
    kicker: "Cosa fa",
    title: "Raffredda mentre lavora",
    body: "La punta del manipolo abbassa la temperatura cutanea durante l'impulso laser. La sensazione di calore/dolore cala drasticamente, anche dove la pelle è sottile.",
  },
  {
    kicker: "Come lo usiamo",
    title: "Parametri sempre tarati",
    body: "Il comfort non sostituisce il metodo. Lavoriamo su settaggio, fototipo e calendario reali: il manipolo aiuta, non improvvisa.",
  },
  {
    kicker: "Perché conta",
    title: "Più comoda = continuità",
    body: "Una seduta sopportabile è una seduta che ti fa tornare. Il percorso laser funziona se lo segui: il comfort è la condizione che lo rende possibile.",
  },
];

const shortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/competenze/epilazione-laser-ascelle-carmagnola", label: "Guida ascelle" },
  { href: "/competenze/epilazione-laser-inguine-carmagnola", label: "Guida inguine" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Laser uomo" },
  { href: "/epilazione-laser-carmagnola", label: "Percorso laser" },
  { href: "/listino-estetica-laser", label: "Prezzi e listino" },
];
---
<BaseLayout meta={meta} bodyClass="page-laser-ice-polar">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Manipolo Ice Polar · Carmagnola"
    title="Ice Polar: il laser che _resta comodo_, anche dove la pelle è sottile."
    lead="Il manipolo Ice Polar raffredda la pelle in tempo reale durante l'impulso laser. Risultato: ascelle, inguine e baffetti diventano sedute brevi e sopportabili, non un test di resistenza."
    bullets={["Raffreddamento attivo durante l'impulso", "Più comfort su ascelle, inguine, baffetti", "Test possibile in valutazione gratuita"]}
    meta={["Diodo Thory · Ice Polar", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come funziona"
        title="Tre cose che servono _davvero_ a saperlo."
        lead="Il manipolo Ice Polar in tre punti: cosa fa, come lo usiamo in cabina, perché ti permette di completare il percorso laser senza saltarlo."
      />
      <div class="card-grid card-grid--3">
        {principles.map((p) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant="feature" />
        ))}
      </div>
    </div>
  </section>

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="La punta che raffredda"
          title="Quel _freddo_ al contatto è la pelle protetta."
          body="Mentre l'impulso lavora sul follicolo, la punta a contatto resta a bassa temperatura. È questo che abbassa la sensazione di calore e rende la seduta breve e gestibile, anche sulle zone più delicate."
          bullets={["Raffreddamento attivo, in tempo reale", "Sedute rapide anche su ascelle e inguine", "Comfort che ti fa completare il percorso"]}
          cta={{ label: "Vedi il percorso laser completo", href: "/epilazione-laser-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container split">
      <article class="card">
        <p class="kicker">In studio</p>
        <h2 class="card__title">Il comfort è una condizione, non una promessa.</h2>
        <p class="card__body">
          Ice Polar è il manipolo del nostro laser diodo Thory, con sistema di raffreddamento attivo
          integrato. Quando senti il "freddo" al contatto, è la pelle che viene protetta in tempo reale
          mentre l'impulso lavora sul follicolo. Su ascelle, inguine e baffetti è la differenza tra
          una seduta comoda e una difficile da reggere.
        </p>
        <p class="card__body">
          Detto questo: il laser è un percorso, non una seduta singola. Il comfort serve a farti
          arrivare alla fine. Quello che fa la differenza vera sono i parametri impostati bene e un
          calendario sensato — non il manipolo da solo.
        </p>
      </article>
      <aside class="card card--feature">
        <p class="kicker">Da dove iniziare</p>
        <h3 class="card__title">Pagine utili prima di prenotare.</h3>
        <ul class="ice-shortcuts">
          {shortcuts.map((s) => (
            <li><a class="btn btn--secondary btn--sm" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="sm"
      align="left"
      kicker="In cabina, a Carmagnola"
      quote="Una seduta sopportabile è una seduta che ti fa tornare."
    />
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Domande frequenti"
        title="Risposte _oneste_ su Ice Polar."
      />
      <FaqAccordion items={faqs} kicker="Comfort & metodo" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi sentirlo tu?"
        title="Prova Ice Polar in _valutazione gratuita_."
        lead="Quindici minuti in studio: ti raccontiamo la tecnologia, leggiamo zona e fototipo, e se vuoi facciamo un piccolo test su una zona limitata. Senza obbligo di acquisto."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione gratuita"
        secondaryHref="/epilazione-laser-carmagnola"
        secondaryLabel="Vedi il percorso laser"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Prova Ice Polar gratis" primary={{ label: "Valutazione gratuita", href: "/contatti" }} />
</BaseLayout>

<style>
  .ice-shortcuts {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
</style>
