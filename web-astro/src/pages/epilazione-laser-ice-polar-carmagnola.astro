---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-ice-polar-carmagnola");

const meta = createPageMeta({
  title: "Laser Ice Polar a Carmagnola — Comfort durante la seduta",
  description:
    "ICE Polar è il naming REBEL dedicato al comfort durante l'epilazione laser con Lumina X1 Pro di THORY a Carmagnola. Valutazione e parametri personalizzati.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  openGraphType: "article",
  keywords: [
    "Ice Polar Carmagnola",
    "laser Ice Polar Carmagnola",
    "comfort Ice Polar",
    "laser con raffreddamento Carmagnola",
    "epilazione laser comoda Carmagnola",
    "Lumina X1 Pro Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Ice Polar", path: "/epilazione-laser-ice-polar-carmagnola" },
]);

const serviceSchema = buildServiceSchema(
  "Epilazione laser con comfort ICE Polar a Carmagnola",
  "Approfondimento sul comfort ICE Polar nel percorso laser con Lumina X1 Pro di THORY e sulla valutazione per viso e corpo.",
  "/epilazione-laser-ice-polar-carmagnola",
);

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser con Ice Polar a Carmagnola",
  description:
    "Una guida chiara sul comfort ICE Polar, sul metodo e sui consigli pratici prima di iniziare un percorso laser.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  keywords: ["Ice Polar", "laser con raffreddamento", "epilazione laser Carmagnola", "comfort laser"],
  section: "Laser",
});

const faqs = [
  {
    q: "Cos'è esattamente Ice Polar?",
    a: "ICE Polar è il naming usato da REBEL per raccontare il comfort del freddo che accompagna la seduta. Il dispositivo è Lumina X1 Pro di THORY; il suo raffreddamento tecnico si chiama Ice Point Cooling e lavora a contatto in zaffiro.",
  },
  {
    q: "Che sensazione si avverte durante la seduta?",
    a: "La percezione cambia da persona a persona e da zona a zona. Il comfort ICE Polar accompagna la seduta, mentre la professionista adatta i parametri alla risposta della pelle.",
  },
  {
    q: "Su quali zone si nota di più la differenza?",
    a: "Soprattutto su ascelle, inguine, baffetti e contorno labbra: zone con pelle sottile e terminazioni nervose ravvicinate. Anche sulla schiena e sulle gambe la seduta resta più confortevole, ma lì la differenza è meno marcata.",
  },
  {
    q: "Ice Polar basta da solo per avere un buon risultato?",
    a: "No. Il comfort è un elemento del percorso; valutazione, parametri e calendario vengono definiti sulla persona. Non promettiamo risultati uguali o un numero fisso di sedute.",
  },
  {
    q: "Posso provarlo prima di iniziare un percorso?",
    a: "Durante la valutazione di 30–40 minuti definiamo se il percorso è pertinente e come impostarlo. La valutazione è gratuita quando finalizzata al Percorso REBEL; l’home care resta separata.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const principles = [
  {
    kicker: "Cosa fa",
    title: "Accompagna il comfort",
    body: "ICE Polar è il linguaggio REBEL per il comfort del freddo durante la seduta. Il raffreddamento tecnico di Lumina X1 Pro è Ice Point Cooling, a contatto in zaffiro.",
  },
  {
    kicker: "Come lo usiamo",
    title: "Parametri sempre tarati",
    body: "Il comfort non sostituisce il metodo. Lavoriamo su settaggio, pelle, caratteristiche del pelo e calendario reali: la tecnologia viene sempre adattata alla valutazione.",
  },
  {
    kicker: "Perché conta",
    title: "Comfort e continuità",
    body: "Una seduta gestibile rende più semplice seguire il calendario concordato. La continuità resta parte del metodo, senza garanzie uguali per tutti.",
  },
];

const shortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/competenze/epilazione-laser-ascelle-carmagnola", label: "Guida ascelle" },
  { href: "/competenze/epilazione-laser-inguine-carmagnola", label: "Guida inguine" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Laser uomo" },
  { href: "/epilazione-laser-carmagnola", label: "Percorso laser" },
  { href: "/listino-estetica-laser", label: "Prezzi e listino" },
];
---
<BaseLayout meta={meta} bodyClass="page-laser-ice-polar">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Comfort ICE Polar · Carmagnola"
    title="ICE Polar: il comfort che _accompagna_ il percorso laser."
    lead="Lumina X1 Pro di THORY è il dispositivo laser. ICE Polar è il naming REBEL dedicato al comfort del freddo durante la seduta: due informazioni distinte, raccontate con chiarezza."
    bullets={["Raffreddamento tecnico Ice Point Cooling", "Comfort ICE Polar nel percorso REBEL", "Valutazione · 30–40 minuti"]}
    meta={["Lumina X1 Pro di THORY · comfort ICE Polar", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come funziona"
        title="Tre cose che servono _davvero_ a saperlo."
        lead="Il comfort ICE Polar in tre punti: che cosa indica, come entra nel metodo REBEL e perché la valutazione resta decisiva."
      />
      <div class="card-grid card-grid--3">
        {principles.map((p) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant="feature" />
        ))}
      </div>
    </div>
  </section>

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Tecnologia e comfort"
          title="Il freddo al contatto, raccontato _senza confondere i nomi_."
          body="Lumina X1 Pro integra Ice Point Cooling, il raffreddamento THORY a contatto in zaffiro. ICE Polar resta il naming REBEL per il comfort che accompagna la seduta."
          bullets={["Lumina X1 Pro di THORY", "Ice Point Cooling a contatto in zaffiro", "Comfort ICE Polar nel percorso REBEL"]}
          cta={{ label: "Vedi il percorso laser completo", href: "/epilazione-laser-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container split">
      <article class="card">
        <p class="kicker">In studio</p>
        <h2 class="card__title">Il comfort è una condizione, non una promessa.</h2>
        <p class="card__body">
          Il dispositivo è Lumina X1 Pro di THORY, con raffreddamento Ice Point Cooling a contatto in
          zaffiro. ICE Polar è invece il naming REBEL dedicato al comfort del freddo che accompagna la
          seduta. La percezione resta personale e viene ascoltata durante il trattamento.
        </p>
        <p class="card__body">
          Detto questo: il laser è un percorso, non una seduta singola. Il comfort serve a farti
          arrivare alla fine. Quello che fa la differenza vera sono i parametri impostati bene e un
          calendario sensato — non un singolo elemento tecnologico.
        </p>
      </article>
      <aside class="card card--feature">
        <p class="kicker">Da dove iniziare</p>
        <h3 class="card__title">Pagine utili prima di prenotare.</h3>
        <ul class="ice-shortcuts">
          {shortcuts.map((s) => (
            <li><a class="btn btn--secondary btn--sm" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="sm"
      align="left"
      kicker="In cabina, a Carmagnola"
      quote="Una seduta sopportabile è una seduta che ti fa tornare."
    />
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Domande frequenti"
        title="Risposte _oneste_ su Ice Polar."
      />
      <FaqAccordion items={faqs} kicker="Comfort & metodo" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi sentirlo tu?"
        title="Valuta il percorso con comfort _ICE Polar_."
        lead="Valutazione e analisi durano 30–40 minuti e sono gratuite quando finalizzate alla costruzione del Percorso: raccontiamo la tecnologia, leggiamo zona e fototipo e definiamo i passi successivi."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/epilazione-laser-carmagnola"
        secondaryLabel="Vedi il percorso laser"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Valutazione 30–40 min" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .ice-shortcuts {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
</style>
