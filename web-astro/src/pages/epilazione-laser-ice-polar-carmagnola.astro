---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-ice-polar-carmagnola");

const meta = createPageMeta({
  title: "Laser ICE Polar a Carmagnola — Comfort durante la seduta",
  description:
    "Epilazione laser con Lumina X1 Pro e raffreddamento a contatto ICE Polar a Carmagnola. Scopri come si svolge la seduta e prenota la valutazione.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  openGraphType: "article",
  keywords: [
    "ICE Polar Carmagnola",
    "laser ICE Polar Carmagnola",
    "comfort ICE Polar",
    "laser con raffreddamento Carmagnola",
    "epilazione laser comoda Carmagnola",
    "Lumina X1 Pro Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "ICE Polar", path: "/epilazione-laser-ice-polar-carmagnola" },
]);

const serviceSchema = buildServiceSchema(
  "Epilazione laser con comfort ICE Polar a Carmagnola",
  "Approfondimento sul comfort ICE Polar nel percorso laser con Lumina X1 Pro di THORY e sulla valutazione per viso e corpo.",
  "/epilazione-laser-ice-polar-carmagnola",
);

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser con ICE Polar a Carmagnola",
  description:
    "Una guida chiara sul comfort ICE Polar, sul metodo e sui consigli pratici prima di iniziare un percorso laser.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  keywords: ["ICE Polar", "laser con raffreddamento", "epilazione laser Carmagnola", "comfort laser"],
  section: "Laser",
});

const faqs = [
  {
    q: "Cos’è esattamente ICE Polar?",
    a: "ICE Polar indica il raffreddamento a contatto utilizzato durante la seduta con Lumina X1 Pro di THORY. Il sistema tecnico Ice Point Cooling raffredda la pelle attraverso il contatto in zaffiro del manipolo.",
  },
  {
    q: "Che sensazione si avverte durante la seduta?",
    a: "La sensazione varia da persona a persona e da zona a zona. Durante la seduta ti chiediamo come la percepisci e, se necessario, adattiamo i parametri.",
  },
  {
    q: "La sensazione cambia tra una zona e l'altra?",
    a: "Sì, la percezione può cambiare tra persone e zone. La verifichiamo durante la seduta e adattiamo i parametri quando necessario.",
  },
  {
    q: "ICE Polar svolge anche il trattamento laser?",
    a: "No. Il raffreddamento riguarda il comfort durante la seduta. Prima di iniziare valutiamo separatamente pelle, pelo e zona per capire se e come impostare il trattamento.",
  },
  {
    q: "Posso provarlo prima di iniziare un percorso?",
    a: "Durante la valutazione di 30–40 minuti osserviamo pelle, pelo e zona e ti spieghiamo come impostare il percorso. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const principles = [
  {
    kicker: "Cosa fa",
    title: "Raffredda la pelle durante la seduta",
    body: "Il sistema Ice Point Cooling di Lumina X1 Pro lavora a contatto attraverso la superficie in zaffiro del manipolo.",
  },
  {
    kicker: "Come lo usiamo",
    title: "Impostiamo i parametri dopo la valutazione",
    body: "Prima di iniziare valutiamo pelle, caratteristiche del pelo e zona. Durante gli appuntamenti osserviamo i cambiamenti e aggiorniamo i parametri quando serve.",
  },
  {
    kicker: "Perché conta",
    title: "Raffreddamento durante il trattamento",
    body: "Il manipolo raffredda la pelle a ogni passaggio. La sensazione varia da persona a persona e viene verificata durante la seduta.",
  },
];

const shortcuts = [
  { href: "/servizi/epilazione-laser-viso-carmagnola", label: "Laser viso" },
  { href: "/servizi/epilazione-laser-corpo-carmagnola", label: "Laser corpo" },
  { href: "/competenze/epilazione-laser-ascelle-carmagnola", label: "Guida ascelle" },
  { href: "/competenze/epilazione-laser-inguine-carmagnola", label: "Guida inguine" },
  { href: "/competenze/laser-uomo-carmagnola", label: "Laser uomo" },
  { href: "/epilazione-laser-carmagnola", label: "Percorso laser" },
  { href: "/listino-estetica-laser", label: "Prezzi e listino" },
];
---
<BaseLayout meta={meta} bodyClass="page-laser-ice-polar">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Comfort ICE Polar · Carmagnola"
    title="ICE Polar: raffreddamento a contatto durante il _percorso laser_."
    lead="Durante la seduta con Lumina X1 Pro, il sistema ICE Polar raffredda la pelle attraverso il contatto in zaffiro del manipolo."
    bullets={["Raffreddamento a contatto Ice Point Cooling", "Parametri definiti dopo la valutazione", "Valutazione · 30–40 minuti"]}
    meta={["Lumina X1 Pro di THORY · comfort ICE Polar", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Come funziona"
        title="Come funziona il _raffreddamento ICE Polar_."
        lead="Come funziona il raffreddamento, come scegliamo i parametri e perché la valutazione viene prima della seduta."
      />
      <div class="card-grid card-grid--3">
        {principles.map((p) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant="feature" />
        ))}
      </div>
    </div>
  </section>

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Tecnologia e comfort"
          title="Lumina X1 Pro e ICE Polar: _come lavorano insieme_."
          body="Lumina X1 Pro è il laser THORY che utilizziamo. Il sistema ICE Polar raffredda la pelle a contatto durante la seduta attraverso la superficie in zaffiro del manipolo."
          bullets={["Lumina X1 Pro di THORY", "Contatto in zaffiro", "Raffreddamento durante la seduta"]}
          cta={{ label: "Vedi il percorso laser completo", href: "/epilazione-laser-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container split">
      <article class="card">
        <p class="kicker">In studio</p>
        <h2 class="card__title">Il raffreddamento è una parte del percorso.</h2>
        <p class="card__body">
          Il sistema Ice Point Cooling di Lumina X1 Pro raffredda la pelle attraverso il contatto in
          zaffiro del manipolo. La sensazione varia: ti chiediamo come stai e adattiamo i
          parametri quando necessario.
        </p>
        <p class="card__body">
          L’epilazione laser prevede più appuntamenti. Durante la valutazione definiamo parametri e
          intervalli; ai controlli osserviamo la pelle e la ricrescita.
        </p>
      </article>
      <aside class="card card--feature">
        <p class="kicker">Da dove iniziare</p>
        <h3 class="card__title">Approfondisci il percorso laser.</h3>
        <ul class="ice-shortcuts">
          {shortcuts.map((s) => (
            <li><a class="btn btn--secondary btn--sm" href={s.href}>{s.label}</a></li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="sm"
      align="left"
      kicker="In studio, a Carmagnola"
      quote="Il manipolo raffredda la pelle a contatto durante la seduta laser."
    />
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Domande frequenti"
        title="Le risposte alle domande su _ICE Polar_."
      />
      <FaqAccordion items={faqs} kicker="Comfort e metodo" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Da dove iniziare"
        title="Scopri se l’_epilazione laser_ è adatta a te."
        lead="In 30–40 minuti valutiamo zona, pelle e caratteristiche del pelo, poi ti spieghiamo parametri, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/epilazione-laser-carmagnola"
        secondaryLabel="Vedi il percorso laser"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Valutazione 30–40 min" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .ice-shortcuts {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }
</style>
