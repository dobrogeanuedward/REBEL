---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import LaserHub from "@/components/LaserHub.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  createPageMeta,
} from "@/lib/seo";
import { getPageMedia } from "@/lib/page-media";
import { laserOffer } from "@/lib/laser-offer";

const m = getPageMedia("/epilazione-laser-ice-polar-carmagnola");

const meta = createPageMeta({
  title: "Laser ICE Polar a Carmagnola — Comfort durante la seduta",
  description:
    "Epilazione laser con Lumina X1 Pro e raffreddamento a contatto ICE Polar a Carmagnola. Scopri come si svolge la seduta e prenota la valutazione.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  openGraphType: "article",
  keywords: [
    "ICE Polar Carmagnola",
    "laser ICE Polar Carmagnola",
    "comfort ICE Polar",
    "laser con raffreddamento Carmagnola",
    "epilazione laser comoda Carmagnola",
    "Lumina X1 Pro Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "ICE Polar", path: "/epilazione-laser-ice-polar-carmagnola" },
]);

const serviceSchema = buildServiceSchema(
  "Epilazione laser con comfort ICE Polar a Carmagnola",
  "Approfondimento sul comfort ICE Polar nel percorso laser con Lumina X1 Pro di THORY e sulla valutazione per viso e corpo.",
  "/epilazione-laser-ice-polar-carmagnola",
);

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser con ICE Polar a Carmagnola",
  description:
    "Una guida chiara sul comfort ICE Polar, sul metodo e sui consigli pratici prima di iniziare un percorso laser.",
  path: "/epilazione-laser-ice-polar-carmagnola",
  keywords: ["ICE Polar", "laser con raffreddamento", "epilazione laser Carmagnola", "comfort laser"],
  section: "Laser",
});

const faqs = [
  {
    q: "Cos’è esattamente ICE Polar?",
    a: "ICE Polar indica il raffreddamento a contatto utilizzato durante la seduta con Lumina X1 Pro di THORY. Il sistema tecnico Ice Point Cooling raffredda la pelle attraverso il contatto in zaffiro del manipolo.",
  },
  {
    q: "Che sensazione si avverte durante la seduta?",
    a: "La sensazione varia da persona a persona e da zona a zona. Durante la seduta ti chiediamo come la percepisci e, se necessario, adattiamo i parametri.",
  },
  {
    q: "La sensazione cambia tra una zona e l'altra?",
    a: "Sì, la percezione può cambiare tra persone e zone. La verifichiamo durante la seduta e adattiamo i parametri quando necessario.",
  },
  {
    q: "ICE Polar svolge anche il trattamento laser?",
    a: "No. Il raffreddamento riguarda il comfort durante la seduta. Prima di iniziare valutiamo separatamente pelle, pelo e zona per capire se e come impostare il trattamento.",
  },
  {
    q: "Posso provarlo prima di iniziare un percorso?",
    a: "Durante la valutazione di 30–40 minuti osserviamo pelle, pelo e zona e ti spieghiamo come impostare il percorso. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-laser-ice-polar">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.splitA}
    imageCaption="Il contatto del manipolo. · Scena illustrativa"
    imagePosition="55% 50%"
    kicker="La guida alla tecnologia · ICE Polar"
    title="ICE Polar. Il comfort, _sulla pelle._"
    lead="Conosci il raffreddamento a contatto di Lumina X1 Pro di THORY: come funziona, che sensazione aspettarti e perché partiamo dalla valutazione."
    bullets={["Contatto in zaffiro · Ice Point Cooling", "Parametri scelti per pelle, pelo e zona"]}
    meta={["REBEL · Viale Barbaroux 20, Carmagnola"]}
    ctaPrimary={{ label: "Scopri come funziona", href: "#ice-contatto", halo: true }}
    ctaSecondary={{ label: "Esplora il percorso laser", href: "/epilazione-laser-carmagnola" }}
  />

  <LaserHub variant="ice" />

  <section class="section ice-faq-section" id="laser-faq">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="ICE Polar, _con chiarezza_." />
      <FaqAccordion items={faqs} kicker="Comfort e metodo" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Da dove iniziare · 30–40 minuti"
        title="Il prossimo passo? _Parliamone._"
        lead="Valutiamo zona, pelle e caratteristiche del pelo, poi ti spieghiamo parametri, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/epilazione-laser-carmagnola"
        secondaryLabel="Vedi il percorso laser"
      />
    </div>
  </section>

  <StickyBookingBar promo priceHint={laserOffer.stickyLabel} primary={{ label: "Richiedi la promo", href: laserOffer.contactPath }} />
</BaseLayout>

<style>
  .ice-faq-section{background:#fff;scroll-margin-top:6rem}
</style>
