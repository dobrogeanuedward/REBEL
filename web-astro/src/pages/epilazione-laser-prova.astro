---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Epilazione laser Carmagnola — valutazione 30–40 minuti | Rebel",
  description:
    "Valutazione laser di 30–40 minuti a Carmagnola con Lumina X1 Pro e raffreddamento ICE Polar. Gratuita se inizi il Percorso REBEL.",
  path: "/epilazione-laser-prova",
  keywords: [
    "epilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "valutazione laser Carmagnola",
    "ICE Polar Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Valutazione laser", path: "/epilazione-laser-prova" },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Epilazione laser con Lumina X1 Pro e comfort ICE Polar",
  serviceType: "Epilazione laser",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
  description:
    "Trattamento con Lumina X1 Pro di THORY e raffreddamento ICE Polar. Valutazione di 30–40 minuti, gratuita se inizi il Percorso REBEL.",
};

const faqs = [
  {
    q: "Quanto costa una seduta laser da Rebel?",
    a: "Il prezzo parte da 25,90 € per una singola area e varia in base alla zona. Puoi consultare tutti i prezzi nel listino online prima di prenotare.",
  },
  {
    q: "Cosa include la valutazione laser?",
    a: "Trenta–quaranta minuti in studio per valutare fototipo, pelle, pelo e zona. Ti spieghiamo Lumina X1 Pro, raffreddamento ICE Polar, intervalli e costi indicativi. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero di sedute varia in base a zona, pelle e caratteristiche del pelo. Dopo la valutazione ti diamo una prima stima e la aggiorniamo durante il percorso.",
  },
  {
    q: "Fa male?",
    a: "La sensazione varia in base alla persona e alla zona. ICE Polar raffredda la pelle a contatto durante la seduta; ti chiediamo come lo percepisci e adattiamo i parametri quando serve.",
  },
  {
    q: "Posso fare il laser d'estate?",
    a: "Dipende da esposizione, abbronzatura, zona e condizioni della pelle. Prima della seduta verifichiamo se procedere o riprogrammare.",
  },
  {
    q: "Come capisco se il laser è adatto a me?",
    a: "Lo verifichiamo durante la valutazione iniziale, osservando pelle, zona e caratteristiche del pelo. Prima di procedere ti spieghiamo se il trattamento è indicato e come impostiamo i parametri.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--laser"
  ctaHref="#form"
  ctaLabel="Prenota la valutazione"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    media={media.laser.hero}
    badge="Valutazione 30–40 min"
    kicker="Epilazione laser · Carmagnola"
    title="Prima la valutazione. _Poi il percorso laser._"
    lead="In 30–40 minuti osserviamo pelle, pelo e zona, ti spieghiamo Lumina X1 Pro e il raffreddamento ICE Polar, poi definiamo calendario e costi. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita."
    bullets={[
      { text: "Lumina X1 Pro di THORY, 755 / 808 / 940 / 1064 nm." },
      { text: "Raffreddamento ICE Polar e parametri definiti dopo la valutazione." },
      { text: "Prezzi pubblici, da 25,90 € per area." },
      { text: "Numero e frequenza delle sedute definiti in base a zona, pelle e caratteristiche del pelo." },
    ]}
    primaryCta={{ label: "Prenota la valutazione", href: "#form" }}
    secondaryCta={{ label: "Vedi listino completo", href: "/listino-estetica-laser" }}
    footnote="Ti contattiamo personalmente via WhatsApp o telefono."
  />

  <LandingProof
    kicker="Perché farlo da noi"
    items={[
      {
        title: "Comfort ICE Polar",
        body: "Il raffreddamento accompagna la seduta; percezione e parametri vengono gestiti zona per zona.",
      },
      {
        title: "Operatori formati",
        body: "Il team segue un percorso di formazione continua Thory Academy, dedicato all'uso consapevole delle tecnologie e all'aggiornamento professionale.",
      },
      {
        title: "Prezzi trasparenti",
        body: "Il listino è online: puoi conoscere il prezzo della zona prima di prenotare.",
      },
      {
        title: "Controlli durante il percorso",
        body: "A ogni appuntamento verifichiamo pelle e ricrescita e confermiamo quando programmare la seduta successiva.",
      },
    ]}
  />

  <LandingSteps
    kicker="Come funziona la valutazione"
    title="Trenta–quaranta minuti per capire come iniziare."
    steps={[
      {
        title: "Lascia i tuoi recapiti",
        body: "Nome, telefono e — se vuoi — la zona che ti interesserebbe trattare.",
      },
      {
        title: "Concordiamo l’appuntamento",
        body: "Ti contattiamo su WhatsApp o al telefono per scegliere un orario disponibile.",
      },
      {
        title: "Valutazione in studio",
        body: "Valutiamo fototipo e zona, spieghiamo il trattamento e, se serve, facciamo un test su una piccola area.",
      },
      {
        title: "Definiamo il percorso",
        body: "Ti diamo una stima delle sedute, degli intervalli e del prezzo, poi decidi con calma se iniziare.",
      },
    ]}
  />

  <FullBleedBand
    image={media.laser.mood}
    height="sm"
    align="center"
    kicker="Epilazione laser · Carmagnola"
    quote="Durante la valutazione definiamo parametri, calendario e prezzo."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Valutazione laser"
    title="Prenota la valutazione laser."
    lead="Bastano nome e numero. Se vuoi, scrivici già la zona che ti interesserebbe trattare (ascelle, inguine, gambe, viso…)."
    source="landing-laser"
    defaultMessage=""
    submitLabel="Prenota la valutazione"
    showRitual={false}
    showMessage={true}
  />

  <LandingFaq items={faqs} />
</LandingLayout>
