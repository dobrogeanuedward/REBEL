---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Epilazione laser Carmagnola — valutazione 30–40 minuti | Rebel",
  description:
    "Valutazione laser di 30–40 minuti a Carmagnola con Lumina X1 Pro di THORY e comfort ICE Polar. Gratuita quando finalizzata al Percorso REBEL; home care separata.",
  path: "/epilazione-laser-prova",
  keywords: [
    "epilazione laser Carmagnola",
    "laser diodo Carmagnola",
    "valutazione laser Carmagnola",
    "Ice Polar Carmagnola",
    "epilazione definitiva Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Valutazione laser", path: "/epilazione-laser-prova" },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Epilazione laser con Lumina X1 Pro e comfort ICE Polar",
  serviceType: "Epilazione laser",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
  description:
    "Trattamento con Lumina X1 Pro di THORY e comfort ICE Polar. Valutazione di 30–40 minuti, gratuita quando finalizzata al Percorso REBEL; home care separata.",
};

const faqs = [
  {
    q: "Quanto costa una seduta laser da Rebel?",
    a: "Dipende dalla zona. Per esempio, ascelle 25 €, inguine completo 45 €, gambe complete 110 €. Tutti i prezzi sono pubblici nel listino e non cambiano in base a chi entra. Pacchetti solo se ha senso, mai imposti.",
  },
  {
    q: "Cosa include la valutazione laser?",
    a: "Trenta–quaranta minuti in studio: lettura del fototipo, valutazione di pelle e zona, spiegazione di Lumina X1 Pro e del comfort ICE Polar, più una proposta scritta con intervalli e costi indicativi. La valutazione è gratuita quando è finalizzata alla costruzione del Percorso.",
  },
  {
    q: "Quante sedute servono?",
    a: "In media 6-8 sedute distanziate di 4-8 settimane a seconda della zona. Te lo confermiamo dopo aver visto la pelle: meglio dirlo onestamente in visita che promettere \"in 3 sedute via tutto\".",
  },
  {
    q: "Fa male?",
    a: "La percezione cambia in base alla persona e alla zona. Il comfort ICE Polar accompagna la seduta; su aree più sensibili, come inguine e viso, adattiamo i parametri alla risposta della pelle.",
  },
  {
    q: "Posso fare il laser d'estate?",
    a: "Sì, sulle zone non esposte al sole (ascelle, inguine, addome). Per gambe e viso valutiamo insieme: se ti esponi al sole spesso, conviene partire da settembre.",
  },
  {
    q: "Come capisco se il laser è adatto a me?",
    a: "Lo verifichiamo nella valutazione iniziale osservando pelle, zona e caratteristiche del pelo. Non diamo per scontata l'idoneità sulla base del solo fototipo e calibrare i parametri viene sempre prima della seduta.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--laser"
  ctaHref="#form"
  ctaLabel="Prenota la valutazione"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    badge="Valutazione 30–40 min"
    kicker="Epilazione laser · Carmagnola"
    title="Valuta prima. _Costruisci il Percorso._"
    lead="Valutazione laser di 30–40 minuti: leggiamo pelle e fototipo, ti spieghiamo Lumina X1 Pro di THORY e il comfort ICE Polar, poi prepariamo una proposta con calendario e costi reali. È gratuita quando costruiamo insieme il Percorso."
    bullets={[
      { text: "Lumina X1 Pro di THORY, 755 / 808 / 940 / 1064 nm." },
      { text: "Comfort ICE Polar e parametri definiti dopo la valutazione." },
      { text: "Listino pubblico: ascelle 25 €, inguine completo 45 €." },
      { text: "Niente pacchetti pre-confezionati. Paghi seduta per seduta o a pacchetto, decidi tu." },
    ]}
    primaryCta={{ label: "Prenota la valutazione", href: "#form" }}
    secondaryCta={{ label: "Vedi listino completo", href: "/listino-estetica-laser" }}
    footnote="Risposta entro poche ore via WhatsApp o telefono."
  />

  <LandingProof
    kicker="Perché farlo da noi"
    items={[
      {
        title: "Comfort ICE Polar",
        body: "Il freddo accompagna la seduta; percezione e parametri vengono gestiti zona per zona, senza promettere assenza di sensazioni.",
      },
      {
        title: "Operatori formati",
        body: "Il team segue un percorso di formazione continua Thory Academy, dedicato all'uso consapevole delle tecnologie e all'aggiornamento professionale.",
      },
      {
        title: "Prezzi trasparenti",
        body: "Listino sempre online. Nessuna sorpresa al banco, nessun preventivo \"da telefonarci\".",
      },
      {
        title: "Promemoria gestiti",
        body: "Ti scriviamo noi quando è il momento della seduta successiva, così rispetti i giusti intervalli.",
      },
    ]}
  />

  <LandingSteps
    kicker="Come funziona la prima visita"
    title="Trenta–quaranta minuti per costruire il Percorso con criterio."
    steps={[
      {
        title: "Compili il form",
        body: "Nome, telefono e — se vuoi — la zona che ti interesserebbe trattare.",
      },
      {
        title: "Ti scriviamo entro poche ore",
        body: "Su WhatsApp, con un orario disponibile compatibile con la tua agenda.",
      },
      {
        title: "Visita in studio",
        body: "Lettura del fototipo, valutazione della zona, spiegazione del trattamento e patch test se serve.",
      },
      {
        title: "Proposta scritta",
        body: "Numero di sedute stimato, intervalli, prezzo totale. Decidi se iniziare oggi o pensarci a casa.",
      },
    ]}
  />

  <FullBleedBand
    image={media.laser.mood}
    height="sm"
    align="center"
    kicker="Epilazione laser · Carmagnola"
    quote="Valutazione, parametri e calendario: il Percorso nasce da qui."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Valutazione laser"
    title="Prenota la valutazione laser."
    lead="Bastano nome e numero. Se vuoi, scrivici già la zona che ti interesserebbe trattare (ascelle, inguine, gambe, viso…)."
    source="landing-laser"
    defaultMessage=""
    submitLabel="Prenota la valutazione"
    showRitual={false}
    showMessage={true}
  />

  <LandingFaq items={faqs} />
</LandingLayout>
