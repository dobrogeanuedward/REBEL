---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/epilazione-laser-racconigi");

const meta = createPageMeta({
  title: "Epilazione laser per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description:
    "Da Racconigi a Rebel sono dieci minuti di strada, senza autostrada. È il comune più vicino: il laser smette di essere un evento e diventa una routine semplice. Diodo Thory + Ice Polar, prima valutazione gratuita.",
  path: "/epilazione-laser-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/laser-hero-icepolar.webp",
  openGraphType: "article",
  keywords: [
    "epilazione laser Racconigi",
    "laser Racconigi",
    "centro laser Racconigi",
    "laser diodo Racconigi",
    "epilazione laser vicino Racconigi",
    "laser viso Racconigi",
    "laser corpo Racconigi",
    "laser ascelle Racconigi",
    "laser inguine Racconigi",
    "laser gambe Racconigi",
    "Rebel epilazione laser Racconigi",
    "epilazione laser Racconigi CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Epilazione laser Carmagnola", path: "/epilazione-laser-carmagnola" },
  { name: "Racconigi", path: "/epilazione-laser-racconigi" },
]);

const webPage = buildWebPageSchema({
  name: "Epilazione laser per chi viene da Racconigi",
  description: meta.description,
  path: "/epilazione-laser-racconigi",
});

const articleSchema = buildArticleSchema({
  headline: "Epilazione laser per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description: meta.description,
  path: "/epilazione-laser-racconigi",
  keywords: [
    "epilazione laser Racconigi",
    "laser Racconigi",
    "laser diodo Racconigi",
    "Ice Polar Racconigi",
  ],
  section: "Laser",
  image: "https://www.rebelepigenetica.it/img/generated/laser-hero-icepolar.webp",
});

const laserServiceSchema = buildServiceSchema(
  "Epilazione laser per chi viene da Racconigi",
  "Percorso di epilazione laser per clienti provenienti da Racconigi: laser diodo Thory con manipolo Ice Polar, valutazione iniziale gratuita e piano personalizzato. A circa dieci minuti via SS20.",
  "/epilazione-laser-racconigi",
  {
    priceFrom: 25.9,
    keywords: [
      "epilazione laser Racconigi",
      "laser Racconigi CN",
      "laser diodo Racconigi",
      "Ice Polar Racconigi",
    ],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-racconigi#service-geo`,
  name: "Epilazione laser per chi viene da Racconigi",
  serviceType: "Laser hair removal",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Racconigi",
      containedInPlace: {
        "@type": "AdministrativeArea",
        name: "Provincia di Cuneo",
      },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: {
        "@type": "GeoCoordinates",
        latitude: 44.7676,
        longitude: 7.6786,
      },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "25.90",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Da Racconigi, quanto tempo serve per arrivare a Rebel?",
    a: "Una decina di minuti: sono circa dieci chilometri via SS20 (Via Racconigi), senza autostrada e senza pedaggio. Lo studio è in Viale Barbaroux 20, in centro a Carmagnola, con parcheggio gratuito a un minuto a piedi. È il comune più vicino tra quelli che seguiamo.",
  },
  {
    q: "Visto che siamo vicini, posso fare sedute frequenti senza stress?",
    a: "Esatto, ed è il vantaggio più concreto per chi viene da Racconigi. A dieci minuti porta-a-porta una seduta ogni quattro settimane è una pausa, non una spedizione. E il laser premia proprio la regolarità: chi tiene il ritmo vede risultati più stabili.",
  },
  {
    q: "Posso fare il laser anche in primavera o devo aspettare l'autunno?",
    a: "Puoi partire in qualsiasi stagione. L'inverno è più comodo, ma in primavera o estate scegliamo zone meno esposte (ascelle, inguine, addome) e ti diamo regole pratiche per il post-seduta. Non ti diremo mai di rinunciare al sole, ti diremo come gestirlo.",
  },
  {
    q: "Quante sedute servono in media?",
    a: "Dipende da zona, fototipo e tipo di pelo. Si lavora per cicli (di solito una decina di sedute distribuite su 12-18 mesi), ma il numero esatto te lo diciamo in valutazione, non al telefono. Una stima onesta vale più di una promessa generica.",
  },
  {
    q: "Si paga ogni seduta o c'è un pacchetto da chiudere?",
    a: "Si paga seduta per seduta. Se vuoi fissare il ritmo e bloccare il prezzo, c'è la possibilità di chiudere un piccolo ciclo (di solito 4-6 sedute) — ma non è mai un'imposizione.",
  },
  {
    q: "Posso fare laser + un altro trattamento nello stesso giorno?",
    a: "Sì, con criterio. Vista la vicinanza, molte clienti di Racconigi abbinano laser corpo a manicure semipermanente, laminazione o un massaggio nella stessa sosta. Pulizia viso e protocolli epigenetici sul viso si pianificano invece con un po' di distanza dal laser viso. Lo decidiamo insieme.",
  },
  {
    q: "Come prenoto da Racconigi?",
    a: "Su WhatsApp è il modo più rapido: ci scrivi le zone che ti interessano e i giorni in cui di solito sei libera, ti rispondiamo con gli slot più vicini. Il mercoledì siamo aperti fino alle 19.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/epilazione-laser-racconigi#speakable`,
  name: "Epilazione laser per chi viene da Racconigi",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/epilazione-laser-racconigi`,
};

const principles = [
  {
    kicker: "01 · Il comune più vicino",
    title: "Dieci minuti: la distanza che rende tutto facile.",
    body: "Racconigi è il centro più vicino tra quelli che seguiamo. A dieci minuti via SS20 non esiste la scusa del 'è lontano': la seduta entra nell'agenda come una commissione qualsiasi, e il percorso non si interrompe mai.",
  },
  {
    kicker: "02 · Diodo Thory + Ice Polar",
    title: "Tecnologia, non nome in vetrina.",
    body: "Tre lunghezze d'onda combinate e raffreddamento attivo durante la seduta. Efficace su una gamma ampia di pelli e peli, con comfort migliorato anche su zone sensibili come inguine e ascelle.",
  },
  {
    kicker: "03 · Piano scritto, non a voce",
    title: "Zona, calendario, prezzo: tutto nero su bianco.",
    body: "In consulenza scriviamo il piano: zone, cadenza, regole tra le sedute. Niente 'vedrai che vedrai' — un calendario realistico che puoi seguire senza ansia.",
  },
  {
    kicker: "04 · Comunicazione vera",
    title: "WhatsApp, risposte in giornata.",
    body: "Dubbi su sole, sport, prodotti? Scrivici tra una seduta e l'altra. Rispondere in modo concreto è parte del metodo, non un servizio extra.",
  },
];

const guides = [
  {
    href: "/competenze/epilazione-laser-ascelle-carmagnola-guida-pratica",
    title: "Laser ascelle",
    body: "Piccola zona, grande ritorno quotidiano: spesso si parte da qui.",
  },
  {
    href: "/competenze/epilazione-laser-inguine-carmagnola-guida-pratica",
    title: "Laser inguine",
    body: "Settaggio gentile, calendario realistico, regole pratiche post-seduta.",
  },
  {
    href: "/competenze/laser-gambe-carmagnola-guida-pratica",
    title: "Laser gambe",
    body: "Per chi ha già provato di tutto: l'alternativa con un piano vero e continuità.",
  },
  {
    href: "/servizi/epilazione-laser-viso-carmagnola",
    title: "Laser viso baffetti e mento",
    body: "Zona piccola, settaggio delicato, prima richiesta dopo i 30 anni.",
  },
  {
    href: "/competenze/laser-barba-collo-carmagnola-guida-pratica",
    title: "Laser uomo barba e collo",
    body: "Per peli incarniti e pelle irritata dal rasoio quotidiano.",
  },
  {
    href: "/competenze/peli-incarniti-laser-carmagnola",
    title: "Peli incarniti e laser",
    body: "Quando il problema è sotto pelle: cause, errori tipici e come si risolve.",
  },
];

const seasonCards = [
  {
    href: "/competenze/epilazione-laser-inverno-carmagnola",
    title: "Laser in inverno: perché conviene",
    body: "Il momento più semplice per costruire continuità. Si arriva ai mesi luminosi con il percorso già rodato.",
  },
  {
    href: "/competenze/epilazione-laser-estate-sole-carmagnola",
    title: "Laser e sole: cosa puoi fare davvero",
    body: "Cosa fare davvero e cosa evitare, senza bloccare la tua vita. Weekend e gite: ci si organizza.",
  },
];

const combos = [
  {
    href: "/laminazione-racconigi",
    title: "Laser + laminazione",
    body: "Corpo e sguardo nella stessa sosta: a dieci minuti, ottimizzi davvero il viaggio.",
  },
  {
    href: "/manicure-semipermanente-racconigi",
    title: "Laser + manicure",
    body: "Mani in ordine mentre sei già in zona. Nessun conflitto tra i due trattamenti.",
  },
  {
    href: "/massaggio-rilassante-racconigi",
    title: "Laser + massaggio",
    body: "Cinquanta minuti per staccare davvero, comodi da incastrare visto che sei vicina.",
  },
];

const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "A pochi km, sull'asse per Carmagnola." },
  { city: "Carignano", href: "/localita/carignano", desc: "Subito a nord, lungo la SS20." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Poco più a sud, nella pianura cuneese." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={laserServiceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Laser — da Racconigi a Carmagnola"
    title="Epilazione laser per chi viene da Racconigi: _dieci minuti_, e il percorso non si ferma più."
    lead="Da Racconigi a Rebel sono dieci minuti via SS20, senza autostrada e senza pedaggio. È il comune più vicino tra quelli che seguiamo: la distanza giusta perché il laser smetta di essere un'eccezione e diventi una routine semplice — parametri su misura, manipolo Ice Polar, calendario che regge davvero."
    bullets={["~14 min da Racconigi via SS20", "Diodo Thory + Ice Polar", "Prima valutazione gratuita"]}
    meta={["~10 km da Racconigi", "Da 25,90 € a zona"]}
    ctaPrimary={{ label: "Prenota la valutazione gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicinissimi"
        title="Il comune più vicino: il laser diventa _una routine_, non un evento."
        lead="A dieci minuti porta-a-porta, una seduta ogni quattro settimane non pesa. Ed è esattamente quella continuità a fare il risultato."
      />
      <div class="card-grid card-grid--2">
        {principles.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Pagina pillar laser</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Comfort reale"
          title="Il manipolo _Ice Polar_: efficace senza farti stringere i denti."
          body="Il timore più comune del laser è il fastidio, soprattutto su ascelle e inguine. Il raffreddamento attivo della punta lavora durante l'impulso: la pelle resta protetta e la seduta diventa sostenibile, anche sulle zone delicate."
          bullets={["Diodo Thory a tre lunghezze d'onda (755 + 808 + 1064 nm)", "Raffreddamento attivo continuo durante la seduta", "Adatto a un'ampia gamma di fototipi"]}
          cta={{ label: "Come funziona il comfort Ice Polar", href: "/epilazione-laser-ice-polar-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Racconigi a Rebel: _dieci minuti_ di strada dritta."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Racconigi a Carmagnola sono circa dieci chilometri lungo la
            <strong>SS20 (Via Racconigi)</strong>: si esce dal centro in direzione nord e si
            arriva quasi sempre in dieci-quattordici minuti, senza autostrada e senza pedaggio.
            È il tragitto più semplice tra tutti i comuni che seguiamo.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro Carmagnola.
            Parcheggio gratuito a 30 secondi a piedi.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Racconigi in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Racconigi a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Frequenza"
        title="Il ritmo del laser da Racconigi: _una settimana alla volta_."
        lead="Quando una seduta richiede ore di viaggio si tende a posticipare. Quando basta un quarto d'ora, il ciclo si tiene da solo."
      />
      <p class="body-p" style="max-width:70ch;">
        Per chi parte da Racconigi suggeriamo spesso di fissare un giorno e una fascia oraria
        ricorrenti per le prime sei sedute: vista la vicinanza è quasi un automatismo, e una
        volta che il ritmo è entrato si può rilassare. È il modo più semplice per non perdere
        i momenti utili del ciclo di crescita del pelo.
      </p>
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Zone e guide"
        title="Da Racconigi: le zone che ci vengono _chieste più spesso_."
        lead="Ascelle e inguine per la praticità quotidiana, gambe per chi è stanco di rasoio e ceretta, viso per le richieste più delicate. Ogni zona ha la sua guida pratica."
      />
      <div class="card-grid card-grid--3">
        {guides.map((g) => (
          <FeatureCard
            title={g.title}
            body={g.body}
            href={g.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Il comune più vicino: dieci minuti, e il percorso non si ferma."
      cta={{ label: "Prenota la valutazione gratuita", href: "/contatti" }}
    />
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Quando partire"
        title="Stagionalità: i mesi non sono tutti uguali, ma _nessuno è vietato_."
        lead="La domanda più frequente: 'posso iniziare adesso o aspetto l'inverno?'. La risposta dipende, ma raramente è 'aspetta'."
      />
      <div class="card-grid card-grid--2">
        {seasonCards.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Prezzi"
        title="Quanto costa il laser da Rebel, _per chi viene da Racconigi_."
      />
      <p class="body-p">
        Partiamo da <strong>25,90 € a zona</strong>. Il prezzo della singola seduta dipende
        dall'estensione dell'area: per le aree più piccole (baffetti, mento, ascelle) si resta
        vicini al riferimento di base; per gambe complete e aree ampie si sale, ma in modo
        trasparente — il totale onesto te lo diciamo in consulenza, non con un "da" generico.
        Si paga seduta per seduta; chi preferisce, può chiudere un piccolo ciclo (4-6 sedute)
        per fissare il calendario e bloccare il prezzo.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/listino-estetica-laser">Listino completo</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Pagina pillar laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-ice-polar-carmagnola">Comfort Ice Polar</a>
      </div>
    </div>
  </section>

  {m.splitB ? (
    <section class="section">
      <div class="container">
        <SplitFeature
          image={m.splitB}
          side="left"
          kicker="La prima volta"
          title="Prima un piano _scritto_, poi la prima seduta."
          body="La valutazione iniziale è gratuita e dura una quindicina di minuti. Leggiamo pelle, fototipo e zone, capiamo le tue settimane e ti consegniamo una proposta con prezzi e numero di sedute realistico — non un 'da' che poi cambia."
          bullets={["Valutazione gratuita, senza impegno", "Proposta scritta con prezzi e tempi", "Si paga seduta per seduta"]}
          cta={{ label: "Prenota la valutazione", href: "/contatti" }}
          ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Racconigi: le risposte _oneste_."
      />
      <FaqAccordion items={faqs} kicker="FAQ Laser Racconigi" />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Il laser non è l'unico motivo per venire a Carmagnola _da Racconigi_."
        lead="Se cerchi anche viso (pulizia, protocolli), corpo (drenaggio) o un percorso completo che vada oltre l'epilazione, la pagina panoramica per chi viene da Racconigi ne parla più a fondo."
        primaryHref="/localita/racconigi"
        primaryLabel="Pagina panoramica Rebel per Racconigi"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Tutti i protocolli epigenetici"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino a Racconigi"
        title="Comuni vicini: _pagine dedicate_."
        lead="Sull'asse per Carmagnola si trovano diversi comuni a pochi minuti l'uno dall'altro."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Prenota la _valutazione laser_, in 15 minuti."
        lead="Capiamo zona, ciclo e calendario reale. Ti consegniamo una proposta scritta con prezzi e tempi. Senza obbligo di acquisto — e da Racconigi sei qui in dieci minuti."
        primaryLabel="Prenota la valutazione gratuita"
        primaryHref="/contatti"
        secondaryLabel="Scrivi su WhatsApp"
        secondaryHref={siteConfig.social.whatsapp}
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Laser da 25,90 €/zona" primary={{ label: "Valutazione gratuita", href: "/contatti" }} />
</BaseLayout>

<style>
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
