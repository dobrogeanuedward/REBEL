---
import { getJourney, rebelJourneys } from "@/lib/rebel-journeys";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { journeyPhotographs, photographSchema } from "@/lib/journey-photographs";
import { buildBreadcrumbSchema, createPageMeta } from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
const meta = createPageMeta({ title: "Gallery REBEL | Viso, corpo ed epilazione a Carmagnola", description: "Esplora i nove percorsi REBEL a Carmagnola: valutazioni, manualità, cosmetici e tecnologie per viso, corpo ed epilazione.", path: "/gallery", image: journeyPhotographs[1].src });
const orderedPhotos = [...journeyPhotographs].sort((a,b) => rebelJourneys.findIndex(j => j.slug === a.journey) - rebelJourneys.findIndex(j => j.slug === b.journey));
const archive = [
  { slug: "glow", name: "Glow", title: "Illuminare", alt: "Manualità per l’assorbimento di un cosmetico sul viso" },
  { slug: "longevity", name: "Longevity", title: "Prendersi cura, nel tempo", alt: "Un momento di massaggio viso nel percorso Longevity" },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={buildBreadcrumbSchema([{ name: "Home", path: "/" }, { name: "Gallery", path: "/gallery" }])} />
  <JsonLd data={{ "@context": "https://schema.org", "@type": "ImageGallery", "@id": `${siteConfig.siteUrl}/gallery#gallery`, url: `${siteConfig.siteUrl}/gallery`, name: "La cura, da vicino · REBEL", description: meta.description, inLanguage: "it-IT", publisher: { "@id": `${siteConfig.siteUrl}/#organization` }, image: journeyPhotographs.map(photographSchema), associatedMedia: journeyPhotographs.map(photographSchema), primaryImageOfPage: photographSchema(journeyPhotographs[1]) }} />
  <section class="shoot-gallery">
    <div class="rebel-container">
      <header class="shoot-gallery__intro"><p class="rebel-kicker">REBEL · Carmagnola</p><h1>La cura,<br/><em>da vicino.</em></h1><p>Ascolto, gesti e preparazioni. Entra nell’universo dei nostri percorsi viso, corpo ed epilazione, una scena alla volta.</p><span>Immagini editoriali e illustrative dei percorsi. Per conoscere gli ambienti e il team, <a href="/chi-siamo">visita lo studio</a>.</span></header>
      <nav class="shoot-gallery__nav" aria-label="Percorsi nella gallery">{rebelJourneys.filter(journey => orderedPhotos.some(photo => photo.journey === journey.slug)).map(journey => <a href={`#foto-${journey.slug}`}>{journey.name}</a>)}</nav>
      <div class="shoot-gallery__grid">
        {orderedPhotos.map((photo, i) => <figure id={i === 0 || orderedPhotos[i-1].journey !== photo.journey ? `foto-${photo.journey}` : undefined} class:list={["shoot-gallery__item", { "shoot-gallery__item--portrait": photo.height > photo.width }]}>
          <a href={photo.src} aria-label={`Apri immagine: ${photo.title}`}><img src={photo.src} srcset={`${photo.preview} 640w, ${photo.src} ${photo.width}w`} sizes="(max-width:720px) 92vw, 46vw" alt={photo.alt} width={photo.width} height={photo.height} loading={i < 2 ? "eager" : "lazy"} decoding="async" /></a>
          <figcaption><span class="rebel-kicker">{`${getJourney(photo.journey)?.name} · ${getJourney(photo.journey)?.priority}`}</span><h2>{photo.title}</h2><p>{photo.caption}</p><a href={`/percorsi/${photo.journey}`}>Scopri {getJourney(photo.journey)?.name} →</a></figcaption>
        </figure>)}
        {archive.filter(item => !journeyPhotographs.some(photo => photo.journey === item.slug)).map(item => <figure class="shoot-gallery__item"><a href={`/percorsi/${item.slug}`}><img src={`/img/film-editorial-v1/${item.slug}.webp`} alt={item.alt} width="1664" height="936" loading="lazy" decoding="async" /></a><figcaption><span class="rebel-kicker">{item.name}</span><h2>{item.title}</h2><a href={`/percorsi/${item.slug}`}>Scopri il percorso →</a></figcaption></figure>)}
      </div>
      <div class="shoot-gallery__closing"><p>Ogni percorso parte dalla tua pelle.</p><span>Ti aspettiamo in Viale Barbaroux 20, a Carmagnola.</span><a class="btn btn--primary" href="/contatti">Prenota la tua valutazione</a><a href="/percorsi">Esplora tutti i percorsi →</a></div>
    </div>
  </section>
</BaseLayout>
<style>
.shoot-gallery{padding:clamp(9rem,15vw,12rem) 0 6rem;background:radial-gradient(ellipse at 95% 0%,#ddc8f190,transparent 35%),#f8f3ed;color:#291633}.shoot-gallery__intro{max-width:54rem;margin:0 0 4.5rem}.shoot-gallery__intro h1{font:500 clamp(4rem,9vw,8rem)/.98 var(--font-display);letter-spacing:-.055em;margin:1rem 0 1.7rem;text-transform:none}.shoot-gallery__intro em{color:#87419e}.shoot-gallery__intro>p{font-size:clamp(1.1rem,2vw,1.4rem);max-width:36rem;line-height:1.65}.shoot-gallery__intro>span{display:block;font-size:.8rem;color:#76667d;max-width:37rem;line-height:1.65}.shoot-gallery a{color:inherit}.shoot-gallery__nav{display:flex;flex-wrap:wrap;gap:.65rem;margin:0 0 2.5rem}.shoot-gallery__nav a{padding:.75rem 1rem;border:1px solid #7e3d9635;border-radius:2rem;text-decoration:none;font-size:.9rem;min-height:44px}.shoot-gallery__nav a:hover{background:#ede0f4}.shoot-gallery__item[id]{scroll-margin-top:8rem}.shoot-gallery__grid{display:grid;grid-template-columns:1fr 1fr;gap:3.5rem 2.4rem;align-items:start}.shoot-gallery__item{margin:0;min-width:0}.shoot-gallery__item:nth-child(even){padding-top:6rem}.shoot-gallery__item img{display:block;width:100%;height:auto;object-fit:contain;border-radius:.45rem}.shoot-gallery__item figcaption{padding:1.4rem .2rem 0}.shoot-gallery__item h2{font:500 clamp(1.7rem,3vw,2.7rem)/1.18 var(--font-display);margin:.65rem 0 .75rem;letter-spacing:-.035em}.shoot-gallery__item p{color:#705c79;line-height:1.7;margin:0 0 1rem}.shoot-gallery__item figcaption>a{color:#7e3d96;font-weight:700;font-size:.9rem;text-decoration:none}.shoot-gallery__closing{display:grid;justify-items:center;gap:1.2rem;text-align:center;border-top:1px solid #46265425;margin-top:5rem;padding-top:4rem}.shoot-gallery__closing p{font:500 clamp(2rem,4vw,3rem)/1.2 var(--font-display);margin:0}.shoot-gallery__closing>span{color:#715d79;line-height:1.6}.shoot-gallery__closing>a:last-child{font-size:.85rem}.shoot-gallery a:focus-visible{outline:3px solid #8040c1;outline-offset:5px}@media(max-width:720px){.shoot-gallery__grid{grid-template-columns:1fr;gap:2.8rem}.shoot-gallery__item:nth-child(even){padding-top:0}.shoot-gallery__intro{margin-bottom:2.8rem}.shoot-gallery__intro h1{font-size:4.5rem}}
</style>
