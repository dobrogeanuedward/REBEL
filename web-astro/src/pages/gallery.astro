---
import { beautyPhotographs, beautyImageSchema } from "@/lib/beauty-editorial";
import { getJourney, rebelJourneys } from "@/lib/rebel-journeys";
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import { journeyPhotographs, photographSchema } from "@/lib/journey-photographs";
import { buildBreadcrumbSchema, createPageMeta } from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
const meta = createPageMeta({ title: "Gallery REBEL | Viso, corpo ed epilazione a Carmagnola", description: "Esplora i nove percorsi REBEL a Carmagnola: valutazioni, manualità, cosmetici e tecnologie per viso, corpo ed epilazione.", path: "/gallery", image: journeyPhotographs[1].src });
const orderedPhotos = [...journeyPhotographs].sort((a,b) => rebelJourneys.findIndex(j => j.slug === a.journey) - rebelJourneys.findIndex(j => j.slug === b.journey));
const cover = orderedPhotos[0];
const archive = [
  { slug: "glow", name: "Glow", title: "Illuminare", alt: "Manualità per l’assorbimento di un cosmetico sul viso" },
  { slug: "longevity", name: "Longevity", title: "Prendersi cura, nel tempo", alt: "Un momento di massaggio viso nel percorso Longevity" },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-gallery">
  <JsonLd data={buildBreadcrumbSchema([{ name: "Home", path: "/" }, { name: "Gallery", path: "/gallery" }])} />
  <JsonLd data={{ "@context": "https://schema.org", "@type": "ImageGallery", "@id": `${siteConfig.siteUrl}/gallery#gallery`, url: `${siteConfig.siteUrl}/gallery`, name: "La cura, da vicino · REBEL", description: meta.description, inLanguage: "it-IT", publisher: { "@id": `${siteConfig.siteUrl}/#organization` }, image: [...journeyPhotographs.map(photographSchema), ...beautyPhotographs.map(beautyImageSchema)], associatedMedia: [...journeyPhotographs.map(photographSchema), ...beautyPhotographs.map(beautyImageSchema)], primaryImageOfPage: photographSchema(journeyPhotographs[1]) }} />
  <section class="shoot-gallery">
    <div class="rebel-container">
      <header class="shoot-gallery__intro">
        <div class="shoot-gallery__intro-copy"><p class="rebel-kicker">REBEL · Carmagnola</p><h1>La cura,<br /><em>da vicino.</em></h1><p>Percorsi viso, corpo, epilazione e beauty. Il mondo REBEL raccontato dai gesti, una scena alla volta.</p></div>
        <figure class="shoot-gallery__feature" id={`foto-${cover.journey}`}><a href={cover.src} aria-label={`Apri immagine: ${cover.title}`}><img src={cover.src} srcset={`${cover.preview} 640w, ${cover.src} ${cover.width}w`} sizes="(max-width:760px) 94vw, 52vw" alt={cover.alt} width={cover.width} height={cover.height} fetchpriority="high" decoding="async" /></a><figcaption><span class="rebel-kicker">{getJourney(cover.journey)?.name}</span><h2>{cover.title}</h2><p>{cover.caption}</p><a href={`/percorsi/${cover.journey}`}>Scopri {getJourney(cover.journey)?.name} <span aria-hidden="true">↗</span></a></figcaption></figure>
      </header>
      <p class="shoot-gallery__note">Immagini editoriali e illustrative dei percorsi e dei trattamenti. Per conoscere gli ambienti e il team, <a href="/chi-siamo">visita lo studio</a>.</p>
      <nav class="shoot-gallery__nav" aria-label="Percorsi nella gallery">{rebelJourneys.filter(journey => orderedPhotos.some(photo => photo.journey === journey.slug)).map(journey => <a href={`#foto-${journey.slug}`}>{journey.name}</a>)}<a href="#foto-beauty">Trattamenti beauty</a></nav>
      <div class="shoot-gallery__grid">
        {orderedPhotos.slice(1).map((photo, i) => <figure id={orderedPhotos[i].journey !== photo.journey ? `foto-${photo.journey}` : undefined} class:list={["shoot-gallery__item", { "shoot-gallery__item--portrait": photo.height > photo.width }]}>
          <a href={photo.src} aria-label={`Apri immagine: ${photo.title}`}><img src={photo.src} srcset={`${photo.preview} 640w, ${photo.src} ${photo.width}w`} sizes="(max-width:720px) 92vw, 46vw" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></a>
          <figcaption><span class="rebel-kicker">{`${getJourney(photo.journey)?.name} · ${getJourney(photo.journey)?.priority}`}</span><h2>{photo.title}</h2><p>{photo.caption}</p><a href={`/percorsi/${photo.journey}`}>Scopri {getJourney(photo.journey)?.name} →</a></figcaption>
        </figure>)}
        {archive.filter(item => !journeyPhotographs.some(photo => photo.journey === item.slug)).map(item => <figure class="shoot-gallery__item"><a href={`/percorsi/${item.slug}`}><img src={`/img/film-editorial-v1/${item.slug}.webp`} alt={item.alt} width="1664" height="936" loading="lazy" decoding="async" /></a><figcaption><span class="rebel-kicker">{item.name}</span><h2>{item.title}</h2><a href={`/percorsi/${item.slug}`}>Scopri il percorso →</a></figcaption></figure>)}
      </div>
      <section id="foto-beauty" class="beauty-gallery"><header><p class="rebel-kicker">Trattamenti beauty</p><h2>La bellezza dei piccoli gesti.</h2><p>Fotografie editoriali e illustrative. Apri la scheda collegata per dettagli, prezzi e prenotazioni.</p></header><div class="shoot-gallery__grid">{beautyPhotographs.map(photo=><figure class="shoot-gallery__item"><a href={photo.src} aria-label={`Apri immagine: ${photo.title}`}><img src={photo.src} srcset={`${photo.preview} 480w, ${photo.src} ${photo.width}w`} sizes="(max-width:720px) 92vw, 46vw" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async"/></a><figcaption><span class="rebel-kicker">Beauty · REBEL</span><h2>{photo.title}</h2><p>{photo.caption}</p><a href={photo.path}>Esplora il trattamento →</a></figcaption></figure>)}</div></section>
      <div class="shoot-gallery__closing"><p>Ogni percorso parte dalla tua pelle.</p><span>Ti aspettiamo in Viale Barbaroux 20, a Carmagnola.</span><a class="btn btn--primary" href="/contatti">Prenota la tua valutazione</a><a href="/percorsi">Esplora tutti i percorsi →</a></div>
    </div>
  </section>
</BaseLayout>
<style>
  .shoot-gallery { padding:clamp(7.5rem,11vw,10rem) 0 6rem;background:#fbf7f2;color:#301a3a; }
  .shoot-gallery a { color:inherit; }
  .shoot-gallery__intro { display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,5vw,5rem);align-items:center;margin-bottom:2rem; }
  .shoot-gallery__intro-copy { min-width:0; }
  .shoot-gallery__intro-copy h1 { margin:1rem 0 1.5rem;color:#301a3a;font:500 clamp(3.2rem,6.7vw,6.5rem)/1.02 var(--font-display);letter-spacing:-.055em;text-transform:none; }
  .shoot-gallery__intro-copy em { color:#85497c;font-weight:400; }
  .shoot-gallery__intro-copy > p:not(.rebel-kicker) { max-width:32ch;color:#705c79;font-size:1rem;line-height:1.85; }
  .shoot-gallery__feature { margin:0;min-width:0;scroll-margin-top:7rem; }
  .shoot-gallery__feature > a { display:block;overflow:hidden;border-radius:.4rem 3rem .4rem .4rem; }
  .shoot-gallery__feature img { display:block;width:100%;height:auto; }
  .shoot-gallery__feature figcaption { display:grid;grid-template-columns:1fr auto;gap:.4rem 1rem;padding-top:1rem; }
  .shoot-gallery__feature figcaption .rebel-kicker { margin:0;font-size:.62rem; }
  .shoot-gallery__feature h2 { grid-column:1;grid-row:2;margin:0;color:#301a3a;font:500 clamp(1.4rem,2vw,2rem)/1.2 var(--font-display);letter-spacing:-.025em; }
  .shoot-gallery__feature figcaption > p { grid-column:1/-1;margin:.3rem 0 0;color:#705c79;font-size:.75rem;line-height:1.7; }
  .shoot-gallery__feature figcaption > a { grid-column:2;grid-row:1/3;display:inline-flex;align-items:center;gap:.6rem;min-height:44px;color:#814480;font-size:.7rem;font-weight:700;text-decoration:none; }
  .shoot-gallery__note { margin:1.5rem 0;color:#7b6781;font-size:.7rem;line-height:1.8; }
  .shoot-gallery__note a { color:#814480;text-underline-offset:.3em; }
  .shoot-gallery__nav { display:flex;flex-wrap:wrap;gap:.6rem;margin:0 0 2.5rem; }
  .shoot-gallery__nav a { display:inline-flex;align-items:center;min-height:44px;padding:.65rem 1rem;border:1px solid #8b588a35;border-radius:2rem;color:#78517c;text-decoration:none;font-size:.75rem; }
  .shoot-gallery__nav a:hover { background:#eee3ee; }
  .shoot-gallery__item[id] { scroll-margin-top:7rem; }
  .shoot-gallery__grid { display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:3.5rem 2.4rem;align-items:start; }
  .shoot-gallery__item { margin:0;min-width:0; }
  .shoot-gallery__item:nth-child(even) { padding-top:4rem; }
  .shoot-gallery__item img { display:block;width:100%;height:auto;object-fit:contain;border-radius:.4rem; }
  .shoot-gallery__item figcaption { padding:1.4rem .2rem 0; }
  .shoot-gallery__item h2 { font:500 clamp(1.7rem,3vw,2.7rem)/1.18 var(--font-display);margin:.65rem 0 .75rem;letter-spacing:-.035em; }
  .shoot-gallery__item p { color:#705c79;line-height:1.7;margin:0 0 1rem; }
  .shoot-gallery__item figcaption > a { display:inline-flex;align-items:center;min-height:44px;color:#814480;font-weight:700;font-size:.85rem;text-decoration:none; }
  .beauty-gallery { padding-top:5rem;scroll-margin-top:7rem; }
  .beauty-gallery > header { margin-bottom:3rem; }
  .beauty-gallery > header h2 { font:500 clamp(2.5rem,5vw,4rem)/1.1 var(--font-display); }
  .beauty-gallery > header p:last-child { color:#705c79;line-height:1.7;max-width:40rem; }
  .shoot-gallery__closing { display:grid;justify-items:center;gap:1.2rem;text-align:center;border-top:1px solid #46265425;margin-top:5rem;padding-top:4rem; }
  .shoot-gallery__closing p { font:500 clamp(2rem,4vw,3rem)/1.2 var(--font-display);margin:0; }
  .shoot-gallery__closing > span { color:#715d79;line-height:1.6; }
  .shoot-gallery__closing > a:last-child { display:inline-flex;align-items:center;min-height:44px;font-size:.85rem; }
  .shoot-gallery a:focus-visible { outline:3px solid #8040c1;outline-offset:5px; }
  @media(max-width:760px) {
    .shoot-gallery { padding-top:7rem; }.shoot-gallery__intro { grid-template-columns:minmax(0,1fr);gap:1.7rem;margin-bottom:1.5rem; }.shoot-gallery__intro-copy h1 { font-size:clamp(3rem,11vw,4.5rem);margin:.8rem 0 1rem; }.shoot-gallery__intro-copy > p:not(.rebel-kicker) { max-width:42ch;font-size:.9rem;line-height:1.8; }.shoot-gallery__feature > a { border-radius:.4rem 2rem .4rem .4rem; }
    .shoot-gallery__grid { grid-template-columns:minmax(0,1fr);gap:2.8rem; }.shoot-gallery__item:nth-child(even) { padding-top:0; }.shoot-gallery__nav { flex-wrap:nowrap;overflow-x:auto;gap:.5rem;padding:.25rem 0 .7rem;margin-bottom:1.8rem;scrollbar-width:thin;scrollbar-color:#c0a1be transparent; }.shoot-gallery__nav a { flex:0 0 auto; }.shoot-gallery__note { font-size:.65rem; }
  }
  @media(max-width:380px) { .shoot-gallery__feature figcaption { grid-template-columns:minmax(0,1fr); }.shoot-gallery__feature figcaption > a { grid-column:1;grid-row:auto; }.shoot-gallery__feature figcaption > p { grid-column:1; } }
</style>
