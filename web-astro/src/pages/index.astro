---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StoreGallery from "@/components/StoreGallery.tsx";
import InstagramFeed from "@/components/InstagramFeed.astro";
import { storeGalleryImages } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Rebel Estetica Epigenetica a Carmagnola — Metodo, Percorsi e Laser",
  description:
    "Rebel costruisce percorsi estetici evolutivi a Carmagnola: Valutazione Rebel, Skin Reset, attivi epigenetici, tecnologie e Laser Ice Polar.",
  path: "/",
  keywords: [
    "centro estetico Carmagnola",
    "estetica epigenetica Carmagnola",
    "Metodo Rebel",
    "percorsi viso Carmagnola",
    "rimodellamento corpo Carmagnola",
    "epilazione laser Carmagnola",
    "Laser Ice Polar",
  ],
});

const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }]);
const webPage = buildWebPageSchema({ name: "Rebel Estetica Epigenetica", description: meta.description, path: "/" });
const article = buildArticleSchema({
  headline: "Ogni pelle ha una priorità. Scopri il Metodo Rebel.",
  description: meta.description,
  path: "/",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Home",
});

const heroImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";
const faceImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";
const bodyImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/9d9033f2-f11f-4485-f69c-38d05556bb00/public";
const freedomImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e63a6c84-f777-4f2d-995b-eef9c7e09900/public";

const method = [
  ["01", "Valutazione", "Ascoltiamo desideri, abitudini e storia della pelle."],
  ["02", "Priorità", "Individuiamo ciò che viene prima nel momento attuale."],
  ["03", "Skin Reset", "Prepariamo la pelle a ricevere il percorso."],
  ["04", "Percorso", "Combiniamo manualità, attivi e tecnologie con una ragione precisa."],
  ["05", "Rivalutazione", "Osserviamo la risposta e aggiorniamo sequenza e frequenza."],
  ["06", "Preservare", "Accompagniamo nel tempo l’equilibrio raggiunto."],
];

const priorities = ["Comfort", "Purezza", "Luminosità", "Idratazione", "Struttura", "Uniformità", "Longevità"];

const journeys = [
  {
    name: "Glow",
    kicker: "Percorsi viso",
    copy: "Per una pelle più luminosa, uniforme e vitale. Skin Reset, attivi selezionati e tecnologie entrano in una progressione costruita sulla priorità attuale.",
    image: faceImage,
    tags: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Longevity",
    kicker: "Preservare nel tempo",
    copy: "Un percorso dinamico dedicato a barriera, elasticità, tonicità e qualità della pelle. Lift, Collagen, Rebirth 60+ ed Eye Genesis diventano strumenti della stessa regia.",
    image: faceImage,
    tags: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Forma",
    kicker: "Valorizzare il corpo",
    copy: "Una valutazione globale di tessuti, tonicità, microcircolo, ritenzione e obiettivi personali apre un programma progressivo per leggerezza, compattezza e armonia.",
    image: bodyImage,
    tags: ["Lift Body", "LPG", "Pressomassaggio", "Tecar", "Crioterapia"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Libertà",
    kicker: "Pelle libera, gesto sicuro",
    copy: "Il percorso dedicato all’epilazione combina Valutazione Rebel, tecnologia Laser Ice Polar e calendario calibrato sulla zona e sulla risposta reale.",
    image: freedomImage,
    tags: ["Laser Ice Polar", "Comfort", "Progressione", "Total Body"],
    href: "/epilazione-laser-carmagnola",
  },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <div class="rebel-shell">
    <section class="rebel-hero" style={`--hero-image: url('${heroImage}')`}>
      <div class="rebel-container rebel-hero__copy">
        <div class="rebel-hero__eyebrow" data-reveal>
          <span>Rebel · Estetica Epigenetica</span><span>Viale Barbaroux 20 · Carmagnola</span>
        </div>
        <h1 class="rebel-display" data-reveal style="--reveal-delay:50ms">Ogni pelle ha una priorità.</h1>
        <div class="rebel-spectrum-rule"></div>
        <p class="rebel-lead" data-reveal style="--reveal-delay:120ms">
          Rebel osserva la pelle nel suo contesto e costruisce una direzione precisa. Manualità,
          attivi e tecnologie entrano nel momento in cui servono. Il percorso evolve insieme a te.
        </p>
        <div class="rebel-hero__actions" data-reveal style="--reveal-delay:180ms">
          <a class="btn btn--primary" href="/metodo-rebel">Scopri il Metodo Rebel</a>
          <a class="btn btn--secondary" href="/contatti">Prenota la Valutazione Rebel</a>
        </div>
        <div class="rebel-hero__signature"><strong>Be Beautiful. Be Rebel.</strong><span>Prima la pelle. Poi la tecnologia.</span></div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container rebel-manifesto">
        <div>
          <p class="rebel-kicker">Manifesto</p>
          <h2 class="rebel-manifesto__quote">La pelle cambia.<br/><em>Il percorso evolve.</em></h2>
        </div>
        <div>
          <p class="rebel-lead">La tua pelle cambia con il tempo, le stagioni e le abitudini. La Professionista Rebel individua la priorità attuale, seleziona gli strumenti e osserva la risposta nel tempo.</p>
          <p class="rebel-lead"><strong>Estetica Epigenetica</strong> significa accompagnare l’equilibrio della pelle attraverso scelte professionali mirate, coordinate e aggiornabili.</p>
        </div>
      </div>
    </section>

    <section class="rebel-section" id="metodo">
      <div class="rebel-container rebel-method">
        <div class="rebel-method__intro">
          <p class="rebel-kicker">Il Metodo Rebel</p>
          <h2 class="rebel-title">Una regia professionale in sei passaggi.</h2>
          <p class="rebel-lead">La consulenza diventa una direzione concreta. Ogni scelta ha una funzione, una sequenza e un momento di rivalutazione.</p>
          <div class="rebel-map">
            <div class="rebel-map__head"><strong>MAPPA REBEL</strong><br/><small>Priorità / Percorso / Rivalutazione</small></div>
            <div class="rebel-map__fields">
              {['Priorità attuale','Obiettivo condiviso','Percorso consigliato','Primo step','Manualità, attivi e tecnologie','Frequenza iniziale','Data della rivalutazione','Evoluzione del percorso'].map((field)=><span>{field}</span>)}
            </div>
          </div>
        </div>
        <div class="rebel-method__steps">
          {method.map(([number,title,text]) => (
            <article class="rebel-method__step"><b>{number}</b><div><h3>{title}</h3><p>{text}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Le 7 priorità della pelle</p>
        <h2 class="rebel-title">Prima di scegliere un trattamento, capiamo cosa viene prima.</h2>
        <div class="rebel-priorities">
          {priorities.map((priority,index)=><article class="rebel-priority"><small>0{index+1}</small><h3>{priority}</h3></article>)}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--plum">
      <div class="rebel-container">
        <p class="rebel-kicker">I Percorsi Rebel</p>
        <h2 class="rebel-title">I protocolli diventano strumenti. Il percorso diventa la regia.</h2>
        <p class="rebel-lead">Lift, Rebirth, Eye Genesis, Catalysis, Collagen, Cell Regen e Lift Body non scompaiono: vengono interpolati nella nuova architettura e attivati in base alla priorità.</p>
        <div class="rebel-journeys">
          {journeys.map((journey)=>(
            <a class="rebel-journey" href={journey.href} style={`--journey-image:url('${journey.image}')`}>
              <div class="rebel-journey__copy"><p class="rebel-kicker">{journey.kicker}</p><h3>{journey.name}</h3><p>{journey.copy}</p><div class="rebel-journey__tags">{journey.tags.map(tag=><span>{tag}</span>)}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Rebel World</p>
        <h2 class="rebel-title">Un mondo di bellezza, guidato dal metodo.</h2>
        <div class="rebel-world">
          <article class="rebel-world__card"><h3>SKIN</h3><p>Percorsi viso, Skin Reset, Laminazione Coreana, sguardo e attivi epigenetici.</p><a href="/protocolli-epigenetici">Esplora Skin →</a></article>
          <article class="rebel-world__card"><h3>BODY</h3><p>Forma, rimodellamento, pressomassaggio, crioterapia e percorsi corpo.</p><a href="/listino-estetica-laser">Esplora Body →</a></article>
          <article class="rebel-world__card"><h3>TECH</h3><p>Laser Ice Polar, Tecar Terapia e tecnologie selezionate dalla Professionista Rebel.</p><a href="/epilazione-laser-carmagnola">Esplora Tech →</a></article>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Lo studio reale</p>
        <h2 class="rebel-title">Quattro cabine. Una sola regia Rebel.</h2>
        <p class="rebel-lead">Il mondo visual incontra lo spazio reale di Viale Barbaroux 20: accoglienza, tecnologie e professioniste che seguono ogni evoluzione.</p>
        <StoreGallery client:visible images={storeGalleryImages} />
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Rebel, ogni settimana</p>
        <h2 class="rebel-title">Trattamenti, backstage e cultura della pelle.</h2>
        <InstagramFeed showReels={true} showPosts={true} maxReels={4} maxPosts={3} hidePostsOnMobile={true} />
      </div>
    </section>

    <section class="rebel-campaign">
      <div class="rebel-container">
        <strong>Be <span>Cool.</span><br/>Be Rebel.</strong>
        <p>La firma campaign di Rebel vive su ventaglio, bag, fiera, contenuti stagionali e attivazioni più pop. La firma istituzionale resta “Be Beautiful. Be Rebel.”</p>
        <div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la Valutazione Rebel</a><a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Scrivici su WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
