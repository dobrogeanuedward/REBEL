---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StoreGallery from "@/components/StoreGallery.tsx";
import InstagramFeed from "@/components/InstagramFeed.astro";
import { storeGalleryImages } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Rebel Estetica Epigenetica a Carmagnola — Metodo, Percorsi e Laser",
  description:
    "Rebel crea percorsi estetici personalizzati a Carmagnola: valutazione iniziale, attivi epigenetici, tecnologie e Laser Ice Polar.",
  path: "/",
  keywords: [
    "centro estetico Carmagnola",
    "estetica epigenetica Carmagnola",
    "Metodo Rebel",
    "percorsi viso Carmagnola",
    "rimodellamento corpo Carmagnola",
    "epilazione laser Carmagnola",
    "Laser Ice Polar",
  ],
});

const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }]);
const webPage = buildWebPageSchema({ name: "Rebel Estetica Epigenetica", description: meta.description, path: "/" });
const article = buildArticleSchema({
  headline: "La tua pelle cambia. Anche il percorso deve cambiare.",
  description: meta.description,
  path: "/",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Home",
});

const heroImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";
const faceImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";
const bodyImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/9d9033f2-f11f-4485-f69c-38d05556bb00/public";
const freedomImage = "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e63a6c84-f777-4f2d-995b-eef9c7e09900/public";

const method = [
  ["01", "Ti ascoltiamo", "Partiamo da ciò che vuoi migliorare e da come vivi la tua pelle ogni giorno."],
  ["02", "Osserviamo la pelle", "Valutiamo il momento attuale e capiamo quali aspetti meritano più attenzione."],
  ["03", "Definiamo la priorità", "Stabiliamo insieme da dove iniziare e quale risultato vogliamo raggiungere."],
  ["04", "Costruiamo il percorso", "Scegliamo manualità, attivi e tecnologie in funzione delle tue esigenze."],
  ["05", "Seguiamo l’evoluzione", "Controlliamo la risposta della pelle e aggiorniamo frequenza e intensità."],
  ["06", "Manteniamo il risultato", "Consolidiamo ciò che hai ottenuto con richiami mirati e una routine essenziale."],
];

const priorities = ["Comfort", "Purezza", "Luminosità", "Idratazione", "Struttura", "Uniformità", "Longevità"];

const journeys = [
  {
    name: "Glow",
    kicker: "Percorsi viso",
    copy: "Per una pelle più luminosa, uniforme e vitale. Ogni fase viene scelta in base alla priorità del momento.",
    image: faceImage,
    tags: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Longevity",
    kicker: "Mantenere ciò che hai conquistato",
    copy: "Un percorso dedicato a elasticità, tonicità e qualità della pelle, pensato per accompagnarla nel tempo.",
    image: faceImage,
    tags: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Forma",
    kicker: "Ritrovare leggerezza e tono",
    copy: "Un programma progressivo costruito su tessuti, microcircolo, ritenzione e obiettivi personali.",
    image: bodyImage,
    tags: ["Lift Body", "LPG", "Pressomassaggio", "Tecar", "Crioterapia"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Libertà",
    kicker: "Pelle liscia. Senza pensieri.",
    copy: "Il percorso dedicato all’epilazione combina valutazione iniziale, Laser Ice Polar e un calendario costruito sulla zona e sulla risposta reale.",
    image: freedomImage,
    tags: ["Laser Ice Polar", "Comfort", "Progressione", "Total Body"],
    href: "/epilazione-laser-carmagnola",
  },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <div class="rebel-shell">
    <section class="rebel-hero" style={`--hero-image: url('${heroImage}')`}>
      <div class="rebel-container rebel-hero__copy">
        <div class="rebel-hero__eyebrow" data-reveal>
          <span>Rebel · Estetica Epigenetica</span><span>Viale Barbaroux 20 · Carmagnola</span>
        </div>
        <h1 class="rebel-display" data-reveal style="--reveal-delay:50ms">La tua pelle cambia.</h1>
        <div class="rebel-spectrum-rule"></div>
        <p class="rebel-lead" data-reveal style="--reveal-delay:120ms">
          Anche il percorso deve cambiare. Da Rebel ogni trattamento nasce da una valutazione della pelle,
          delle tue esigenze e del risultato che vuoi raggiungere.
        </p>
        <div class="rebel-hero__actions" data-reveal style="--reveal-delay:180ms">
          <a class="btn btn--primary" href="/metodo-rebel">Scopri il Metodo Rebel</a>
          <a class="btn btn--secondary" href="/contatti">Prenota la prima visita</a>
        </div>
        <div class="rebel-hero__signature"><strong>Be Beautiful. Be Rebel.</strong><span>Prima la pelle. Poi la tecnologia.</span></div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container rebel-manifesto">
        <div>
          <p class="rebel-kicker">Come lavoriamo</p>
          <h2 class="rebel-manifesto__quote">La pelle cambia.<br/><em>Il percorso evolve.</em></h2>
        </div>
        <div>
          <p class="rebel-lead">La tua pelle cambia con il tempo, le stagioni e le abitudini. Per questo partiamo sempre da ciò che serve davvero oggi.</p>
          <p class="rebel-lead"><strong>Estetica Epigenetica</strong> significa scegliere con precisione trattamenti, attivi e tecnologie e aggiornarli nel tempo in base alla risposta della pelle.</p>
        </div>
      </div>
    </section>

    <section class="rebel-section" id="metodo">
      <div class="rebel-container rebel-method">
        <div class="rebel-method__intro">
          <p class="rebel-kicker">Il Metodo Rebel</p>
          <h2 class="rebel-title">Sei passaggi per costruire il percorso giusto.</h2>
          <p class="rebel-lead">La prima visita serve a capire da dove partire. Ogni scelta ha un obiettivo preciso e viene aggiornata nel tempo.</p>
          <div class="rebel-map">
            <div class="rebel-map__head"><strong>MAPPA REBEL</strong><br/><small>Priorità / Percorso / Rivalutazione</small></div>
            <div class="rebel-map__fields">
              {['Priorità attuale','Obiettivo condiviso','Percorso consigliato','Primo step','Manualità, attivi e tecnologie','Frequenza iniziale','Data della rivalutazione','Evoluzione del percorso'].map((field)=><span>{field}</span>)}
            </div>
          </div>
        </div>
        <div class="rebel-method__steps">
          {method.map(([number,title,text]) => (
            <article class="rebel-method__step"><b>{number}</b><div><h3>{title}</h3><p>{text}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Le 7 priorità della pelle</p>
        <h2 class="rebel-title">Prima di scegliere un trattamento, capiamo cosa viene prima.</h2>
        <div class="rebel-priorities">
          {priorities.map((priority,index)=><article class="rebel-priority"><small>0{index+1}</small><h3>{priority}</h3></article>)}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--plum">
      <div class="rebel-container">
        <p class="rebel-kicker">I Percorsi Rebel</p>
        <h2 class="rebel-title">Ogni percorso nasce da una priorità precisa.</h2>
        <p class="rebel-lead">Lift, Rebirth, Eye Genesis, Catalysis, Collagen, Cell Regen e Lift Body vengono scelti e combinati in base alla pelle, al corpo e al risultato che vuoi raggiungere.</p>
        <div class="rebel-journeys">
          {journeys.map((journey)=>(
            <a class="rebel-journey" href={journey.href} style={`--journey-image:url('${journey.image}')`}>
              <div class="rebel-journey__copy"><p class="rebel-kicker">{journey.kicker}</p><h3>{journey.name}</h3><p>{journey.copy}</p><div class="rebel-journey__tags">{journey.tags.map(tag=><span>{tag}</span>)}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Tutto Rebel</p>
        <h2 class="rebel-title">Viso, corpo e tecnologia. In un unico percorso.</h2>
        <div class="rebel-world">
          <article class="rebel-world__card"><h3>SKIN</h3><p>Percorsi viso, Skin Reset, Laminazione Coreana, sguardo e attivi epigenetici.</p><a href="/protocolli-epigenetici">Scopri i percorsi viso →</a></article>
          <article class="rebel-world__card"><h3>BODY</h3><p>Forma, rimodellamento, pressomassaggio, crioterapia e percorsi corpo.</p><a href="/listino-estetica-laser">Scopri i percorsi corpo →</a></article>
          <article class="rebel-world__card"><h3>TECH</h3><p>Laser Ice Polar, Tecar e tecnologie selezionate in base alle tue esigenze.</p><a href="/tecnologie-rebel">Scopri le tecnologie →</a></article>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Lo studio</p>
        <h2 class="rebel-title">Quattro cabine. Un percorso costruito su di te.</h2>
        <p class="rebel-lead">In Viale Barbaroux 20 trovi accoglienza, tecnologie e professioniste che seguono ogni fase del tuo percorso.</p>
        <StoreGallery client:visible images={storeGalleryImages} />
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Rebel, ogni settimana</p>
        <h2 class="rebel-title">Trattamenti, backstage e consigli per la pelle.</h2>
        <InstagramFeed showReels={true} showPosts={true} maxReels={4} maxPosts={3} hidePostsOnMobile={true} />
      </div>
    </section>

    <section class="rebel-campaign">
      <div class="rebel-container">
        <strong>Be <span>Cool.</span><br/>Be Rebel.</strong>
        <p>La firma più libera e pop di Rebel, pensata per campagne stagionali, eventi e materiali speciali.</p>
        <div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la prima visita</a><a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Scrivici su WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
