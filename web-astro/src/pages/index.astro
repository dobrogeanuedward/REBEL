---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StoreGallery from "@/components/StoreGallery.tsx";
import DeployedJourneyMap from "@/components/DeployedJourneyMap.astro";
import HomeFilm from "@/components/HomeFilm.astro";
import LocalBookingGuide from "@/components/LocalBookingGuide.astro";
import TreatmentGallery from "@/components/TreatmentGallery.astro";
import "@/styles/live-preserved.css";
import InstagramFeed from "@/components/InstagramFeed.astro";
import LaserOffer from "@/components/LaserOffer.astro";
import { methodSteps, storeGalleryImages } from "@/lib/content";
import { rebelWorlds, getJourneysByWorld } from "@/lib/rebel-journeys";
import { siteConfig } from "@/lib/site-config";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Rebel Estetica Epigenetica a Carmagnola — Viso, Corpo e Laser",
  description:
    "Centro estetico a Carmagnola per trattamenti viso, percorsi corpo, epilazione laser, manicure e benessere. Valutazione REBEL di 30–40 minuti.",
  path: "/",
  keywords: [
    "centro estetico Carmagnola",
    "estetica epigenetica Carmagnola",
    "Metodo Rebel",
    "percorsi viso Carmagnola",
    "rimodellamento corpo Carmagnola",
    "epilazione laser Carmagnola",
    "Laser Ice Polar",
  ],
});

const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }]);
const webPage = buildWebPageSchema({ name: "Rebel Estetica Epigenetica", description: meta.description, path: "/" });
const article = buildArticleSchema({
  headline: "Trattamenti viso, percorsi corpo ed epilazione laser a Carmagnola",
  description: meta.description,
  path: "/",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Home",
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const faceImage = siteAsset("journeys.glow.hero.desktop");
const bodyImage = siteAsset("journeys.forma.hero.desktop");
const studioImage = siteAsset("studio.real.overview.desktop");
const consultationImage = "/img/film-editorial-v1/consultation.webp";
const activesImage = siteAsset("services.face.activesTopshot.mobile");
const skinTextureImage = siteAsset("services.face.skinTexture.mobile");

const priorities = [
  ["Sensibilità e comfort", "Rossori, reattività e sensazioni di pelle che tira."],
  ["Impurità e imperfezioni", "Comedoni, lucidità, grana irregolare e zone con impurità."],
  ["Pelle spenta", "Colorito poco uniforme e luminosità ridotta."],
  ["Disidratazione", "Pelle che tira, comfort ridotto e linee superficiali."],
  ["Perdita di tono", "Elasticità e compattezza da sostenere nel tempo."],
  ["Macchie e colorito irregolare", "Discromie e differenze visibili fra le zone del viso."],
  ["Segni del tempo", "Rughe, contorno occhi e qualità generale della pelle."],
];

const journeyImages = {
  glow: siteAsset("journeys.glow.moment"),
  longevity: siteAsset("journeys.longevity.moment"),
  forma: siteAsset("services.technologies.detail.desktop"),
  liberta: siteAsset("services.laser.handpiece.desktop"),
};
const journeys = rebelWorlds.map((world) => ({
  name: world.name,
  kicker: world.eyebrow,
  copy: world.summary,
  image: journeyImages[world.id],
  tags: getJourneysByWorld(world.id).map((journey) => journey.slug === "white" ? "Uniformare" : journey.name),
  href: world.href,
}));

const worlds = [
  {
    number: "01",
    name: "Viso",
    copy: "Pulizia viso, Glow, Longevity, trattamenti con attivi epigenetici, contorno occhi e laminazione coreana.",
    image: faceImage,
    href: "/percorsi",
    cta: "Esplora il viso",
  },
  {
    number: "02",
    name: "Corpo",
    copy: "Drenaggio, massaggi, rimodellamento e LPG in percorsi definiti dopo la valutazione.",
    image: bodyImage,
    href: "/percorsi/forma",
    cta: "Esplora il corpo",
  },
  {
    number: "03",
    name: "Tecnologie",
    copy: "Tecnologie professionali per viso, corpo ed epilazione, scelte in base alla zona e all’obiettivo.",
    image: siteAsset("technologies.studio.thory.desktop"),
    href: "/tecnologie-rebel",
    cta: "Conosci le tecnologie",
  },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <div class="rebel-shell">
    <HomeFilm />
    <nav class="home-decision-nav" aria-label="Scegli da dove iniziare"><a href="/listino-estetica-laser"><span>So cosa cerco</span><strong>Trattamenti e prezzi ↗</strong></a><a href="/promo-epilazione-laser-carmagnola"><span>La promozione del momento</span><strong>Scopri la promo laser ↗</strong></a><a href="/contatti#prenota"><span>Vorrei un consiglio</span><strong>Parliamone con REBEL ↗</strong></a></nav>
    <TreatmentGallery />

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container rebel-manifesto">
        <div>
          <p class="rebel-kicker">Estetica epigenetica</p>
          <h2 class="rebel-manifesto__quote">Valutiamo la pelle.<br/><em>Costruiamo il trattamento.</em></h2>
          <figure class="rebel-manifesto__media">
            <img src={consultationImage} alt="Cliente e professionista consultano una scheda durante la valutazione REBEL" width="1122" height="1402" loading="lazy" decoding="async" />
          </figure>
        </div>
        <div>
          <p class="rebel-lead">Durante la valutazione osserviamo le condizioni della pelle o del corpo, ascoltiamo il risultato che desideri e definiamo un piano chiaro.</p>
          <p class="rebel-lead"><strong>Estetica epigenetica</strong> significa scegliere attivi, tecniche manuali e tecnologie in base a ciò che osserviamo e verificare nel tempo come cambia la pelle o il corpo.</p>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--laser-offer">
      <div class="rebel-container">
        <LaserOffer />
      </div>
    </section>

    <section class="rebel-section" id="mappa-rebel-live">
      <div class="rebel-container">
        <p class="rebel-kicker">Mappa REBEL</p>
        <h2 class="rebel-title">Confronta i nove percorsi.</h2>
        <p class="rebel-lead">Per ogni percorso trovi esigenze, prezzo di partenza, ingredienti e tecnologie previsti. Puoi così capire quali vuoi approfondire durante la valutazione.</p>
        <DeployedJourneyMap />
      </div>
    </section>

    <div class="rebel-material-band rebel-material-band--prism" aria-hidden="true"></div>

    <section class="rebel-section" id="metodo">
      <div class="rebel-container rebel-method">
        <div class="rebel-method__intro">
          <p class="rebel-kicker">Il Metodo Rebel</p>
          <h2 class="rebel-title">Sei passaggi, dalla valutazione al mantenimento.</h2>
          <p class="rebel-lead">Sai che cosa trattiamo, quali strumenti utilizziamo, quante volte ci vediamo e quando controlliamo i risultati.</p>
          <a class="rebel-text-link" href="/metodo-rebel">Leggi tutte le fasi del Metodo →</a>
          <figure class="rebel-method__media">
            <img src={activesImage} alt="Prodotti e strumenti preparati per un trattamento viso" width="1122" height="1402" loading="lazy" decoding="async" />
          </figure>
        </div>
        <div class="rebel-method__steps">
          {methodSteps.map(({ step, title, text }) => (
            <article class="rebel-method__step"><b>{step}</b><div><h3>{title}</h3><p>{text}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <div class="rebel-material-band rebel-material-band--cut" aria-hidden="true"></div>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Cosa valutiamo sul viso</p>
        <h2 class="rebel-title">Sette segnali che orientano la scelta del trattamento.</h2>
        <figure class="rebel-priorities__media">
          <img src={skinTextureImage} alt="Dettaglio ravvicinato della grana naturale della pelle" width="1122" height="1402" loading="lazy" decoding="async" />
          <figcaption>Osserviamo la pelle dal vivo: grana, comfort, uniformità e cambiamenti nel tempo.</figcaption>
        </figure>
        <div class="rebel-priorities">
          {priorities.map(([priority, detail],index)=><article class="rebel-priority"><small>0{index+1}</small><h3>{priority}</h3><p>{detail}</p></article>)}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--plum">
      <div class="rebel-container">
        <p class="rebel-kicker">I Percorsi Rebel</p>
        <h2 class="rebel-title">Nove percorsi per esigenze diverse.</h2>
        <p class="rebel-lead">Luminosità ed equilibrio, tono nel tempo, forma del corpo ed epilazione progressiva: scegli l’area su cui vuoi lavorare e confronta i percorsi disponibili.</p>
        <div class="rebel-journeys">
          {journeys.map((journey)=>(
            <a class="rebel-journey" href={journey.href}>
              <figure class="rebel-journey__media" aria-hidden="true">
                <img src={journey.image} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
              </figure>
              <div class="rebel-journey__copy"><p class="rebel-kicker">{journey.kicker}</p><h3>{journey.name}</h3><p>{journey.copy}</p><div class="rebel-journey__tags">{journey.tags.map(tag=><span>{tag}</span>)}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Servizi Rebel</p>
        <h2 class="rebel-title">Viso, corpo e tecnologie: scegli da dove partire.</h2>
        <div class="rebel-world">
          {worlds.map((world) => (
            <a class="rebel-world__card" href={world.href} style={`--world-image:url('${world.image}')`}>
              <span class="rebel-world__number">{world.number}</span>
              <div><h3>{world.name}</h3><p>{world.copy}</p><strong>{world.cta} →</strong></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <div class="rebel-studio-proof">
          <div>
            <p class="rebel-kicker">Dentro Rebel</p>
            <h2 class="rebel-title">Scopri lo studio REBEL.</h2>
            <p class="rebel-lead">Quattro cabine, una postazione manicure e tecnologie professionali. Qui facciamo la valutazione, eseguiamo i trattamenti e controlliamo insieme i risultati.</p>
            <a class="rebel-text-link" href="/chi-siamo">Scopri lo studio e il team →</a>
          </div>
          <picture class="rebel-studio-proof__media">
            <source media="(max-width: 760px)" srcset={siteAsset("studio.real.overview.mobile")} />
            <img src={studioImage} alt="Interno dello studio REBEL a Carmagnola" width="1672" height="941" loading="lazy" decoding="async" />
          </picture>
        </div>
        <div class="rebel-studio-real">
          <p class="rebel-kicker">Gli spazi di Viale Barbaroux 20</p>
          <p>Scopri le quattro cabine, la postazione manicure e l’area accoglienza del centro REBEL di Carmagnola.</p>
        </div>
        <StoreGallery client:visible images={storeGalleryImages} />
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Rebel, ogni settimana</p>
        <h2 class="rebel-title">Trattamenti, novità e momenti di vita in studio.</h2>
        <InstagramFeed showReels={true} showPosts={false} maxReels={3} maxPosts={0} hidePostsOnMobile={true} />
      </div>
    </section>

    <LocalBookingGuide />
    <LocalBookingGuide />
    <section class="rebel-campaign">
      <div class="rebel-container">
        <strong>Be <span>Beautiful.</span><br/>Be Rebel.</strong>
        <p>Prenota la valutazione: in 30–40 minuti definiamo zona, obiettivo, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.</p>
        <div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la valutazione</a><a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Scrivici su WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>.home-decision-nav{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;background:#e3d8e9;border-bottom:1px solid #e3d8e9}.home-decision-nav a{display:flex;flex-direction:column;gap:.6rem;background:#fcf9fe;color:#42224f;padding:1.6rem clamp(1rem,3vw,3rem);text-decoration:none}.home-decision-nav a:hover{background:#f3eaf8}.home-decision-nav span{font-size:.65rem;text-transform:uppercase;letter-spacing:.1em;color:#826b8c}.home-decision-nav strong{font-size:clamp(.85rem,1.2vw,1.1rem);font-weight:500}@media(max-width:600px){.home-decision-nav{grid-template-columns:1fr}.home-decision-nav a{padding:1rem 1.4rem;flex-direction:row;align-items:center;justify-content:space-between;gap:1rem}.home-decision-nav span{font-size:.59rem;max-width:38%}.home-decision-nav strong{font-size:.8rem}}</style>
