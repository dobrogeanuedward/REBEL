---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StoreGallery from "@/components/StoreGallery.tsx";
import InstagramFeed from "@/components/InstagramFeed.astro";
import { storeGalleryImages } from "@/lib/content";
import { siteConfig } from "@/lib/site-config";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Rebel Estetica Epigenetica a Carmagnola — Viso, Corpo e Laser",
  description:
    "Centro estetico a Carmagnola per trattamenti viso, percorsi corpo, epilazione Laser Ice Polar, manicure e benessere. Valutazione iniziale gratuita.",
  path: "/",
  keywords: [
    "centro estetico Carmagnola",
    "estetica epigenetica Carmagnola",
    "Metodo Rebel",
    "percorsi viso Carmagnola",
    "rimodellamento corpo Carmagnola",
    "epilazione laser Carmagnola",
    "Laser Ice Polar",
  ],
});

const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }]);
const webPage = buildWebPageSchema({ name: "Rebel Estetica Epigenetica", description: meta.description, path: "/" });
const article = buildArticleSchema({
  headline: "Trattamenti viso, percorsi corpo ed epilazione laser a Carmagnola",
  description: meta.description,
  path: "/",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Home",
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const heroImage = siteAsset("home.hero.method.desktop");
const faceImage = siteAsset("journeys.glow.hero.desktop");
const longevityImage = siteAsset("journeys.longevity.hero.desktop");
const bodyImage = siteAsset("journeys.forma.hero.desktop");
const freedomImage = siteAsset("journeys.liberta.hero.desktop");
const studioImage = siteAsset("studio.professional.desktop");

const method = [
  ["01", "Ascoltiamo l’obiettivo", "Ci racconti cosa vuoi migliorare, quali trattamenti hai già provato e quanto tempo puoi dedicare al percorso."],
  ["02", "Valutiamo pelle o corpo", "Osserviamo idratazione, sensibilità, tono, uniformità, tessuti e caratteristiche della zona interessata."],
  ["03", "Definiamo il risultato", "Stabiliamo un obiettivo concreto e realistico, così sai che cosa stiamo trattando e perché."],
  ["04", "Scegliamo i trattamenti", "Combiniamo manualità, attivi e tecnologie adatti alla zona e al risultato concordato."],
  ["05", "Controlliamo i cambiamenti", "Verifichiamo la risposta e modifichiamo frequenza, intensità o combinazioni quando necessario."],
  ["06", "Manteniamo il risultato", "Programmiamo richiami e una routine essenziale per conservare ciò che hai ottenuto."],
];

const priorities = [
  ["Sensibilità e comfort", "Rossori, reattività e sensazioni di pelle che tira."],
  ["Impurità e imperfezioni", "Comedoni, lucidità, grana irregolare e zone congestionate."],
  ["Pelle spenta", "Colorito poco uniforme e luminosità ridotta."],
  ["Disidratazione", "Comfort ridotto, linee superficiali e bisogno di acqua."],
  ["Perdita di tono", "Elasticità e compattezza da sostenere nel tempo."],
  ["Macchie e colorito irregolare", "Discromie e differenze visibili fra le zone del viso."],
  ["Segni del tempo", "Rughe, contorno occhi e qualità generale della pelle."],
];

const journeys = [
  {
    name: "Glow",
    kicker: "Viso · luminosità e uniformità",
    copy: "Per pelle spenta, irregolare o disidratata. Può includere Skin Reset, Catalysis, Cell Regen e attivi epigenetici.",
    image: faceImage,
    tags: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Longevity",
    kicker: "Viso · tono e segni del tempo",
    copy: "Per lavorare su elasticità, compattezza, comfort e qualità della pelle con protocolli dedicati anche al contorno occhi.",
    image: longevityImage,
    tags: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Forma",
    kicker: "Corpo · drenaggio e compattezza",
    copy: "Per pesantezza, ritenzione, tono e rimodellamento. Può combinare Lift Body, LPG, pressomassaggio, Tecar e crioterapia.",
    image: bodyImage,
    tags: ["Lift Body", "LPG", "Pressomassaggio", "Tecar", "Crioterapia"],
    href: "/protocolli-epigenetici",
  },
  {
    name: "Libertà",
    kicker: "Epilazione laser · viso e corpo",
    copy: "Laser Ice Polar con valutazione iniziale, parametri personalizzati e calendario definito per ogni zona.",
    image: freedomImage,
    tags: ["Laser Ice Polar", "Viso", "Corpo", "Total Body"],
    href: "/epilazione-laser-carmagnola",
  },
];

const worlds = [
  {
    number: "01",
    name: "Viso",
    copy: "Pulizia viso, Glow, Longevity, attivi epigenetici, contorno occhi e laminazione coreana.",
    image: faceImage,
    href: "/protocolli-epigenetici",
    cta: "Esplora il viso",
  },
  {
    number: "02",
    name: "Corpo",
    copy: "Drenaggio, massaggi, rimodellamento, LPG, Tecar, pressomassaggio e crioterapia.",
    image: bodyImage,
    href: "/listino-estetica-laser",
    cta: "Esplora il corpo",
  },
  {
    number: "03",
    name: "Tecnologie",
    copy: "THORY Lumina X1 Pro con ICE Polar, LPG, Tecar 448Revolution, InfraPress X2, CryoShape X2 e Lumina K3.",
    image: siteAsset("services.technologies.detail.desktop"),
    href: "/tecnologie-rebel",
    cta: "Conosci le tecnologie",
  },
];
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />

  <div class="rebel-shell">
    <section class="rebel-hero" style={`--hero-image: url('${heroImage}')`}>
      <div class="rebel-container rebel-hero__copy">
        <div class="rebel-hero__eyebrow" data-reveal>
          <span>Rebel · Estetica Epigenetica</span><span>Viale Barbaroux 20 · Carmagnola</span>
        </div>
        <h1 class="rebel-display" data-reveal style="--reveal-delay:50ms">Il Metodo Rebel parte dalla tua pelle.</h1>
        <div class="rebel-spectrum-rule"></div>
        <p class="rebel-lead" data-reveal style="--reveal-delay:120ms">
          Nella prima visita definiamo priorità, risultato, trattamenti, frequenza e controlli.
          Tutto viene raccolto nella tua Mappa Rebel.
        </p>
        <div class="rebel-hero__actions" data-reveal style="--reveal-delay:180ms">
          <a class="btn btn--primary" href="/metodo-rebel">Scopri il Metodo Rebel</a>
          <a class="btn btn--secondary" href="/contatti">Prenota la prima visita</a>
        </div>
        <div class="rebel-hero__signature"><strong>Be Beautiful. Be Rebel.</strong><span>Prima visita gratuita · Mappa Rebel · controlli</span></div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container rebel-manifesto">
        <div>
          <p class="rebel-kicker">Estetica epigenetica</p>
          <h2 class="rebel-manifesto__quote">Valutiamo la pelle.<br/><em>Costruiamo il trattamento.</em></h2>
        </div>
        <div>
          <p class="rebel-lead">Durante la prima visita osserviamo le condizioni della pelle o del corpo, ascoltiamo il risultato che desideri e definiamo un programma comprensibile.</p>
          <p class="rebel-lead"><strong>Estetica epigenetica</strong> significa scegliere attivi, manualità e tecnologie in base alle caratteristiche della persona e controllare nel tempo come risponde.</p>
        </div>
      </div>
    </section>

    <div class="rebel-material-band rebel-material-band--prism" aria-hidden="true"></div>

    <section class="rebel-section" id="metodo">
      <div class="rebel-container rebel-method">
        <div class="rebel-method__intro">
          <p class="rebel-kicker">Il Metodo Rebel</p>
          <h2 class="rebel-title">Sei passaggi. Un percorso leggibile.</h2>
          <p class="rebel-lead">Sai che cosa trattiamo, quali strumenti utilizziamo, quante volte ci vediamo e quando controlliamo i risultati.</p>
          <div class="rebel-map">
            <div class="rebel-map__head"><strong>MAPPA REBEL</strong><br/><small>Valutazione / Trattamenti / Controlli</small></div>
            <div class="rebel-map__fields">
              {['Esigenza principale','Condizione osservata','Risultato concordato','Trattamenti indicati','Tecnologie utilizzabili','Frequenza iniziale','Controllo dei risultati','Mantenimento'].map((field)=><span>{field}</span>)}
            </div>
          </div>
        </div>
        <div class="rebel-method__steps">
          {method.map(([number,title,text]) => (
            <article class="rebel-method__step"><b>{number}</b><div><h3>{title}</h3><p>{text}</p></div></article>
          ))}
        </div>
      </div>
    </section>

    <div class="rebel-material-band rebel-material-band--cut" aria-hidden="true"></div>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Cosa valutiamo sul viso</p>
        <h2 class="rebel-title">Sette segnali che orientano la scelta del trattamento.</h2>
        <div class="rebel-priorities">
          {priorities.map(([priority, detail],index)=><article class="rebel-priority"><small>0{index+1}</small><h3>{priority}</h3><p>{detail}</p></article>)}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--plum">
      <div class="rebel-container">
        <p class="rebel-kicker">I Percorsi Rebel</p>
        <h2 class="rebel-title">Quattro percorsi, ciascuno con una priorità precisa.</h2>
        <p class="rebel-lead">Glow per luminosità e uniformità; Longevity per tono e qualità della pelle; Forma per drenaggio e compattezza; Libertà per il Laser Ice Polar.</p>
        <div class="rebel-journeys">
          {journeys.map((journey)=>(
            <a class="rebel-journey" href={journey.href} style={`--journey-image:url('${journey.image}')`}>
              <div class="rebel-journey__copy"><p class="rebel-kicker">{journey.kicker}</p><h3>{journey.name}</h3><p>{journey.copy}</p><div class="rebel-journey__tags">{journey.tags.map(tag=><span>{tag}</span>)}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Servizi Rebel</p>
        <h2 class="rebel-title">Viso, corpo e tecnologie: scegli da dove partire.</h2>
        <div class="rebel-world">
          {worlds.map((world) => (
            <a class="rebel-world__card" href={world.href} style={`--world-image:url('${world.image}')`}>
              <span class="rebel-world__number">{world.number}</span>
              <div><h3>{world.name}</h3><p>{world.copy}</p><strong>{world.cta} →</strong></div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <div class="rebel-studio-proof">
          <div>
            <p class="rebel-kicker">Il lavoro in studio</p>
            <h2 class="rebel-title">Prepariamo, registriamo, controlliamo.</h2>
            <p class="rebel-lead">La professionista prepara il trattamento, registra prodotti e parametri e confronta la risposta nel tempo. È questo che rende il percorso personalizzato, non il nome del macchinario.</p>
            <a class="rebel-text-link" href="/chi-siamo">Scopri lo studio e il team →</a>
          </div>
          <picture class="rebel-studio-proof__media">
            <source media="(max-width: 760px)" srcset={siteAsset("studio.professional.mobile")} />
            <img src={studioImage} alt="Professionista Rebel mentre prepara un trattamento" loading="lazy" />
          </picture>
        </div>
        <div class="rebel-studio-real">
          <p class="rebel-kicker">Gli spazi reali di Viale Barbaroux 20</p>
          <p>Quattro cabine, postazione mani, area accoglienza e tecnologie professionali fotografate nel centro REBEL di Carmagnola.</p>
        </div>
        <StoreGallery client:visible images={storeGalleryImages} />
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Rebel, ogni settimana</p>
        <h2 class="rebel-title">Trattamenti reali, novità e vita in studio.</h2>
        <InstagramFeed showReels={true} showPosts={false} maxReels={3} maxPosts={0} hidePostsOnMobile={true} />
      </div>
    </section>

    <section class="rebel-campaign">
      <div class="rebel-container">
        <strong>Be <span>Cool.</span><br/>Be Rebel.</strong>
        <p>Prenota la valutazione gratuita: definiamo area, obiettivo, frequenza e prezzo prima di iniziare.</p>
        <div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la prima visita</a><a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Scrivici su WhatsApp</a></div>
      </div>
    </section>
  </div>
</BaseLayout>
