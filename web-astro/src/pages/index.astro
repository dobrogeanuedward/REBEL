---
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import StepStrip from "@/components/StepStrip.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import HeroPhotoSlider from "@/components/HeroPhotoSlider.tsx";
import StoreGallery from "@/components/StoreGallery.tsx";
import InstagramFeed from "@/components/InstagramFeed.astro";
import BrandStrip from "@/components/BrandStrip.astro";
import PromoBanner from "@/components/PromoBanner.astro";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { homeHeroImages, methodSteps, storeGalleryImages } from "@/lib/content";
import { servicePages } from "@/lib/seo-content";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Centro Estetico a Carmagnola — Rebel | Laser, Viso, Mani, Massaggi",
  description:
    "Centro estetico a Carmagnola, Viale Barbaroux 20: epilazione laser Ice Polar, pulizia viso, manicure, ceretta, massaggi e protocolli viso/corpo. Prima visita gratuita, listino chiaro online.",
  path: "/",
  keywords: [
    "centro estetico Carmagnola",
    "estetista Carmagnola",
    "epilazione laser Carmagnola",
    "pulizia viso Carmagnola",
    "manicure Carmagnola",
    "massaggi Carmagnola",
    "Rebel Carmagnola",
    "centro estetico Viale Barbaroux Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }]);
const webPage = buildWebPageSchema({
  name: "Rebel — Centro estetico a Carmagnola",
  description: meta.description,
  path: "/",
});
const article = buildArticleSchema({
  headline: "Centro estetico a Carmagnola — Rebel",
  description:
    "Epilazione laser Ice Polar, viso, mani, massaggi e protocolli a Carmagnola. Prima visita gratuita.",
  path: "/",
  keywords: ["centro estetico Carmagnola", "epilazione laser Carmagnola", "Rebel"],
  section: "Home",
});

// Trattamenti più richiesti — l'ordine riflette le priorità di prenotazione.
const baseSlugs = [
  "pulizia-viso-carmagnola",
  "epilazione-laser-corpo-carmagnola",
  "manicure-semipermanente-carmagnola",
  "laminazione-ciglia-sopracciglia-carmagnola",
  "massaggio-rilassante-carmagnola",
  "pedicure-carmagnola",
];
const baseServices = baseSlugs
  .map((slug) => servicePages.find((s) => s.slug === slug))
  .filter((s): s is NonNullable<typeof s> => Boolean(s));

const baseServicesSchema = baseServices.length > 0
  ? buildItemListSchema({
      name: "Trattamenti più richiesti — Rebel Carmagnola",
      path: "/",
      items: baseServices.map((s) => ({
        name: s.name,
        path: `/servizi/${s.slug}`,
      })),
    })
  : null;

const pillars = [
  {
    kicker: "Viso & corpo",
    title: "Pulizia viso, massaggi, ceretta",
    body: "Servizi quotidiani fatti come si deve, con prodotti professionali e tempi di seduta sensati. Niente fretta, niente upsell.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Epilazione laser",
    title: "Laser con manipolo Ice Polar",
    body: "Diodo Thory con raffreddamento attivo: comfort vero anche su ascelle e inguine. Valutazione iniziale gratuita.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    kicker: "Protocolli avanzati",
    title: "Estetica epigenetica viso/corpo",
    body: "Quando vuoi un percorso che lavori in profondità: linee Marbellas ed Eberlin, sedute calibrate, risultati nel tempo.",
    href: "/protocolli-epigenetici",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Dove si trova Rebel a Carmagnola?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Rebel è in Viale Barbaroux 20 a Carmagnola (TO), a pochi minuti dal centro città. Riceviamo solo su appuntamento, da martedì a sabato.",
      },
    },
    {
      "@type": "Question",
      name: "La prima visita è davvero gratuita?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì. La prima visita è una consulenza gratuita di circa quindici minuti: ci raccontate cosa vorreste fare e proponiamo un percorso realistico, con prezzi e tempi chiari. Include anche un piccolo regalo a vostra scelta.",
      },
    },
    {
      "@type": "Question",
      name: "Quali tecnologie usate per l'epilazione laser?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Lavoriamo con tecnologia laser a diodo Thory dotata di manipolo Ice Polar (raffreddamento attivo). Riduce sensibilmente il fastidio anche su ascelle e inguine.",
      },
    },
    {
      "@type": "Question",
      name: "Si può prenotare via WhatsApp?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì, scriveteci al +39 351 691 9416 oppure dal pulsante WhatsApp del sito. Indicate cosa vorreste fare e una fascia oraria comoda: rispondiamo negli orari di apertura.",
      },
    },
  ],
};
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={article} />
  <JsonLd data={faqSchema} />
  {baseServicesSchema ? <JsonLd data={baseServicesSchema} /> : null}

  <!-- ============================================================
       HERO — short, direct, locale-first. The italic accent on
       "Carmagnola" is intentional: it's the keyword, not abstract poetry.
       ============================================================ -->
  <section class="home-hero">
    <div class="home-hero__media">
      <HeroPhotoSlider client:load images={homeHeroImages} intervalMs={5200} />
    </div>
    <div class="container home-hero__overlay">
      <p class="home-hero__kicker" data-reveal>
        Centro estetico · Viale Barbaroux 20
      </p>
      <h1 class="home-hero__title" data-reveal style="--reveal-delay: 40ms;">
        Il tuo centro estetico nel cuore di <em>Carmagnola</em>.
      </h1>
      <p class="home-hero__lead" data-reveal style="--reveal-delay: 120ms;">
        Pulizia viso, manicure, ceretta, massaggi, epilazione laser Ice Polar.
        Tutta la cura che ti aspetti, fatta con calma e con metodo.
        <strong>La prima visita è gratuita</strong> — e include un piccolo regalo a tua scelta.
      </p>
      <div class="home-hero__cta cluster cluster--stack-mobile" data-reveal style="--reveal-delay: 200ms;">
        <a class="btn btn--primary btn--halo" href="/contatti">Prenota la prima visita gratuita</a>
        <a class="btn btn--secondary" href={siteConfig.social.whatsapp} target="_blank" rel="noreferrer">Scrivici su WhatsApp</a>
      </div>
      <ul class="home-hero__metrics" data-reveal style="--reveal-delay: 280ms;">
        <li>
          <strong>Gratuita</strong>
          <span>Prima visita di 15′</span>
        </li>
        <li>
          <strong>Ice Polar</strong>
          <span>Laser con raffreddamento attivo</span>
        </li>
        <li>
          <strong>Listino online</strong>
          <span>Prezzi sempre chiari</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- ============================================================
       PROMO BANNER — first-visit gift. Single CTA section.
       ============================================================ -->
  <section class="section section--tight">
    <div class="container">
      <PromoBanner />
    </div>
  </section>

  <!-- ============================================================
       INSTAGRAM — moved up. It's the most "alive" section of the site:
       reels and posts shot in cabin act as social proof + atmosphere.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Instagram · @rebelesteticaepigenetica"
        title="Cosa succede in cabina, _ogni settimana_."
        lead="Reel e post pubblicati direttamente dallo studio: trattamenti reali, atmosfera, dietro le quinte. Tocca per aprire il profilo."
      />
      <InstagramFeed
        showReels={true}
        showPosts={true}
        maxReels={4}
        maxPosts={3}
        hidePostsOnMobile={true}
      />
    </div>
  </section>

  <!-- ============================================================
       THREE PILLARS — what we do, in three lanes.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Cosa facciamo"
        title="Tre _modi_ di entrare in studio."
        lead="Estetica classica e benessere, epilazione laser, protocolli avanzati. Si parte da quello che ti serve adesso, non dal pacchetto più costoso."
      />
      <div class="card-grid card-grid--3">
        {pillars.map((p, idx) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            href={p.href}
            index={idx + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============================================================
       BRAND & TECHNOLOGY — the real differentiator vs. local
       competitors. Honest framing: "collaborazioni esclusive", not
       proprietary lines.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Brand & tecnologie"
        title="Le firme con cui _lavoriamo davvero_."
        lead="Non improvvisiamo: usiamo tecnologie e linee professionali precise, con formazione continua sul team. Qui sotto chi sono e cosa portano in cabina."
      />
      <BrandStrip />
    </div>
  </section>

  <!-- ============================================================
       MOST-REQUESTED SERVICES — concrete, prezzi visibili, prenotabili.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Trattamenti più richiesti"
        title="I _servizi_ con cui iniziano la maggior parte delle clienti."
        lead="Ognuno ha la sua scheda con prezzo, durata indicativa e quando ha senso farlo."
      />
      <div class="card-grid card-grid--3">
        {baseServices.map((s) => (
          <FeatureCard
            kicker={s.priceHint}
            title={s.name}
            body={s.shortDescription}
            href={`/servizi/${s.slug}`}
            variant="quiet"
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top: 1.8rem; justify-content: center;">
        <a class="btn btn--secondary" href="/listino-estetica-laser">Vedi tutto il listino</a>
      </div>
    </div>
  </section>

  <!-- ============================================================
       METHOD — five concrete steps, no flowery language.
       ============================================================ -->
  <section class="section section--tight">
    <div class="container">
      <SectionHead
        kicker="Come lavoriamo"
        title="Cinque _passaggi_, dalla prima visita al mantenimento."
        lead="Non un trattamento dopo l'altro: un percorso semplice, chiaro, costruito insieme."
      />
      <StepStrip items={methodSteps} />
    </div>
  </section>

  <!-- ============================================================
       STORE — interior shots; helps trust + local SEO image signals.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Lo studio"
        title="Dentro Rebel, in _Viale Barbaroux 20_."
        lead="Tre cabine, area accoglienza e una postazione mani. Studio nuovo, attrezzatura nuova, ordine vero."
      />
      <StoreGallery client:visible images={storeGalleryImages} />
    </div>
  </section>

  <!-- ============================================================
       FINAL CTA — closes with a clear next step.
       ============================================================ -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Pronta a iniziare"
        title="Prenota la _prima visita_, scegli il tuo regalo."
        lead="Ti rispondiamo entro poche ore negli orari di apertura. Per il confronto immediato, scrivici su WhatsApp."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita gratuita"
        secondaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scrivici su WhatsApp"
      />
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Home hero ---------- */
  .home-hero {
    position: relative;
    min-height: clamp(620px, 95vh, 920px);
    padding-top: clamp(7rem, 11vw, 10rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }
  .home-hero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
  }
  .home-hero__media :global(.hero-photo-slider) {
    aspect-ratio: auto;
    height: 100%;
    border-radius: 0;
    border: 0;
    box-shadow: none;
  }
  .home-hero__media :global(.hero-photo-slider__veil) {
    background:
      radial-gradient(ellipse at 30% 70%, rgba(46, 16, 101, 0.5), transparent 60%),
      linear-gradient(180deg, rgba(7, 5, 14, 0.55) 0%, rgba(7, 5, 14, 0.25) 35%, rgba(7, 5, 14, 0.92) 95%);
  }
  .home-hero__overlay {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    max-width: 920px;
  }
  .home-hero__kicker {
    font-family: var(--font-body);
    font-size: var(--t-kicker);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
    color: var(--mauve);
    font-weight: 600;
    margin: 0;
  }
  .home-hero__title {
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: var(--tracking-display);
    color: var(--text-strong);
    text-wrap: balance;
    margin: 0;
  }
  .home-hero__title em {
    font-style: italic;
    background: var(--type-accent);
    background-size: 100% 100%;
    background-position: 0% 50%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .home-hero__lead {
    font-size: var(--t-body-lg);
    line-height: var(--lh-body);
    color: var(--text-muted);
    max-width: 60ch;
    margin: 0;
  }
  .home-hero__lead strong {
    color: var(--text);
    font-weight: 600;
  }
  .home-hero__cta {
    margin-top: 0.6rem;
  }
  .home-hero__metrics {
    list-style: none;
    margin: 1.4rem 0 0;
    padding: 1.2rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    border-top: 1px solid var(--line);
    max-width: 620px;
  }
  .home-hero__metrics li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .home-hero__metrics strong {
    font-family: var(--font-display);
    font-size: 1.2rem;
    color: var(--mauve);
    letter-spacing: -0.01em;
    font-style: italic;
  }
  .home-hero__metrics span {
    font-size: 0.78rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }
  @media (max-width: 720px) {
    .home-hero__metrics { grid-template-columns: 1fr; gap: 0.6rem; }
  }
</style>
