---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Laminazione ciglia e sopracciglia per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Da Rebel a Carmagnola trovi Lash Lift vegano e laminazione sopracciglia, con durata indicativa di 6-8 settimane. Circa 30 minuti via A33.",
  path: "/laminazione-alba",
  image: "https://www.rebelepigenetica.it/img/brand/laminazione-occhio-purple.png",
  openGraphType: "article",
  keywords: [
    "laminazione ciglia Alba",
    "lash lift Alba",
    "laminazione sopracciglia Alba",
    "ciglia Alba CN",
    "laminazione ciglia Langhe",
    "lash lift vicino Alba",
    "brow lamination Alba",
    "lifting ciglia Alba",
    "ciglia definite Alba",
    "estetista ciglia sopracciglia Alba",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laminazione Carmagnola", path: "/servizi/laminazione-ciglia-sopracciglia-carmagnola" },
  { name: "Alba e Langhe", path: "/laminazione-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Laminazione ciglia e sopracciglia per chi viene da Alba",
  description: meta.description,
  path: "/laminazione-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Laminazione ciglia e sopracciglia per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/laminazione-alba",
  keywords: ["laminazione ciglia Alba", "lash lift Alba", "laminazione sopracciglia Alba CN"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/brand/laminazione-occhio-purple.png",
});

const serviceSchema = buildServiceSchema(
  "Laminazione ciglia e sopracciglia per chi viene da Alba",
  "Laminazione ciglia (Lash Lift vegano) e sopracciglia a Carmagnola per clienti di Alba e delle Langhe, con durata indicativa di 6-8 settimane.",
  "/laminazione-alba",
  {
    priceFrom: 55,
    keywords: ["lash lift Alba", "laminazione ciglia Alba CN", "brow lamination Alba Langhe"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/laminazione-alba#service-geo`,
  name: "Laminazione ciglia e sopracciglia per chi viene da Alba",
  serviceType: "Lash lift and brow lamination",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7008, longitude: 8.0354 },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "55.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto dura la laminazione ciglia?",
    a: "In genere l'effetto dura 6-8 settimane, ma può variare in base al ciclo naturale di ciglia e sopracciglia e alle abitudini successive. Al termine della seduta ti spieghiamo le accortezze da seguire.",
  },
  {
    q: "Posso truccarmi dopo la laminazione?",
    a: "Sì, ma non subito. Nelle prime 24-48 ore evita acqua, vapore e prodotti a base oleosa per non alterare la piega. In seguito puoi tornare a usare mascara ed eyeliner seguendo le indicazioni ricevute in studio.",
  },
  {
    q: "È adatta anche a chi ha ciglia rade o corte?",
    a: "Dipende dalla struttura delle ciglia e dall'effetto che desideri. Prima della seduta le osserviamo e ti spieghiamo quale risultato visivo è realistico aspettarsi.",
  },
  {
    q: "Posso abbinarla ad altri trattamenti nello stesso giorno?",
    a: "Dicci quali servizi vorresti abbinare: verifichiamo tempi e compatibilità prima di fissare l'appuntamento. Se hai il laser viso programmato, valutiamo insieme se sia meglio distanziare le sedute.",
  },
  {
    q: "Quanto ci vuole da Alba a Rebel?",
    a: "Circa trenta minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Come prenoto da Alba?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Lash Lift vegano",
    title: "Lash lift sulle ciglia naturali, senza extension.",
    body: "Usiamo una formula vegana per sollevare le ciglia dalla radice. L'intensità dell'effetto dipende dalla loro lunghezza e struttura; la durata indicativa è di 6-8 settimane.",
  },
  {
    kicker: "02 · Brow lamination",
    title: "Sopracciglia disciplinate, forma definita.",
    body: "La laminazione pettina e fissa i peli nella direzione concordata, per un effetto visivo più ordinato e definito. Forma e intensità vengono scelte insieme prima di iniziare.",
  },
  {
    kicker: "03 · Sguardo da subito",
    title: "L'effetto è visibile al termine della seduta.",
    body: "Prima di iniziare concordiamo forma e intensità. Alla fine controlliamo insieme l'effetto su ciglia e sopracciglia, che varia in base alle caratteristiche di partenza.",
  },
  {
    kicker: "04 · Cura post-trattamento",
    title: "Le indicazioni per le ore successive.",
    body: "Niente acqua nelle prime 24 ore, niente prodotti oleosi intorno agli occhi e mascara waterproof da evitare. Ti spieghiamo tutto prima di uscire; la durata può comunque variare da persona a persona.",
  },
];

const combos = [
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Laminazione + manicure semipermanente",
    body: "Se vuoi abbinare laminazione e manicure, verifichiamo la disponibilità necessaria per organizzarle nella stessa visita.",
  },
  {
    href: "/epilazione-laser-alba",
    title: "Laminazione + laser viso",
    body: "Se hai in programma il laser viso, indicaci zona e data: valutiamo se i due appuntamenti possano coincidere o vadano distanziati.",
  },
  {
    href: "/servizi/pulizia-viso-carmagnola",
    title: "Laminazione + pulizia viso",
    body: "Puoi chiederci di organizzare laminazione e pulizia viso nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/laminazione-bra", desc: "~22 min da Carmagnola via SP7." },
  { city: "Canale", href: "/laminazione-canale", desc: "Roero, ~35 min via A33." },
  { city: "Tutte le località", href: "/localita", desc: "Scopri servizi e indicazioni per ogni zona." },
];

const m = getPageMedia("/laminazione-alba");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Eye — da Alba a Carmagnola"
    title="Laminazione ciglia e sopracciglia per chi viene da Alba: _durata indicativa 6-8 settimane_."
    lead="Da Alba a Rebel sono circa trenta minuti via A33. In studio puoi scegliere Lash Lift vegano, laminazione sopracciglia o entrambi; prima della seduta concordiamo forma e intensità."
    bullets={["Durata indicativa 6-8 settimane", "Lash lift vegano + brow lamination", "Valutazione REBEL · 30–40 min"]}
    meta={["~33 km da Alba", "~30 min via A33", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Alba", href: "https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Sguardo definito -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Sguardo definito"
          title="Lash lift e brow lamination _su misura per il tuo sguardo_."
          body="Il lash lift lavora sulle ciglia naturali senza extension; la brow lamination pettina e fissa i peli nella forma concordata. L'effetto e la durata variano da persona a persona."
          bullets={["Lash lift vegano sulle ciglia naturali", "Brow lamination per sopracciglia ordinate", "Durata indicativa 6-8 settimane"]}
          cta={{ label: "Scopri la laminazione", href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Lash Lift vegano"
        title="Cosa trovi da Rebel _venendo da Alba_."
        lead="A circa trenta minuti via A33 trovi Lash Lift vegano e laminazione sopracciglia. Prima di iniziare definiamo insieme l'effetto desiderato e le indicazioni per le ore successive."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/laminazione-ciglia-sopracciglia-carmagnola">Scopri la laminazione</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- BRAND ASSET — procedura laminazione -->
  <section class="section section--scene-ivory">
    <div class="container">
      <div class="split-visual">
        <div class="split-visual__text">
          <SectionHead
            kicker="Prima e dopo"
            title="L'effetto si vede _al termine della seduta_."
            lead="Forma e intensità dipendono dalle caratteristiche di ciglia e sopracciglia. Prima di iniziare ti spieghiamo che cosa è realistico aspettarsi."
          />
          <p class="body-p">
            Utilizziamo una formula <strong>Lash Lift vegana</strong> per sollevare le ciglia
            dalla radice, senza extension. Le sopracciglia vengono pettinate nella forma
            concordata; l'effetto ha una durata indicativa di 6-8 settimane.
          </p>
          <p class="body-p">
            Nelle prime 24 ore evita acqua e prodotti oleosi intorno agli occhi. Prima
            di lasciare lo studio ricevi tutte le indicazioni per i giorni successivi.
          </p>
        </div>
        <div class="split-visual__image">
          <img
            src="/img/brand/laminazione-procedura.png"
            alt="Procedura laminazione ciglia in cabina Rebel — applicazione professionale con guanti"
            width="900"
            height="1100"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- BRAND ASSET — prima/dopo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Prima / Dopo"
        title="La differenza che _parla da sola_."
        lead="Lo stesso viso, lo stesso sguardo — prima e dopo la laminazione ciglia e sopracciglia."
      />
      <div class="editorial-image-frame">
        <img
          src="/img/brand/laminazione-prima-dopo.png"
          alt="Prima e dopo laminazione ciglia e sopracciglia Rebel — confronto sguardo naturale vs definito"
          width="1200"
          height="800"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- SEZIONE — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Alba sono circa 33 chilometri via <strong>A33 direzione Torino</strong>,
            uscita Marene, poi <strong>SP661 fino a Carmagnola</strong>. In trenta minuti
            sei in studio.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">
              Apri il percorso da Alba in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Alba a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Una sola sosta"
        title="Vuoi abbinare _un altro servizio_?"
        lead="Dicci quali trattamenti ti interessano: verifichiamo disponibilità, durata e compatibilità prima di fissare l'appuntamento."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Langhe -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Alba a Carmagnola"
      quote="Lash lift vegano e brow lamination, con forma e intensità concordate."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- FAQ -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Alba e dalle _Langhe_: le risposte." />
      <FaqAccordion items={faqs} kicker="FAQ Laminazione Alba" />
    </div>
  </section>

  <!-- Panoramica -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="La laminazione non è l'unico motivo per venire a Carmagnola _dalle Langhe_."
        lead="Se ti interessa anche il laser, la manicure, la pulizia viso o i protocolli, la guida ai servizi per chi arriva da Alba li raccoglie in un’unica pagina."
        primaryHref="/localita/alba"
        primaryLabel="Scopri i servizi REBEL da Alba"
        secondaryHref="/epilazione-laser-alba"
        secondaryLabel="Laser da Alba"
      />
    </div>
  </section>

  <!-- Comuni vicini -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino ad Alba" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Laminazione con durata indicativa di _sei-otto settimane_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la laminazione"
        secondaryHref="/servizi/laminazione-ciglia-sopracciglia-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame--portrait {
    max-height: 680px;
    max-width: 480px;
    margin-inline: auto;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .split-visual {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    margin-top: 1rem;
  }
  .split-visual__image {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 600px;
  }
  .split-visual__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 760px) {
    .split-visual { grid-template-columns: 1fr; }
    .split-visual__image { order: -1; }
  }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
