---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Laminazione ciglia e sopracciglia da Canale | REBEL",
  description:
    "Per chi arriva da Canale e dal Roero: Lash Lift vegano e laminazione sopracciglia a Carmagnola, con durata indicativa di 6-8 settimane. Prenota su WhatsApp.",
  path: "/laminazione-canale",
  image: "https://www.rebelepigenetica.it/img/brand/laminazione-occhio-purple.png",
  openGraphType: "article",
  keywords: [
    "laminazione ciglia Canale",
    "lash lift Canale",
    "laminazione sopracciglia Canale",
    "ciglia Canale CN",
    "laminazione ciglia Roero",
    "lash lift Roero",
    "brow lamination Canale",
    "lifting ciglia Canale d'Alba",
    "estetista ciglia sopracciglia Roero",
    "laminazione ciglia vicino Canale",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Laminazione Carmagnola", path: "/servizi/laminazione-ciglia-sopracciglia-carmagnola" },
  { name: "Canale e Roero", path: "/laminazione-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Laminazione ciglia e sopracciglia per chi viene da Canale e dal Roero",
  description: meta.description,
  path: "/laminazione-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Laminazione ciglia e sopracciglia per chi viene da Canale e dal Roero — Rebel Carmagnola",
  description: meta.description,
  path: "/laminazione-canale",
  keywords: ["laminazione ciglia Canale", "lash lift Roero", "brow lamination Canale d'Alba CN"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/brand/laminazione-occhio-purple.png",
});

const serviceSchema = buildServiceSchema(
  "Laminazione ciglia e sopracciglia per chi viene da Canale e dal Roero",
  "Lash Lift vegano e brow lamination a Carmagnola per clienti di Canale d'Alba e del Roero, con durata indicativa di 6-8 settimane.",
  "/laminazione-canale",
  {
    priceFrom: 55,
    keywords: ["lash lift Canale", "laminazione ciglia Roero CN", "brow lamination Canale d'Alba"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/laminazione-canale#service-geo`,
  name: "Laminazione ciglia e sopracciglia per chi viene da Canale e dal Roero",
  serviceType: "Lash lift and brow lamination",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7864, longitude: 8.0281 },
      geoRadius: "9000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "55.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Come arrivo da Canale a Rebel?",
    a: "Lo studio è in Viale Barbaroux 20 a Carmagnola. Apri Google Maps per controllare il percorso da Canale, il traffico e i tempi aggiornati prima di partire.",
  },
  {
    q: "Quali trattamenti di laminazione proponete?",
    a: "Puoi scegliere Lash Lift vegano, laminazione sopracciglia o entrambi. Prima della seduta osserviamo ciglia e sopracciglia e concordiamo forma e intensità.",
  },
  {
    q: "Quanto dura la laminazione?",
    a: "In genere l'effetto dura 6-8 settimane, ma può variare in base al ciclo naturale di ciglia e sopracciglia e alle abitudini successive. Al termine della seduta ti spieghiamo le accortezze da seguire.",
  },
  {
    q: "Posso fare sport dopo la laminazione?",
    a: "Nelle prime 24 ore evita acqua, vapore e attività che fanno sudare molto. In seguito puoi riprendere le tue abitudini seguendo le indicazioni ricevute in studio.",
  },
  {
    q: "Posso abbinarla ad altri trattamenti nello stesso giorno?",
    a: "Dicci quali servizi vorresti abbinare: verifichiamo tempi e compatibilità prima di fissare l'appuntamento. Se hai il laser viso programmato, valutiamo insieme se sia meglio distanziare le sedute.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Scelta del trattamento",
    title: "Lash Lift, laminazione sopracciglia o entrambi.",
    body: "Prima della seduta osserviamo ciglia e sopracciglia e concordiamo forma e intensità in base all'effetto che desideri.",
  },
  {
    kicker: "02 · Lash Lift vegano",
    title: "Lash lift sulle ciglia naturali, senza extension.",
    body: "Usiamo una formula vegana per sollevare le ciglia dalla radice. L'intensità dell'effetto dipende dalla loro lunghezza e struttura; la durata indicativa è di 6-8 settimane.",
  },
  {
    kicker: "03 · Brow lamination",
    title: "Forma e intensità concordate per le sopracciglia.",
    body: "La laminazione pettina e fissa i peli nella direzione concordata, per un effetto visivo più ordinato e definito. Forma e intensità vengono scelte insieme prima di iniziare.",
  },
  {
    kicker: "04 · Indicazioni successive",
    title: "Le accortezze per le prime 24 ore.",
    body: "Nelle prime 24 ore evita acqua, vapore, prodotti oleosi intorno agli occhi e attività che fanno sudare molto. Ti spieghiamo tutto al momento della seduta.",
  },
];

const combos = [
  {
    href: "/epilazione-laser-canale",
    title: "Laminazione + laser",
    body: "Se hai in programma il laser, indicaci zona e data: valutiamo se i due appuntamenti possano coincidere o vadano distanziati.",
  },
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Laminazione + manicure",
    body: "Se vuoi abbinare laminazione e manicure, verifichiamo la disponibilità necessaria per organizzarle nella stessa visita.",
  },
  {
    href: "/pulizia-viso-canale",
    title: "Laminazione + pulizia viso",
    body: "Puoi chiederci di organizzare laminazione e pulizia viso nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/laminazione-alba", desc: "Scopri la pagina dedicata ad Alba." },
  { city: "Bra", href: "/laminazione-bra", desc: "Scopri la pagina dedicata a Bra." },
  { city: "Tutte le località", href: "/localita", desc: "Scopri servizi e indicazioni per ogni zona." },
];

const m = getPageMedia("/laminazione-canale");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Eye — da Canale a Carmagnola"
    title="Laminazione ciglia e sopracciglia per chi viene da Canale: _forma e intensità concordate_."
    lead="Da Rebel a Carmagnola puoi scegliere Lash Lift vegano, laminazione sopracciglia o entrambi. Prima della seduta concordiamo forma e intensità."
    bullets={["Durata indicativa 6-8 settimane", "Lash lift vegano + brow lamination", "Confronto iniziale"]}
    meta={["Studio a Carmagnola", "Indicazioni su Google Maps", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Canale", href: "https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Sguardo definito"
          title="Lash lift e brow lamination _su misura per il tuo sguardo_."
          body="Il lash lift lavora sulle ciglia naturali senza extension; la brow lamination pettina e fissa i peli nella forma concordata. L'effetto e la durata variano da persona a persona."
          bullets={["Lash lift vegano sulle ciglia naturali", "Brow lamination per sopracciglia ordinate", "Durata indicativa 6-8 settimane"]}
          cta={{ label: "Scopri la laminazione", href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead kicker="Il metodo Rebel" title="Lash Lift e laminazione _con forma concordata_." lead="Puoi scegliere Lash Lift vegano, laminazione sopracciglia o entrambi. Prima di iniziare definiamo insieme l'effetto desiderato e ti spieghiamo le indicazioni per le ore successive." />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (<FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Chiedi un appuntamento</a>
        <a class="btn btn--secondary" href="/servizi/laminazione-ciglia-sopracciglia-carmagnola">Scopri la laminazione</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <div class="split-visual">
        <div class="split-visual__text">
          <SectionHead kicker="Prima e dopo" title="L'effetto _al termine della seduta_." lead="Le immagini mostrano un confronto prima e dopo; l'effetto varia in base alle caratteristiche di ciglia e sopracciglia." />
          <p class="body-p">Il Lash Lift vegano solleva le ciglia dalla radice senza aggiungere extension. Le sopracciglia vengono pettinate e fissate nella forma concordata prima della seduta.</p>
          <p class="body-p">Nelle prime 24 ore evita acqua, vapore e prodotti oleosi intorno agli occhi. Al termine ricevi tutte le indicazioni per i giorni successivi.</p>
        </div>
        <div class="split-visual__image">
          <img src="/img/brand/laminazione-prima-dopo.png" alt="Prima e dopo laminazione ciglia Rebel — confronto sguardo naturale definito" width="1200" height="800" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Canale a Rebel: _controlla il percorso su Maps_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">REBEL è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola. Apri Google Maps per controllare il percorso da Canale, il traffico e i tempi aggiornati prima di partire.</p>
          <p class="body-p">Per informazioni aggiornate sui parcheggi disponibili in zona, consulta Maps.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Canale in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Canale a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Servizi abbinabili" title="Vuoi abbinare _un altro servizio_?" lead="Dicci quali trattamenti ti interessano: verifichiamo disponibilità, durata e compatibilità prima di fissare l'appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Dal Roero a Carmagnola"
      quote="Lash lift vegano e brow lamination, con forma e intensità concordate."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <section class="section">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Informazioni sulla laminazione per chi viene da _Canale_." />
      <FaqAccordion items={faqs} kicker="FAQ Laminazione Canale" />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Altri servizi"
        title="Scopri gli altri trattamenti disponibili da _Rebel_."
        lead="Nella pagina dedicata a Canale trovi anche laser, manicure, pulizia viso e protocolli."
        primaryHref="/localita/canale"
        primaryLabel="Vedi i servizi per Canale"
        secondaryHref="/epilazione-laser-canale"
        secondaryLabel="Laser da Canale"
      />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Altre località" title="Cerchi informazioni per _un'altra zona_?" />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Laminazione con durata indicativa di _sei-otto settimane_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la laminazione"
        secondaryHref="/servizi/laminazione-ciglia-sopracciglia-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame--portrait { max-height: 680px; max-width: 480px; margin-inline: auto; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .split-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-top: 1rem; }
  .split-visual__image { border-radius: var(--r-lg); overflow: hidden; max-height: 500px; }
  .split-visual__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 760px) { .split-visual { grid-template-columns: 1fr; } .split-visual__image { order: -1; } }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
