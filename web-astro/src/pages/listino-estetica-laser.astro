---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import PriceRow from "@/components/PriceRow.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { protocolCards } from "@/lib/content";
import { rebelJourneys } from "@/lib/rebel-journeys";
import { servicePages } from "@/lib/seo-content";

const meta = createPageMeta({
  title: "Listino centro estetico, laser e protocolli | Rebel Carmagnola",
  description:
    "Prezzi Rebel a Carmagnola per i nove percorsi viso, corpo ed epilazione, più beauty, laser e protocolli mirati.",
  path: "/listino-estetica-laser",
  keywords: [
    "listino centro estetico Carmagnola",
    "prezzi centro estetico Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "prezzi pulizia viso Carmagnola",
    "prezzi manicure Carmagnola",
    "prezzi massaggi Carmagnola",
    "tariffe estetista Carmagnola",
  ],
});

const classica = servicePages.filter((s) => s.category === "estetica-classica");
const laser = servicePages.filter((s) => s.category === "laser");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Listino estetica e laser", path: "/listino-estetica-laser" },
]);
const webPage = buildWebPageSchema({
  name: "Listino e prezzi — Rebel Carmagnola",
  description:
    "Prezzi per estetica e benessere, epilazione Laser Ice Polar e protocolli professionali viso e corpo.",
  path: "/listino-estetica-laser",
});
const listinoSchema = buildItemListSchema({
  name: "Listino Rebel Estetica e Laser",
  path: "/listino-estetica-laser",
  items: [...classica, ...laser].map((s) => ({
    name: s.name,
    path: `/servizi/${s.slug}`,
  })),
});
const journeySchema = buildItemListSchema({
  name: "I nove percorsi Rebel",
  path: "/listino-estetica-laser",
  items: rebelJourneys.map((journey) => ({
    name: journey.name,
    path: `/percorsi/${journey.slug}`,
  })),
});

const switchItems = [
  { href: "#estetica", label: "Viso, corpo e beauty", glyph: "✦" },
  { href: "#laser", label: "Epilazione laser", glyph: "◉" },
  { href: "#percorsi", label: "I 9 Percorsi REBEL", glyph: "⬡" },
];
---
<BaseLayout meta={meta} bodyClass="page-beauty page-listino">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={listinoSchema} />
  <JsonLd data={journeySchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Listino Rebel · Carmagnola"
    title="Prezzi di _viso, corpo, beauty e laser_."
    lead="Consulta i prezzi dei singoli servizi e apri la relativa scheda per leggere descrizione, durata indicativa e informazioni utili. La valutazione REBEL è gratuita quando finalizzata alla costruzione del Percorso."
    bullets={["Prezzi pubblicati online", "Scheda per ogni servizio", "Valutazione REBEL · 30–40 min"]}
    meta={["Nove percorsi con prezzo", "Viso, corpo e laser", "Valutazione professionale"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: "https://wa.me/393516919416" }}
  />

  <section class="section section--tight">
    <div class="container">
      <nav class="listino-switch" aria-label="Vai alla categoria">
        {switchItems.map((it) => (
          <a class="listino-switch__btn" href={it.href}>
            <span aria-hidden="true">{it.glyph}</span>
            {it.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="estetica">
    <div class="container">
      <SectionHead
        kicker="Viso, corpo e beauty"
        title="Pulizia viso, manicure, pedicure, ceretta e massaggi."
        lead="Servizi estetici prenotabili singolarmente, con prezzo e durata indicativa riportati nella scheda dedicata."
      />
      <div class="price-grid">
        {classica.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="laser">
    <div class="container">
      <SectionHead
        kicker="Epilazione laser"
        title="Prezzi Laser Ice Polar per viso e corpo."
        lead="Lumina X1 Pro di THORY integra quattro lunghezze d’onda documentate; il comfort ICE Polar accompagna la seduta come elemento distinto. Apri la zona interessata per leggere prezzo e informazioni specifiche."
      />
      <div class="price-grid">
        {laser.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem;">
        <a class="btn btn--primary btn--halo" href="/contatti">Prenota la valutazione laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Come funziona il percorso laser</a>
      </div>
    </div>
  </section>

  <section class="section" id="percorsi">
    <div class="container">
      <SectionHead
        kicker="I nove Percorsi REBEL"
        title="Una priorità, una pagina, un prezzo di partenza."
        lead="Skin Reset, Barrier, Balance, Glow, White, Structure, Longevity, Forma e Libertà. Ogni scheda riporta durata, materia, botaniche e tecnologie selezionabili."
      />
      <div class="price-grid">
        {rebelJourneys.map((item) => (
          <PriceRow
            name={item.slug === "white" ? "Uniformare · White" : item.name}
            description={`${item.priority} · ${item.summary} · ${item.duration}`}
            price={item.price}
            href={`/percorsi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="protocolli-mirati">
    <div class="container">
      <SectionHead
        kicker="Protocolli mirati"
        title="Trattamenti professionali già prenotabili."
        lead="Lift, Rebirth 60+, Eye Genesis, Catalysis, Collagen e Cell Regen restano disponibili con la propria scheda e il proprio prezzo."
      />
      <div class="price-grid">
        {protocolCards.map((item) => <PriceRow name={item.name} description={item.desc} price={item.price} href={`/protocolli/${item.slug}`} />)}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Listino Rebel · Carmagnola"
    quote="Prezzi online e valutazione REBEL di 30–40 minuti per i percorsi personalizzati."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Ricevi una proposta con trattamento, _frequenza e prezzo_."
        lead="In 30–40 minuti valutiamo la zona interessata e ti spieghiamo il programma consigliato prima di prenotare. La valutazione è gratuita quando viene finalizzata alla costruzione del Percorso REBEL."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>

<style>
  .listino-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .listino-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
    background: rgba(7, 5, 14, 0.4);
  }
  .listino-switch__btn:hover {
    border-color: var(--mauve);
    background: rgba(91, 43, 216, 0.12);
    color: var(--ivory-1);
  }
  .listino-switch__btn span {
    color: var(--mauve);
    font-size: 0.95rem;
  }
  .price-grid {
    display: grid;
    gap: 0.6rem;
    max-width: 980px;
    margin-inline: auto;
  }
</style>
