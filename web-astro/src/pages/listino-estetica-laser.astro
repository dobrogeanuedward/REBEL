---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { menu, euro, priceRange, durationRange, requestTreatment } from "@/lib/treatment-catalog";
import { laserOffer } from "@/lib/laser-offer";
import { rebelJourneys } from "@/lib/rebel-journeys";
import { protocolPages } from "@/lib/protocol-pages";
import "@/styles/treatment-catalog.css";
const meta = createPageMeta({ title: "Trattamenti e prezzi a Carmagnola | Listino completo REBEL", description: `Il menu REBEL: 85 trattamenti beauty, 9 percorsi, protocolli viso e corpo. Durate, varianti e prezzi. Laser ${laserOffer.zone.price} a zona, Full Body ${laserOffer.totalBody.price}.`, path: "/listino-estetica-laser" });
const faq = [
 { q: "Posso scegliere un singolo trattamento?", a: "Sì. Puoi prenotare un servizio beauty senza iniziare un percorso. Se hai dubbi, ti aiutiamo a scegliere in base all’esigenza e al tempo a disposizione." },
 { q: "Il prezzo sul sito e quello su Treatwell sono uguali?", a: "Per i servizi beauty mostriamo il prezzo ordinario e, quando presente, il prezzo minimo rilevato su Treatwell. Le offerte della piattaforma possono dipendere dall’orario e dalla disponibilità: il totale aggiornato è visibile prima di confermare su Treatwell. La promo laser REBEL si richiede direttamente allo studio." },
 { q: "Che differenza c’è tra servizio, protocollo e percorso?", a: "Il servizio è il trattamento che scegli dal listino. Il protocollo combina passaggi dedicati a un’esigenza. Il percorso REBEL parte dalla valutazione e prevede frequenza e controlli concordati: prima di iniziare ti spieghiamo cosa comprende e quanto costa." },
 { q: "Come funziona la promo laser?", a: `${laserOffer.zone.price} per zona e seduta oppure ${laserOffer.totalBody.price} per ${laserOffer.totalBody.detail} in una seduta. L’inguine conta come due zone. Confermiamo insieme il conteggio e l’idoneità al trattamento prima di iniziare.` },
];
const categoryImages: Record<string,string> = { viso:"glow", corpo:"forma", massaggi:"longevity", "laser-treatwell":"liberta", sguardo:"skin-reset", pressoterapia:"forma" };
const catalogSchema = { "@context":"https://schema.org", "@type":"ItemList", name:"Trattamenti e prezzi REBEL a Carmagnola", numberOfItems:menu.categories.reduce((n,c)=>n+c.items.length,0), itemListElement:menu.categories.flatMap(c=>c.items).map((i,n)=>({"@type":"ListItem",position:n+1,name:i.name,url:`https://www.rebelepigenetica.it/listino-estetica-laser#${i.id}`})) };
---
<BaseLayout meta={meta} bodyClass="page-listino">
 <JsonLd data={buildBreadcrumbSchema([{name:"Home",path:"/"},{name:"Trattamenti e prezzi",path:"/listino-estetica-laser"}])} /><JsonLd data={catalogSchema}/><JsonLd data={{"@context":"https://schema.org","@type":"FAQPage",mainEntity:faq.map(f=>({"@type":"Question",name:f.q,acceptedAnswer:{"@type":"Answer",text:f.a}}))}}/>
 <div class="treatment-menu" data-treatment-menu>
  <header class="catalog-intro catalog-wrap">
   <div><p class="catalog-kicker">Il menu REBEL · Carmagnola</p><h1>La cura che cerchi.<br/><em>Il prezzo, in chiaro.</em></h1><p>Scegli un trattamento, confronta i percorsi o parti dalla promo laser. Qui trovi durata, varianti e il prossimo passo per prenotare.</p><a class="catalog-help" href="/contatti#prenota">Non sai da dove partire? Ti aiutiamo a scegliere ↗</a></div>
   <figure><img src="/img/film-editorial-v1/glow.webp" alt="Un momento del trattamento viso REBEL" width="1664" height="936" fetchpriority="high"/><figcaption>Viso · Corpo · Laser · Beauty</figcaption></figure>
  </header>
  <div class="catalog-tools"><div class="catalog-wrap">
   <label class="catalog-search"><span class="sr-only">Cerca un trattamento, una zona o un percorso</span><span aria-hidden="true">⌕</span><input type="search" placeholder="Cerca: pulizia viso, laser, manicure…" data-catalog-search autocomplete="off"/><button type="button" data-catalog-clear hidden aria-label="Cancella la ricerca">×</button></label>
   <details class="catalog-navigation"><summary>Categorie <span aria-hidden="true">＋</span></summary><nav aria-label="Categorie del listino"><a href="#laser">Promo laser</a><a href="#percorsi">Percorsi REBEL</a><a href="#protocolli">Protocolli</a>{menu.categories.map(c=><a href={`#${c.id}`}>{c.name}<small>{c.items.length}</small></a>)}</nav></details>
  </div></div>
  <div class="catalog-wrap catalog-body">
   <p class="catalog-result" data-catalog-result role="status" aria-live="polite">85 trattamenti beauty · 9 percorsi REBEL · promo laser</p>
   <div class="catalog-empty" data-catalog-empty hidden><h2>Troviamolo insieme.</h2><p>Prova con una zona o un’esigenza, oppure chiedici un consiglio.</p><button type="button" class="btn btn--secondary" data-catalog-reset>Mostra tutto</button><a href="/contatti#prenota" class="btn btn--primary">Chiedi a REBEL</a></div>
   <section id="laser" class="catalog-promo" data-catalog-section data-search="laser epilazione promo full body total corpo zone">
    <div class="catalog-promo__heading"><p class="catalog-kicker">{laserOffer.campaignLabel}</p><h2>Più libertà.<br/><em>A partire da una zona.</em></h2><a href={laserOffer.landingPath}>Scopri come funziona la promo →</a></div>
    <a class="catalog-promo__price" href={requestTreatment("promo-zona")}><span>Laser · a zona</span><strong>{laserOffer.zone.price}</strong><small>per zona · una seduta</small><b>Richiedi la promo ↗</b></a>
    <a class="catalog-promo__price" href={requestTreatment("promo-full-body")}><span>Laser · Full Body</span><strong>{laserOffer.totalBody.price}</strong><small>{laserOffer.totalBody.detail} · una seduta</small><b>Scegli Full Body ↗</b></a>
    <p class="catalog-promo__note">L’inguine conta come 2 zone. Confermiamo il conteggio prima della prenotazione. Promo diretta REBEL, distinta dal listino su Treatwell.</p>
   </section>
   <section id="percorsi" class="catalog-paths" data-catalog-section>
    <div class="catalog-section-head"><div><p class="catalog-kicker">Un obiettivo, un percorso</p><h2>I nove percorsi REBEL.</h2></div><a href="/percorsi">Come scegliere →</a></div>
    <div class="catalog-path-grid">{rebelJourneys.map(j=><article class="catalog-path" data-catalog-item data-search={`${j.name} ${j.area} ${j.priority} ${j.summary}`}><img src={`/img/film-editorial-v1/${j.slug}.webp`} alt={j.heroAlt} width="1664" height="936" loading="lazy"/><div><span class="catalog-kicker">{j.area} · {j.priority}</span><h3>{j.name}</h3><p>{j.summary}</p><strong>{j.price}</strong><small>{j.priceNote}</small><a href={`/percorsi/${j.slug}`}>Cosa comprende →</a></div></article>)}</div>
   </section>
   <section id="protocolli" class="catalog-protocols" data-catalog-section><div class="catalog-section-head"><div><p class="catalog-kicker">Le combinazioni REBEL</p><h2>I protocolli.</h2></div></div><div class="catalog-service-grid">{protocolPages.map(p=><article class="catalog-protocol" data-catalog-item data-search={`${p.name} ${p.shortDescription}`}><h3>{p.name}</h3><p>{p.shortDescription}</p><strong>{p.price}</strong><a href={`/protocolli/${p.slug}`}>Esplora il protocollo →</a></article>)}</div></section>
   <section id="estetica" class="catalog-beauty"><div class="catalog-section-head"><div><p class="catalog-kicker">Anche un solo trattamento</p><h2>Il listino beauty completo.</h2></div><a href={menu.source} target="_blank" rel="noopener noreferrer">Disponibilità su Treatwell ↗</a></div><p class="catalog-source">Prezzi ordinari e durate del listino Treatwell, verificati l’8 settembre 2026. Le offerte della piattaforma possono variare: verifica il totale al momento della prenotazione.</p>
    {menu.categories.map(c=><details id={c.id} class="catalog-category" data-catalog-section data-category>
     <summary class="catalog-category__heading">{categoryImages[c.id] && <img src={`/img/film-editorial-v1/${categoryImages[c.id]}.webp`} alt="" width="120" height="90" loading="lazy"/>}<h2>{c.name}</h2><span>{c.items.length} {c.items.length===1?"trattamento":"trattamenti"}</span><b aria-hidden="true">＋</b></summary>
     {c.id==="laser-treatwell" && <p class="catalog-source">Questi sono i prezzi della piattaforma. Per la promozione diretta REBEL <a href="#laser">vai alla promo laser ↑</a>.</p>}
     <div class="catalog-service-grid">{c.items.map(i=><details id={i.id} class="catalog-service" data-catalog-item data-search={`${c.name} ${i.name} ${i.options.map(o=>o.name).join(" ")}`}>
      <summary><span><h3>{i.name}</h3><small>{durationRange(i.durationMin,i.durationMax)}{i.options.length>1?` · ${i.options.length} varianti`:""}</small></span><span class="catalog-service__price"><strong>{priceRange(i.price)}</strong><small>Dettagli e prenota ＋</small></span></summary>
      <div class="catalog-service__details">{i.options.map(o=><div class="catalog-option"><div><h4>{o.name}</h4><span>{o.duration} min · {priceRange(o.price)}</span>{o.price.saleMin < o.price.min && <small>Su Treatwell da {euro(o.price.saleMin)}, secondo disponibilità.</small>}</div><a href={requestTreatment(i.id,o.id)} aria-label={`Richiedi ${i.name}, ${o.name}`}>Richiedi ↗</a></div>)}<a class="catalog-treatwell" href={menu.source} target="_blank" rel="noopener noreferrer">Scegli servizio e orario su Treatwell ↗</a><p>Il link apre il listino REBEL su Treatwell: seleziona lì trattamento, variante e appuntamento.</p></div>
     </details>)}</div>
     {['viso','corpo','massaggi','laser-treatwell'].includes(c.id) && <aside class="catalog-bridge">Cerchi continuità nei trattamenti? <a href={c.id==='laser-treatwell'?laserOffer.landingPath:c.id==='viso'?'/percorsi':'/percorsi/forma'}>Confronta {c.id==='laser-treatwell'?'la promo laser':'i percorsi REBEL'} →</a></aside>}
    </details>)}
   </section>
   <section class="catalog-faq"><p class="catalog-kicker">Prima di scegliere</p><h2>Domande sui trattamenti e sulle prenotazioni.</h2><FaqAccordion items={faq}/></section>
   <aside class="catalog-final"><h2>Hai trovato quello che cercavi?</h2><p>Ci trovi in Viale Barbaroux 20 a Carmagnola. Porta con te il trattamento che hai scelto: al resto pensiamo insieme.</p><a class="btn btn--primary" href="/contatti#prenota">Scegli come prenotare →</a></aside>
  </div>
 </div>
</BaseLayout>
<script src="@/scripts/treatment-catalog.ts"></script>
