---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import PriceRow from "@/components/PriceRow.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import LaserOffer from "@/components/LaserOffer.astro";
import { media } from "@/lib/page-media";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { protocolCards } from "@/lib/content";
import { rebelJourneys } from "@/lib/rebel-journeys";
import { servicePages } from "@/lib/seo-content-refined";

const meta = createPageMeta({
  title: "Listino centro estetico, laser e protocolli | Rebel Carmagnola",
  description:
    "Consulta i prezzi REBEL a Carmagnola per trattamenti viso e corpo, manicure, pedicure, epilazione laser, nove percorsi personalizzati e protocolli epigenetici.",
  path: "/listino-estetica-laser",
  keywords: [
    "listino centro estetico Carmagnola",
    "prezzi centro estetico Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "prezzi pulizia viso Carmagnola",
    "prezzi manicure Carmagnola",
    "prezzi massaggi Carmagnola",
    "tariffe estetista Carmagnola",
  ],
});

const classica = servicePages.filter((s) => s.category === "estetica-classica");
const laser = servicePages.filter((s) => s.category === "laser");

const formatPrice = (value: string) =>
  value
    .replace(/\bEUR\s*(\d+(?:[.,]\d+)?)/gi, "€$1")
    .replace(/€\s+(\d+(?:[.,]\d+)?)/g, "€$1")
    .replace(/(\d+)\.(\d{2})\b/g, "$1,$2")
    .replace(/(€\d+(?:,\d+)?)\s+a\s+(\d+(?:,\d+)?)(?!\s*€)/g, "$1 a €$2")
    .replace(/\s*\/\s*/g, " / ")
    .replace(/\s{2,}/g, " ")
    .trim();

const journeyDescription = (summary: string, duration: string) => {
  const sentence = summary.replace(/[.\s]+$/, "");
  return `${sentence}. Durata indicativa: ${duration}.`;
};

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Listino estetica e laser", path: "/listino-estetica-laser" },
]);
const webPage = buildWebPageSchema({
  name: "Listino e prezzi — Rebel Carmagnola",
  description:
    "Prezzi per trattamenti estetici e benessere, epilazione laser con Lumina X1 Pro, percorsi REBEL e protocolli professionali viso e corpo.",
  path: "/listino-estetica-laser",
});
const listinoSchema = buildItemListSchema({
  name: "Listino Rebel Estetica e Laser",
  path: "/listino-estetica-laser",
  items: [...classica, ...laser].map((s) => ({
    name: s.name,
    path: `/servizi/${s.slug}`,
  })),
});
const journeySchema = buildItemListSchema({
  name: "I nove percorsi Rebel",
  path: "/listino-estetica-laser",
  items: rebelJourneys.map((journey) => ({
    name: journey.slug === "white" ? "Uniformare · White" : journey.name,
    path: `/percorsi/${journey.slug}`,
  })),
});

const switchItems = [
  { href: "#estetica", label: "Trattamenti e benessere", glyph: "✦" },
  { href: "#laser", label: "Epilazione laser", glyph: "◉" },
  { href: "#percorsi", label: "I 9 Percorsi REBEL", glyph: "⬡" },
];
---
<BaseLayout meta={meta} bodyClass="page-beauty page-listino">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={listinoSchema} />
  <JsonLd data={journeySchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Listino Rebel · Carmagnola"
    title="Prezzi chiari per _trattamenti, percorsi e laser_."
    lead="Consulta prezzi, durata indicativa e informazioni utili prima di prenotare. Se scegli di iniziare il percorso proposto, la valutazione iniziale REBEL è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
    bullets={["Prezzi pubblicati online", "Dettagli per ogni servizio", "Valutazione REBEL · 30–40 min"]}
    meta={["Trattamenti singoli", "Nove percorsi REBEL", "Epilazione laser"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: "https://wa.me/393516919416" }}
  />

  <section class="section section--tight">
    <div class="container">
      <nav class="listino-switch" aria-label="Vai alla categoria">
        {switchItems.map((it) => (
          <a class="listino-switch__btn" href={it.href}>
            <span aria-hidden="true">{it.glyph}</span>
            {it.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="estetica">
    <div class="container">
      <SectionHead
        kicker="Trattamenti e benessere"
        title="Pulizia viso, manicure, pedicure, ceretta e massaggi."
        lead="Puoi prenotare ogni servizio singolarmente. Nella scheda trovi prezzo, durata indicativa e tutto ciò che è utile sapere."
      />
      <div class="price-grid">
        {classica.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={formatPrice(item.priceHint)}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="laser">
    <div class="container">
      <SectionHead
        kicker="Epilazione laser"
        title="Prezzi dell’epilazione laser per viso e corpo."
        lead="Per l’epilazione utilizziamo Lumina X1 Pro di THORY con raffreddamento a contatto ICE Polar. Scegli la zona per vedere prezzo e informazioni specifiche."
      />
      <LaserOffer compact />
      <p class="listino-laser-label">Listino ordinario</p>
      <div class="price-grid">
        {laser.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={formatPrice(item.priceHint)}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem;">
        <a class="btn btn--primary btn--halo" href="/contatti">Prenota la valutazione laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Come funziona il percorso laser</a>
      </div>
    </div>
  </section>

  <section class="section" id="percorsi">
    <div class="container">
      <SectionHead
        kicker="I nove Percorsi REBEL"
        title="Scegli in base a ciò che vuoi migliorare."
        lead="Skin Reset, Barrier, Balance, Glow, Uniformare · White, Structure, Longevity, Forma e Libertà. Per ogni percorso trovi obiettivo, durata, ingredienti e tecnologie che possono essere utilizzate."
      />
      <div class="price-grid">
        {rebelJourneys.map((item) => (
          <PriceRow
            name={item.slug === "white" ? "Uniformare · White" : item.name}
            description={journeyDescription(item.summary, item.duration)}
            price={formatPrice(item.price)}
            href={`/percorsi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tight" id="protocolli-mirati">
    <div class="container">
      <SectionHead
        kicker="Protocolli epigenetici"
        title="Trattamenti professionali per viso e corpo."
        lead="Consulta Lift, Rebirth 60+, Eye Genesis, Catalysis, Collagen e Cell Regen. Per ogni trattamento trovi a chi è rivolto, come si svolge e il prezzo."
      />
      <div class="price-grid">
        {protocolCards.map((item) => <PriceRow name={item.name} description={item.desc} price={formatPrice(item.price)} href={`/protocolli/${item.slug}`} />)}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Listino Rebel · Carmagnola"
    quote="Prezzi online e valutazione REBEL di 30–40 minuti per i percorsi personalizzati."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Hai un dubbio? Ti aiutiamo a scegliere _come iniziare_."
        lead="Durante la valutazione parliamo del risultato che desideri, osserviamo la pelle o la zona da trattare e ti spieghiamo trattamento, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .listino-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .listino-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
    background: rgba(7, 5, 14, 0.4);
  }
  .listino-switch__btn:hover {
    border-color: var(--mauve);
    background: rgba(91, 43, 216, 0.12);
    color: var(--ivory-1);
  }
  .listino-switch__btn span {
    color: var(--mauve);
    font-size: 0.95rem;
  }
  .price-grid {
    display: grid;
    gap: 0.6rem;
    max-width: 980px;
    margin-inline: auto;
  }
  .listino-laser-label {
    max-width: 980px;
    margin: 2.5rem auto .8rem;
    color: var(--mauve);
    font-size: .68rem;
    font-weight: 850;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
</style>
