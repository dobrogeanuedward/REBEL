---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import PriceRow from "@/components/PriceRow.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { protocolCards } from "@/lib/content";
import { servicePages } from "@/lib/seo-content";

const meta = createPageMeta({
  title: "Listino e Prezzi — Centro Estetico Carmagnola | Rebel",
  description:
    "Listino completo Rebel a Carmagnola con prezzi chiari: pulizia viso, manicure, ceretta, massaggi, epilazione laser Ice Polar e protocolli viso/corpo. Prima visita gratuita.",
  path: "/listino-estetica-laser",
  keywords: [
    "listino centro estetico Carmagnola",
    "prezzi centro estetico Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "prezzi pulizia viso Carmagnola",
    "prezzi manicure Carmagnola",
    "prezzi massaggi Carmagnola",
    "tariffe estetista Carmagnola",
  ],
});

const classica = servicePages.filter((s) => s.category === "estetica-classica");
const laser = servicePages.filter((s) => s.category === "laser");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Listino estetica e laser", path: "/listino-estetica-laser" },
]);
const webPage = buildWebPageSchema({
  name: "Listino e prezzi — Rebel Carmagnola",
  description:
    "Listino completo per categoria: estetica classica, epilazione laser Ice Polar, protocolli viso e corpo.",
  path: "/listino-estetica-laser",
});
const listinoSchema = buildItemListSchema({
  name: "Listino Rebel Estetica e Laser",
  path: "/listino-estetica-laser",
  items: [...classica, ...laser].map((s) => ({
    name: s.name,
    path: `/servizi/${s.slug}`,
  })),
});
const protocolSchema = buildItemListSchema({
  name: "Protocolli epigenetici Rebel (listino)",
  path: "/listino-estetica-laser",
  items: protocolCards.map((p) => ({
    name: p.name,
    path: `/protocolli/${p.slug}`,
  })),
});

const switchItems = [
  { href: "#estetica", label: "Estetica & benessere", glyph: "✦" },
  { href: "#laser", label: "Epilazione laser", glyph: "◉" },
  { href: "#epigenetica", label: "Estetica epigenetica", glyph: "⬡" },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={listinoSchema} />
  <JsonLd data={protocolSchema} />

  <PageHero
    kicker="Listino · Carmagnola"
    title="Tutto il listino, in una _pagina sola_."
    lead="Prezzi chiari, ordinati per categoria. Per ogni servizio trovi una scheda con durata, comfort e quando ha senso farlo. La prima visita resta gratuita."
    meta={["Estetica & benessere", "Epilazione laser Ice Polar", "Protocolli viso e corpo"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: "https://wa.me/393516919416" }}
  />

  <section class="section section--tight">
    <div class="container">
      <nav class="listino-switch" aria-label="Vai alla categoria">
        {switchItems.map((it) => (
          <a class="listino-switch__btn" href={it.href}>
            <span aria-hidden="true">{it.glyph}</span>
            {it.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="estetica">
    <div class="container">
      <SectionHead
        kicker="Estetica & benessere"
        title="I trattamenti _classici_, fatti come si deve."
        lead="Pulizia viso, manicure, ceretta, massaggi: i servizi su cui contare ogni mese, con tempi di seduta sensati e prodotti professionali."
      />
      <div class="price-grid">
        {classica.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="laser">
    <div class="container">
      <SectionHead
        kicker="Epilazione laser"
        title="Laser Thory + manipolo _Ice Polar_."
        lead="Diodo a tre lunghezze d'onda con raffreddamento attivo. Più comodo anche su ascelle e inguine. Valutazione iniziale gratuita."
      />
      <div class="price-grid">
        {laser.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem;">
        <a class="btn btn--primary btn--halo" href="/contatti">Prenota la valutazione gratuita</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Vedi il percorso laser</a>
      </div>
    </div>
  </section>

  <section class="section" id="epigenetica">
    <div class="container">
      <SectionHead
        kicker="Protocolli avanzati"
        title="Estetica _epigenetica_ viso e corpo."
        lead="Percorsi su più sedute con linee Marbellas ed Eberlin. Quando vuoi un risultato che lavori in profondità: tono, densità, luminosità."
      />
      <div class="price-grid">
        {protocolCards.map((item) => (
          <PriceRow
            name={item.name}
            description={item.desc}
            price={item.price}
            href={`/protocolli/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Vieni in studio per _quindici minuti_, gratis."
        lead="Capiamo da dove ha senso partire, ti facciamo una proposta scritta e scegli un piccolo regalo. Senza obbligo di acquisto."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .listino-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .listino-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
    background: rgba(7, 5, 14, 0.4);
  }
  .listino-switch__btn:hover {
    border-color: var(--mauve);
    background: rgba(91, 43, 216, 0.12);
    color: var(--ivory-1);
  }
  .listino-switch__btn span {
    color: var(--mauve);
    font-size: 0.95rem;
  }
  .price-grid {
    display: grid;
    gap: 0.6rem;
    max-width: 980px;
    margin-inline: auto;
  }
</style>
