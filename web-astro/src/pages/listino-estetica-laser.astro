---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import PriceRow from "@/components/PriceRow.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { protocolCards } from "@/lib/content";
import { servicePages } from "@/lib/seo-content";

const meta = createPageMeta({
  title: "Listino centro estetico, laser e protocolli | Rebel Carmagnola",
  description:
    "Prezzi Rebel a Carmagnola per pulizia viso, manicure, pedicure, ceretta, massaggi, epilazione Laser Ice Polar e protocolli viso e corpo.",
  path: "/listino-estetica-laser",
  keywords: [
    "listino centro estetico Carmagnola",
    "prezzi centro estetico Carmagnola",
    "prezzi epilazione laser Carmagnola",
    "prezzi pulizia viso Carmagnola",
    "prezzi manicure Carmagnola",
    "prezzi massaggi Carmagnola",
    "tariffe estetista Carmagnola",
  ],
});

const classica = servicePages.filter((s) => s.category === "estetica-classica");
const laser = servicePages.filter((s) => s.category === "laser");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Listino estetica e laser", path: "/listino-estetica-laser" },
]);
const webPage = buildWebPageSchema({
  name: "Listino e prezzi — Rebel Carmagnola",
  description:
    "Prezzi per estetica e benessere, epilazione Laser Ice Polar e protocolli professionali viso e corpo.",
  path: "/listino-estetica-laser",
});
const listinoSchema = buildItemListSchema({
  name: "Listino Rebel Estetica e Laser",
  path: "/listino-estetica-laser",
  items: [...classica, ...laser].map((s) => ({
    name: s.name,
    path: `/servizi/${s.slug}`,
  })),
});
const protocolSchema = buildItemListSchema({
  name: "Protocolli professionali Rebel",
  path: "/listino-estetica-laser",
  items: protocolCards.map((p) => ({
    name: p.name,
    path: `/protocolli/${p.slug}`,
  })),
});

const switchItems = [
  { href: "#estetica", label: "Viso, corpo e beauty", glyph: "✦" },
  { href: "#laser", label: "Epilazione laser", glyph: "◉" },
  { href: "#epigenetica", label: "Protocolli viso e corpo", glyph: "⬡" },
];
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={listinoSchema} />
  <JsonLd data={protocolSchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Listino Rebel · Carmagnola"
    title="Prezzi di _viso, corpo, beauty e laser_."
    lead="Consulta i prezzi dei singoli servizi e apri la relativa scheda per leggere descrizione, durata indicativa e informazioni utili. Per i percorsi personalizzati è disponibile una valutazione iniziale gratuita."
    bullets={["Prezzi pubblicati online", "Scheda per ogni servizio", "Valutazione iniziale gratuita"]}
    meta={["Viso, corpo e beauty", "Laser Ice Polar", "Protocolli professionali"]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: "https://wa.me/393516919416" }}
  />

  <section class="section section--tight">
    <div class="container">
      <nav class="listino-switch" aria-label="Vai alla categoria">
        {switchItems.map((it) => (
          <a class="listino-switch__btn" href={it.href}>
            <span aria-hidden="true">{it.glyph}</span>
            {it.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="estetica">
    <div class="container">
      <SectionHead
        kicker="Viso, corpo e beauty"
        title="Pulizia viso, manicure, pedicure, ceretta e massaggi."
        lead="Servizi estetici prenotabili singolarmente, con prezzo e durata indicativa riportati nella scheda dedicata."
      />
      <div class="price-grid">
        {classica.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="laser">
    <div class="container">
      <SectionHead
        kicker="Epilazione laser"
        title="Prezzi Laser Ice Polar per viso e corpo."
        lead="Laser a diodo con tre lunghezze d’onda e raffreddamento attivo. Apri la zona interessata per leggere prezzo e informazioni specifiche."
      />
      <div class="price-grid">
        {laser.map((item) => (
          <PriceRow
            name={item.name}
            description={item.shortDescription}
            price={item.priceHint}
            href={`/servizi/${item.slug}`}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem;">
        <a class="btn btn--primary btn--halo" href="/contatti">Prenota la valutazione laser</a>
        <a class="btn btn--secondary" href="/epilazione-laser-carmagnola">Come funziona il Laser Ice Polar</a>
      </div>
    </div>
  </section>

  <section class="section" id="epigenetica">
    <div class="container">
      <SectionHead
        kicker="Protocolli professionali"
        title="Trattamenti viso e corpo con obiettivi specifici."
        lead="Protocolli dedicati a luminosità, tono, pelle matura, contorno occhi, compattezza e qualità cutanea. Ogni scheda riporta prezzo e indicazioni."
      />
      <div class="price-grid">
        {protocolCards.map((item) => (
          <PriceRow
            name={item.name}
            description={item.desc}
            price={item.price}
            href={`/protocolli/${item.slug}`}
          />
        ))}
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Listino Rebel · Carmagnola"
    quote="Prezzi online e valutazione gratuita per i percorsi personalizzati."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Ricevi una proposta con trattamento, _frequenza e prezzo_."
        lead="In circa quindici minuti valutiamo la zona interessata e ti spieghiamo il programma consigliato prima di prenotare."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>

<style>
  .listino-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .listino-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
    background: rgba(7, 5, 14, 0.4);
  }
  .listino-switch__btn:hover {
    border-color: var(--mauve);
    background: rgba(91, 43, 216, 0.12);
    color: var(--ivory-1);
  }
  .listino-switch__btn span {
    color: var(--mauve);
    font-size: 0.95rem;
  }
  .price-grid {
    display: grid;
    gap: 0.6rem;
    max-width: 980px;
    margin-inline: auto;
  }
</style>
