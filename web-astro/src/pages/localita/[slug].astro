---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import type { LocalAreaPage } from "@/lib/local-pages";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return localAreaPages.map((a) => ({
    params: { slug: a.slug },
    props: { area: a },
  }));
}

const { area } = Astro.props as { area: LocalAreaPage };

const meta = createPageMeta({
  title: area.title,
  description: area.description,
  path: `/localita/${area.slug}`,
  keywords: area.keywords,
  openGraphType: "article",
});

const toWords = (v: string) => v.trim().split(/\s+/).filter(Boolean);
const readingMinutes = Math.max(
  2,
  Math.round(
    toWords(
      [
        area.intro,
        area.description,
        area.whyRebel.join(" "),
        area.directions?.heading ?? "",
        (area.directions?.paragraphs ?? []).join(" "),
        area.focus?.heading ?? "",
        (area.focus?.paragraphs ?? []).join(" "),
        (area.faqs ?? []).map((f) => `${f.q} ${f.a}`).join(" "),
      ].join(" "),
    ).length / 190,
  ),
);

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Località", path: "/localita" },
  { name: area.city, path: `/localita/${area.slug}` },
]);
const webPage = buildWebPageSchema({
  name: area.title,
  description: area.description,
  path: `/localita/${area.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: area.title,
  description: area.description,
  path: `/localita/${area.slug}`,
  keywords: area.keywords,
  section: "Aree servite",
});

const pageFaqs = area.faqs ?? [];
const faqSchema =
  pageFaqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: pageFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
      }
    : null;

const focusLinks = area.focus?.links ?? [];

const relatedAreas = localAreaPages
  .filter((i) => i.slug !== area.slug && i.cluster === area.cluster)
  .slice(0, 6);

const tocItems = [
  { id: "perche", label: `Perché Rebel (${area.city})` },
  { id: "partire", label: "Da dove partire" },
  ...(area.directions ? [{ id: "come-arrivare", label: "Come arrivare" }] : []),
  ...(area.focus ? [{ id: "focus", label: "Approfondimento locale" }] : []),
  ...(pageFaqs.length > 0 ? [{ id: "faq", label: "Domande frequenti" }] : []),
  ...(relatedAreas.length > 0 ? [{ id: "vicini", label: "Comuni vicini" }] : []),
];
---
<BaseLayout meta={meta} bodyClass="page-localita-detail">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  {faqSchema ? <JsonLd data={faqSchema} /> : null}

  <PageHero
    kicker="Rebel vicino a te"
    title={area.title.replace(area.city, `_${area.city}_`)}
    lead={area.intro}
    meta={[
      `${area.city} e zone limitrofe`,
      `${readingMinutes} min lettura`,
      `Aggiornato ${siteConfig.lastUpdated}`,
    ]}
    ctaPrimary={{ label: "Prenota ora", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri Maps", href: siteConfig.social.maps }}
  />

  <section class="section">
    <div class="container detail-grid">
      <article class="detail-main">
        <div id="perche">
          <SectionHead
            kicker={`Perché Rebel`}
            title={`Perché chi arriva da _${area.city}_ sceglie Rebel.`}
          />
          <KeyPointsGrid points={area.whyRebel} />
        </div>

        <div id="partire" class="detail-section">
          <SectionHead
            kicker="Da dove partire"
            title={`Se _arrivi da ${area.city}_: il primo passo.`}
            lead={`Scegliamo insieme una priorità (laser, viso o corpo) e impostiamo ritmo e obiettivo.`}
          />
          {focusLinks.length > 0 ? (
            <div class="card-grid card-grid--2">
              {focusLinks.slice(0, 4).map((l, i) => (
                l.external || l.href.startsWith("http") ? (
                  <a class="card card--quiet" href={l.href} target="_blank" rel="noreferrer" data-link="true" data-reveal>
                    <span class="card__index">{String(i + 1).padStart(2, "0")}</span>
                    <p class="card__kicker">Link utile</p>
                    <h3 class="card__title">{l.label}</h3>
                    {l.description ? <p class="card__body">{l.description}</p> : null}
                  </a>
                ) : (
                  <FeatureCard
                    kicker="Link utile"
                    title={l.label}
                    body={l.description ?? ""}
                    href={l.href}
                    variant="quiet"
                    index={i + 1}
                  />
                )
              ))}
            </div>
          ) : null}
        </div>

        {area.directions ? (
          <div id="come-arrivare" class="detail-section">
            <SectionHead kicker="Come arrivare" title={area.directions.heading} />
            <div class="directions-grid">
              <div>
                {area.directions.paragraphs.map((p) => (
                  <p class="directions-p">{p}</p>
                ))}
                <div class="cluster" style="margin-top:1.4rem;">
                  <a class="btn btn--secondary btn--sm" href={area.directions.mapsUrl} target="_blank" rel="noreferrer">
                    Apri percorso su Google Maps
                  </a>
                  <a class="btn btn--secondary btn--sm" href="/contatti">Contatti</a>
                </div>
              </div>
              <div class="map-frame">
                <iframe
                  src={area.directions.embedUrl ?? "https://www.google.com/maps?q=Viale+Barbaroux+20,+Carmagnola&output=embed"}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mappa percorso verso Rebel da ${area.city}`}
                ></iframe>
              </div>
            </div>
          </div>
        ) : null}

        {area.focus ? (
          <div id="focus" class="detail-section">
            <SectionHead
              kicker="Approfondimento locale"
              title={area.focus.heading}
            />
            <div class="editorial-flow">
              {area.focus.paragraphs.map((p) => (
                <p class="focus-p">{p}</p>
              ))}
            </div>
          </div>
        ) : null}

        {pageFaqs.length > 0 ? (
          <div id="faq" class="detail-section">
            <SectionHead
              kicker="Domande frequenti"
              title={`Da _${area.city}_, le risposte oneste.`}
            />
            <FaqAccordion items={pageFaqs} kicker={`Da ${area.city}`} />
          </div>
        ) : null}

        {relatedAreas.length > 0 ? (
          <div id="vicini" class="detail-section">
            <SectionHead
              kicker="Comuni vicini"
              title={`_Vicino_ a ${area.city}.`}
              lead="Le pagine dei comuni vicini, ognuna con un focus diverso."
            />
            <div class="card-grid card-grid--3">
              {relatedAreas.map((a, i) => (
                <FeatureCard
                  kicker="Località"
                  title={a.city}
                  body={a.description}
                  href={`/localita/${a.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}
      </article>

      <aside class="detail-aside">
        <TableOfContents items={tocItems} />
        <InlineCta
          kicker="Da dove parti?"
          title={`Da _${area.city}_, definiamo il primo passo.`}
          lead="Scrivici zona, obiettivo, tempi: orientiamo verso il trattamento più adatto."
          primaryHref="/contatti"
          primaryLabel="Apri consulenza"
          secondaryHref="/servizi"
          secondaryLabel="Tutti i servizi"
        />
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { order: -1; }
  }
  .detail-main { min-width: 0; }
  .detail-section { margin-top: clamp(3rem, 6vw, 5rem); }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    margin-top: 1.4rem;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .directions-p, .focus-p {
    font-size: var(--t-body);
    line-height: var(--leading-body);
    color: var(--text);
    margin: 0 0 0.85rem;
    max-width: 70ch;
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .editorial-flow { display: grid; gap: 1rem; max-width: 70ch; margin-top: 1.6rem; }
  .detail-aside { display: grid; gap: 1.4rem; }
</style>
