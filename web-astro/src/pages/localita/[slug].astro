---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import type { LocalAreaPage } from "@/lib/local-pages";
import { localAreaPages } from "@/lib/local-pages";
import { media } from "@/lib/page-media";
import {
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return localAreaPages.map((a) => ({
    params: { slug: a.slug },
    props: { area: a },
  }));
}

const { area } = Astro.props as { area: LocalAreaPage };

const localeMood =
  area.slug === "racconigi"
    ? media.locale.racconigi
    : area.slug === "alba"
    ? media.locale.langhe
    : area.slug === "canale"
      ? media.locale.roero
      : area.slug === "bra"
        ? media.locale.bra
        : media.studio.realExterior;

const isCarmagnola = area.slug === "carmagnola";
const visitMedia = isCarmagnola ? media.studio.realExterior : media.studio.realOverview;
const originLabel = isCarmagnola ? "REBEL Carmagnola" : `Da ${area.city} a REBEL Carmagnola`;
const clearTitle = isCarmagnola
  ? "REBEL Carmagnola | Indirizzo, servizi e contatti"
  : `Da ${area.city} a REBEL Carmagnola | Indicazioni e contatti`;
const clearDescription = isCarmagnola
  ? "REBEL si trova in Viale Barbaroux 20 a Carmagnola. Consulta mappa, servizi, prezzi e modalità di prenotazione."
  : `REBEL si trova in Viale Barbaroux 20 a Carmagnola. Da ${area.city}, consulta mappa, servizi, prezzi e modalità di prenotazione.`;
const clearIntro = `Lo studio è in Viale Barbaroux 20 a Carmagnola. Qui trovi il percorso sulla mappa, i servizi disponibili, il listino e i contatti per prenotare.`;
const clearWhyRebel = [
  "Viale Barbaroux 20 · Carmagnola",
  "Trattamenti viso, corpo, laser e beauty",
  "Listino online e valutazione REBEL di 30–40 minuti",
];
const clearFaqs = [
  {
    q: "Dove si trova REBEL?",
    a: "Lo studio è in Viale Barbaroux 20 a Carmagnola. Puoi aprire la mappa qui per ottenere il percorso aggiornato.",
  },
  {
    q: isCarmagnola ? "Come posso prenotare?" : `Come posso prenotare se arrivo da ${area.city}?`,
    a: "Puoi scriverci su WhatsApp oppure usare il modulo contatti. Indicaci il trattamento che ti interessa e le tue disponibilità.",
  },
  {
    q: "Dove posso vedere i prezzi?",
    a: "Il listino online riporta i prezzi dei servizi, dei percorsi REBEL e delle aree laser.",
  },
  {
    q: "Come funziona la valutazione REBEL?",
    a: "Dura 30–40 minuti: osserviamo la zona e ti spieghiamo trattamento, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita.",
  },
];
const clearDirections = area.directions
  ? {
      mapsUrl: area.directions.mapsUrl,
      embedUrl: area.directions.embedUrl,
    }
  : undefined;
const focusLinks = [
  {
    kicker: "Servizi",
    label: "Scopri tutti i servizi",
    body: "Consulta i trattamenti disponibili e le informazioni utili prima di prenotare.",
    href: "/servizi",
  },
  {
    kicker: "Prezzi",
    label: "Consulta il listino",
    body: "Trova prezzi e durata indicativa di trattamenti, laser e percorsi REBEL.",
    href: "/listino-estetica-laser",
  },
  {
    kicker: "Valutazione",
    label: "Prenota la valutazione REBEL",
    body: "Scrivici per verificare la disponibilità e organizzare il primo appuntamento.",
    href: "/contatti",
  },
  {
    kicker: "Percorsi REBEL",
    label: "Esplora i nove percorsi",
    body: "Confronta obiettivi, durata e prezzo di ogni percorso REBEL.",
    href: "/percorsi",
  },
];

const meta = createPageMeta({
  title: clearTitle,
  description: clearDescription,
  path: `/localita/${area.slug}`,
  openGraphType: "article",
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Località", path: "/localita" },
  { name: area.city, path: `/localita/${area.slug}` },
]);
const webPage = buildWebPageSchema({
  name: clearTitle,
  description: clearDescription,
  path: `/localita/${area.slug}`,
});

const faqSchema =
  clearFaqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: clearFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
      }
    : null;

const relatedAreas = localAreaPages
  .filter((item) => item.slug !== area.slug && item.cluster === area.cluster)
  .slice(0, 6);

const tocItems = [
  { id: "servizi", label: "Servizi e informazioni" },
  { id: "prenotare", label: "Prezzi e prenotazione" },
  ...(clearDirections ? [{ id: "come-arrivare", label: "Percorso e mappa" }] : []),
  { id: "focus", label: "Prima di venire" },
  { id: "faq", label: "Domande frequenti" },
  ...(relatedAreas.length > 0 ? [{ id: "vicini", label: "Altri comuni" }] : []),
];
---
<BaseLayout meta={meta} bodyClass="page-localita-detail">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  {faqSchema ? <JsonLd data={faqSchema} /> : null}

  <PageHero
    image={localeMood}
    kicker={originLabel}
    title={`Indicazioni per raggiungere _REBEL_.`}
    lead={clearIntro}
    bullets={["Indirizzo e mappa", "Servizi e prezzi online", "Valutazione REBEL · 30–40 min"]}
    meta={[
      "Viale Barbaroux 20 · Carmagnola",
      "Da martedì a sabato · su appuntamento",
    ]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri il percorso su Maps", href: siteConfig.social.maps }}
  />

  <section class="section">
    <div class="container detail-grid">
      <article class="detail-main">
        <div id="servizi">
          <SectionHead
            kicker="Prima di prenotare"
            title="Tutto ciò che ti serve per organizzare la visita."
            lead="REBEL offre trattamenti viso, corpo, laser e beauty. Puoi consultare prezzi e durata online oppure scriverci per scegliere il trattamento."
          />
          <KeyPointsGrid points={clearWhyRebel} title="Informazioni utili" />
        </div>

        <div id="prenotare" class="detail-section">
          <SectionHead
            kicker="Prezzi e prenotazione"
            title={isCarmagnola ? "Organizza la tua visita." : `Organizza la tua visita da ${area.city}.`}
            lead="Consulta il listino oppure prenota una valutazione REBEL di 30–40 minuti per definire trattamento, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita."
          />
          <div class="card-grid card-grid--2">
            <FeatureCard
              kicker="Prezzi"
              title="Consulta il listino Rebel"
              body="Prezzi per trattamenti viso, corpo, laser, beauty, massaggi e protocolli professionali."
              href="/listino-estetica-laser"
              variant="quiet"
              index={1}
            />
            <FeatureCard
              kicker="Valutazione"
              title="Prenota la valutazione REBEL"
              body="In 30–40 minuti valutiamo la zona e definiamo trattamento, frequenza e prezzo. Se inizi il percorso proposto, la valutazione iniziale è gratuita."
              href="/contatti"
              variant="quiet"
              index={2}
            />
          </div>
        </div>

        {clearDirections ? (
          <div id="come-arrivare" class="detail-section">
            <SectionHead kicker="Percorso e mappa" title={isCarmagnola ? "Viale Barbaroux 20, Carmagnola." : `Da ${area.city} a Viale Barbaroux 20.`} />
            <div class="directions-grid">
              <div>
                <p class="directions-p">REBEL si trova a Carmagnola. Apri la mappa per ottenere il percorso aggiornato da {area.city} in base al mezzo con cui viaggi.</p>
                <p class="directions-p">Per orari e disponibilità puoi contattarci prima di partire.</p>
                <div class="cluster" style="margin-top:1.4rem;">
                  <a class="btn btn--secondary btn--sm" href={clearDirections.mapsUrl} target="_blank" rel="noreferrer">Apri Google Maps</a>
                  <a class="btn btn--secondary btn--sm" href="/contatti">Telefono, WhatsApp e orari</a>
                </div>
              </div>
              <div class="map-frame">
                <iframe
                  src={clearDirections.embedUrl ?? "https://www.google.com/maps?q=Viale+Barbaroux+20,+Carmagnola&output=embed"}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mappa del percorso da ${area.city} a Rebel Carmagnola`}
                ></iframe>
              </div>
            </div>
          </div>
        ) : null}

        <div id="focus" class="detail-section">
          <SectionHead kicker="Prima di venire" title={isCarmagnola ? "Servizi e prezzi a Carmagnola." : `Servizi e prezzi per chi arriva da ${area.city}.`} />
          <div class="editorial-flow">
            <EditorialSection
              heading="Lo studio e il primo appuntamento."
              paragraphs={[
                "Lo studio è a Carmagnola, in Viale Barbaroux 20. Trovi trattamenti viso, corpo, laser e beauty, con prezzi consultabili online.",
                "Se non sai quale trattamento scegliere, durante la valutazione ti spieghiamo opzioni, frequenza e prezzo prima di iniziare.",
              ]}
              media={visitMedia}
              mediaSide="end"
              level={3}
            />
          </div>
          {focusLinks.length > 0 ? (
            <div class="card-grid card-grid--2" style="margin-top:1.5rem;">
              {focusLinks.map((link, i) => (
                <FeatureCard
                  kicker={link.kicker}
                  title={link.label}
                  body={link.body}
                  href={link.href}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          ) : null}
        </div>

        <div id="faq" class="detail-section">
          <SectionHead
            kicker="Domande frequenti"
            title="Le informazioni pratiche prima dell’appuntamento."
          />
          <FaqAccordion items={clearFaqs} kicker={`Da ${area.city}`} />
        </div>

        {relatedAreas.length > 0 ? (
          <div id="vicini" class="detail-section">
            <SectionHead
              kicker="Altri comuni della zona"
              title="Indicazioni per raggiungere Rebel dai comuni vicini."
              lead="Scegli il comune per aprire la mappa e trovare contatti, servizi e prezzi."
            />
            <div class="card-grid card-grid--3">
              {relatedAreas.map((relatedArea, i) => (
                <FeatureCard
                  kicker="Località"
                  title={relatedArea.city}
                  body={`Indicazioni e contatti per organizzare la visita da ${relatedArea.city}.`}
                  href={`/localita/${relatedArea.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}
      </article>

      <aside class="detail-aside">
        <TableOfContents items={tocItems} />
        <InlineCta
          kicker="Valutazione REBEL · 30–40 minuti"
          title={isCarmagnola ? "Prenota una valutazione in studio." : `Vieni da ${area.city}? Prenota una valutazione in studio.`}
          lead="Indicaci il servizio o la zona che ti interessa. Ti spieghiamo trattamento, frequenza e prezzo prima di iniziare."
          primaryHref="/contatti"
          primaryLabel="Prenota la valutazione"
          secondaryHref="/servizi"
          secondaryLabel="Vedi tutti i servizi"
        />
      </aside>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="center"
    kicker={originLabel}
    title="Valutazione REBEL di _30–40 minuti_."
    lead="Valutiamo la zona e definiamo trattamento, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita."
    cta={{ label: "Prenota la valutazione", href: "/contatti" }}
  />

  <StickyBookingBar priceHint="Valutazione 30–40 min" primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { order: -1; }
  }
  .detail-main { min-width: 0; }
  .detail-section { margin-top: clamp(3rem, 6vw, 5rem); }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    margin-top: 1.4rem;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .directions-p {
    font-size: var(--t-body);
    line-height: var(--leading-body);
    color: var(--text);
    margin: 0 0 0.85rem;
    max-width: 70ch;
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .editorial-flow { display: grid; gap: 1rem; margin-top: 1.6rem; }
  .detail-aside { display: grid; gap: 1.4rem; }
</style>
