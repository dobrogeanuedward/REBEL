---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import type { LocalAreaPage } from "@/lib/local-pages";
import { localAreaPages } from "@/lib/local-pages";
import { media } from "@/lib/page-media";
import { clarifyCopy } from "@/lib/copy-clarity";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return localAreaPages.map((a) => ({
    params: { slug: a.slug },
    props: { area: a },
  }));
}

const { area } = Astro.props as { area: LocalAreaPage };

const localeMood =
  area.slug === "alba"
    ? media.locale.langhe
    : area.slug === "canale"
      ? media.locale.roero
      : area.slug === "bra"
        ? media.locale.bra
        : media.studio.cabin;

const clearTitle = clarifyCopy(area.title);
const clearDescription = clarifyCopy(area.description);
const clearIntro = clarifyCopy(area.intro);
const clearWhyRebel = area.whyRebel.map(clarifyCopy);
const clearFaqs = (area.faqs ?? []).map((faq) => ({ q: clarifyCopy(faq.q), a: clarifyCopy(faq.a) }));
const clearDirections = area.directions
  ? {
      ...area.directions,
      heading: clarifyCopy(area.directions.heading),
      paragraphs: area.directions.paragraphs.map(clarifyCopy),
    }
  : undefined;
const clearFocus = area.focus
  ? {
      ...area.focus,
      heading: clarifyCopy(area.focus.heading),
      paragraphs: area.focus.paragraphs.map(clarifyCopy),
      links: area.focus.links.map((link) => ({
        ...link,
        label: clarifyCopy(link.label),
        description: link.description ? clarifyCopy(link.description) : undefined,
      })),
    }
  : undefined;

const meta = createPageMeta({
  title: clearTitle,
  description: clearDescription,
  path: `/localita/${area.slug}`,
  keywords: area.keywords,
  openGraphType: "article",
});

const toWords = (v: string) => v.trim().split(/\s+/).filter(Boolean);
const readingMinutes = Math.max(
  2,
  Math.round(
    toWords(
      [
        clearIntro,
        clearDescription,
        clearWhyRebel.join(" "),
        clearDirections?.heading ?? "",
        (clearDirections?.paragraphs ?? []).join(" "),
        clearFocus?.heading ?? "",
        (clearFocus?.paragraphs ?? []).join(" "),
        clearFaqs.map((f) => `${f.q} ${f.a}`).join(" "),
      ].join(" "),
    ).length / 190,
  ),
);

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Località", path: "/localita" },
  { name: area.city, path: `/localita/${area.slug}` },
]);
const webPage = buildWebPageSchema({
  name: clearTitle,
  description: clearDescription,
  path: `/localita/${area.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: clearTitle,
  description: clearDescription,
  path: `/localita/${area.slug}`,
  keywords: area.keywords,
  section: "Come raggiungere Rebel",
});

const faqSchema =
  clearFaqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: clearFaqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
      }
    : null;

const focusLinks = clearFocus?.links ?? [];
const relatedAreas = localAreaPages
  .filter((item) => item.slug !== area.slug && item.cluster === area.cluster)
  .slice(0, 6);

const tocItems = [
  { id: "servizi", label: "Servizi e vantaggi" },
  { id: "prenotare", label: "Prezzi e prenotazione" },
  ...(clearDirections ? [{ id: "come-arrivare", label: "Percorso e mappa" }] : []),
  ...(clearFocus ? [{ id: "focus", label: "Informazioni per la zona" }] : []),
  ...(clearFaqs.length > 0 ? [{ id: "faq", label: "Domande frequenti" }] : []),
  ...(relatedAreas.length > 0 ? [{ id: "vicini", label: "Altri comuni" }] : []),
];
---
<BaseLayout meta={meta} bodyClass="page-localita-detail">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  {faqSchema ? <JsonLd data={faqSchema} /> : null}

  <PageHero
    image={localeMood}
    kicker={`Centro estetico per chi arriva da ${area.city}`}
    title={clearTitle.replace(area.city, `_${area.city}_`)}
    lead={clearIntro}
    bullets={[`Indicazioni da ${area.city}`, "Listino online", "Prima visita gratuita"]}
    meta={[
      `${readingMinutes} min di lettura`,
      `Studio in Viale Barbaroux 20 · Carmagnola`,
    ]}
    ctaPrimary={{ label: "Prenota la prima visita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri il percorso su Maps", href: siteConfig.social.maps }}
  />

  <section class="section">
    <div class="container detail-grid">
      <article class="detail-main">
        <div id="servizi">
          <SectionHead
            kicker={`Rebel per chi arriva da ${area.city}`}
            title="Servizi, prezzi e informazioni prima dell’appuntamento."
            lead={`Lo studio offre trattamenti viso, corpo, laser e beauty. Le schede online riportano prezzo, durata indicativa e modalità di ogni servizio.`}
          />
          <KeyPointsGrid points={clearWhyRebel} title="Informazioni utili" />
        </div>

        <div id="prenotare" class="detail-section">
          <SectionHead
            kicker="Prezzi e prenotazione"
            title={`Come scegliere e prenotare un trattamento da ${area.city}.`}
            lead="Puoi consultare il listino, aprire la scheda del servizio oppure prenotare una visita gratuita di circa quindici minuti per ricevere indicazioni su trattamento, frequenza e prezzo."
          />
          {focusLinks.length > 0 ? (
            <div class="card-grid card-grid--2">
              {focusLinks.slice(0, 4).map((link, i) => (
                link.external || link.href.startsWith("http") ? (
                  <a class="card card--quiet" href={link.href} target="_blank" rel="noreferrer" data-link="true" data-reveal>
                    <span class="card__index">{String(i + 1).padStart(2, "0")}</span>
                    <p class="card__kicker">Informazione utile</p>
                    <h3 class="card__title">{link.label}</h3>
                    {link.description ? <p class="card__body">{link.description}</p> : null}
                  </a>
                ) : (
                  <FeatureCard
                    kicker="Informazione utile"
                    title={link.label}
                    body={link.description ?? "Apri la pagina per leggere informazioni, prezzo o modalità di prenotazione."}
                    href={link.href}
                    variant="quiet"
                    index={i + 1}
                  />
                )
              ))}
            </div>
          ) : (
            <div class="card-grid card-grid--2">
              <FeatureCard
                kicker="Prezzi"
                title="Consulta il listino Rebel"
                body="Prezzi di viso, corpo, laser, manicure, pedicure, massaggi e protocolli professionali."
                href="/listino-estetica-laser"
                variant="quiet"
                index={1}
              />
              <FeatureCard
                kicker="Prima visita"
                title="Prenota una valutazione gratuita"
                body="In circa quindici minuti valutiamo la zona e ti comunichiamo trattamento, frequenza e prezzo."
                href="/contatti"
                variant="quiet"
                index={2}
              />
            </div>
          )}
        </div>

        {clearDirections ? (
          <div id="come-arrivare" class="detail-section">
            <SectionHead kicker="Percorso e mappa" title={clearDirections.heading} />
            <div class="directions-grid">
              <div>
                {clearDirections.paragraphs.map((paragraph) => (
                  <p class="directions-p">{paragraph}</p>
                ))}
                <div class="cluster" style="margin-top:1.4rem;">
                  <a class="btn btn--secondary btn--sm" href={clearDirections.mapsUrl} target="_blank" rel="noreferrer">Apri Google Maps</a>
                  <a class="btn btn--secondary btn--sm" href="/contatti">Telefono, WhatsApp e orari</a>
                </div>
              </div>
              <div class="map-frame">
                <iframe
                  src={clearDirections.embedUrl ?? "https://www.google.com/maps?q=Viale+Barbaroux+20,+Carmagnola&output=embed"}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title={`Mappa del percorso da ${area.city} a Rebel Carmagnola`}
                ></iframe>
              </div>
            </div>
          </div>
        ) : null}

        {clearFocus ? (
          <div id="focus" class="detail-section">
            <SectionHead kicker={`Informazioni per chi arriva da ${area.city}`} title={clearFocus.heading} />
            <div class="editorial-flow">
              {clearFocus.paragraphs.map((paragraph) => (
                <p class="focus-p">{paragraph}</p>
              ))}
            </div>
          </div>
        ) : null}

        {clearFaqs.length > 0 ? (
          <div id="faq" class="detail-section">
            <SectionHead
              kicker="Domande frequenti"
              title={`Distanza, appuntamenti, prezzi e servizi per chi arriva da ${area.city}.`}
            />
            <FaqAccordion items={clearFaqs} kicker={`Da ${area.city}`} />
          </div>
        ) : null}

        {relatedAreas.length > 0 ? (
          <div id="vicini" class="detail-section">
            <SectionHead
              kicker="Altri comuni della zona"
              title="Indicazioni per raggiungere Rebel dai comuni vicini."
              lead="Ogni pagina riporta informazioni locali e collegamenti a servizi, listino e prenotazione."
            />
            <div class="card-grid card-grid--3">
              {relatedAreas.map((relatedArea, i) => (
                <FeatureCard
                  kicker="Località"
                  title={relatedArea.city}
                  body={relatedArea.description}
                  href={`/localita/${relatedArea.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}
      </article>

      <aside class="detail-aside">
        <TableOfContents items={tocItems} />
        <InlineCta
          kicker="Prima visita gratuita"
          title={`Vieni da ${area.city}? Prenota una valutazione in studio.`}
          lead="Indicaci il servizio o la zona che ti interessa. Ti comunichiamo appuntamento, trattamento, frequenza e prezzo."
          primaryHref="/contatti"
          primaryLabel="Prenota la prima visita"
          secondaryHref="/servizi"
          secondaryLabel="Vedi tutti i servizi"
        />
      </aside>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="center"
    kicker={`Da ${area.city} a Rebel Carmagnola`}
    title="Prima visita gratuita di circa _quindici minuti_."
    lead="Valutiamo la zona interessata e ti comunichiamo trattamento consigliato, frequenza e prezzo prima della prenotazione."
    cta={{ label: "Prenota la prima visita", href: "/contatti" }}
  />

  <StickyBookingBar priceHint="Prima visita gratuita" primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { order: -1; }
  }
  .detail-main { min-width: 0; }
  .detail-section { margin-top: clamp(3rem, 6vw, 5rem); }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
    margin-top: 1.4rem;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .directions-p, .focus-p {
    font-size: var(--t-body);
    line-height: var(--leading-body);
    color: var(--text);
    margin: 0 0 0.85rem;
    max-width: 70ch;
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .editorial-flow { display: grid; gap: 1rem; max-width: 70ch; margin-top: 1.6rem; }
  .detail-aside { display: grid; gap: 1.4rem; }
</style>
