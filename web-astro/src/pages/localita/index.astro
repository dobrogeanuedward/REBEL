---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import MediaFigure from "@/components/MediaFigure.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Come raggiungere Rebel da Carmagnola, Torino Sud e Cuneese",
  description:
    "REBEL si trova in Viale Barbaroux 20 a Carmagnola. Trova mappa, indicazioni, servizi, prezzi e contatti per organizzare la visita.",
  path: "/localita",
  keywords: [
    "centro estetico Carmagnola e dintorni",
    "estetista Carmagnola Torino sud",
    "estetista vicino Carmagnola",
    "epilazione laser Torino sud",
    "epilazione laser Cuneese",
  ],
});

const areaGroups = [
  {
    key: "asse-carmagnola" as const,
    kicker: "Comuni vicini a Carmagnola",
    title: "Carignano, Racconigi, Poirino, Villastellone e dintorni.",
    lead: "Scegli il comune per vedere il percorso verso lo studio, i servizi disponibili e i contatti.",
    image: media.locale.racconigi,
    caption: "Il territorio tra Carmagnola e Racconigi; per tempi e percorso aggiornati apri sempre la mappa.",
  },
  {
    key: "torino-sud" as const,
    kicker: "Torino Sud",
    title: "Moncalieri, Nichelino, Vinovo, La Loggia e comuni limitrofi.",
    lead: "Mappa, indicazioni verso Carmagnola e informazioni utili prima dell’appuntamento.",
    image: media.studio.realExterior,
    caption: "L’ingresso REBEL in Viale Barbaroux 20, punto di arrivo delle indicazioni.",
  },
  {
    key: "cuneo" as const,
    kicker: "Provincia di Cuneo",
    title: "Alba, Bra, Canale, Savigliano, Fossano, Saluzzo e altre località.",
    lead: "Indicazioni per raggiungere lo studio e informazioni su trattamenti viso, corpo, epilazione laser e valutazione REBEL.",
    image: media.locale.langhe,
    caption: "Filari e colline delle Langhe, una delle aree da cui raggiungere lo studio di Carmagnola.",
  },
];

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Località", path: "/localita" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Località e indicazioni per raggiungere Rebel",
  description:
    "Mappe, indicazioni e contatti per raggiungere lo studio REBEL di Carmagnola dai comuni vicini.",
  path: "/localita",
});
const localAreaListSchema = buildItemListSchema({
  name: "Località con indicazioni per raggiungere REBEL",
  path: "/localita",
  items: localAreaPages.map((a) => ({ name: a.city, path: `/localita/${a.slug}` })),
});

const groupedAreas = areaGroups.map((group) => ({
  ...group,
  areas: localAreaPages.filter((area) => area.cluster === group.key),
}));
---
<BaseLayout meta={meta} bodyClass="page-localita">
  <JsonLd data={breadcrumb} />
  <JsonLd data={localAreaListSchema} />
  <JsonLd data={webPageSchema} />

  <PageHero
    image={media.locale.langhe}
    kicker="Come raggiungere Rebel · Carmagnola"
    title="Indicazioni da Torino Sud e _provincia di Cuneo_."
    lead="Lo studio è in Viale Barbaroux 20 a Carmagnola. Scegli il tuo comune per aprire la mappa e trovare servizi, prezzi e contatti."
    bullets={[`${localAreaPages.length} località`, "Mappe e indicazioni", "Valutazione REBEL · 30–40 min"]}
    meta={["Viale Barbaroux 20 · Carmagnola", "Da martedì a sabato", "Su appuntamento"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Indicazioni da Carmagnola", href: "/localita/carmagnola" }}
  />

  {groupedAreas.map((group) =>
    group.areas.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHead kicker={group.kicker} title={group.title} lead={group.lead} />
          <MediaFigure src={group.image.src} alt={group.image.alt} caption={group.caption} ratio="21/9" width={1915} height={821} />
          <div class="card-grid card-grid--3" style="margin-top:2rem;">
            {group.areas.map((area, i) => (
              <FeatureCard
                kicker="Indicazioni e servizi"
                title={area.city}
                body={`Mappa, contatti e informazioni per organizzare la visita da ${area.city}.`}
                href={`/localita/${area.slug}`}
                ariaLabel={`Apri indicazioni e servizi per ${area.city}`}
                index={i + 1}
              />
            ))}
          </div>
        </div>
      </section>
    ) : null,
  )}

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Informazioni prima di venire"
        title="Epilazione laser, percorsi viso e corpo e listino completo."
        lead="Scopri i trattamenti disponibili, come funziona la valutazione e quali sono i prezzi."
      />
      <div class="card-grid card-grid--3">
        <FeatureCard
          kicker="Epilazione laser"
          title="Epilazione laser con ICE Polar: zone, prezzi e sedute"
          body="Tecnologia, raffreddamento, valutazione iniziale, frequenza e prezzi per viso e corpo."
          href="/epilazione-laser-carmagnola"
        />
        <FeatureCard
          kicker="Trattamenti personalizzati"
          title="Protocolli professionali per viso e corpo"
          body="Confronta esigenze trattate, modalità, prezzi e indicazioni prima di prenotare."
          href="/protocolli-epigenetici"
        />
        <FeatureCard
          kicker="Prezzi"
          title="Listino completo Rebel"
          body="Prezzi di viso, corpo, beauty, massaggi, laser e protocolli professionali."
          href="/listino-estetica-laser"
        />
      </div>
    </div>
  </section>

  <FullBleedBand
    image={media.locale.langhe}
    height="sm"
    align="left"
    kicker="Studio Rebel · Carmagnola"
    quote="Viale Barbaroux 20: quattro cabine per viso, corpo, laser e beauty."
    cite="Da martedì a sabato su appuntamento"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vieni da un altro comune?"
        title="Indicaci località e servizio: ti aiutiamo a _organizzare la visita_."
        lead="Scrivi quale trattamento ti interessa e quando sei disponibile. Ti contattiamo per concordare l’appuntamento e darti le informazioni utili."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/servizi"
        secondaryLabel="Vedi tutti i servizi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
