---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Aree servite — Centro Estetico Carmagnola, Torino Sud e Cuneo",
  description:
    "Da Carmagnola serviamo Torino Sud e parte della provincia di Cuneo. Una pagina per ogni località: come raggiungerci, percorsi laser ed estetica.",
  path: "/localita",
  keywords: [
    "centro estetico Carmagnola e dintorni",
    "estetista Carmagnola Torino sud",
    "estetista vicino Carmagnola",
    "epilazione laser Torino sud",
    "epilazione laser Cuneese",
  ],
});

const areaGroups = [
  {
    key: "asse-carmagnola" as const,
    kicker: "Asse Carmagnola",
    title: "I _comuni_ più vicini allo studio.",
    lead: "Le zone da cui arrivano più spesso le clienti Rebel.",
  },
  {
    key: "torino-sud" as const,
    kicker: "Torino Sud",
    title: "_Cintura_ torinese a sud.",
    lead: "Comuni serviti nell'area sud della città metropolitana di Torino.",
  },
  {
    key: "cuneo" as const,
    kicker: "Provincia di Cuneo",
    title: "Il _cuneese_ che ci raggiunge.",
    lead: "Comuni della provincia di Cuneo da cui ci raggiungono per percorsi completi.",
  },
];

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Località", path: "/localita" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Località servite da Rebel",
  description:
    "Pagine dedicate alle località da cui ci raggiungono: focus e link utili per iniziare (laser, protocolli, servizi).",
  path: "/localita",
});
const localAreaListSchema = buildItemListSchema({
  name: "Aree servite Rebel",
  path: "/localita",
  items: localAreaPages.map((a) => ({ name: a.city, path: `/localita/${a.slug}` })),
});

const groupedAreas = areaGroups.map((g) => ({
  ...g,
  areas: localAreaPages.filter((a) => a.cluster === g.key),
}));
---
<BaseLayout meta={meta} bodyClass="page-localita">
  <JsonLd data={breadcrumb} />
  <JsonLd data={localAreaListSchema} />
  <JsonLd data={webPageSchema} />

  <PageHero
    kicker="Aree servite · Carmagnola"
    title="Da _Carmagnola_ a Torino Sud e Cuneese."
    lead="Lo studio è in Viale Barbaroux 20, a Carmagnola. Da qui raggiungiamo regolarmente clienti da Torino Sud e dalla provincia di Cuneo. Per ogni località abbiamo una pagina con indicazioni e i percorsi più richiesti."
    meta={[`${localAreaPages.length} località coperte`, "Mappa e indicazioni", "Parcheggio in zona"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vedi pagina Carmagnola", href: "/localita/carmagnola" }}
  />

  {groupedAreas.map((g) =>
    g.areas.length > 0 ? (
      <section class="section">
        <div class="container">
          <SectionHead kicker={g.kicker} title={g.title} lead={g.lead} />
          <div class="card-grid card-grid--3">
            {g.areas.map((a, i) => (
              <FeatureCard
                kicker={g.kicker}
                title={a.city}
                body={a.description}
                href={`/localita/${a.slug}`}
                ariaLabel={`Apri la pagina ${a.city}`}
                index={i + 1}
              />
            ))}
          </div>
        </div>
      </section>
    ) : null,
  )}

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Da dove iniziare"
        title="Tre _direzioni_ utili anche se vieni da fuori."
        lead="Pagine principali per orientarti subito: percorso laser, protocolli viso/corpo e listino completo."
      />
      <div class="card-grid card-grid--3">
        <FeatureCard
          kicker="Percorso"
          title="Epilazione laser a Carmagnola"
          body="Come funziona Ice Polar, calendario sedute, prezzi e cosa aspettarsi davvero."
          href="/epilazione-laser-carmagnola"
        />
        <FeatureCard
          kicker="Percorso"
          title="Protocolli viso e corpo"
          body="Quando un trattamento singolo non basta: percorsi su più sedute con linee Marbellas ed Eberlin."
          href="/protocolli-epigenetici"
        />
        <FeatureCard
          kicker="Listino"
          title="Listino e prezzi"
          body="Tutti i servizi ordinati per categoria, con prezzi sempre online."
          href="/listino-estetica-laser"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vieni da fuori Carmagnola?"
        title="Scrivici due righe, _orientiamo insieme_."
        lead="Zona, obiettivo, tempi: ti diciamo qual è la scelta più pulita per partire. La prima visita è gratuita."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita gratuita"
        secondaryHref="/servizi"
        secondaryLabel="Vedi tutti i servizi"
      />
    </div>
  </section>
</BaseLayout>
