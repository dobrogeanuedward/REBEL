---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Manicure semipermanente per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Da Rebel a Carmagnola trovi manicure semipermanente con preparazione accurata e gel professionale. Durata indicativa fino a 3-4 settimane.",
  path: "/manicure-semipermanente-alba",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "manicure semipermanente Alba",
    "smalto semipermanente Alba",
    "nail Alba",
    "manicure Alba CN",
    "estetista unghie Alba",
    "smalto gel Alba",
    "manicure semipermanente Langhe",
    "nail art Alba",
    "unghie semipermanente vicino Alba",
    "centro estetico manicure Alba",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Manicure semipermanente Carmagnola", path: "/servizi/manicure-semipermanente-carmagnola" },
  { name: "Alba e Langhe", path: "/manicure-semipermanente-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Manicure semipermanente per chi viene da Alba e dalle Langhe",
  description: meta.description,
  path: "/manicure-semipermanente-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Manicure semipermanente per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/manicure-semipermanente-alba",
  keywords: ["manicure semipermanente Alba", "smalto semipermanente Alba", "nail Alba CN"],
  section: "Manicure",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Manicure semipermanente per chi viene da Alba",
  "Manicure semipermanente a Carmagnola per clienti di Alba e delle Langhe: preparazione della lamina, applicazione gel professionale e durata indicativa fino a 3-4 settimane.",
  "/manicure-semipermanente-alba",
  {
    priceFrom: 35,
    keywords: ["manicure semipermanente Alba", "smalto gel Alba CN", "nail Alba Langhe"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-alba#service-geo`,
  name: "Manicure semipermanente per chi viene da Alba",
  serviceType: "Nail care",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7008, longitude: 8.0354 },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "35.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto dura una manicure semipermanente fatta bene?",
    a: "La durata indicativa è fino a 3-4 settimane e varia in base a ricrescita, caratteristiche dell'unghia e abitudini. Alla fine ti spieghiamo come prendertene cura a casa.",
  },
  {
    q: "Posso scegliere colori neutri o sono solo colori vivaci?",
    a: "Puoi scegliere nuance nude, beige, rosa cipria, toni naturali oppure colori più decisi. Ti aiutiamo a trovare quello che preferisci.",
  },
  {
    q: "La rimozione danneggia la lamina?",
    a: "La rimozione viene eseguita senza strappare il prodotto e limitando la limatura. Se le unghie sono fragili, irritate o danneggiate, segnalacelo prima dell'appuntamento.",
  },
  {
    q: "Posso abbinarla al laser nello stesso giorno?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità.",
  },
  {
    q: "Quanto ci vuole da Alba a Rebel?",
    a: "Circa trenta minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Come prenoto da Alba?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Preparazione della lamina",
    title: "Il risultato si costruisce prima del colore.",
    body: "Prepariamo cuticole, bordi e superficie prima di applicare il colore. La durata resta variabile in base all'unghia e alle abitudini.",
  },
  {
    kicker: "02 · Prodotti professionali",
    title: "Gel professionale, non da scaffale.",
    body: "Usiamo prodotti selezionati per adesione e finitura. La differenza rispetto ai kit consumer si vede sul lungo periodo: il colore resta compatto, senza screpolature nei bordi liberi.",
  },
  {
    kicker: "03 · Scelta del colore",
    title: "Toni naturali o più decisi.",
    body: "Ti mostriamo le nuance disponibili e ti aiutiamo a scegliere in base ai tuoi gusti e allo stile che cerchi.",
  },
  {
    kicker: "04 · Rimozione delicata",
    title: "Il prodotto non viene strappato.",
    body: "Ammorbidiamo e rimuoviamo il gel con cura, limitando la limatura. Prima di procedere osserviamo sempre le condizioni dell'unghia.",
  },
];

const combos = [
  {
    href: "/epilazione-laser-alba",
    title: "Manicure + epilazione laser",
    body: "Due servizi nello stesso appuntamento, se tempi e compatibilità lo consentono.",
  },
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Manicure + laminazione ciglia",
    body: "Mani ordinate e sguardo definito. Due cose che cambiano la percezione di sé — in una visita.",
  },
  {
    href: "/servizi/pulizia-viso-carmagnola",
    title: "Manicure + pulizia viso",
    body: "Per chi vuole lavorare su mani e viso nello stesso giorno. Si pianifica in modo semplice.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/manicure-semipermanente-bra", desc: "~22 min da Carmagnola." },
  { city: "Canale", href: "/manicure-semipermanente-canale", desc: "Roero, ~35 min via A33." },
  { city: "Tutte le località", href: "/localita", desc: "Mappe e indicazioni per raggiungerci." },
];

const m = getPageMedia("/manicure-semipermanente-alba");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Nails — da Alba a Carmagnola"
    title="Manicure semipermanente per chi viene da Alba: _finitura curata_ e colore a scelta."
    lead="Da Alba a Rebel sono circa trenta minuti via A33. Prepariamo la lamina, applichiamo il gel professionale e curiamo la finitura; la durata indicativa è fino a 3-4 settimane e varia da persona a persona."
    bullets={["Durata indicativa fino a 3-4 settimane", "Gel professionale e preparazione accurata", "Colore e finitura a scelta"]}
    meta={["~33 km da Alba", "~30 min via A33", "Da 35 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Alba", href: "https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Mani in ordine -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Mani in ordine"
          title="Semipermanente con _durata indicativa fino a 3-4 settimane_."
          body="Preparazione, prodotto e applicazione contribuiscono alla tenuta, che varia in base a ricrescita, caratteristiche dell'unghia e abitudini."
          bullets={["Preparazione accurata della lamina", "Gel professionale, finitura naturale o decisa", "Indicazioni per la cura a casa"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/manicure-semipermanente-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="La manicure REBEL, a _circa trenta minuti da Alba_."
        lead="Preparazione accurata, gel professionale e una finitura scelta insieme in base ai tuoi gusti."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/manicure-semipermanente-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Alba sono circa 33 chilometri via <strong>A33 direzione Torino</strong>,
            uscita Marene, poi <strong>SP661 fino a Carmagnola</strong>. In condizioni normali
            si è in studio in trenta minuti. Chi preferisce evitare l'autostrada può prendere
            SP7 e SP661 — qualche minuto in più, nessun costo di pedaggio.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Alba in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Alba a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Servizi abbinabili"
        title="Vuoi abbinare un altro _trattamento_?"
        lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Langhe -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Alba a Carmagnola"
      quote="Le mani sono la prima cosa che gli altri vedono."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 4 — FAQ -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Alba e dalle _Langhe_: le risposte dirette."
      />
      <FaqAccordion items={faqs} kicker="FAQ Manicure Semipermanente Alba" />
    </div>
  </section>

  <!-- SEZIONE 5 — Pagina panoramica -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Scopri cosa puoi prenotare da _Alba_."
        lead="Trovi laser, pulizia viso, laminazione e trattamenti corpo disponibili per chi arriva da Alba."
        primaryHref="/localita/alba"
        primaryLabel="Scopri tutti i servizi da Alba"
        secondaryHref="/epilazione-laser-alba"
        secondaryLabel="Laser da Alba"
      />
    </div>
  </section>

  <!-- SEZIONE 6 — Comuni vicini -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Vicino ad Alba"
        title="Comuni vicini: _pagine dedicate_ per la manicure."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Prenota la tua _manicure semipermanente_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/manicure-semipermanente-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
