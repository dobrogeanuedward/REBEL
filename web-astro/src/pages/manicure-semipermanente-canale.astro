---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Manicure semipermanente per chi viene da Canale e dal Roero — Rebel (Carmagnola, ~35 min)",
  description:
    "Vivi a Canale o nel Roero? Da Rebel a Carmagnola trovi manicure semipermanente con preparazione accurata e gel professionale. Durata indicativa fino a 3-4 settimane.",
  path: "/manicure-semipermanente-canale",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "manicure semipermanente Canale",
    "smalto semipermanente Canale",
    "nail Canale",
    "manicure Canale CN",
    "estetista unghie Canale",
    "manicure semipermanente Roero",
    "smalto gel Roero",
    "unghie semipermanente vicino Canale",
    "centro estetico manicure Roero",
    "nail care Canale d'Alba",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Manicure semipermanente Carmagnola", path: "/servizi/manicure-semipermanente-carmagnola" },
  { name: "Canale e Roero", path: "/manicure-semipermanente-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Manicure semipermanente per chi viene da Canale e dal Roero",
  description: meta.description,
  path: "/manicure-semipermanente-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Manicure semipermanente per chi viene da Canale e dal Roero — Rebel (Carmagnola, ~35 min)",
  description: meta.description,
  path: "/manicure-semipermanente-canale",
  keywords: ["manicure semipermanente Canale", "smalto gel Roero", "nail Canale d'Alba CN"],
  section: "Manicure",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Manicure semipermanente per chi viene da Canale e dal Roero",
  "Manicure semipermanente per clienti di Canale d'Alba e del Roero: preparazione della lamina, gel professionale e durata indicativa fino a 3-4 settimane.",
  "/manicure-semipermanente-canale",
  {
    priceFrom: 35,
    keywords: ["manicure semipermanente Canale", "smalto gel Roero", "nail Canale CN"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-canale#service-geo`,
  name: "Manicure semipermanente per chi viene da Canale e dal Roero",
  serviceType: "Nail care",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7864, longitude: 8.0281 },
      geoRadius: "9000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "35.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Canale a Rebel?",
    a: "Circa 35 minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Sono 37 km. Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Quanto ci vuole da Canale a Rebel?",
    a: "Circa 35-37 minuti via A33 e SP661, in base al traffico. Lo studio è in Viale Barbaroux 20 a Carmagnola.",
  },
  {
    q: "Quanto dura la semipermanente?",
    a: "La durata indicativa è fino a 3-4 settimane e varia in base a ricrescita, caratteristiche dell'unghia e abitudini. Alla fine ti spieghiamo come prendertene cura a casa.",
  },
  {
    q: "Faccio attività all'aperto e le mani lavorano. Regge?",
    a: "La durata cambia da persona a persona e in base all'uso delle mani. Ti spieghiamo cosa evitare nelle prime 24 ore e come prenderti cura della manicure a casa.",
  },
  {
    q: "Posso abbinarla a qualcos'altro nello stesso giorno?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Da Canale a Carmagnola",
    title: "Circa 35-37 minuti di viaggio.",
    body: "Puoi organizzare l'appuntamento in base ai tuoi impegni e agli orari disponibili dello studio.",
  },
  {
    kicker: "02 · Lamina prima del colore",
    title: "La base è tutto.",
    body: "Prepariamo cuticole, bordi e superficie prima di applicare il colore. La durata resta variabile in base all'unghia e alle abitudini.",
  },
  {
    kicker: "03 · Gel professionale",
    title: "Prodotti scelti per applicazione e finitura.",
    body: "Applichiamo gel professionale e curiamo bordi e superficie. La durata finale dipende anche dalle caratteristiche dell'unghia e dall'uso delle mani.",
  },
  {
    kicker: "04 · Rimozione delicata",
    title: "Il prodotto non viene strappato.",
    body: "Ammorbidiamo e rimuoviamo il gel con cura, limitando la limatura. Prima di procedere osserviamo sempre le condizioni dell'unghia.",
  },
];

const combos = [
  {
    href: "/epilazione-laser-canale",
    title: "Manicure + epilazione laser",
    body: "Due servizi nello stesso appuntamento, se tempi e compatibilità lo consentono.",
  },
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Manicure + laminazione ciglia",
    body: "Se vuoi abbinare manicure e laminazione, verifichiamo la disponibilità necessaria per organizzarle nella stessa visita.",
  },
  {
    href: "/pulizia-viso-canale",
    title: "Manicure + pulizia viso",
    body: "Per chi vuole ottimizzare i 35 minuti di viaggio: mani e viso curati nella stessa visita.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/manicure-semipermanente-alba", desc: "Langhe, ~30 min via A33." },
  { city: "Bra", href: "/manicure-semipermanente-bra", desc: "~22 min da Carmagnola." },
  { city: "Tutte le località", href: "/localita", desc: "Mappe e indicazioni per raggiungerci." },
];

const m = getPageMedia("/manicure-semipermanente-canale");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Nails — da Canale a Carmagnola"
    title="Manicure semipermanente per chi viene da Canale: _finitura curata_ e colore a scelta."
    lead="Da Canale a Rebel sono circa 35-37 minuti. Prepariamo la lamina, applichiamo il gel professionale e curiamo la finitura; la durata indicativa è fino a 3-4 settimane e varia da persona a persona."
    bullets={["Durata indicativa fino a 3-4 settimane", "Gel professionale e preparazione accurata", "Colore e finitura a scelta"]}
    meta={["~37 km da Canale", "~35 min via A33", "Da 35 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Canale", href: "https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Mani in ordine"
          title="Semipermanente con _durata indicativa fino a 3-4 settimane_."
          body="Preparazione, prodotto e applicazione contribuiscono alla tenuta, che varia in base a ricrescita, caratteristiche dell'unghia e abitudini."
          bullets={["Preparazione accurata della lamina", "Gel professionale, finitura naturale o decisa", "Indicazioni per la cura a casa"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/manicure-semipermanente-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="La manicure REBEL, a _circa 35 minuti da Canale_."
        lead="Preparazione accurata, gel professionale e una finitura scelta insieme in base ai tuoi gusti."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/manicure-semipermanente-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Canale a Rebel: _35 minuti_ via A33." />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Canale a Carmagnola il percorso più rapido è via
            <strong>A33 direzione Torino</strong>, uscita Marene, poi
            <strong>SP661 fino a Carmagnola</strong>: 35-37 minuti in condizioni normali.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">
              Apri il percorso da Canale in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Canale a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Servizi abbinabili" title="Vuoi abbinare un altro _trattamento_?" lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Dal Roero a Carmagnola"
      quote="Le mani sono la prima cosa che gli altri vedono."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Canale e dal _Roero_: le risposte." />
      <FaqAccordion items={faqs} kicker="FAQ Manicure Semipermanente Canale" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Scopri cosa puoi prenotare da _Canale_."
        lead="Trovi laser, pulizia viso, laminazione e trattamenti corpo disponibili per chi arriva da Canale."
        primaryHref="/localita/canale"
        primaryLabel="Scopri tutti i servizi da Canale"
        secondaryHref="/epilazione-laser-canale"
        secondaryLabel="Laser da Canale"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino a Canale" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Prenota la tua _manicure semipermanente_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/manicure-semipermanente-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
