---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Manicure semipermanente da Racconigi | REBEL",
  description:
    "Per chi arriva da Racconigi: manicure semipermanente a Carmagnola con preparazione accurata, gel professionale e durata indicativa fino a 3-4 settimane.",
  path: "/manicure-semipermanente-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "manicure semipermanente Racconigi",
    "smalto semipermanente Racconigi",
    "nail Racconigi",
    "manicure Racconigi CN",
    "estetista unghie Racconigi",
    "smalto gel Racconigi",
    "manicure gel Racconigi",
    "unghie semipermanente vicino Racconigi",
    "centro estetico manicure Racconigi",
    "nail care Racconigi Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Manicure semipermanente Carmagnola", path: "/servizi/manicure-semipermanente-carmagnola" },
  { name: "Racconigi", path: "/manicure-semipermanente-racconigi" },
]);

const webPage = buildWebPageSchema({
  name: "Manicure semipermanente per chi viene da Racconigi",
  description: meta.description,
  path: "/manicure-semipermanente-racconigi",
});

const articleSchema = buildArticleSchema({
  headline: "Manicure semipermanente per chi viene da Racconigi — Rebel Carmagnola",
  description: meta.description,
  path: "/manicure-semipermanente-racconigi",
  keywords: ["manicure semipermanente Racconigi", "smalto gel Racconigi", "nail Racconigi CN"],
  section: "Manicure",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Manicure semipermanente per chi viene da Racconigi",
  "Manicure semipermanente a Carmagnola per clienti di Racconigi e zona: preparazione della lamina, gel professionale e durata indicativa fino a 3-4 settimane.",
  "/manicure-semipermanente-racconigi",
  {
    priceFrom: 35,
    keywords: ["manicure semipermanente Racconigi", "smalto gel Racconigi CN", "nail care Racconigi"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-racconigi#service-geo`,
  name: "Manicure semipermanente per chi viene da Racconigi",
  serviceType: "Nail care",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Racconigi",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7676, longitude: 7.6786 },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "35.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Come arrivo da Racconigi a Rebel?",
    a: "Lo studio è in Viale Barbaroux 20 a Carmagnola. Apri Google Maps per controllare il percorso da Racconigi, il traffico e i tempi aggiornati prima di partire.",
  },
  {
    q: "Quanto dura la semipermanente?",
    a: "La durata indicativa è fino a 3-4 settimane e varia in base a ricrescita, caratteristiche dell'unghia e abitudini. Alla fine ti spieghiamo come prendertene cura a casa.",
  },
  {
    q: "Lavoro con le mani — regge comunque?",
    a: "La durata cambia da persona a persona e in base all'uso delle mani. Ti spieghiamo cosa evitare nelle prime 24 ore e come prenderti cura della manicure a casa.",
  },
  {
    q: "Posso abbinarla ad altri trattamenti nello stesso giorno?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità.",
  },
  {
    q: "Avete colori neutri o solo nuance vivaci?",
    a: "Lavoriamo molto su nude, beige, rosa cipria, bianco lattiginoso e colori naturali — quelli che tengono in ogni contesto. Ma abbiamo anche colori vivaci se preferisci qualcosa di più deciso.",
  },
  {
    q: "Come prenoto da Racconigi?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-racconigi#speakable`,
  name: "Manicure semipermanente per chi viene da Racconigi",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/manicure-semipermanente-racconigi`,
};

const points = [
  {
    kicker: "01 · Preparazione della lamina",
    title: "Il colore viene applicato su una base preparata con cura.",
    body: "Prepariamo cuticole, bordi e superficie prima di applicare il gel.",
  },
  {
    kicker: "02 · Lamina preparata bene",
    title: "Il colore viene dopo. Prima viene la base.",
    body: "Prepariamo cuticole, bordi e superficie prima di applicare il colore. La durata resta variabile in base all'unghia e alle abitudini.",
  },
  {
    kicker: "03 · Gel professionale",
    title: "Prodotti scelti per adesione e finitura.",
    body: "Applichiamo il gel con attenzione a bordi e superficie. La durata varia anche in base alle caratteristiche dell'unghia e all'uso delle mani.",
  },
  {
    kicker: "04 · Rimozione delicata",
    title: "Il prodotto non viene strappato.",
    body: "Ammorbidiamo e rimuoviamo il gel con cura, limitando la limatura. Prima di procedere osserviamo sempre le condizioni dell'unghia.",
  },
];

const combos = [
  {
    href: "/epilazione-laser-racconigi",
    title: "Manicure + epilazione laser",
    body: "Due servizi nello stesso appuntamento, se tempi e compatibilità lo consentono.",
  },
  {
    href: "/laminazione-racconigi",
    title: "Manicure + laminazione ciglia",
    body: "Se vuoi abbinare manicure e laminazione, verifichiamo la disponibilità necessaria per organizzarle nella stessa visita.",
  },
  {
    href: "/pulizia-viso-racconigi",
    title: "Manicure + pulizia viso",
    body: "Se vuoi curare mani e viso nello stesso appuntamento, verifichiamo disponibilità e tempi prima di confermare.",
  },
];

const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "Informazioni per chi arriva da Caramagna Piemonte." },
  { city: "Carignano", href: "/localita/carignano", desc: "Informazioni per chi arriva da Carignano." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Informazioni per chi arriva da Savigliano." },
];

const m = getPageMedia("/manicure-semipermanente-racconigi");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Nails — da Racconigi a Carmagnola"
    title="Manicure semipermanente per chi viene da Racconigi: _finitura curata_ e colore a scelta."
    lead="Prepariamo la lamina, applichiamo il gel professionale e curiamo la finitura. La durata indicativa è fino a 3-4 settimane e varia in base all'unghia e alle abitudini."
    bullets={["Durata indicativa fino a 3-4 settimane", "Gel professionale e preparazione accurata", "Colore e finitura a scelta"]}
    meta={["Studio a Carmagnola", "Indicazioni su Google Maps", "Da 35 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Racconigi", href: "https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Mani in ordine -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Mani in ordine"
          title="Semipermanente con _durata indicativa fino a 3-4 settimane_."
          body="Preparazione, prodotto e applicazione contribuiscono alla tenuta, che varia in base a ricrescita, caratteristiche dell'unghia e abitudini."
          bullets={["Preparazione accurata della lamina", "Gel professionale, finitura naturale o decisa", "Indicazioni per la cura a casa"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/manicure-semipermanente-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="La manicure REBEL: _preparazione, colore e finitura_."
        lead="Preparazione accurata, gel professionale e una finitura scelta insieme in base ai tuoi gusti."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Chiedi un appuntamento</a>
        <a class="btn btn--secondary" href="/servizi/manicure-semipermanente-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Racconigi a Rebel: _controlla il percorso su Maps_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            REBEL è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Apri Google Maps per controllare il percorso da Racconigi, il traffico e i tempi
            aggiornati prima di partire.
          </p>
          <p class="body-p">
            Per informazioni aggiornate sui parcheggi disponibili in zona, consulta Maps.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Racconigi in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Racconigi a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Servizi abbinabili"
        title="Vuoi abbinare un altro _trattamento_?"
        lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Racconigi -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Colore e finitura vengono scelti insieme in base ai tuoi gusti."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 4 — FAQ -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Le domande più comuni per chi arriva da _Racconigi_."
      />
      <FaqAccordion items={faqs} kicker="FAQ Manicure Semipermanente Racconigi" />
    </div>
  </section>

  <!-- SEZIONE 5 — Pagina panoramica -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Altri servizi"
        title="Scopri gli altri trattamenti disponibili da _Rebel_."
        lead="Nella pagina dedicata a Racconigi trovi anche laser, pulizia viso, laminazione e trattamenti corpo."
        primaryHref="/localita/racconigi"
        primaryLabel="Vedi i servizi per Racconigi"
        secondaryHref="/epilazione-laser-racconigi"
        secondaryLabel="Laser da Racconigi"
      />
    </div>
  </section>

  <!-- SEZIONE 6 — Comuni vicini -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Altre località" title="Cerchi informazioni per _un'altra zona_?" />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Prenota la tua _manicure semipermanente_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/manicure-semipermanente-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
