---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Manicure semipermanente per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description:
    "Da Racconigi a Rebel sono dieci minuti via SS20, senza autostrada. È il comune più vicino: manicure semipermanente fatta bene, lamina preparata, gel professionale, colori che tengono settimane. Prenota su WhatsApp.",
  path: "/manicure-semipermanente-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "manicure semipermanente Racconigi",
    "smalto semipermanente Racconigi",
    "nail Racconigi",
    "manicure Racconigi CN",
    "estetista unghie Racconigi",
    "smalto gel Racconigi",
    "manicure gel Racconigi",
    "unghie semipermanente vicino Racconigi",
    "centro estetico manicure Racconigi",
    "nail care Racconigi Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Manicure semipermanente Carmagnola", path: "/servizi/manicure-semipermanente-carmagnola" },
  { name: "Racconigi", path: "/manicure-semipermanente-racconigi" },
]);

const webPage = buildWebPageSchema({
  name: "Manicure semipermanente per chi viene da Racconigi",
  description: meta.description,
  path: "/manicure-semipermanente-racconigi",
});

const articleSchema = buildArticleSchema({
  headline: "Manicure semipermanente per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description: meta.description,
  path: "/manicure-semipermanente-racconigi",
  keywords: ["manicure semipermanente Racconigi", "smalto gel Racconigi", "nail Racconigi CN"],
  section: "Manicure",
  image: "https://www.rebelepigenetica.it/img/generated/manicure-semipermanente-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Manicure semipermanente per chi viene da Racconigi",
  "Manicure semipermanente a Carmagnola per clienti di Racconigi e zona: lamina preparata, gel professionale, durata 3-4 settimane. A dieci minuti via SS20.",
  "/manicure-semipermanente-racconigi",
  {
    priceFrom: 35,
    keywords: ["manicure semipermanente Racconigi", "smalto gel Racconigi CN", "nail care Racconigi"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-racconigi#service-geo`,
  name: "Manicure semipermanente per chi viene da Racconigi",
  serviceType: "Nail care",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Racconigi",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7676, longitude: 7.6786 },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "35.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Da Racconigi, quanto tempo serve per arrivare a Rebel?",
    a: "Una decina di minuti via SS20 (Via Racconigi) verso Carmagnola: circa dieci chilometri, senza autostrada e senza pedaggio. Lo studio è in Viale Barbaroux 20, con parcheggio gratuito a un minuto a piedi. È il comune più vicino tra quelli che seguiamo.",
  },
  {
    q: "Quanto dura la semipermanente?",
    a: "Di solito 3-4 settimane. Dipende dalla lamina, dal prodotto e da cosa si fa con le mani. Da Rebel usiamo gel professionale e curiamo ogni passaggio: il risultato tiene bene nel tempo. E il rinnovo, da Racconigi, è a dieci minuti.",
  },
  {
    q: "Lavoro con le mani — regge comunque?",
    a: "Con le giuste accortezze, sì. Ti diciamo subito cosa evitare nelle prime 24 ore e come allungare la durata con piccole abitudini a casa. Il prodotto che usiamo è progettato per reggere un utilizzo normale delle mani.",
  },
  {
    q: "Posso abbinarla ad altri trattamenti nello stesso giorno?",
    a: "Sì, è il trattamento più facile da abbinare. Non entra in conflitto con il laser, con la laminazione o con la pulizia viso. E visto che da Racconigi sei a dieci minuti, mettere insieme due cose nella stessa sosta è la norma.",
  },
  {
    q: "Avete colori neutri o solo nuance vivaci?",
    a: "Lavoriamo molto su nude, beige, rosa cipria, bianco lattiginoso e colori naturali — quelli che tengono in ogni contesto. Ma abbiamo anche colori vivaci se preferisci qualcosa di più deciso.",
  },
  {
    q: "Come prenoto da Racconigi?",
    a: "Scrivici su WhatsApp con il giorno che ti è più comodo. Ti rispondiamo con gli slot disponibili. Di solito si chiude in pochi messaggi.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/manicure-semipermanente-racconigi#speakable`,
  name: "Manicure semipermanente per chi viene da Racconigi",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/manicure-semipermanente-racconigi`,
};

const points = [
  {
    kicker: "01 · Il comune più vicino",
    title: "Dieci minuti: il rinnovo non è mai una spedizione.",
    body: "Da Racconigi sei qui in un quarto d'ora scarso. Quando la semipermanente chiede il cambio dopo tre-quattro settimane, ci si torna senza pensarci: la manutenzione delle mani diventa una routine, non un evento da organizzare.",
  },
  {
    kicker: "02 · Lamina preparata bene",
    title: "Il colore viene dopo. Prima viene la base.",
    body: "Cuticole, superficie, bordi: una lamina preparata correttamente regge il gel molto più a lungo. Questo è il passaggio che distingue una manicure che dura da una che cede in una settimana.",
  },
  {
    kicker: "03 · Gel professionale",
    title: "Prodotti scelti per adesione e finitura.",
    body: "Non usiamo prodotti da scaffale. Il gel professionale ha una formulazione diversa: aderisce meglio, resiste all'usura quotidiana e rimane compatto sui bordi liberi.",
  },
  {
    kicker: "04 · Rimozione sana",
    title: "La lamina resta integra nel tempo.",
    body: "La rimozione si fa ammorbidendo il gel, non limanando. Questo preserva lo spessore della lamina e mantiene l'unghia sana a ogni ciclo.",
  },
];

const combos = [
  {
    href: "/epilazione-laser-racconigi",
    title: "Manicure + epilazione laser",
    body: "La combinazione più facile: laser e manicure non si ostacolano mai. A dieci minuti da Racconigi, tutto in una sosta.",
  },
  {
    href: "/laminazione-racconigi",
    title: "Manicure + laminazione ciglia",
    body: "Mani curate e sguardo definito. Due trattamenti veloci che cambiano la percezione di sé.",
  },
  {
    href: "/pulizia-viso-racconigi",
    title: "Manicure + pulizia viso",
    body: "Mani e viso nella stessa visita. Per chi vuole ottimizzare l'uscita da Racconigi.",
  },
];

const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "A pochi km, sull'asse per Carmagnola." },
  { city: "Carignano", href: "/localita/carignano", desc: "Subito a nord, lungo la SS20." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Poco più a sud, nella pianura cuneese." },
];

const m = getPageMedia("/manicure-semipermanente-racconigi");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Nails — da Racconigi a Carmagnola"
    title="Manicure semipermanente per chi viene da Racconigi: _dieci minuti_, tre-quattro settimane di risultato."
    lead="Da Racconigi a Rebel sono dieci minuti via SS20, senza autostrada e senza pedaggio. È il comune più vicino: la manicure semipermanente si fa bene — lamina preparata, gel professionale, finitura curata — e regge settimane senza chiederti nulla. Con il rinnovo a un quarto d'ora, è una scelta semplice."
    bullets={["Tenuta reale 3-4 settimane", "Gel professionale, lamina preparata bene", "Valutazione REBEL · 30–40 min"]}
    meta={["~10 km da Racconigi", "~14 min via SS20", "Da 35 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Racconigi", href: "https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Mani in ordine -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Mani in ordine"
          title="Semipermanente che _dura davvero_ 3-4 settimane."
          body="La tenuta non è fortuna: è preparazione della lamina, prodotto professionale e applicazione precisa. Mani curate che restano impeccabili anche con le mani sempre in attività."
          bullets={["Preparazione accurata della lamina", "Gel professionale, finish naturale o deciso", "Tenuta reale di 3-4 settimane"]}
          cta={{ label: "Scheda manicure", href: "/servizi/manicure-semipermanente-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicinissimi"
        title="Da Racconigi la manicure diventa _una routine_, non un evento."
        lead="A dieci minuti porta-a-porta, anche il rinnovo ogni tre-quattro settimane è una commissione veloce. Mani sempre in ordine senza dover programmare una mezza giornata."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/manicure-semipermanente-carmagnola">Scheda completa manicure</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Racconigi a Rebel: _dieci minuti_ di strada dritta."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Racconigi a Carmagnola sono circa dieci chilometri via <strong>SS20 (Via Racconigi)</strong>:
            si esce dal centro in direzione nord e si segue la statale fino in centro a Carmagnola.
            Si arriva quasi sempre in dieci-quattordici minuti, senza autostrada e senza pedaggio.
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro Carmagnola.
            Parcheggio gratuito a 30 secondi a piedi.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Racconigi in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Racconigi a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Una sola sosta"
        title="La manicure non blocca nulla: _abbinala_ liberamente."
        lead="Non entra in conflitto con laser, laminazione o trattamenti viso. E a dieci minuti da Racconigi, due trattamenti nella stessa uscita sono la cosa più comoda."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />
        ))}
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Racconigi -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Le mani sono la prima cosa che gli altri vedono — e il rinnovo è a dieci minuti."
      cta={{ label: "Prenota la prima visita", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 4 — FAQ -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Racconigi: le risposte _oneste_."
      />
      <FaqAccordion items={faqs} kicker="FAQ Manicure Semipermanente Racconigi" />
    </div>
  </section>

  <!-- SEZIONE 5 — Pagina panoramica -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="La manicure non è l'unico motivo per venire a Carmagnola _da Racconigi_."
        lead="La pagina panoramica per chi viene da Racconigi raccoglie laser, pulizia viso, laminazione e protocolli corpo in modo ordinato."
        primaryHref="/localita/racconigi"
        primaryLabel="Pagina panoramica Rebel per Racconigi"
        secondaryHref="/epilazione-laser-racconigi"
        secondaryLabel="Laser da Racconigi"
      />
    </div>
  </section>

  <!-- SEZIONE 6 — Comuni vicini -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino a Racconigi" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Mani in ordine per _tre-quattro settimane_."
        lead="Scrivici su WhatsApp con il giorno preferito. Ti rispondiamo in poco tempo — e da Racconigi sei qui in dieci minuti."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scheda manicure completa"
        secondaryHref="/servizi/manicure-semipermanente-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
