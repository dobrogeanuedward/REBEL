---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/massaggio-linfodrenante-bra");

const meta = createPageMeta({
  title: "Massaggio linfodrenante per chi viene da Bra — Rebel (Carmagnola, ~22 min)",
  description:
    "Vivi a Bra? Da Rebel a Carmagnola sono venti minuti via SP661. Massaggio linfodrenante con manualità delicate, dedicato alla sensazione di pesantezza e al benessere delle gambe. Da 69 €.",
  path: "/massaggio-linfodrenante-bra",
  image: "https://www.rebelepigenetica.it/img/brand/rimodellamento-donna-beige.png",
  openGraphType: "article",
  keywords: [
    "massaggio linfodrenante Bra",
    "massaggio drenante Bra",
    "linfodrenante gambe Bra",
    "ritenzione idrica Bra",
    "gambe gonfie Bra",
    "drenaggio linfatico Bra",
    "massaggio gambe pesanti Bra",
    "linfodrenante vicino Bra",
    "massaggio drenante Bra CN",
    "trattamento corpo drenante Bra",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio linfodrenante Carmagnola", path: "/servizi/massaggio-linfodrenante-carmagnola" },
  { name: "Bra", path: "/massaggio-linfodrenante-bra" },
]);

const webPage = buildWebPageSchema({
  name: "Massaggio linfodrenante per chi viene da Bra",
  description: meta.description,
  path: "/massaggio-linfodrenante-bra",
});

const articleSchema = buildArticleSchema({
  headline: "Massaggio linfodrenante per chi viene da Bra — Rebel (Carmagnola, ~22 min)",
  description: meta.description,
  path: "/massaggio-linfodrenante-bra",
  keywords: ["massaggio linfodrenante Bra", "massaggio drenante Bra", "ritenzione idrica Bra CN"],
  section: "Estetica classica",
  image: "https://www.rebelepigenetica.it/img/brand/rimodellamento-donna-beige.png",
});

const serviceSchema = buildServiceSchema(
  "Massaggio linfodrenante per chi viene da Bra",
  "Massaggio linfodrenante a Carmagnola per clienti di Bra, con manualità delicate e ritmo adattato alle sensazioni della persona.",
  "/massaggio-linfodrenante-bra",
  {
    priceFrom: 69,
    keywords: ["massaggio linfodrenante Bra", "massaggio drenante Bra CN", "ritenzione idrica Bra"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-linfodrenante-bra#service-geo`,
  name: "Massaggio linfodrenante per chi viene da Bra",
  serviceType: "Lymphatic drainage massage",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Bra",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.6968, longitude: 7.8558 },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "69.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Bra a Rebel per il linfodrenante?",
    a: "Circa ventidue minuti via SP661, venti chilometri in totale. Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "A cosa serve il massaggio linfodrenante?",
    a: "È un massaggio con manualità delicate e progressive, dedicato alla sensazione di pesantezza e al benessere delle gambe. Pressione e ritmo vengono adattati alle tue sensazioni.",
  },
  {
    q: "Bastano una o due sedute o serve un ciclo?",
    a: "La frequenza dipende da ciò che cerchi e da come percepisci la seduta. Puoi prenotare un singolo appuntamento oppure valutare con noi una cadenza, senza pacchetti imposti.",
  },
  {
    q: "È adatto in caso di ritenzione e gambe stanche a fine giornata?",
    a: "Possiamo dedicare la seduta alle gambe e alle zone in cui avverti maggiore pesantezza. In caso di gonfiore improvviso, persistente o doloroso, chiedi prima consiglio al medico.",
  },
  {
    q: "Posso abbinarlo ad altri trattamenti?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Bra?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/massaggio-linfodrenante-bra#speakable`,
  name: "Massaggio linfodrenante per chi viene da Bra",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/massaggio-linfodrenante-bra`,
};

const points = [
  {
    kicker: "01 · Manualità progressive",
    title: "Un ritmo delicato, adattato a te.",
    body: "Pressione e ritmo vengono modulati durante la seduta in base alle tue sensazioni, senza manovre aggressive.",
  },
  {
    kicker: "02 · Benessere delle gambe",
    title: "La seduta si concentra sulle zone che indichi.",
    body: "Puoi segnalarci dove avverti maggiore pesantezza; adattiamo la seduta alla tua sensibilità e al tempo disponibile.",
  },
  {
    kicker: "03 · Frequenza personalizzata",
    title: "Un appuntamento singolo o una cadenza concordata.",
    body: "La frequenza viene decisa insieme in base alle tue preferenze e a come percepisci il trattamento, senza pacchetti imposti.",
  },
  {
    kicker: "04 · Parte di un percorso",
    title: "Può affiancare altri servizi.",
    body: "Se vuoi abbinare un altro trattamento, verifichiamo prima tempi e compatibilità e organizziamo l'appuntamento di conseguenza.",
  },
];

const combos = [
  {
    href: "/massaggio-rilassante-bra",
    title: "Drenante + rilassante",
    body: "Due momenti di benessere nello stesso appuntamento, se tempi e compatibilità lo consentono.",
  },
  {
    href: "/epilazione-laser-bra",
    title: "Drenante + laser gambe",
    body: "Due servizi dedicati alle gambe, organizzati insieme solo quando compatibili.",
  },
  {
    href: "/servizi/scrub-corpo-carmagnola",
    title: "Drenante + scrub corpo",
    body: "Cura della pelle e massaggio nello stesso appuntamento, quando indicato.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/massaggio-linfodrenante-alba", desc: "Langhe, ~30 min via A33." },
  { city: "Canale", href: "/massaggio-linfodrenante-canale", desc: "Roero, ~35 min." },
  { city: "Tutte le località", href: "/localita", desc: "Mappe e indicazioni per raggiungerci." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Body — da Bra a Carmagnola"
    title="Massaggio linfodrenante per chi viene da Bra: _venti minuti_ da Carmagnola."
    lead="Da Bra a Rebel sono venti minuti via SP661. La seduta utilizza manualità delicate e progressive, con pressione e ritmo adattati alle tue sensazioni."
    bullets={["Manualità delicate e progressive", "Seduta dedicata al benessere delle gambe", "Valutazione REBEL · 30–40 min"]}
    meta={["~20 km da Bra", "~22 min via SP661", "Da 69 €"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Bra", href: "https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Drenaggio mirato"
          title="Una seduta dedicata al _benessere delle gambe_."
          body="Il trattamento segue un ritmo graduale e viene adattato alle zone che indichi e alle tue sensazioni durante la seduta."
          bullets={["Manualità delicate e progressive", "Pressione adattata alla sensibilità", "Frequenza concordata insieme"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/massaggio-linfodrenante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Il linfodrenante REBEL, a _venti minuti da Bra_."
        lead="Una seduta con manualità progressive, personalizzata in base alle zone che vuoi trattare e alle tue sensazioni."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-linfodrenante-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Bra a Rebel: venti minuti _senza autostrada_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">Da Bra a Carmagnola sono circa 20 km via <strong>SP661</strong> in direzione Sommariva del Bosco e Carmagnola. In condizioni normali si arriva in 22-25 minuti, senza pedaggio.</p>
          <p class="body-p">Lo studio è in <strong>Viale Barbaroux 20</strong>. possibilità di parcheggio nelle vicinanze.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Bra in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Bra&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Bra a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Una sola sosta" title="Vuoi abbinare un altro _trattamento_?" lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Bra a Carmagnola"
      quote="Un momento dedicato al benessere delle gambe."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Bra: le risposte _dirette_." />
      <FaqAccordion items={faqs} kicker="FAQ Linfodrenante Bra" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Il drenante non è l'unico motivo per venire da _Bra_."
        lead="Scopri laser, massaggi, pulizia viso e trattamenti corpo disponibili per chi arriva da Bra."
        primaryHref="/localita/bra"
        primaryLabel="Scopri tutti i servizi da Bra"
        secondaryHref="/massaggio-rilassante-bra"
        secondaryLabel="Massaggio rilassante da Bra"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino a Bra" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="Prenota il tuo _massaggio linfodrenante_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/massaggio-linfodrenante-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Linfodrenante da 69 €" primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
