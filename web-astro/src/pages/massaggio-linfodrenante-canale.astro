---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/massaggio-linfodrenante-canale");

const meta = createPageMeta({
  title: "Massaggio linfodrenante da Canale e Roero | REBEL",
  description:
    "Massaggio linfodrenante a Carmagnola per chi arriva da Canale e dal Roero: manualità delicate, seduta adattata alle tue sensazioni e prezzo da 69 €.",
  path: "/massaggio-linfodrenante-canale",
  image: "https://www.rebelepigenetica.it/img/brand/rimodellamento-donna-beige.png",
  openGraphType: "article",
  keywords: [
    "massaggio linfodrenante Canale",
    "massaggio drenante Canale",
    "linfodrenante gambe Canale",
    "ritenzione idrica Canale",
    "gambe gonfie Canale",
    "drenaggio linfatico Roero",
    "massaggio gambe pesanti Canale",
    "linfodrenante vicino Canale",
    "massaggio drenante Canale CN",
    "trattamento corpo drenante Roero",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio linfodrenante Carmagnola", path: "/servizi/massaggio-linfodrenante-carmagnola" },
  { name: "Canale", path: "/massaggio-linfodrenante-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Massaggio linfodrenante per chi arriva da Canale e dal Roero",
  description: meta.description,
  path: "/massaggio-linfodrenante-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Massaggio linfodrenante per chi arriva da Canale — REBEL Carmagnola",
  description: meta.description,
  path: "/massaggio-linfodrenante-canale",
  keywords: ["massaggio linfodrenante Canale", "massaggio drenante Roero", "ritenzione idrica Canale CN"],
  section: "Estetica classica",
  image: "https://www.rebelepigenetica.it/img/brand/rimodellamento-donna-beige.png",
});

const serviceSchema = buildServiceSchema(
  "Massaggio linfodrenante per chi arriva da Canale",
  "Massaggio linfodrenante a Carmagnola con manualità delicate, adattate alle zone indicate e alle sensazioni comunicate durante la seduta.",
  "/massaggio-linfodrenante-canale",
  {
    priceFrom: 69,
    keywords: ["massaggio linfodrenante Canale", "massaggio drenante Roero", "ritenzione idrica Canale"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-linfodrenante-canale#service-geo`,
  name: "Massaggio linfodrenante per chi arriva da Canale",
  serviceType: "Massaggio linfodrenante",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7956, longitude: 8.0008 },
      geoRadius: "10000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "69.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Dove si trova REBEL rispetto a Canale?",
    a: "Lo studio è in Viale Barbaroux 20, a Carmagnola. Apri Google Maps per verificare percorso, traffico e tempi aggiornati.",
  },
  {
    q: "Come si svolge il massaggio linfodrenante?",
    a: "La seduta utilizza manualità delicate. Adattiamo pressione e zone alle sensazioni che ci comunichi durante il trattamento.",
  },
  {
    q: "Posso prenotare una sola seduta?",
    a: "Sì. Puoi prenotare un singolo appuntamento; se desideri tornare, concordiamo insieme la frequenza.",
  },
  {
    q: "È adatto in caso di ritenzione e gambe stanche a fine giornata?",
    a: "Possiamo dedicare la seduta alle gambe e alle zone in cui avverti maggiore pesantezza. In caso di gonfiore improvviso, persistente o doloroso, chiedi prima consiglio al medico.",
  },
  {
    q: "Posso abbinarlo ad altri trattamenti?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Indica che cosa vuoi abbinare: verifichiamo disponibilità e compatibilità prima di confermare.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/massaggio-linfodrenante-canale#speakable`,
  name: "Massaggio linfodrenante per chi arriva da Canale",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/massaggio-linfodrenante-canale`,
};

const points = [
  {
    kicker: "01 · Manualità delicate",
    title: "Pressione adattata durante la seduta.",
    body: "Adattiamo la pressione alle sensazioni che ci comunichi durante il trattamento.",
  },
  {
    kicker: "02 · Benessere delle gambe",
    title: "La seduta si concentra sulle zone che indichi.",
    body: "Prima di iniziare puoi indicarci le aree su cui preferisci concentrare la seduta.",
  },
  {
    kicker: "03 · Frequenza",
    title: "Un appuntamento singolo o una cadenza concordata.",
    body: "Puoi prenotare una sola seduta oppure concordare gli appuntamenti successivi.",
  },
  {
    kicker: "04 · Servizi abbinabili",
    title: "Può affiancare altri servizi.",
    body: "Se vuoi abbinare un altro trattamento, verifichiamo prima disponibilità e compatibilità.",
  },
];

const combos = [
  {
    href: "/massaggio-rilassante-canale",
    title: "Drenante + rilassante",
    body: "Se vuoi abbinare i due massaggi, verifichiamo disponibilità e compatibilità prima di confermare.",
  },
  {
    href: "/epilazione-laser-canale",
    title: "Drenante + laser gambe",
    body: "Se vuoi abbinare il laser gambe, verifichiamo zone e compatibilità prima di confermare.",
  },
  {
    href: "/servizi/scrub-corpo-carmagnola",
    title: "Drenante + scrub corpo",
    body: "Se vuoi aggiungere uno scrub corpo, verifichiamo disponibilità e compatibilità prima di confermare.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/massaggio-linfodrenante-alba", desc: "Massaggio linfodrenante per chi arriva da Alba." },
  { city: "Racconigi", href: "/massaggio-linfodrenante-racconigi", desc: "Massaggio linfodrenante per chi arriva da Racconigi." },
  { city: "Tutte le località", href: "/localita", desc: "Consulta indirizzo, mappa e contatti." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Massaggio linfodrenante · REBEL Carmagnola"
    title="Massaggio linfodrenante per chi arriva da _Canale_."
    lead="Una seduta con manualità delicate, adattata alle zone che indichi e alle sensazioni che comunichi durante il trattamento."
    bullets={["Manualità delicate", "Zone concordate prima della seduta", "Prezzo da 69 €"]}
    meta={["Studio in Viale Barbaroux 20, Carmagnola", "Trattamento corpo estetico"]}
    ctaPrimary={{ label: "Chiedi un appuntamento", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri Google Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Il trattamento"
          title="Una seduta dedicata al _benessere delle gambe_."
          body="Prima di iniziare concordiamo le zone; durante la seduta adattiamo la pressione alle sensazioni che comunichi."
          bullets={["Manualità delicate", "Zone concordate prima di iniziare", "Pressione adattata durante la seduta"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/massaggio-linfodrenante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il trattamento REBEL"
        title="Come si svolge il _massaggio linfodrenante_."
        lead="Concordiamo le zone prima di iniziare e adattiamo le manualità durante la seduta."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Chiedi un appuntamento</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-linfodrenante-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Come raggiungere REBEL da _Canale_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">REBEL si trova in <strong>Viale Barbaroux 20, a Carmagnola</strong>.</p>
          <p class="body-p">Apri Google Maps per verificare percorso, traffico e tempi aggiornati.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri Google Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Indicazioni da Canale a REBEL Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Servizi abbinabili" title="Vuoi abbinare un altro _trattamento_?" lead="Indica i servizi che ti interessano: verifichiamo disponibilità e compatibilità prima dell’appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Massaggio linfodrenante a Carmagnola"
      quote="Manualità e pressione vengono adattate durante la seduta."
      cta={{ label: "Chiedi un appuntamento", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Domande sul _massaggio linfodrenante_." />
      <FaqAccordion items={faqs} kicker="FAQ Linfodrenante Canale" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Altri servizi REBEL"
        title="Trattamenti viso e corpo per chi arriva da _Canale_."
        lead="Consulta i servizi disponibili nello studio REBEL di Carmagnola."
        primaryHref="/localita/canale"
        primaryLabel="Scopri tutti i servizi da Canale"
        secondaryHref="/massaggio-rilassante-canale"
        secondaryLabel="Massaggio rilassante da Canale"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Altre località" title="Servizi REBEL dalle _zone vicine_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Località" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenotazione"
        title="Prenota il tuo _massaggio linfodrenante_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità oppure usa il modulo contatti."
        primaryLabel="Scrivici su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/massaggio-linfodrenante-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Massaggio linfodrenante da 69 €" primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
