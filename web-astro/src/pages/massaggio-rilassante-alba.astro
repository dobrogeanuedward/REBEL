---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Massaggio rilassante per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Da Rebel il massaggio rilassante dura 50 minuti ed è dedicato a schiena, spalle e collo, con ritmo e pressione concordati. Circa 30 minuti via A33.",
  path: "/massaggio-rilassante-alba",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "massaggio rilassante Alba",
    "massaggio Alba",
    "massaggio cervicale Alba",
    "massaggio schiena Alba",
    "centro benessere Alba",
    "massaggio rilassante Langhe",
    "massaggio vicino Alba",
    "massaggio spalle Alba CN",
    "benessere Alba",
    "relax Alba Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio rilassante Carmagnola", path: "/servizi/massaggio-rilassante-carmagnola" },
  { name: "Alba e Langhe", path: "/massaggio-rilassante-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Massaggio rilassante per chi viene da Alba e dalle Langhe",
  description: meta.description,
  path: "/massaggio-rilassante-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Massaggio rilassante per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/massaggio-rilassante-alba",
  keywords: ["massaggio rilassante Alba", "massaggio cervicale Alba", "massaggio spalle Alba CN"],
  section: "Massaggi",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Massaggio rilassante per chi viene da Alba",
  "Massaggio rilassante a Carmagnola per clienti di Alba e delle Langhe: 50 minuti dedicati a schiena, spalle e collo, con ritmo e pressione concordati.",
  "/massaggio-rilassante-alba",
  {
    priceFrom: 55,
    keywords: ["massaggio rilassante Alba", "massaggio cervicale Alba CN", "massaggio schiena Langhe"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-alba#service-geo`,
  name: "Massaggio rilassante per chi viene da Alba",
  serviceType: "Relaxation massage",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7008, longitude: 8.0354 },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "55.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Alba a Rebel?",
    a: "Circa trenta minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Quanto dura la seduta?",
    a: "50 minuti. Le manualità si concentrano su schiena, spalle e collo, con pressione concordata e ritmo graduale.",
  },
  {
    q: "Ho spesso schiena e spalle tese. Può aiutarmi a rilassarmi?",
    a: "Il massaggio può offrire una sensazione temporanea di distensione e relax su schiena, spalle e collo. Se avverti dolore acuto o persistente, chiedi prima una valutazione sanitaria o fisioterapica.",
  },
  {
    q: "Ogni quanto conviene farlo?",
    a: "La frequenza dipende dalle tue preferenze e da come percepisci la seduta. Puoi prenotarla come momento singolo oppure concordare una cadenza che si adatti alla tua agenda.",
  },
  {
    q: "Posso abbinare il massaggio ad altri trattamenti nello stesso giorno?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Alba?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · 50 minuti reali",
    title: "Niente tagli, niente spiccioli.",
    body: "Cinquanta minuti dedicati a schiena, spalle e collo. Concordiamo pressione e zone prima di iniziare e manteniamo un ritmo graduale.",
  },
  {
    kicker: "02 · Ritmo graduale",
    title: "Si parte piano e si approfondisce.",
    body: "La pressione aumenta solo se la percepisci come confortevole. Durante la seduta puoi chiedere di alleggerirla o concentrarla su una zona diversa.",
  },
  {
    kicker: "03 · Schiena, spalle e collo",
    title: "Le zone vengono concordate prima di iniziare.",
    body: "Ci racconti dove preferisci concentrare il massaggio e adattiamo pressione e ritmo alle tue sensazioni durante la seduta.",
  },
  {
    kicker: "04 · Frequenza personalizzata",
    title: "Un appuntamento singolo o una cadenza concordata.",
    body: "Scegliamo la frequenza insieme, in base alle tue preferenze e al tempo che vuoi dedicare al relax.",
  },
];

const combos = [
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Massaggio + manicure semipermanente",
    body: "Relax e mani curate nella stessa visita. Si organizza facilmente in una mattinata.",
  },
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Massaggio + laminazione ciglia",
    body: "Due servizi nello stesso appuntamento, se tempi e compatibilità lo consentono.",
  },
  {
    href: "/servizi/massaggio-linfodrenante-carmagnola",
    title: "Massaggio rilassante + linfodrenante",
    body: "Due tipologie di massaggio da organizzare insieme solo dopo aver verificato tempi e compatibilità.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/massaggio-rilassante-bra", desc: "~22 min da Carmagnola via SP7." },
  { city: "Canale", href: "/massaggio-rilassante-canale", desc: "Roero, ~35 min via A33." },
  { city: "Tutte le località", href: "/localita", desc: "Mappe e indicazioni per raggiungerci." },
];

const m = getPageMedia("/massaggio-rilassante-alba");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Massaggi — da Alba a Carmagnola"
    title="Massaggio rilassante per chi viene da Alba: _50 minuti dedicati a te_."
    lead="Da Alba a Rebel sono circa trenta minuti via A33. La seduta dura 50 minuti e si concentra su schiena, spalle e collo, con pressione concordata e ritmo graduale."
    bullets={["50 minuti di relax", "Schiena, spalle e collo", "Pressione concordata"]}
    meta={["~33 km da Alba", "~30 min via A33", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Alba", href: "https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Stacco vero"
          title="Cinquanta minuti per _rilassare_ schiena, spalle e collo."
          body="Il massaggio segue un ritmo graduale. Prima di iniziare concordiamo le zone e la pressione, poi le adattiamo alle tue sensazioni."
          bullets={["50 minuti, ritmo graduale", "Focus su schiena, spalle e collo", "Ambiente caldo e silenzioso"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/massaggio-rilassante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Una seduta personalizzata, a _circa trenta minuti da Alba_."
        lead="Concordiamo zone, pressione e ritmo prima di iniziare e li adattiamo alle tue sensazioni durante i 50 minuti di trattamento."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-rilassante-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <div class="split-visual">
        <div class="split-visual__image">
          <img src="/img/brand/corpo-rilassamento-schiena.png" alt="Persona distesa durante un massaggio rilassante" width="900" height="1100" loading="lazy" />
        </div>
        <div class="split-visual__text">
          <SectionHead kicker="Durante la seduta" title="Un ritmo _graduale e concordato_." lead="Ti chiediamo come percepisci pressione e manualità e le adattiamo durante i 50 minuti di trattamento." />
          <p class="body-p">
            La percezione del massaggio cambia da persona a persona. Puoi indicarci in qualsiasi momento se preferisci una pressione più leggera o più intensa.
          </p>
          <p class="body-p">
            Al termine ti chiediamo come ti senti e, se vuoi tornare, concordiamo una frequenza compatibile con le tue preferenze e la tua agenda.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">Da Alba sono circa 33 km via <strong>A33 direzione Torino</strong>, uscita Marene, poi <strong>SP661 fino a Carmagnola</strong>. In trenta minuti sei in studio.</p>
          <p class="body-p">Lo studio è in <strong>Viale Barbaroux 20</strong>. possibilità di parcheggio nelle vicinanze.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Alba in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Alba a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Una sola sosta" title="Vuoi abbinare un altro _trattamento_?" lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Alba a Carmagnola"
      quote="Da Alba a Carmagnola per un massaggio rilassante di 50 minuti."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Alba e dalle _Langhe_: le risposte." />
      <FaqAccordion items={faqs} kicker="FAQ Massaggio Rilassante Alba" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Scopri cosa puoi prenotare da _Alba_."
        lead="Trovi laser, manicure, laminazione e trattamenti viso e corpo disponibili per chi arriva da Alba."
        primaryHref="/localita/alba"
        primaryLabel="Scopri tutti i servizi da Alba"
        secondaryHref="/servizi/massaggio-linfodrenante-carmagnola"
        secondaryLabel="Massaggio linfodrenante"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino ad Alba" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="_50 minuti_ dedicati al relax."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/massaggio-rilassante-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .split-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-top: 1rem; }
  .split-visual__image { border-radius: var(--r-lg); overflow: hidden; max-height: 620px; }
  .split-visual__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 760px) { .split-visual { grid-template-columns: 1fr; } .split-visual__image { order: -1; } }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
