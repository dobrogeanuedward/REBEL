---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Massaggio rilassante per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Il massaggio rilassante da Rebel è 50 minuti dedicati a schiena, spalle e cervicale con ritmo graduale e attenzione reale. ~30 min via A33.",
  path: "/massaggio-rilassante-alba",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "massaggio rilassante Alba",
    "massaggio Alba",
    "massaggio cervicale Alba",
    "massaggio schiena Alba",
    "centro benessere Alba",
    "massaggio rilassante Langhe",
    "massaggio vicino Alba",
    "massaggio spalle Alba CN",
    "benessere Alba",
    "relax Alba Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio rilassante Carmagnola", path: "/servizi/massaggio-rilassante-carmagnola" },
  { name: "Alba e Langhe", path: "/massaggio-rilassante-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Massaggio rilassante per chi viene da Alba e dalle Langhe",
  description: meta.description,
  path: "/massaggio-rilassante-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Massaggio rilassante per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/massaggio-rilassante-alba",
  keywords: ["massaggio rilassante Alba", "massaggio cervicale Alba", "massaggio spalle Alba CN"],
  section: "Massaggi",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Massaggio rilassante per chi viene da Alba",
  "Massaggio rilassante a Carmagnola per clienti di Alba e delle Langhe: 50 minuti dedicati a schiena, spalle e cervicale con ritmo graduale e tecnica manuale.",
  "/massaggio-rilassante-alba",
  {
    priceFrom: 55,
    keywords: ["massaggio rilassante Alba", "massaggio cervicale Alba CN", "massaggio schiena Langhe"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-alba#service-geo`,
  name: "Massaggio rilassante per chi viene da Alba",
  serviceType: "Relaxation massage",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7008, longitude: 8.0354 },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "55.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Alba a Rebel?",
    a: "Circa trenta minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Viale Barbaroux 20, parcheggio gratuito a meno di un minuto.",
  },
  {
    q: "Quanto dura la seduta?",
    a: "50 minuti. Si lavora su schiena, spalle e cervicale con un ritmo graduale — si parte dai punti meno tesi e si approfondisce con attenzione, senza forzare.",
  },
  {
    q: "Ho la cervicale sempre tesa per via del lavoro. È il trattamento giusto?",
    a: "Sì. La cervicale contratta è spesso legata allo stress accumulato e alle posture prolungate. Il massaggio rilassante lavora in modo mirato sulla zona cervicale e sulle spalle, liberando la tensione progressivamente senza aggredire.",
  },
  {
    q: "Ogni quanto conviene farlo?",
    a: "Dipende dal tuo livello di tensione e dallo stile di vita. Per chi ha stress cronico, una seduta ogni 3-4 settimane è un ritmo sensato. Per chi vuole staccare davvero, anche una seduta ogni mese o due ha un effetto percepibile.",
  },
  {
    q: "Posso abbinare il massaggio ad altri trattamenti nello stesso giorno?",
    a: "Sì. Si abbina bene con la manicure semipermanente, la laminazione e la pulizia viso. Per il laser, ti suggeriamo di fare il massaggio prima o in un giorno separato: non è un conflitto tecnico, ma per una questione di comfort.",
  },
  {
    q: "Come prenoto da Alba?",
    a: "Scrivici su WhatsApp con il giorno preferito. Ti proponiamo gli slot disponibili. Il mercoledì siamo aperti fino alle 19.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · 50 minuti reali",
    title: "Niente tagli, niente spiccioli.",
    body: "Cinquanta minuti interamente dedicati a schiena, spalle e cervicale. Si comincia gradualmente, si approfondisce dove serve e si chiude con calma. Non è un massaggio da 30 minuti venduto come 50.",
  },
  {
    kicker: "02 · Ritmo graduale",
    title: "Si parte piano e si approfondisce.",
    body: "Nelle Langhe lo stress è di casa: vendemmia, lavoro, vita sociale. Il massaggio non aggredisce — lavora per strati, costruendo fiducia con il corpo prima di liberare le tensioni più profonde.",
  },
  {
    kicker: "03 · Cervicale e spalle prima di tutto",
    title: "Le zone più richieste, lavorate davvero.",
    body: "Cervicale, trapezi e spalle concentrano la maggior parte delle tensioni. Lavoriamo su queste zone con tecnica manuale specifica — non un generico sfioramento, ma una decontrazione progressiva e percepibile.",
  },
  {
    kicker: "04 · Un ritmo che si può tenere",
    title: "Una seduta al mese cambia la qualità del recupero.",
    body: "Non è necessario venire ogni settimana. Una seduta ogni 3-4 settimane — inserita nella tua agenda come un appuntamento fisso — è sufficiente per mantenere la tensione sotto controllo.",
  },
];

const combos = [
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Massaggio + manicure semipermanente",
    body: "Relax e mani curate nella stessa visita. Si organizza facilmente in una mattinata.",
  },
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Massaggio + laminazione ciglia",
    body: "Corpo disteso e sguardo definito. Un upgrade completo in un'unica sosta.",
  },
  {
    href: "/servizi/massaggio-linfodrenante-carmagnola",
    title: "Massaggio rilassante + linfodrenante",
    body: "Per chi vuole lavorare sia sulla tensione muscolare che sulla leggerezza delle gambe.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/massaggio-rilassante-bra", desc: "~22 min da Carmagnola via SP7." },
  { city: "Canale", href: "/massaggio-rilassante-canale", desc: "Roero, ~35 min via A33." },
  { city: "Tutte le località", href: "/localita", desc: "Panoramica Rebel per zona." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    kicker="Rebel Massaggi — da Alba a Carmagnola"
    title="Massaggio rilassante per chi viene da Alba: _50 minuti_ per schiena, spalle e cervicale."
    lead="Vivi ad Alba o nelle Langhe? Da Carmagnola sono trenta minuti via A33. Da Rebel il massaggio rilassante è cinquanta minuti interamente dedicati alle zone più tese — cervicale, trapezi, spalle — con un ritmo graduale che lascia il corpo davvero diverso dalla prima seduta."
    meta={["~33 km da Alba", "~30 min via A33", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Alba", href: "https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="editorial-image-frame">
        <img
          src="/img/generated/massaggio-rilassante-rebel-editorial.png"
          alt="Massaggio rilassante schiena e spalle in cabina Rebel — trattamento professionale benessere"
          width="1200"
          height="900"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Perché chi vive ad Alba _viene a Carmagnola_ per il massaggio."
        lead="Nelle Langhe si vive bene ma ci si stanca sul serio: lavoro, vino, fiere, vendemmia, cene. La cervicale tesa e le spalle contratte non si risolvono con lo stretching — si risolvono con cinquanta minuti di lavoro manuale fatto bene."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-rilassante-carmagnola">Scheda completa massaggio</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <div class="split-visual">
        <div class="split-visual__image">
          <img src="/img/brand/corpo-rilassamento-schiena.png" alt="Corpo in rilassamento dopo massaggio — sensazione di leggerezza e benessere" width="900" height="1100" loading="lazy" />
        </div>
        <div class="split-visual__text">
          <SectionHead kicker="La sensazione dopo" title="Il corpo si _sgrava_. E lo senti subito." lead="Dopo cinquanta minuti di lavoro mirato sulle zone di tensione, il corpo risponde in modo percepibile." />
          <p class="body-p">
            Cervicale più mobile, spalle abbassate, respiro più profondo: non è una metafora. Sono gli effetti fisici di un massaggio fatto con ritmo corretto e pressione adeguata.
          </p>
          <p class="body-p">
            Il giorno dopo potresti sentire una leggera dolenzia muscolare — è normale dopo un lavoro in profondità. Sparisce in 24-48 ore e lascia una sensazione di leggerezza che dura giorni.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">Da Alba sono circa 33 km via <strong>A33 direzione Torino</strong>, uscita Marene, poi <strong>SP661 fino a Carmagnola</strong>. In trenta minuti sei in studio.</p>
          <p class="body-p">Lo studio è in <strong>Viale Barbaroux 20</strong>. Parcheggio gratuito a meno di un minuto.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Alba in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Alba a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Una sola sosta" title="Abbina il massaggio: _si organizza_ facilmente." lead="Il massaggio si combina bene con manicure e laminazione. Per il laser, consigliamo di abbinarli in momenti diversi." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Alba e dalle _Langhe_: le risposte." />
      <FaqAccordion items={faqs} kicker="FAQ Massaggio Rilassante Alba" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="Il massaggio non è l'unico motivo per venire a Carmagnola _dalle Langhe_."
        lead="Laser, manicure, laminazione, pulizia viso e protocolli: la pagina panoramica per chi viene da Alba li raccoglie tutti."
        primaryHref="/localita/alba"
        primaryLabel="Pagina panoramica Rebel per Alba"
        secondaryHref="/servizi/massaggio-linfodrenante-carmagnola"
        secondaryLabel="Massaggio linfodrenante"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino ad Alba" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenota"
        title="_50 minuti_ per smettere davvero di pensare."
        lead="Scrivici su WhatsApp con il giorno preferito. Ti rispondiamo con gli slot disponibili."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scheda massaggio completa"
        secondaryHref="/servizi/massaggio-rilassante-carmagnola"
      />
    </div>
  </section>
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .split-visual { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; margin-top: 1rem; }
  .split-visual__image { border-radius: var(--r-lg); overflow: hidden; max-height: 620px; }
  .split-visual__image img { width: 100%; height: 100%; object-fit: cover; display: block; }
  @media (max-width: 760px) { .split-visual { grid-template-columns: 1fr; } .split-visual__image { order: -1; } }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
