---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { buildBreadcrumbSchema, buildServiceSchema, buildWebPageSchema, buildArticleSchema, createPageMeta } from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Massaggio rilassante da Bra | REBEL Carmagnola",
  description: "Massaggio rilassante di 50 minuti a Carmagnola per chi arriva da Bra: schiena, spalle e collo, con zone e pressione concordate. Da 55 €.",
  path: "/massaggio-rilassante-bra",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "massaggio rilassante Bra", "massaggio Bra", "massaggio cervicale Bra", "massaggio schiena Bra",
    "centro benessere Bra", "massaggio vicino Bra", "massaggio spalle Bra CN", "benessere Bra", "relax Bra Cuneo", "massaggio rilassante vicino Bra",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio rilassante Carmagnola", path: "/servizi/massaggio-rilassante-carmagnola" },
  { name: "Bra", path: "/massaggio-rilassante-bra" },
]);
const webPage = buildWebPageSchema({ name: "Massaggio rilassante per chi arriva da Bra", description: meta.description, path: "/massaggio-rilassante-bra" });
const articleSchema = buildArticleSchema({ headline: "Massaggio rilassante per chi arriva da Bra — REBEL Carmagnola", description: meta.description, path: "/massaggio-rilassante-bra", keywords: ["massaggio rilassante Bra", "massaggio cervicale Bra CN"], section: "Massaggi", image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png" });
const serviceSchema = buildServiceSchema("Massaggio rilassante per chi arriva da Bra", "Massaggio rilassante di 50 minuti a Carmagnola, dedicato a schiena, spalle e collo, con zone e pressione concordate prima di iniziare.", "/massaggio-rilassante-bra", { priceFrom: 55, keywords: ["massaggio rilassante Bra", "massaggio cervicale Bra CN"] });
const geoServiceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-bra#service-geo`,
  name: "Massaggio rilassante per chi arriva da Bra", serviceType: "Massaggio rilassante",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    { "@type": "City", name: "Bra", containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" } },
    { "@type": "GeoCircle", geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.6968, longitude: 7.8558 }, geoRadius: "6000" },
  ],
  offers: { "@type": "Offer", priceCurrency: "EUR", price: "55.00", url: `${siteConfig.siteUrl}/contatti`, availability: "https://schema.org/InStock" },
};

const faqs = [
  { q: "Dove si trova REBEL rispetto a Bra?", a: "Lo studio è in Viale Barbaroux 20, a Carmagnola. Apri Google Maps per verificare percorso, traffico e tempi aggiornati." },
  { q: "Quanto dura la seduta?", a: "La seduta dura 50 minuti. Prima di iniziare concordiamo le zone e la pressione, con attenzione a schiena, spalle e collo." },
  { q: "Ho spesso schiena e spalle tese. Può aiutarmi a rilassarmi?", a: "Il massaggio può offrire una sensazione temporanea di distensione e relax. Se avverti dolore acuto o persistente, chiedi prima una valutazione sanitaria o fisioterapica." },
  { q: "Posso prenotare una sola seduta?", a: "Sì. Puoi prenotare una singola seduta oppure concordare gli appuntamenti successivi in base alle tue preferenze." },
  { q: "Posso abbinarlo ad altri trattamenti nello stesso giorno?", a: "Alcuni servizi possono essere organizzati nella stessa visita. Indica che cosa vuoi abbinare: verifichiamo disponibilità e compatibilità prima di confermare." },
  { q: "Come prenoto da Bra?", a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

const points = [
  { kicker: "01 · Durata", title: "Una seduta di 50 minuti.", body: "Concordiamo zone e pressione prima di iniziare, con attenzione a schiena, spalle e collo." },
  { kicker: "02 · Pressione", title: "La pressione si adatta alle tue indicazioni.", body: "Durante la seduta puoi chiedere una pressione più leggera o indicare una zona diversa." },
  { kicker: "03 · Zone", title: "Schiena, spalle e collo.", body: "Prima di iniziare indichi dove preferisci concentrare il massaggio." },
  { kicker: "04 · Frequenza", title: "Una seduta o più appuntamenti.", body: "Puoi prenotare una sola seduta oppure concordare gli appuntamenti successivi." },
];

const combos = [
  { href: "/servizi/manicure-semipermanente-carmagnola", title: "Massaggio + manicure", body: "Se vuoi aggiungere la manicure, verifichiamo disponibilità e compatibilità prima di confermare." },
  { href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola", title: "Massaggio + laminazione", body: "Se vuoi aggiungere la laminazione, verifichiamo disponibilità e compatibilità prima di confermare." },
  { href: "/servizi/massaggio-linfodrenante-carmagnola", title: "Massaggio rilassante + linfodrenante", body: "Se vuoi abbinare i due massaggi, verifichiamo disponibilità e compatibilità prima di confermare." },
];
const nearbyAreas = [
  { city: "Alba", href: "/massaggio-rilassante-alba", desc: "Massaggio rilassante per chi arriva da Alba." },
  { city: "Canale", href: "/massaggio-rilassante-canale", desc: "Massaggio rilassante per chi arriva da Canale." },
  { city: "Tutte le località", href: "/localita", desc: "Consulta indirizzo, mappa e contatti." },
];

const m = getPageMedia("/massaggio-rilassante-bra");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Massaggio rilassante · REBEL Carmagnola"
    title="Massaggio rilassante di _50 minuti_ per chi arriva da Bra."
    lead="La seduta dura 50 minuti. Prima di iniziare concordiamo le zone e la pressione, con attenzione a schiena, spalle e collo."
    bullets={["Seduta di 50 minuti", "Schiena, spalle e collo", "Pressione concordata"]}
    meta={["Studio a Carmagnola", "Indicazioni su Google Maps", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Chiedi un appuntamento", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri Google Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Durante il massaggio"
          title="Una seduta di _50 minuti_ per schiena, spalle e collo."
          body="Prima di iniziare concordiamo le zone e la pressione. Durante la seduta puoi indicarci come preferisci proseguire."
          bullets={["Seduta di 50 minuti", "Schiena, spalle e collo", "Pressione adattabile durante il massaggio"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/massaggio-rilassante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead kicker="Il massaggio REBEL" title="Zone e pressione _concordate prima di iniziare_." lead="La seduta dura 50 minuti e può concentrarsi su schiena, spalle e collo in base alle tue preferenze." />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (<FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Chiedi un appuntamento</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-rilassante-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Come raggiungere REBEL da _Bra_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">REBEL si trova in <strong>Viale Barbaroux 20, a Carmagnola</strong>.</p>
          <p class="body-p">Apri Google Maps per verificare percorso, traffico e tempi aggiornati.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri Google Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Bra&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Indicazioni da Bra a REBEL Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Servizi abbinabili" title="Vuoi abbinare un altro _trattamento_?" lead="Indica i servizi che ti interessano: verifichiamo disponibilità e compatibilità prima dell’appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Massaggio rilassante a Carmagnola"
      quote="La seduta dura 50 minuti e le zone vengono concordate prima di iniziare."
      cta={{ label: "Chiedi un appuntamento", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Informazioni utili sul _massaggio rilassante_." />
      <FaqAccordion items={faqs} kicker="FAQ Massaggio Rilassante Bra" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Altri servizi REBEL" title="Trattamenti viso e corpo per chi arriva da _Bra_." lead="Consulta i servizi disponibili nello studio REBEL di Carmagnola." primaryHref="/localita/bra" primaryLabel="Scopri tutti i servizi da Bra" secondaryHref="/epilazione-laser-bra" secondaryLabel="Scopri il laser" />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Altre località" title="Servizi REBEL dalle _zone vicine_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Località" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Prenotazione" title="Prenota il _massaggio rilassante di 50 minuti_." lead="Scrivici su WhatsApp con il giorno preferito." primaryLabel="Scrivici su WhatsApp" primaryHref={siteConfig.social.whatsapp} secondaryLabel="Scopri il trattamento" secondaryHref="/servizi/massaggio-rilassante-carmagnola" />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
