---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { buildBreadcrumbSchema, buildServiceSchema, buildWebPageSchema, buildArticleSchema, createPageMeta } from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Massaggio rilassante per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description: "Da Racconigi a Rebel sono dieci minuti via SS20, senza autostrada. È il comune più vicino: massaggio rilassante 50 minuti su schiena, spalle e cervicale con ritmo graduale e tecnica manuale. Prenota su WhatsApp.",
  path: "/massaggio-rilassante-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "massaggio rilassante Racconigi", "massaggio Racconigi", "massaggio cervicale Racconigi", "massaggio schiena Racconigi",
    "centro benessere Racconigi", "massaggio vicino Racconigi", "massaggio spalle Racconigi CN", "benessere Racconigi", "relax Racconigi Cuneo", "massaggio rilassante vicino Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio rilassante Carmagnola", path: "/servizi/massaggio-rilassante-carmagnola" },
  { name: "Racconigi", path: "/massaggio-rilassante-racconigi" },
]);
const webPage = buildWebPageSchema({ name: "Massaggio rilassante per chi viene da Racconigi", description: meta.description, path: "/massaggio-rilassante-racconigi" });
const articleSchema = buildArticleSchema({ headline: "Massaggio rilassante per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)", description: meta.description, path: "/massaggio-rilassante-racconigi", keywords: ["massaggio rilassante Racconigi", "massaggio cervicale Racconigi CN"], section: "Massaggi", image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png" });
const serviceSchema = buildServiceSchema("Massaggio rilassante per chi viene da Racconigi", "Massaggio rilassante 50 minuti a Carmagnola per clienti di Racconigi: schiena, spalle e cervicale con ritmo graduale. A dieci minuti via SS20.", "/massaggio-rilassante-racconigi", { priceFrom: 55, keywords: ["massaggio rilassante Racconigi", "massaggio cervicale Racconigi CN"] });
const geoServiceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-racconigi#service-geo`,
  name: "Massaggio rilassante per chi viene da Racconigi", serviceType: "Relaxation massage",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    { "@type": "City", name: "Racconigi", containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" } },
    { "@type": "GeoCircle", geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7676, longitude: 7.6786 }, geoRadius: "7000" },
  ],
  offers: { "@type": "Offer", priceCurrency: "EUR", price: "55.00", url: `${siteConfig.siteUrl}/contatti`, availability: "https://schema.org/InStock" },
};

const faqs = [
  { q: "Da Racconigi, quanto tempo serve per arrivare a Rebel?", a: "Una decina di minuti via SS20 (Via Racconigi) verso Carmagnola: circa dieci chilometri, senza autostrada e senza pedaggio. Viale Barbaroux 20, parcheggio gratuito a un minuto. È il comune più vicino tra quelli che seguiamo." },
  { q: "Quanto dura la seduta?", a: "50 minuti. Si lavora su schiena, spalle e cervicale con ritmo progressivo — si parte piano e si approfondisce dove la tensione è maggiore." },
  { q: "Ho sempre la schiena e le spalle contratte. Aiuta davvero?", a: "Sì. La tensione cronica su queste zone spesso non si risolve con lo stretching. Il massaggio rilassante lavora in profondità, progressivamente, sciogliendo le contrazioni in modo percepibile già dalla prima seduta." },
  { q: "Ogni quanto conviene farlo?", a: "Per chi ha tensione cronica, ogni 3-4 settimane è un ritmo sensato. E da Racconigi, a dieci minuti, tenerlo come appuntamento fisso è facile: diventa una routine, non un evento da incastrare." },
  { q: "Posso abbinarlo ad altri trattamenti nello stesso giorno?", a: "Sì, si abbina bene con manicure semipermanente e laminazione. Per il laser ti consigliamo di fare il massaggio in un momento separato per comfort. Vista la vicinanza, organizzare due soste è semplice." },
  { q: "Come prenoto da Racconigi?", a: "Scrivici su WhatsApp con il giorno preferito. Ti rispondiamo con gli slot disponibili." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-racconigi#speakable`,
  name: "Massaggio rilassante per chi viene da Racconigi",
  speakable: { "@type": "SpeakableSpecification", cssSelector: [".page-hero__title", ".page-hero__lead"] },
  url: `${siteConfig.siteUrl}/massaggio-rilassante-racconigi`,
};

const points = [
  { kicker: "01 · Il comune più vicino", title: "Dieci minuti per cinquanta di vero recupero.", body: "Racconigi è il centro più vicino tra quelli che seguiamo. Dieci minuti di viaggio per cinquanta di massaggio che scaricano una settimana di tensione: il rapporto sforzo-beneficio più alto che esista." },
  { kicker: "02 · 50 minuti reali", title: "Niente ritagli, niente tagli di tempo.", body: "Cinquanta minuti interamente lavorati su schiena, spalle e cervicale. Si comincia gradualmente, si approfondisce dove serve, si chiude senza fretta." },
  { kicker: "03 · Cervicale e trapezi", title: "Le zone più tese, lavorate con tecnica.", body: "Cervicale e trapezi concentrano la maggior parte dello stress accumulato. Lavoriamo su queste zone con una tecnica manuale precisa — non un generico sfioramento." },
  { kicker: "04 · Un ritmo che si può tenere", title: "Una seduta al mese cambia la qualità del recupero.", body: "Non serve venire ogni settimana. Una seduta ogni 3-4 settimane — e a dieci minuti da Racconigi è facile tenerla come appuntamento fisso — basta per gestire la tensione." },
];

const combos = [
  { href: "/manicure-semipermanente-racconigi", title: "Massaggio + manicure", body: "Relax per il corpo e mani curate in una sola visita da Racconigi." },
  { href: "/laminazione-racconigi", title: "Massaggio + laminazione", body: "Corpo disteso e sguardo definito. Un upgrade completo in una sosta." },
  { href: "/servizi/massaggio-linfodrenante-carmagnola", title: "Massaggio rilassante + linfodrenante", body: "Per chi vuole lavorare su tensione muscolare e leggerezza delle gambe." },
];
const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "A pochi km, sull'asse per Carmagnola." },
  { city: "Carignano", href: "/localita/carignano", desc: "Subito a nord, lungo la SS20." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Poco più a sud, nella pianura cuneese." },
];

const m = getPageMedia("/massaggio-rilassante-racconigi");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Massaggi — da Racconigi a Carmagnola"
    title="Massaggio rilassante per chi viene da Racconigi: _dieci minuti_ di viaggio, 50 di recupero."
    lead="Da Racconigi a Rebel sono dieci minuti via SS20, senza autostrada e senza pedaggio. È il comune più vicino: il massaggio rilassante è cinquanta minuti dedicati a schiena, spalle e cervicale — le zone dove si accumula tutto. Ritmo graduale, tecnica manuale precisa, effetto percepibile dalla prima seduta."
    bullets={["50 minuti di vero stacco", "Schiena, spalle, cervicale", "Prima visita gratuita"]}
    meta={["~10 km da Racconigi", "~14 min via SS20", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Racconigi", href: "https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Stacco vero"
          title="Cinquanta minuti per _sciogliere_ schiena e cervicale."
          body="Un massaggio rilassante con ritmo graduale: si parte in ascolto e si lavora dove serve davvero — schiena, spalle, cervicale. Esci con la tensione abbassata, non solo coccolata."
          bullets={["50 minuti, ritmo graduale", "Focus su schiena, spalle, cervicale", "Ambiente caldo e silenzioso"]}
          cta={{ label: "Scheda massaggio", href: "/servizi/massaggio-rilassante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead kicker="Vicinissimi" title="Da Racconigi il massaggio diventa _una routine_, non un evento." lead="A dieci minuti porta-a-porta, cinquanta minuti di stacco ogni 3-4 settimane non pesano. La vicinanza è ciò che trasforma il massaggio da lusso occasionale a manutenzione regolare." />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (<FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-rilassante-carmagnola">Scheda completa massaggio</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Racconigi a Rebel: _dieci minuti_ di strada dritta." />
      <div class="directions-grid">
        <div>
          <p class="body-p">Da Racconigi a Carmagnola sono circa dieci chilometri via <strong>SS20 (Via Racconigi)</strong> direzione nord. Si arriva quasi sempre in dieci-quattordici minuti, senza autostrada e senza pedaggio.</p>
          <p class="body-p">Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro Carmagnola. Parcheggio gratuito a 30 secondi a piedi.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Racconigi in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Racconigi a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Una sola sosta" title="Abbina il massaggio: _si organizza_ facilmente." lead="Si combina bene con manicure e laminazione. E a dieci minuti da Racconigi, un'unica uscita basta per più cose fatte bene." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Dieci minuti di viaggio per un'ora di vero stacco."
      cta={{ label: "Prenota la prima visita", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Racconigi: le risposte _oneste_." />
      <FaqAccordion items={faqs} kicker="FAQ Massaggio Rilassante Racconigi" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Vuoi un piano più ampio?" title="Il massaggio non è l'unico motivo per venire a Carmagnola _da Racconigi_." lead="Laser, manicure, laminazione e protocolli: la pagina panoramica per chi viene da Racconigi li raccoglie tutti." primaryHref="/localita/racconigi" primaryLabel="Pagina panoramica Rebel per Racconigi" secondaryHref="/epilazione-laser-racconigi" secondaryLabel="Laser da Racconigi" />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino a Racconigi" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Prenota" title="_50 minuti_ per smettere di pensare." lead="Scrivici su WhatsApp con il giorno preferito — e da Racconigi sei qui in dieci minuti." primaryLabel="Prenota su WhatsApp" primaryHref={siteConfig.social.whatsapp} secondaryLabel="Scheda massaggio" secondaryHref="/servizi/massaggio-rilassante-carmagnola" />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
