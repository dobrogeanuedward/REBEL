---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { buildBreadcrumbSchema, buildServiceSchema, buildWebPageSchema, buildArticleSchema, createPageMeta } from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Massaggio rilassante per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)",
  description: "Da Racconigi a Rebel sono circa 10-14 minuti via SS20, senza autostrada. Massaggio rilassante di 50 minuti su schiena, spalle e collo, con ritmo e pressione concordati.",
  path: "/massaggio-rilassante-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "massaggio rilassante Racconigi", "massaggio Racconigi", "massaggio cervicale Racconigi", "massaggio schiena Racconigi",
    "centro benessere Racconigi", "massaggio vicino Racconigi", "massaggio spalle Racconigi CN", "benessere Racconigi", "relax Racconigi Cuneo", "massaggio rilassante vicino Racconigi",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Massaggio rilassante Carmagnola", path: "/servizi/massaggio-rilassante-carmagnola" },
  { name: "Racconigi", path: "/massaggio-rilassante-racconigi" },
]);
const webPage = buildWebPageSchema({ name: "Massaggio rilassante per chi viene da Racconigi", description: meta.description, path: "/massaggio-rilassante-racconigi" });
const articleSchema = buildArticleSchema({ headline: "Massaggio rilassante per chi viene da Racconigi — Rebel (Carmagnola, ~14 min)", description: meta.description, path: "/massaggio-rilassante-racconigi", keywords: ["massaggio rilassante Racconigi", "massaggio cervicale Racconigi CN"], section: "Massaggi", image: "https://www.rebelepigenetica.it/img/generated/massaggio-rilassante-rebel-editorial.png" });
const serviceSchema = buildServiceSchema("Massaggio rilassante per chi viene da Racconigi", "Massaggio rilassante di 50 minuti a Carmagnola per clienti di Racconigi: schiena, spalle e collo, con ritmo e pressione concordati. A circa 10-14 minuti via SS20.", "/massaggio-rilassante-racconigi", { priceFrom: 55, keywords: ["massaggio rilassante Racconigi", "massaggio cervicale Racconigi CN"] });
const geoServiceSchema = {
  "@context": "https://schema.org", "@type": "Service",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-racconigi#service-geo`,
  name: "Massaggio rilassante per chi viene da Racconigi", serviceType: "Relaxation massage",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    { "@type": "City", name: "Racconigi", containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" } },
    { "@type": "GeoCircle", geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7676, longitude: 7.6786 }, geoRadius: "7000" },
  ],
  offers: { "@type": "Offer", priceCurrency: "EUR", price: "55.00", url: `${siteConfig.siteUrl}/contatti`, availability: "https://schema.org/InStock" },
};

const faqs = [
  { q: "Da Racconigi, come arrivo a Rebel?", a: "Puoi seguire la SS20 fino a Carmagnola. Apri Google Maps per verificare percorso, traffico e tempi aggiornati; lo studio è in Viale Barbaroux 20." },
  { q: "Quanto dura la seduta?", a: "50 minuti. Le manualità si concentrano su schiena, spalle e collo, con pressione concordata e ritmo graduale." },
  { q: "Ho spesso schiena e spalle tese. Può aiutarmi a rilassarmi?", a: "Il massaggio può offrire una sensazione temporanea di distensione e relax. Se avverti dolore acuto o persistente, chiedi prima una valutazione sanitaria o fisioterapica." },
  { q: "Ogni quanto conviene farlo?", a: "La frequenza dipende dalle tue preferenze e da come percepisci la seduta. Puoi prenotarlo come momento singolo oppure concordare una cadenza che si adatti alla tua agenda." },
  { q: "Posso abbinarlo ad altri trattamenti nello stesso giorno?", a: "Alcuni servizi possono essere organizzati nella stessa visita. Dicci cosa vuoi abbinare e ti confermiamo tempi e compatibilità." },
  { q: "Come prenoto da Racconigi?", a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqs.map((f) => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/massaggio-rilassante-racconigi#speakable`,
  name: "Massaggio rilassante per chi viene da Racconigi",
  speakable: { "@type": "SpeakableSpecification", cssSelector: [".page-hero__title", ".page-hero__lead"] },
  url: `${siteConfig.siteUrl}/massaggio-rilassante-racconigi`,
};

const points = [
  { kicker: "01 · Da Racconigi a Carmagnola", title: "Circa dieci-quattordici minuti di viaggio.", body: "La vicinanza rende semplice organizzare il massaggio in base ai tuoi impegni e agli orari disponibili." },
  { kicker: "02 · Durata della seduta", title: "Cinquanta minuti di massaggio.", body: "La seduta è dedicata a schiena, spalle e collo. Si comincia gradualmente e si adattano ritmo e pressione alle tue indicazioni." },
  { kicker: "03 · Schiena, spalle e collo", title: "Le zone vengono concordate prima di iniziare.", body: "Ci racconti dove preferisci concentrare il massaggio e adattiamo pressione e ritmo alle tue sensazioni durante la seduta." },
  { kicker: "04 · Frequenza personalizzata", title: "Un appuntamento singolo o una cadenza concordata.", body: "Scegliamo la frequenza insieme, in base alle tue preferenze e al tempo che vuoi dedicare al relax." },
];

const combos = [
  { href: "/manicure-semipermanente-racconigi", title: "Massaggio + manicure", body: "Relax per il corpo e mani curate in una sola visita da Racconigi." },
  { href: "/laminazione-racconigi", title: "Massaggio + laminazione", body: "Due servizi nello stesso appuntamento, se tempi e compatibilità lo consentono." },
  { href: "/servizi/massaggio-linfodrenante-carmagnola", title: "Massaggio rilassante + linfodrenante", body: "Due tipologie di massaggio da organizzare insieme solo dopo aver verificato tempi e compatibilità." },
];
const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "A pochi km, sull'asse per Carmagnola." },
  { city: "Carignano", href: "/localita/carignano", desc: "Subito a nord, lungo la SS20." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Poco più a sud, nella pianura cuneese." },
];

const m = getPageMedia("/massaggio-rilassante-racconigi");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Massaggi — da Racconigi a Carmagnola"
    title="Massaggio rilassante per chi viene da Racconigi: _50 minuti dedicati a te_."
    lead="Da Racconigi a Rebel sono circa dieci-quattordici minuti via SS20. La seduta dura 50 minuti e si concentra su schiena, spalle e collo, con pressione concordata e ritmo graduale."
    bullets={["Massaggio rilassante di 50 minuti", "Schiena, spalle e collo", "Valutazione REBEL · 30–40 min"]}
    meta={["~10 km da Racconigi", "~14 min via SS20", "Da 55 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Racconigi", href: "https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Stacco vero"
          title="Cinquanta minuti per _rilassare_ schiena, spalle e collo."
          body="Il massaggio segue un ritmo graduale. Prima di iniziare concordiamo le zone e la pressione, poi le adattiamo alle tue sensazioni."
          bullets={["50 minuti, ritmo graduale", "Focus su schiena, spalle e collo", "Ambiente caldo e silenzioso"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/massaggio-rilassante-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead kicker="Il massaggio REBEL" title="Una seduta personalizzata, a _circa dieci-quattordici minuti da Racconigi_." lead="Concordiamo zone, pressione e ritmo prima di iniziare e li adattiamo alle tue sensazioni durante i 50 minuti di trattamento." />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (<FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota su WhatsApp</a>
        <a class="btn btn--secondary" href="/servizi/massaggio-rilassante-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Da Racconigi a Rebel: _dieci minuti_ di strada dritta." />
      <div class="directions-grid">
        <div>
          <p class="body-p">Da Racconigi a Carmagnola puoi seguire la <strong>SS20 (Via Racconigi)</strong>. Per percorso, traffico e tempi aggiornati, consulta Google Maps prima di partire.</p>
          <p class="body-p">Lo studio è in <strong>Viale Barbaroux 20</strong>, in pieno centro Carmagnola. possibilità di parcheggio nelle vicinanze.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri il percorso da Racconigi in Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Percorso da Racconigi a Rebel Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Una sola sosta" title="Vuoi abbinare un altro _trattamento_?" lead="Dicci quali servizi ti interessano: ti confermiamo tempi e compatibilità prima dell'appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Da Racconigi a Carmagnola per un massaggio rilassante di 50 minuti."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Da Racconigi: le risposte _oneste_." />
      <FaqAccordion items={faqs} kicker="FAQ Massaggio Rilassante Racconigi" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Altri servizi" title="Scopri cosa puoi prenotare da _Racconigi_." lead="Trovi laser, manicure, laminazione e trattamenti viso e corpo disponibili per chi arriva da Racconigi." primaryHref="/localita/racconigi" primaryLabel="Scopri tutti i servizi da Racconigi" secondaryHref="/epilazione-laser-racconigi" secondaryLabel="Scopri il laser" />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Vicino a Racconigi" title="Comuni vicini: _pagine dedicate_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Zona vicina" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta kicker="Prenota" title="_50 minuti_ dedicati al relax." lead="Scrivici su WhatsApp con il giorno preferito." primaryLabel="Prenota su WhatsApp" primaryHref={siteConfig.social.whatsapp} secondaryLabel="Scopri il trattamento" secondaryHref="/servizi/massaggio-rilassante-carmagnola" />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame { border-radius: var(--r-lg); overflow: hidden; max-height: 520px; }
  .editorial-image-frame img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
