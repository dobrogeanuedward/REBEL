---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import StepStrip from "@/components/StepStrip.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { methodSteps } from "@/lib/content";

const meta = createPageMeta({
  title: "Come lavoriamo — Metodo Rebel | Centro estetico Carmagnola",
  description:
    "Cinque passaggi concreti, dalla prima visita gratuita al mantenimento. Come funziona un percorso da Rebel a Carmagnola: prima visita, proposta, primo trattamento, calendario, mantenimento.",
  path: "/metodo-rebel",
  openGraphType: "article",
  keywords: [
    "metodo estetica Carmagnola",
    "come funziona centro estetico Carmagnola",
    "percorso estetica personalizzato Carmagnola",
    "prima visita centro estetico Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Come lavoriamo", path: "/metodo-rebel" },
]);
const webPage = buildWebPageSchema({
  name: "Come lavoriamo — Rebel Carmagnola",
  description:
    "Cinque passaggi: prima visita, proposta, primo trattamento, calendario, mantenimento.",
  path: "/metodo-rebel",
});
const service = buildServiceSchema(
  "Percorso estetico personalizzato a Carmagnola",
  "Percorso in cinque passaggi: prima visita gratuita, proposta chiara, primo trattamento, calendario, mantenimento.",
  "/metodo-rebel",
);
const article = buildArticleSchema({
  headline: "Come lavoriamo — Metodo Rebel",
  description:
    "Dal primo messaggio al mantenimento: cinque passaggi semplici per un percorso senza sorprese.",
  path: "/metodo-rebel",
  keywords: ["metodo Rebel", "come funziona centro estetico Carmagnola"],
  section: "Metodo",
});
---
<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={service} />
  <JsonLd data={article} />

  <PageHero
    image={media.studio.cabin}
    kicker="Come lavoriamo · Carmagnola"
    title="Cinque passaggi, dalla _prima visita_ al mantenimento."
    lead="Niente percorsi complicati o pacchetti gonfiati. Da Rebel funziona così: ci scrivi, vieni in studio gratis, decidiamo insieme cosa fare e quando."
    bullets={["Prima visita gratuita", "Listino sempre online", "Nessun obbligo di acquisto"]}
    meta={["Prima visita gratuita", "Listino sempre online", "Nessun obbligo di acquisto"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vedi listino e prezzi", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il percorso, passo per passo"
        title="Cinque _step_, ciascuno con un compito preciso."
        lead="L'ordine conta: ogni passaggio prepara quello successivo. Per questo non saltiamo la prima visita, anche se è gratuita."
      />
      <StepStrip items={methodSteps} />
    </div>
  </section>

  <section class="section section--tight">
    <div class="container grid-2">
      <article class="card card--feature">
        <p class="card__kicker">Perché lavoriamo così</p>
        <h2 class="card__title">Perché un percorso costruito bene si vede.</h2>
        <p class="card__body" style="margin-top:1rem;">
          Un buon trattamento singolo dà un risultato. Un percorso costruito
          sui tempi e sulle priorità della persona dà un cambiamento. Per questo
          la prima visita non è un'extra: è la base che ci permette di
          proporti qualcosa di sensato.
        </p>
      </article>
      <aside class="card">
        <p class="card__kicker">Cosa porti via dalla prima visita</p>
        <h2 class="card__title">Tre cose concrete.</h2>
        <ul class="flow" style="margin-top:1rem; color: var(--text-muted);">
          <li>Una proposta scritta con prezzi e tempi reali.</li>
          <li>Risposta chiara: ha senso oppure no? E perché.</li>
          <li>Il piccolo regalo che hai scelto in fase di prenotazione.</li>
        </ul>
      </aside>
    </div>
  </section>

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Da Rebel, a Carmagnola"
    quote="Un percorso costruito bene si vede. Per questo iniziamo dall'ascolto."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Iniziamo"
        title="Quindici minuti, _gratis_, in studio."
        lead="Prenota da WhatsApp o dal form. Ti rispondiamo entro poche ore con un orario disponibile."
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>
