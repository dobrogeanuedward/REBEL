---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StepStrip from "@/components/StepStrip.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import RebelMap from "@/components/RebelMap.tsx";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { methodSteps } from "@/lib/content";
import { rebelWorlds, getJourneysByWorld } from "@/lib/rebel-journeys";

const meta = createPageMeta({
  title: "Metodo Rebel — Come scegliamo trattamenti viso e corpo a Carmagnola",
  description:
    "Scopri come funziona la prima visita Rebel: colloquio, valutazione di pelle o corpo, scelta dei trattamenti, calendario, controllo dei risultati e mantenimento.",
  path: "/metodo-rebel",
  openGraphType: "article",
  keywords: [
    "Metodo Rebel",
    "estetica epigenetica Carmagnola",
    "percorso estetico personalizzato Carmagnola",
    "trattamenti viso corpo su misura Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Metodo Rebel", path: "/metodo-rebel" },
]);
const webPage = buildWebPageSchema({
  name: "Metodo Rebel — come lavoriamo a Carmagnola",
  description: meta.description,
  path: "/metodo-rebel",
});
const service = buildServiceSchema(
  "Metodo Rebel — valutazione e programma estetico personalizzato",
  "Colloquio iniziale, valutazione professionale, preparazione della pelle, programma di trattamento, controllo dei risultati e mantenimento.",
  "/metodo-rebel",
);
const article = buildArticleSchema({
  headline: "Metodo Rebel — dalla valutazione al mantenimento",
  description: meta.description,
  path: "/metodo-rebel",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Metodo",
});

const priorities = [
  "Pelle spenta, macchie e colorito irregolare",
  "Perdita di tono, elasticità e compattezza",
  "Sensibilità, secchezza e barriera cutanea",
  "Gonfiore, segni e stanchezza del contorno occhi",
  "Ritenzione, pesantezza e tono del corpo",
  "Impurità, pori e grana irregolare",
  "Ricrescita dei peli su viso e corpo",
];

const journeys = rebelWorlds.map((world) => ({ ...world, paths: getJourneysByWorld(world.id) }));
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-metodo-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={service} />
  <JsonLd data={article} />

  <section class="rb-hero rb-hero--method">
    <div class="rb-hero__media">
      <img src={media.method.hero.src} alt={media.method.hero.alt} />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">Metodo Rebel · Carmagnola</p>
      <h1>Come scegliamo i trattamenti <em>per viso e corpo.</em></h1>
      <p class="rb-lead">
        La prima visita raccoglie il tuo obiettivo, le condizioni della pelle o del corpo e le tue abitudini. Con queste informazioni definiamo trattamenti, prodotti, tecnologie, frequenza e controlli.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la prima visita</a>
        <a class="btn btn--secondary" href="/percorsi">Vedi i nove percorsi</a>
      </div>
      <p class="rb-signature">Be Beautiful. Be Rebel.</p>
    </div>
  </section>

  <section class="rb-section rb-section--ivory" id="mappa-rebel-live">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Mappa REBEL Live</p>
        <h2>Nove percorsi, da esplorare in chiaro.</h2>
      </div>
      <RebelMap client:visible />
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">La Mappa Rebel</p>
        <h2>Un riepilogo chiaro di obiettivo, trattamenti e calendario.</h2>
      </div>
      <div class="rb-copy">
        <p>La Mappa Rebel registra che cosa vuoi migliorare, che cosa abbiamo osservato e quale risultato abbiamo concordato.</p>
        <p>Indica i trattamenti consigliati, le tecnologie utilizzabili, la frequenza iniziale, la data del controllo e il mantenimento previsto.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Come funziona</p>
        <h2>Dal colloquio iniziale al mantenimento, in sei fasi.</h2>
      </div>
      <StepStrip items={methodSteps} />
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Cosa valutiamo</p>
        <h2>Le principali esigenze che possiamo trattare su viso e corpo.</h2>
      </div>
      <ol class="rb-priority-grid">
        {priorities.map((priority, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{priority}</strong></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">I percorsi Rebel</p>
        <h2>Quattro mondi aprono i nove percorsi della brochure REBEL.</h2>
      </div>
      <div class="rb-journey-grid">
        {journeys.map((journey) => (
          <a class="rb-journey-card" href={journey.href}>
            <p class="rb-kicker">Mondo REBEL</p>
            <h3>{journey.name}</h3>
            <p>{journey.summary}</p>
            <p>{journey.paths.map((path) => path.slug === "white" ? "Uniformare" : path.name).join(" · ")}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Manualità, attivi e tecnologie</p>
        <h2>Scegliamo strumenti e parametri in base alla zona e all’obiettivo.</h2>
      </div>
      <div class="rb-copy">
        <p>Per ogni trattamento specifichiamo quali prodotti e tecnologie utilizziamo, che cosa devono fare e con quale frequenza vanno applicati.</p>
        <p>Ai controlli confrontiamo la risposta con l’obiettivo iniziale e aggiorniamo il programma quando necessario.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Raccontaci che cosa vuoi _migliorare_."
        lead="In 30–40 minuti definiamo la priorità e ti spieghiamo quali percorsi, tempi e costi possono essere pertinenti. La valutazione è gratuita quando viene finalizzata alla costruzione del Percorso REBEL."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/percorsi"
        secondaryLabel="Vedi i nove percorsi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
