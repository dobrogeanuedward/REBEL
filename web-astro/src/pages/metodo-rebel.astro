---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StepStrip from "@/components/StepStrip.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { methodSteps } from "@/lib/content";

const meta = createPageMeta({
  title: "Metodo Rebel — Estetica epigenetica e percorsi su misura a Carmagnola",
  description:
    "Il Metodo Rebel unisce valutazione, priorità, Skin Reset, attivi epigenetici, tecnologie e rivalutazione per costruire percorsi viso e corpo su misura a Carmagnola.",
  path: "/metodo-rebel",
  openGraphType: "article",
  keywords: [
    "Metodo Rebel",
    "estetica epigenetica Carmagnola",
    "percorso estetico personalizzato Carmagnola",
    "trattamenti viso corpo su misura Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Metodo Rebel", path: "/metodo-rebel" },
]);
const webPage = buildWebPageSchema({
  name: "Metodo Rebel — estetica epigenetica a Carmagnola",
  description: meta.description,
  path: "/metodo-rebel",
});
const service = buildServiceSchema(
  "Metodo Rebel — percorso estetico personalizzato",
  "Valutazione, priorità, Skin Reset, percorso, rivalutazione e mantenimento.",
  "/metodo-rebel",
);
const article = buildArticleSchema({
  headline: "Metodo Rebel — la bellezza segue il tuo ritmo",
  description: meta.description,
  path: "/metodo-rebel",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Metodo",
});

const priorities = [
  "Luminosità e uniformità",
  "Tono, densità e longevità",
  "Comfort e barriera cutanea",
  "Contorno occhi e qualità dello sguardo",
  "Forma, drenaggio e compattezza",
  "Texture e grana della pelle",
  "Libertà dal pelo con Ice Polar",
];

const journeys = [
  {
    name: "Glow",
    body: "Per una pelle più luminosa, uniforme e vitale. Skin Reset, Catalysis, Cell Regen e attivi epigenetici vengono scelti in base a ciò che la pelle richiede.",
  },
  {
    name: "Longevity",
    body: "Per sostenere tono, densità, comfort e qualità del viso nel tempo. Lift, Collagen, Rebirth 60+ ed Eye Genesis entrano nel percorso quando sono davvero utili.",
  },
  {
    name: "Forma",
    body: "Per leggerezza, tonicità e armonia del corpo. Manualità, LPG, pressomassaggio, Tecar e Lift Body vengono combinati in base all’obiettivo e alla risposta della persona.",
  },
  {
    name: "Libertà",
    body: "Il percorso dedicato all’epilazione laser con manipolo Ice Polar: valutazione iniziale, parametri personalizzati, comfort e continuità.",
  },
];
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-metodo-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={service} />
  <JsonLd data={article} />

  <section class="rb-hero rb-hero--method">
    <div class="rb-hero__media">
      <img src={media.studio.cabin.src ?? media.studio.cabin} alt="Metodo Rebel nello studio di Carmagnola" />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">Estetica epigenetica · Carmagnola</p>
      <h1>La bellezza segue <em>il tuo ritmo.</em></h1>
      <p class="rb-lead">
        Il Metodo Rebel parte dalla tua pelle, dal tuo corpo e da ciò che desideri migliorare. Da lì costruiamo un percorso in cui manualità, attivi e tecnologie vengono scelti con precisione e aggiornati nel tempo.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/protocolli-epigenetici">Scopri i percorsi</a>
      </div>
      <p class="rb-signature">Be Beautiful. Be Rebel.</p>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">La Mappa Rebel</p>
        <h2>Prima di scegliere un trattamento, capiamo <em>da dove partire.</em></h2>
      </div>
      <div class="rb-copy">
        <p>La Mappa Rebel mette insieme ciò che desideri, ciò che la pelle manifesta e ciò che può sostenerla meglio in questo momento.</p>
        <p>Da qui nasce un percorso costruito su di te, con obiettivi chiari e momenti di rivalutazione.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Il Metodo, in sei passaggi</p>
        <h2>Ogni fase prepara <em>quella successiva.</em></h2>
      </div>
      <StepStrip items={methodSteps} />
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Le priorità</p>
        <h2>Prima del trattamento, individuiamo <em>ciò che conta di più.</em></h2>
      </div>
      <ol class="rb-priority-grid">
        {priorities.map((priority, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{priority}</strong></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">I percorsi Rebel</p>
        <h2>Ogni protocollo entra nel percorso <em>quando serve davvero.</em></h2>
      </div>
      <div class="rb-journey-grid">
        {journeys.map((journey) => (
          <article class="rb-journey-card">
            <p class="rb-kicker">Percorso</p>
            <h3>{journey.name}</h3>
            <p>{journey.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">La Professionista Rebel</p>
        <h2>La tecnologia entra quando <em>serve davvero.</em></h2>
      </div>
      <div class="rb-copy">
        <p>Ogni tecnologia viene scelta in base alla priorità, alla sensibilità e alla risposta osservata. Attivi epigenetici, manualità e tecnologie lavorano insieme.</p>
        <p>Durante il percorso rivalutiamo frequenza, intensità e combinazioni per accompagnare l’evoluzione della pelle e del corpo.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="La tua Mappa Rebel"
        title="Partiamo da ciò che conta _adesso_."
        lead="Prenota una valutazione in studio: ascoltiamo le tue esigenze e capiamo insieme da dove iniziare."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Esplora i percorsi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
