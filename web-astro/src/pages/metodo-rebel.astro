---
import BaseLayout from "@/layouts/BaseLayout.astro";
import StepStrip from "@/components/StepStrip.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import RebelMap from "@/components/RebelMap.tsx";
import { media } from "@/lib/page-media";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { methodSteps } from "@/lib/content";
import { rebelWorlds, getJourneysByWorld } from "@/lib/rebel-journeys";

const meta = createPageMeta({
  title: "Metodo Rebel — Come scegliamo trattamenti viso e corpo a Carmagnola",
  description:
    "Scopri come funziona la valutazione REBEL: colloquio, osservazione di pelle o corpo, scelta dei trattamenti, calendario, controlli e mantenimento.",
  path: "/metodo-rebel",
  openGraphType: "article",
  keywords: [
    "Metodo Rebel",
    "estetica epigenetica Carmagnola",
    "percorso estetico personalizzato Carmagnola",
    "trattamenti viso corpo su misura Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Metodo Rebel", path: "/metodo-rebel" },
]);
const webPage = buildWebPageSchema({
  name: "Metodo Rebel — come lavoriamo a Carmagnola",
  description: meta.description,
  path: "/metodo-rebel",
});
const service = buildServiceSchema(
  "Metodo Rebel — valutazione e programma estetico personalizzato",
  "Valutazione REBEL, osservazione della pelle o del corpo, programma di trattamento, controlli e mantenimento.",
  "/metodo-rebel",
);
const article = buildArticleSchema({
  headline: "Metodo Rebel — dalla valutazione al mantenimento",
  description: meta.description,
  path: "/metodo-rebel",
  keywords: ["Metodo Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Metodo",
});

const priorities = [
  "Pelle spenta, macchie e colorito irregolare",
  "Perdita di tono, elasticità e compattezza",
  "Sensibilità, secchezza e barriera cutanea",
  "Gonfiore, segni e stanchezza del contorno occhi",
  "Ritenzione, pesantezza e tono del corpo",
  "Impurità, pori e grana irregolare",
  "Ricrescita dei peli su viso e corpo",
];

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const worldMedia = {
  glow: { src: siteAsset("journeys.glow.hero.desktop"), alt: "Viso di una cliente in luce naturale" },
  longevity: { src: siteAsset("journeys.longevity.hero.desktop"), alt: "Cliente durante un trattamento viso" },
  forma: { src: siteAsset("journeys.forma.hero.desktop"), alt: "Trattamento professionale dedicato al corpo" },
  liberta: { src: siteAsset("journeys.liberta.hero.desktop"), alt: "Professionista durante una seduta di epilazione laser" },
} as const;
const journeys = rebelWorlds.map((world) => ({ ...world, ...worldMedia[world.id], paths: getJourneysByWorld(world.id) }));
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-metodo-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={service} />
  <JsonLd data={article} />

  <section class="rb-hero rb-hero--method">
    <div class="rb-hero__media">
      <img src={media.method.hero.src} alt={media.method.hero.alt} />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">Metodo Rebel · Carmagnola</p>
      <h1>Come scegliamo i trattamenti <em>per viso e corpo.</em></h1>
      <p class="rb-lead">
        Durante la valutazione parliamo di ciò che vuoi migliorare, osserviamo la pelle o il corpo e definiamo trattamenti, prodotti, tecnologie, frequenza e controlli.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/percorsi">Vedi i nove percorsi</a>
      </div>
      <p class="rb-signature">Be Beautiful. Be Rebel.</p>
    </div>
  </section>

  <section class="rb-section rb-section--ivory" id="mappa-rebel-live">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Mappa REBEL</p>
        <h2>Confronta i nove percorsi REBEL.</h2>
      </div>
      <RebelMap client:visible />
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid rb-intro-grid--visual">
      <div>
        <p class="rb-kicker">Dopo la valutazione</p>
        <h2>Obiettivo, trattamenti e calendario in un unico riepilogo.</h2>
      </div>
      <div class="rb-copy">
        <p>Prima di iniziare ti spieghiamo che cosa abbiamo osservato e definiamo insieme l’obiettivo del percorso.</p>
        <p>Ti indichiamo i trattamenti consigliati, le eventuali tecnologie, la frequenza iniziale e quando fare il primo controllo.</p>
      </div>
      <figure class="rb-editorial-media rb-editorial-media--wide">
        <img src={siteAsset("services.method.consultation.mobile")} alt="Cliente e professionista consultano la scheda della valutazione REBEL" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption>Obiettivo, trattamenti, frequenza e controlli spiegati prima di iniziare.</figcaption>
      </figure>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Come funziona</p>
        <h2>Dal colloquio iniziale al mantenimento, in sei fasi.</h2>
      </div>
      <StepStrip items={methodSteps} />
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Cosa valutiamo</p>
        <h2>Le principali esigenze su cui possiamo lavorare, sul viso e sul corpo.</h2>
      </div>
      <figure class="rb-editorial-media rb-editorial-media--skin">
        <img src={siteAsset("services.face.skinTexture.mobile")} alt="Dettaglio ravvicinato della grana naturale della pelle" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption>La valutazione parte da ciò che osserviamo, non da un trattamento scelto in anticipo.</figcaption>
      </figure>
      <ol class="rb-priority-grid">
        {priorities.map((priority, index) => (
          <li><span>{String(index + 1).padStart(2, "0")}</span><strong>{priority}</strong></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">I percorsi Rebel</p>
        <h2>Nove percorsi per il viso, il corpo e l’epilazione progressiva.</h2>
      </div>
      <div class="rb-journey-grid">
        {journeys.map((journey) => (
          <a class="rb-journey-card" href={journey.href}>
            <figure><img src={journey.src} alt={journey.alt} width="1536" height="1024" loading="lazy" decoding="async" /></figure>
            <p class="rb-kicker">{journey.eyebrow}</p>
            <h3>{journey.name}</h3>
            <p>{journey.summary}</p>
            <p>{journey.paths.map((path) => path.slug === "white" ? "Uniformare" : path.name).join(" · ")}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid rb-intro-grid--visual">
      <div>
        <p class="rb-kicker">Trattamenti e tecnologie</p>
        <h2>Scegliamo ciò che serve in base alla zona e al risultato desiderato.</h2>
      </div>
      <div class="rb-copy">
        <p>Per ogni percorso ti spieghiamo che cosa utilizziamo, perché e con quale frequenza programmare gli appuntamenti.</p>
        <p>Ai controlli osserviamo i cambiamenti rispetto all’obiettivo iniziale e aggiorniamo il programma quando necessario.</p>
      </div>
      <figure class="rb-editorial-media rb-editorial-media--wide">
        <img src={siteAsset("services.face.activesTopshot.mobile")} alt="Prodotti e strumenti preparati per un trattamento viso" width="1122" height="1402" loading="lazy" decoding="async" />
        <figcaption>Prodotti, manualità e tecnologie vengono scelti e spiegati prima di iniziare.</figcaption>
      </figure>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Raccontaci che cosa vuoi _migliorare_."
        lead="In 30–40 minuti definiamo quale percorso può essere più adatto, quanto tempo richiede e quanto costa. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/percorsi"
        secondaryLabel="Vedi i nove percorsi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
