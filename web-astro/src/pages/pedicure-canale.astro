---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const m = getPageMedia("/pedicure-canale");

const meta = createPageMeta({
  title: "Pedicure da Canale | REBEL Carmagnola",
  description:
    "Pedicure estetico da 33 € e VIP con scrub da 44 € a Carmagnola per chi arriva da Canale e dal Roero. Disponibile anche con semipermanente.",
  path: "/pedicure-canale",
  image: "https://www.rebelepigenetica.it/img/generated/pedicure-hero.webp",
  openGraphType: "article",
  keywords: [
    "pedicure Canale",
    "pedicure estetico Canale",
    "pedicure semipermanente Canale",
    "pedicure VIP Canale",
    "pedicure estetico Canale",
    "estetista piedi Canale",
    "pedicure con scrub Canale",
    "talloni screpolati Canale",
    "pedicure vicino Canale",
    "pedicure Canale CN",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Pedicure Carmagnola", path: "/servizi/pedicure-carmagnola" },
  { name: "Canale", path: "/pedicure-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Pedicure per chi arriva da Canale",
  description: meta.description,
  path: "/pedicure-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Pedicure per chi arriva da Canale — REBEL Carmagnola",
  description: meta.description,
  path: "/pedicure-canale",
  keywords: ["pedicure Canale", "pedicure estetico Canale", "pedicure semipermanente Canale CN"],
  section: "Estetica classica",
  image: "https://www.rebelepigenetica.it/img/generated/pedicure-hero.webp",
});

const serviceSchema = buildServiceSchema(
  "Pedicure per chi arriva da Canale",
  "Pedicure estetico e VIP con scrub a Carmagnola: rifinitura di unghie, cuticole e pelle, con semipermanente disponibile.",
  "/pedicure-canale",
  {
    priceFrom: 33,
    keywords: ["pedicure Canale", "pedicure estetico Canale CN", "pedicure semipermanente Canale"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/pedicure-canale#service-geo`,
  name: "Pedicure per chi arriva da Canale",
  serviceType: "Pedicure",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7956, longitude: 8.0008 },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "33.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Dove si trova REBEL rispetto a Canale?",
    a: "Lo studio è in Viale Barbaroux 20, a Carmagnola. Apri Google Maps per verificare percorso, traffico e tempi aggiornati.",
  },
  {
    q: "Che differenza c’è tra pedicure estetico e pedicure VIP con scrub?",
    a: "Il pedicure estetico, da 33 €, comprende la rifinitura di unghie, cuticole e pelle. Il pedicure VIP, da 44 €, aggiunge lo scrub.",
  },
  {
    q: "Posso fare il semipermanente anche sui piedi?",
    a: "Sì. Puoi aggiungerlo quando desideri una finitura più duratura. La durata varia in base all’unghia, alla ricrescita e alle abitudini personali.",
  },
  {
    q: "Ho i talloni secchi e screpolati: si può migliorare?",
    a: "Lavoriamo con delicatezza e adattiamo i passaggi alle condizioni osservate. Se sono presenti dolore, lesioni o problemi persistenti, consigliamo di rivolgersi a un podologo o al medico.",
  },
  {
    q: "Posso abbinare pedicure e manicure nella stessa visita?",
    a: "Alcuni servizi possono essere organizzati nella stessa visita. Indica che cosa vuoi abbinare: verifichiamo disponibilità e compatibilità prima di confermare.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/pedicure-canale#speakable`,
  name: "Pedicure per chi arriva da Canale",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/pedicure-canale`,
};

const points = [
  {
    kicker: "01 · Pedicure estetico",
    title: "Rifinitura di unghie, cuticole e pelle.",
    body: "Il pedicure estetico parte da 33 € e comprende i passaggi di rifinitura del piede.",
  },
  {
    kicker: "02 · Pedicure VIP con scrub",
    title: "Il VIP aggiunge lo scrub.",
    body: "Il pedicure VIP parte da 44 € e aggiunge lo scrub ai passaggi di rifinitura.",
  },
  {
    kicker: "03 · Semipermanente piedi",
    title: "Per una finitura più duratura.",
    body: "Il semipermanente può essere aggiunto al pedicure; la durata varia in base all’unghia, alla ricrescita e alle abitudini personali.",
  },
  {
    kicker: "04 · Scelta del servizio",
    title: "Passaggi e prezzo spiegati prima di iniziare.",
    body: "Ti spieghiamo le differenze tra estetico, VIP con scrub e semipermanente prima del trattamento.",
  },
];

const combos = [
  {
    href: "/manicure-semipermanente-canale",
    title: "Pedicure + manicure",
    body: "Se vuoi aggiungere la manicure, verifichiamo disponibilità e compatibilità prima di confermare.",
  },
  {
    href: "/epilazione-laser-canale",
    title: "Pedicure + laser gambe",
    body: "Se vuoi abbinare il laser gambe, verifichiamo zone e compatibilità prima di confermare.",
  },
  {
    href: "/massaggio-rilassante-canale",
    title: "Pedicure + massaggio",
    body: "Se vuoi aggiungere un massaggio, verifichiamo disponibilità e compatibilità prima di confermare.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/pedicure-bra", desc: "Pedicure per chi arriva da Bra." },
  { city: "Alba", href: "/pedicure-alba", desc: "Pedicure per chi arriva da Alba." },
  { city: "Tutte le località", href: "/localita", desc: "Consulta indirizzo, mappa e contatti." },
];
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Pedicure · REBEL Carmagnola"
    title="Pedicure per chi arriva da _Canale_."
    lead="Puoi scegliere il pedicure estetico da 33 €, il pedicure VIP con scrub da 44 € oppure aggiungere il semipermanente."
    bullets={["Pedicure estetico da 33 €", "VIP con scrub da 44 €", "Semipermanente disponibile"]}
    meta={["Studio in Viale Barbaroux 20, Carmagnola", "Unghie, cuticole e pelle"]}
    ctaPrimary={{ label: "Chiedi un appuntamento", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Apri Google Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Pedicure estetico e VIP"
          title="Rifinitura di _unghie, cuticole e pelle_."
          body="Il pedicure estetico comprende la rifinitura; il VIP aggiunge lo scrub. Il semipermanente è disponibile su richiesta."
          bullets={["Pedicure estetico da 33 €", "VIP con scrub da 44 €", "Semipermanente disponibile"]}
          cta={{ label: "Scopri il trattamento", href: "/servizi/pedicure-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il servizio REBEL"
        title="Quale pedicure _scegliere_."
        lead="Prima di iniziare ti spieghiamo passaggi e prezzi di pedicure estetico, VIP con scrub e semipermanente."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard kicker={p.kicker} title={p.title} body={p.body} variant={i === 0 ? "feature" : "default"} index={i + 1} />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Chiedi un appuntamento</a>
        <a class="btn btn--secondary" href="/servizi/pedicure-carmagnola">Scopri il trattamento</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Come arrivare" title="Come raggiungere REBEL da _Canale_." />
      <div class="directions-grid">
        <div>
          <p class="body-p">REBEL si trova in <strong>Viale Barbaroux 20, a Carmagnola</strong>.</p>
          <p class="body-p">Apri Google Maps per verificare percorso, traffico e tempi aggiornati.</p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a class="btn btn--secondary btn--sm" href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" target="_blank" rel="noreferrer">Apri Google Maps</a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="Indicazioni da Canale a REBEL Carmagnola"></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead kicker="Servizi abbinabili" title="Vuoi abbinare un altro _trattamento_?" lead="Indica i servizi che ti interessano: verifichiamo disponibilità e compatibilità prima dell’appuntamento." />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (<FeatureCard title={c.title} body={c.body} href={c.href} variant="quiet" />))}
      </div>
    </div>
  </section>

  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Pedicure a Carmagnola"
      quote="Il pedicure estetico cura la rifinitura; il VIP aggiunge lo scrub."
      cta={{ label: "Chiedi un appuntamento", href: "/contatti" }}
    />
  ) : null}

  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead kicker="Domande frequenti" title="Informazioni utili sul _pedicure_." />
      <FaqAccordion items={faqs} kicker="FAQ Pedicure Canale" />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Altri servizi REBEL"
        title="Trattamenti viso e corpo per chi arriva da _Canale_."
        lead="Consulta i servizi disponibili nello studio REBEL di Carmagnola."
        primaryHref="/localita/canale"
        primaryLabel="Scopri tutti i servizi da Canale"
        secondaryHref="/manicure-semipermanente-canale"
        secondaryLabel="Manicure da Canale"
      />
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead kicker="Altre località" title="Servizi REBEL dalle _zone vicine_." />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (<FeatureCard kicker="Località" title={a.city} body={a.desc} href={a.href} variant="quiet" index={i + 1} />))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prenotazione"
        title="Prenota il _pedicure_."
        lead="Scrivici su WhatsApp per conoscere le disponibilità."
        primaryLabel="Scrivici su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri il trattamento"
        secondaryHref="/servizi/pedicure-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar priceHint="Pedicure da 33 €" primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .section--tight { padding-block: 1.5rem; }
  .directions-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 1.6rem; align-items: start; }
  @media (max-width: 760px) { .directions-grid { grid-template-columns: 1fr; } }
  .map-frame { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r-md); overflow: hidden; border: 1px solid var(--line); background: rgba(7, 5, 14, 0.5); }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .body-p { font-size: var(--t-body); line-height: var(--lh-body); color: var(--text); margin: 0 0 0.9rem; max-width: 70ch; }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
