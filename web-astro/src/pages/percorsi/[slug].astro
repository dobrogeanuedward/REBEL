---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JourneyCarousel from "@/components/JourneyCarousel.astro";
import JourneyPhotoStory from "@/components/JourneyPhotoStory.astro";
import { journeyCarousels } from "@/lib/journey-carousels";
import { journeyPhotographs, photographSchema } from "@/lib/journey-photographs";
import { siteConfig } from "@/lib/site-config";
import LaserOffer from "@/components/LaserOffer.astro";
import { rebelJourneys, type RebelJourney } from "@/lib/rebel-journeys";
import { getJourneyVisual } from "@/lib/journey-visuals";
import { buildBreadcrumbSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";
import { laserOffer } from "@/lib/laser-offer";
import "@/styles/journey-pages.css";

export function getStaticPaths() {
  return rebelJourneys.map((journey) => ({ params: { slug: journey.slug }, props: { journey } }));
}

interface Props { journey: RebelJourney }
const { journey } = Astro.props;
const visual = getJourneyVisual(journey.slug);
const carousel = journeyCarousels[journey.slug];
const photographs = journeyPhotographs.filter(photo => photo.journey === journey.slug);
const editorialHero = carousel ? `/img/film-editorial-v1/${journey.slug}.webp` : undefined;
const displayName = journey.slug === "white" ? "Uniformare · White" : journey.name;
const descriptions: Record<string, string> = {
  "skin-reset": "Skin Reset prepara la pelle ai trattamenti successivi. A Carmagnola, circa 60 minuti, da €69. Scopri come funziona il percorso REBEL.",
  barrier: "Barrier è il percorso REBEL per idratazione, comfort e barriera cutanea. A Carmagnola, circa 60 minuti, da €79.",
  balance: "Balance è il percorso REBEL per pelle lucida, impurità, pori visibili e grana irregolare. A Carmagnola, circa 60 minuti, da €79.",
  glow: "Glow è il percorso viso REBEL dedicato a luminosità, freschezza e uniformità. A Carmagnola, circa 60 minuti, da €89.",
  white: "White è il percorso REBEL per macchie e tono irregolare, con un approccio graduale. A Carmagnola, circa 60 minuti, da €99.",
  structure: "Structure è il percorso viso REBEL per tono, elasticità e compattezza. A Carmagnola, circa 60 minuti, da €109.",
  longevity: "Longevity accompagna nel tempo idratazione, luminosità, tono ed elasticità della pelle. A Carmagnola, sedute da €79.",
  forma: "Forma è il programma corpo REBEL per pesantezza, tono e compattezza. A Carmagnola, sedute da €79.",
  liberta: "Libertà è il percorso di epilazione progressiva REBEL con Lumina X1 Pro e ICE Polar. A Carmagnola, prezzo ordinario da €25,90 a zona.",
};
const meta = createPageMeta({
  title: journey.slug === "liberta"
    ? `${displayName} | Epilazione laser REBEL a Carmagnola`
    : journey.slug === "forma"
      ? `${displayName} | Percorso corpo REBEL a Carmagnola`
      : `${displayName} | Percorso viso REBEL a Carmagnola`,
  description: descriptions[journey.slug] ?? `${journey.summary} ${journey.price}, ${journey.duration}.`,
  path: `/percorsi/${journey.slug}`,
  openGraphType: "article",
  image: editorialHero,
  keywords: [`percorso ${journey.name} Carmagnola`, `${journey.priority.toLowerCase()} pelle`, "Metodo Rebel"],
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const siblings = rebelJourneys
  .filter((item) => item.area === journey.area && item.slug !== journey.slug)
  .slice(0, 4);
const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Percorsi", path: "/percorsi" },
  { name: displayName, path: `/percorsi/${journey.slug}` },
]);
const webPage = buildWebPageSchema({ name: displayName, description: meta.description, path: `/percorsi/${journey.slug}` });
const contactHref = `/contatti?source=percorso&percorso=${encodeURIComponent(journey.slug)}`;
const matterTitle = journey.area === "Viso"
  ? "Attivi e ingredienti scelti per la tua pelle."
  : journey.area === "Corpo"
    ? "Prodotti e ingredienti del percorso."
    : "Cura cosmetica dopo la seduta.";
const matterLead = journey.slug === "liberta"
  ? "Dopo la seduta valutiamo se consigliare un prodotto cosmetico in base alla zona e a come si presenta la pelle."
  : "Attivi e ingredienti vengono scelti dopo la valutazione e possono cambiare in base a ciò che osserviamo durante il percorso.";
const progressTitle = journey.area === "Viso"
  ? "Controlliamo come cambia la pelle tra una seduta e l’altra."
  : journey.area === "Corpo"
    ? "Controlliamo come cambia la zona durante il percorso."
    : "Controlliamo ricrescita e risposta della pelle durante il percorso.";
const progressCopy = journey.area === "Epilazione"
  ? "Durante i controlli aggiorniamo parametri e frequenza in base alla ricrescita osservata e a come risponde la pelle."
  : "Durante i controlli aggiorniamo prodotti, intensità o frequenza in base ai cambiamenti osservati.";
const siblingAreaLabel = journey.area === "Viso" ? "per il viso" : journey.area === "Corpo" ? "per il corpo" : "di epilazione";
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={{ ...webPage, ...(editorialHero ? { primaryImageOfPage: new URL(editorialHero, siteConfig.siteUrl).href } : {}), ...(photographs.length ? { image: photographs.map(photographSchema) } : {}) }} />
  {carousel && <JsonLd data={{ "@context": "https://schema.org", "@type": "Service", "@id": `${siteConfig.siteUrl}/percorsi/${journey.slug}#service`, name: journey.name, description: journey.summary, url: `${siteConfig.siteUrl}/percorsi/${journey.slug}`, provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` }, areaServed: { "@type": "City", name: "Carmagnola" }, image: photographs.map(photographSchema) }} />}

  <main class:list={["journey-page", { "journey-page--editorial": carousel }]} data-world={journey.world}>
    <section class="journey-hero">
      <div class="journey-hero__media">
        <picture>
          <img src={editorialHero ?? siteAsset(visual.momentSlot)} alt={journey.slug === "barrier" ? "Applicazione di una crema viso con un pennello" : visual.momentAlt} width="1536" height="1024" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <div class="journey-hero__veil" aria-hidden="true"></div>
      <div class="rebel-container journey-hero__content">
        <div class="journey-hero__meta"><span>Percorso {journey.number} / 09</span><span>{journey.area}</span></div>
        <h1><small>{journey.priority}</small>{journey.name}</h1>
        <div class="journey-hero__bottom">
          <p class="journey-hero__summary">{journey.summary}</p>
          <div class="journey-price">
            {journey.slug === "liberta" ? <small class="journey-price__label">Listino ordinario</small> : null}
            <span>{journey.price}</span><small>{journey.duration}</small>
          </div>
        </div>
      </div>
    </section>

    {carousel && <JourneyCarousel carousel={carousel} slug={journey.slug} />}

    {journey.slug === "liberta" ? (
      <section class="rebel-section rebel-section--laser-offer">
        <div class="rebel-container"><LaserOffer compact /></div>
      </section>
    ) : null}

    <section class="rebel-section">
      <div class="rebel-container journey-recognition">
        <div class="journey-recognition__label">
          <p class="rebel-kicker">Per chi è pensato</p>
          <strong>{journey.priority}</strong>
        </div>
        <div class="journey-recognition__copy">
          <article class="journey-recognition__card"><small>Quando valutarlo</small><p>{journey.recognize}</p></article>
          <article class="journey-recognition__card"><small>Obiettivo del percorso</small><p>{journey.objective}</p></article>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">Come funziona</p>
        <h2 class="rebel-title">Il percorso, passo dopo passo.</h2>
        <div class="journey-story">
          {journey.chapters.map((chapter) => <article><small>{chapter.eyebrow}</small><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}
        </div>
        {photographs.length ? <JourneyPhotoStory photographs={photographs} /> : <figure class="journey-moment">
          <picture>
            <source media="(max-width:720px)" srcset={siteAsset(journey.heroMobileSlot)} />
            <img src={siteAsset(journey.heroDesktopSlot)} alt={journey.heroAlt} width="1536" height="1024" loading="lazy" decoding="async" />
          </picture>
          <figcaption>
            <small>Durante il percorso</small>
            <strong>{progressTitle}</strong>
            <span>{progressCopy}</span>
          </figcaption>
        </figure>}
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container journey-matter">
        <div class="journey-matter__side">
          <div class="journey-matter__intro">
            <p class="rebel-kicker">Attivi e botaniche</p>
            <h2 class="rebel-title">{matterTitle}</h2>
            <p>{matterLead}</p>
          </div>
        </div>
        <div class="journey-matter__groups">
          <section class="journey-matter__group"><h3>Attivi e complessi cosmetici</h3><ul class="journey-matter__list">{journey.actives.map((item) => <li><strong>{item.name}</strong><span>{item.role}</span></li>)}</ul></section>
          <section class="journey-matter__group journey-matter__group--botanical">
            <div class="journey-matter__botanical-copy">
              <h3>Estratti vegetali e altri ingredienti</h3>
              <ul class="journey-matter__list">{journey.botanicals.map((item) => <li><strong>{item.name}</strong><span>{item.role}</span></li>)}</ul>
            </div>
            <figure class="journey-matter__cutout">
              <img src={visual.botanicalSrc} alt={visual.botanicalAlt} width="1000" height="1000" loading="lazy" decoding="async" />
            </figure>
          </section>
        </div>
      </div>
    </section>

    {journey.technologies.length > 0 ? (
      <section class="rebel-section rebel-section--paper">
        <div class="rebel-container">
          <div class="journey-tech">
            <div><p class="rebel-kicker">Tecnologie nel percorso</p><h2 class="rebel-title">{journey.slug === "liberta" ? "La tecnologia del percorso Libertà." : "Scegliamo la tecnologia in base alla zona e all’obiettivo."}</h2><p>{journey.technologyNote}</p><a class="btn btn--primary" href="/tecnologie-rebel">Scopri le tecnologie REBEL</a></div>
            <div class="journey-tech__stage">
              {visual.technologyVisuals.length > 0 ? (
                <div class="journey-tech__visuals">
                  {visual.technologyVisuals.map((item) => <figure><img src={siteAsset(item.slot)} alt={item.alt} width="1024" height="1024" loading="lazy" decoding="async" /><figcaption>{item.name}</figcaption></figure>)}
                </div>
              ) : null}
              <ul class="journey-tech__list">{journey.technologies.map((technology) => <li>{technology}</li>)}</ul>
            </div>
          </div>
        </div>
      </section>
    ) : null}

    <section class="rebel-section">
      <div class="rebel-container journey-recognition">
        <div class="journey-recognition__label"><p class="rebel-kicker">Durata e prezzo</p><strong>{journey.price}</strong></div>
        <div class="journey-recognition__copy">
          <article class="journey-recognition__card"><small>Durata indicativa</small><p>{journey.duration}</p></article>
          <article class="journey-recognition__card"><small>Come viene definito il prezzo</small><p>{journey.priceNote}</p></article>
          <a class="btn btn--primary" href={contactHref}>Prenota la valutazione REBEL</a>
        </div>
      </div>
    </section>

    {siblings.length > 0 ? <section class="rebel-section rebel-section--paper"><div class="rebel-container"><p class="rebel-kicker">Altri percorsi</p><h2 class="rebel-title">Altri percorsi {siblingAreaLabel}.</h2><div class="journey-siblings">{siblings.map((sibling) => <a href={`/percorsi/${sibling.slug}`}><span>{sibling.slug === "white" ? "Uniformare · White" : `${sibling.priority} · ${sibling.name}`}</span><span>→</span></a>)}</div></div></section> : null}
  </main>

  <StickyBookingBar
    priceHint={journey.slug === "liberta" ? laserOffer.stickyLabel : undefined}
    promo={journey.slug === "liberta"}
    primary={journey.slug === "liberta"
      ? { label: "Richiedi la promo", href: laserOffer.contactPath }
      : { label: "Prenota la valutazione", href: contactHref }}
  />
</BaseLayout>
