---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import { rebelJourneys, getJourneysByWorld, type RebelJourney } from "@/lib/rebel-journeys";
import { buildBreadcrumbSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";
import "@/styles/journey-pages.css";

export function getStaticPaths() {
  return rebelJourneys.map((journey) => ({ params: { slug: journey.slug }, props: { journey } }));
}

interface Props { journey: RebelJourney }
const { journey } = Astro.props;
const titleName = journey.slug === "white" ? "Uniformare · White" : `${journey.priority} · ${journey.name}`;
const meta = createPageMeta({
  title: `${titleName} — Percorso REBEL a Carmagnola`,
  description: `${journey.summary} ${journey.price}, ${journey.duration}. Scopri attivi, botaniche e tecnologie selezionabili.`,
  path: `/percorsi/${journey.slug}`,
  openGraphType: "article",
  keywords: [`percorso ${journey.name} Carmagnola`, `${journey.priority.toLowerCase()} pelle`, "Metodo Rebel"],
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const siblings = getJourneysByWorld(journey.world).filter((item) => item.slug !== journey.slug);
const worldLabel = journey.world === "liberta" ? "Libertà" : journey.world[0].toUpperCase() + journey.world.slice(1);
const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Percorsi", path: "/percorsi" },
  { name: journey.name, path: `/percorsi/${journey.slug}` },
]);
const webPage = buildWebPageSchema({ name: `${journey.priority} · ${journey.name}`, description: meta.description, path: `/percorsi/${journey.slug}` });
const contactHref = `/contatti?source=percorso&percorso=${encodeURIComponent(journey.slug)}`;
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />

  <main class="journey-page" data-world={journey.world}>
    <section class="journey-hero">
      <div class="journey-hero__media">
        <picture>
          <source media="(max-width:720px)" srcset={siteAsset(journey.heroMobileSlot)} />
          <img src={siteAsset(journey.heroDesktopSlot)} alt={journey.heroAlt} width="1536" height="1024" fetchpriority="high" decoding="async" />
        </picture>
      </div>
      <div class="journey-hero__veil" aria-hidden="true"></div>
      <div class="rebel-container journey-hero__content">
        <div class="journey-hero__meta"><span>Percorso {journey.number} / 09</span><span>{journey.area}</span><span>Mondo {worldLabel}</span></div>
        <h1><small>{journey.slug === "white" ? journey.name : journey.priority}</small>{journey.slug === "white" ? "Uniformare" : journey.name}</h1>
        <div class="journey-hero__bottom">
          <p class="journey-hero__summary">{journey.slug === "white" ? `White è il nome del percorso. ${journey.summary}` : journey.summary}</p>
          <div class="journey-price"><span>{journey.price}</span><small>{journey.duration}</small></div>
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container journey-recognition">
        <div class="journey-recognition__label">
          <p class="rebel-kicker">Priorità {journey.number}</p>
          <strong>{journey.priority}</strong>
        </div>
        <div class="journey-recognition__copy">
          <article class="journey-recognition__card"><small>Ti riconosci quando</small><p>{journey.recognize}</p></article>
          <article class="journey-recognition__card"><small>Obiettivo del percorso</small><p>{journey.objective}</p></article>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <p class="rebel-kicker">La narrazione del percorso</p>
        <h2 class="rebel-title">Dalla priorità alla continuità.</h2>
        <div class="journey-story">
          {journey.chapters.map((chapter) => <article><small>{chapter.eyebrow}</small><h3>{chapter.title}</h3><p>{chapter.body}</p></article>)}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container journey-matter">
        <div class="journey-matter__intro">
          <p class="rebel-kicker">Materia REBEL</p>
          <h2 class="rebel-title">Attivi e botaniche, con un ruolo preciso.</h2>
          <p>Le combinazioni descrivono le possibilità del percorso. La selezione finale viene definita dalla professionista dopo la valutazione e può cambiare da una seduta all’altra.</p>
        </div>
        <div class="journey-matter__groups">
          <section class="journey-matter__group"><h3>Attivi e complessi</h3><ul class="journey-matter__list">{journey.actives.map((item) => <li><strong>{item.name}</strong><span>{item.role}</span></li>)}</ul></section>
          <section class="journey-matter__group"><h3>Botaniche</h3><ul class="journey-matter__list">{journey.botanicals.map((item) => <li><strong>{item.name}</strong><span>{item.role}</span></li>)}</ul></section>
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper">
      <div class="rebel-container">
        <div class="journey-tech">
          <div><p class="rebel-kicker">Tecnologie nel percorso</p><h2 class="rebel-title">Selezionabili. Mai automatiche.</h2><p>{journey.technologyNote}</p><a class="btn btn--primary" href="/tecnologie-rebel">Esplora le tecnologie REBEL</a></div>
          {journey.technologies.length > 0 ? <ul class="journey-tech__list">{journey.technologies.map((technology) => <li>{technology}</li>)}</ul> : <div class="journey-tech__empty">La Mappa REBEL lascia volutamente aperta la voce “tecnologie” fino alla valutazione in studio.</div>}
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container journey-recognition">
        <div class="journey-recognition__label"><p class="rebel-kicker">Durata e prezzo</p><strong>{journey.price}</strong></div>
        <div class="journey-recognition__copy">
          <article class="journey-recognition__card"><small>Durata indicativa</small><p>{journey.duration}</p></article>
          <article class="journey-recognition__card"><small>Come si definisce il prezzo</small><p>{journey.priceNote}</p></article>
          <a class="btn btn--primary" href={contactHref}>Prenota la valutazione REBEL</a>
        </div>
      </div>
    </section>

    {siblings.length > 0 ? <section class="rebel-section rebel-section--paper"><div class="rebel-container"><p class="rebel-kicker">Nello stesso mondo</p><h2 class="rebel-title">Continua a esplorare.</h2><div class="journey-siblings">{siblings.map((sibling) => <a href={`/percorsi/${sibling.slug}`}><span>{sibling.priority} · {sibling.slug === "white" ? "Uniformare" : sibling.name}</span><span>→</span></a>)}</div></div></section> : null}
  </main>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: contactHref }} />
</BaseLayout>
