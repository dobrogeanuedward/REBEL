---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import { rebelJourneys } from "@/lib/rebel-journeys";
import { journeyCarousels } from "@/lib/journey-carousels";
import { getJourneyVisual } from "@/lib/journey-visuals";
import { buildBreadcrumbSchema, buildItemListSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";
import "@/styles/journey-pages.css";

const meta = createPageMeta({
  title: "I 9 Percorsi REBEL — Viso, corpo ed epilazione a Carmagnola",
  description: "Scopri Skin Reset, Barrier, Balance, Glow, White, Structure, Longevity, Forma e Libertà: esigenze, durata, prezzi e cosa può includere ogni percorso.",
  path: "/percorsi",
  openGraphType: "article",
  keywords: ["percorsi viso Carmagnola", "trattamenti corpo Carmagnola", "Metodo Rebel", "prezzi trattamenti viso"],
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }, { name: "Percorsi", path: "/percorsi" }]);
const webPage = buildWebPageSchema({ name: "I nove percorsi REBEL", description: meta.description, path: "/percorsi" });
const itemList = buildItemListSchema({
  name: "Percorsi REBEL",
  path: "/percorsi",
  items: rebelJourneys.map((journey) => ({ name: journey.slug === "white" ? "Uniformare · White" : journey.name, path: `/percorsi/${journey.slug}` })),
});
const journeyAreas = [
  {
    id: "viso",
    name: "Viso",
    eyebrow: "Pelle del viso",
    summary: "Percorsi per pulizia, idratazione, impurità, luminosità, macchie, tono ed elasticità.",
    href: "#tutti-i-percorsi",
    heroSlot: "home.hero.face.desktop",
    paths: rebelJourneys.filter((journey) => journey.area === "Viso"),
  },
  {
    id: "corpo",
    name: "Corpo",
    eyebrow: "Trattamenti corpo",
    summary: "Percorsi per leggerezza, tono e compattezza, definiti in base alle tue esigenze.",
    href: "#tutti-i-percorsi",
    heroSlot: "home.hero.body.desktop",
    paths: rebelJourneys.filter((journey) => journey.area === "Corpo"),
  },
  {
    id: "laser",
    name: "Laser",
    eyebrow: "Epilazione progressiva",
    summary: "Epilazione con Lumina X1 Pro e raffreddamento a contatto ICE Polar.",
    href: "/percorsi/liberta",
    heroSlot: "home.hero.laser.desktop",
    paths: rebelJourneys.filter((journey) => journey.area === "Epilazione"),
  },
] as const;
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand journey-hub">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={itemList} />

  <main>
    <section class="journey-hub__hero">
      <div class="rebel-container journey-hub__intro">
        <p class="rebel-kicker">Viso · corpo · laser</p>
        <h1 class="rebel-display">Tre aree.<br/>Nove percorsi.</h1>
        <p class="rebel-lead">Scegli l’area e l’esigenza da cui vuoi partire. Per ogni percorso trovi a chi è rivolto, cosa può includere, durata e prezzo di partenza.</p>
        <div class="rebel-hero__actions">
          <a class="btn btn--primary" href="/#mappa-rebel-live">Scopri da dove partire</a>
          <a class="btn btn--secondary" href="/contatti">Prenota la valutazione</a>
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container">
        <p class="rebel-kicker">Le tre aree</p>
        <h2 class="rebel-title">Scegli l’esigenza su cui vuoi lavorare.</h2>
        <div class="journey-worlds">
          {journeyAreas.map((area) => {
            return (
              <a id={area.id} class="journey-world" href={area.href} style={`--world-image:url('${siteAsset(area.heroSlot)}')`}>
                <div class="journey-world__copy">
                  <p class="rebel-kicker">{area.eyebrow}</p>
                  <h2>{area.name}</h2>
                  <p>{area.summary}</p>
                  <div class="journey-world__paths">{area.paths.map((path) => <span>{path.priority} · {path.name}</span>)}</div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper" id="tutti-i-percorsi">
      <div class="rebel-container">
        <p class="rebel-kicker">Tutti i percorsi</p>
        <h2 class="rebel-title">Confronta i nove percorsi REBEL.</h2>
        <p class="rebel-lead">I prezzi indicati sono di partenza. Prima di iniziare ti confermiamo trattamento, durata, prezzo ed eventuali tecnologie.</p>
        <div class="journey-index">
          {rebelJourneys.map((journey) => {
            const visual = getJourneyVisual(journey.slug);
            const editorial = journeyCarousels[journey.slug];
            return (
              <a class:list={["journey-index__card", { "journey-index__card--editorial": editorial }]} href={`/percorsi/${journey.slug}`} aria-label={editorial ? `${journey.name}: ${journey.summary} ${journey.price}, ${journey.duration}. Scopri il percorso.` : undefined}>
                {editorial ? <>
                  <figure class="journey-index__cover"><img src={editorial.slides[0].src} srcset={`${editorial.slides[0].preview} 640w, ${editorial.slides[0].src} 1080w`} sizes="(max-width:720px) 94vw, (max-width:980px) 46vw, 32vw" alt={`Copertina della guida ${journey.name}`} width="1080" height="1350" loading="lazy" decoding="async" /></figure>
                  <div class="journey-index__editorial-footer"><h3>Scopri {journey.name} <span aria-hidden="true">↗</span></h3><p><strong>{journey.price}</strong><span>{journey.duration}</span></p></div>
                </> : <>
                <figure class="journey-index__moment">
                  <img src={siteAsset(visual.momentSlot)} alt={visual.momentAlt} width="1200" height="800" loading="lazy" decoding="async" />
                </figure>
                <div class="journey-index__content">
                  <div class="journey-index__top"><span>{journey.number}</span><span>{journey.area}</span></div>
                  <h3>{journey.slug === "white" ? "Uniformare · White" : journey.name}</h3>
                  <p>{journey.summary}</p>
                </div>
                <div class="journey-index__ingredients">
                  <img src={visual.botanicalSrc} alt="" width="1000" height="1000" loading="lazy" decoding="async" aria-hidden="true" />
                  <p>
                    <small>Ingredienti del percorso</small>
                    <span>{[...journey.actives.slice(0, 2), ...journey.botanicals.slice(0, 2)].map((item) => item.name).join(" · ")}</span>
                  </p>
                </div>
                <div class="journey-index__price"><span>{journey.price}</span><small>{journey.duration}</small></div>
                </>}
              </a>
            );
          })}
        </div>
      </div>
    </section>

    <section class="rebel-campaign">
      <div class="rebel-container">
        <strong>Non sai da quale percorso partire?<br/><span>Ne parliamo durante la valutazione.</span></strong>
        <p>In studio partiamo dalla tua esigenza e ti spieghiamo cosa consigliamo, con tempi e prezzo.</p>
        <div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la valutazione REBEL</a></div>
      </div>
    </section>
  </main>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
