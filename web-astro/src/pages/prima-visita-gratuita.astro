---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Valutazione e analisi REBEL a Carmagnola | 30–40 minuti",
  description:
    "Prenota la valutazione REBEL a Carmagnola: 30–40 minuti per leggere pelle, zona e priorità e costruire una proposta chiara. Gratuita quando finalizzata al Percorso REBEL; home care separata.",
  path: "/prima-visita-gratuita",
  keywords: [
    "valutazione estetica Carmagnola",
    "analisi pelle Carmagnola",
    "prima visita Rebel Carmagnola",
    "Percorso Rebel Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Valutazione REBEL", path: "/prima-visita-gratuita" },
]);

const evaluationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Valutazione e analisi REBEL",
  description:
    "Valutazione di 30–40 minuti per leggere pelle, zona e priorità e costruire il Percorso REBEL. Gratuita quando finalizzata alla costruzione del Percorso; home care separata.",
  url: `${siteConfig.siteUrl}/prima-visita-gratuita`,
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
};

const faqs = [
  {
    q: "Quando la valutazione REBEL è gratuita?",
    a: "Valutazione e analisi sono gratuite quando vengono finalizzate alla costruzione del Percorso REBEL. Prima di iniziare chiarifichiamo sempre che cosa comprende la proposta.",
  },
  {
    q: "Cosa succede nei 30–40 minuti?",
    a: "Ascoltiamo il tuo obiettivo, leggiamo pelle o zona e definiamo priorità, tecnologie, frequenza e prezzo del possibile Percorso REBEL.",
  },
  {
    q: "L’home care è inclusa?",
    a: "No. L’home care eventualmente consigliata è separata dalla valutazione e dal prezzo del Percorso, e viene sempre indicata con chiarezza.",
  },
  {
    q: "Quando posso venire?",
    a: "Dal martedì al sabato su appuntamento. Lunedì e domenica chiusi. Mercoledì apriamo solo dalle 14. Ti scriviamo entro poche ore con un orario disponibile.",
  },
  {
    q: "Dove vi trovo a Carmagnola?",
    a: "In Viale Barbaroux 20, a Carmagnola (TO). Zona facile da raggiungere e parcheggio nelle vicinanze.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--prima-visita"
  ctaHref="#form"
  ctaLabel="Prenota la valutazione"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={evaluationSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    badge="Valutazione · 30–40 minuti"
    kicker="Centro estetico · Carmagnola"
    title="Una valutazione per costruire il _Percorso REBEL_."
    lead="In 30–40 minuti leggiamo pelle, zona e priorità e definiamo una proposta con tecnologie, frequenza e prezzo. La valutazione è gratuita quando viene finalizzata alla costruzione del Percorso REBEL."
    bullets={[
      { text: "Valutazione e analisi di 30–40 minuti." },
      { text: "Priorità, percorso, frequenza e prezzo messi in chiaro." },
      { text: "Gratuita quando finalizzata alla costruzione del Percorso." },
      { text: "Home care eventualmente consigliata, sempre separata." },
    ]}
    primaryCta={{ label: "Prenota la valutazione", href: "#form" }}
    secondaryCta={{
      label: "Scrivici su WhatsApp",
      href: siteConfig.social.whatsapp,
      external: true,
    }}
    footnote="Ti rispondiamo entro poche ore negli orari di apertura (Mar–Sab)."
  />

  <LandingProof
    kicker="Perché Rebel"
    items={[
      {
        title: "Studio nuovo",
        body: "Aperti a ottobre, in Viale Barbaroux 20. Quattro cabine, attrezzatura nuova, ordine vero.",
      },
      {
        title: "Tecnologia Thory",
        body: "Lumina X1 Pro di THORY integra quattro lunghezze d’onda. Il comfort ICE Polar accompagna la seduta; la valutazione definisce se e come usarlo.",
      },
      {
        title: "Linee professionali",
        body: "Marbellas (epigenetica), Eberlin (biocosmetica), RBL Nails. Niente improvvisazione.",
      },
      {
        title: "Listino sempre online",
        body: "Prezzi pubblicati per ogni servizio. Niente preventivi opachi né telefonate \"per sapere quanto costa\".",
      },
    ]}
  />

  <LandingSteps
    kicker="Come funziona"
    title="Quattro passaggi, niente di complicato."
    steps={[
      {
        title: "Compila il form qui sotto",
        body: "Bastano nome e numero. Se vuoi, dicci già cosa ti interesserebbe fare.",
      },
      {
        title: "Ti ricontattiamo entro poche ore",
        body: "Via WhatsApp o telefono, con un orario disponibile. Mai email automatiche fredde.",
      },
      {
        title: "Vieni in studio per 30–40 minuti",
        body: "Leggiamo pelle o zona, ascoltiamo la priorità e costruiamo una proposta chiara con tempi e prezzi.",
      },
      {
        title: "Costruiamo il Percorso",
        body: "Se la valutazione viene finalizzata al Percorso REBEL è gratuita. L’home care eventualmente consigliata resta separata.",
      },
    ]}
  />

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="center"
    kicker="Da Rebel, a Carmagnola"
    quote="Trenta–quaranta minuti per dare a ogni scelta una _direzione_."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Form valutazione"
    title="Prenota la valutazione."
    lead="Solo nome e telefono. Email e dettagli sono opzionali — possiamo sentirci anche su WhatsApp."
    source="landing-prima-visita"
    submitLabel="Prenota la valutazione"
    showRitual={false}
    showMessage={true}
  />

  <LandingFaq items={faqs} />
</LandingLayout>
