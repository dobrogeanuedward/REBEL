---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import EvaluationStory from "@/components/EvaluationStory.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Valutazione e analisi REBEL a Carmagnola | 30–40 minuti",
  description:
    "Prenota la valutazione REBEL a Carmagnola: 30–40 minuti per parlare del risultato desiderato e conoscere trattamenti, frequenza e prezzi.",
  path: "/prima-visita-gratuita",
  keywords: [
    "valutazione estetica Carmagnola",
    "analisi pelle Carmagnola",
    "Percorso Rebel Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Valutazione REBEL", path: "/prima-visita-gratuita" },
]);

const evaluationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Valutazione e analisi REBEL",
  description:
    "Valutazione di 30–40 minuti per parlare del risultato desiderato, osservare la pelle o l’area da trattare e definire il Percorso REBEL.",
  url: `${siteConfig.siteUrl}/prima-visita-gratuita`,
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
};

const faqs = [
  {
    q: "Quando la valutazione REBEL è gratuita?",
    a: "Se al termine scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Prima di iniziare ti spieghiamo sempre che cosa comprende il trattamento.",
  },
  {
    q: "Cosa succede nei 30–40 minuti?",
    a: "Parliamo del risultato che desideri, osserviamo la pelle o l’area da trattare e definiamo trattamenti, eventuali tecnologie, frequenza e prezzo.",
  },
  {
    q: "I prodotti da usare a casa sono inclusi?",
    a: "No. Gli eventuali prodotti consigliati per casa non sono inclusi nella valutazione né nel prezzo del Percorso e vengono sempre indicati con chiarezza.",
  },
  {
    q: "Quando posso venire?",
    a: "Riceviamo dal martedì al sabato su appuntamento; il mercoledì dalle 14. Ti contattiamo via WhatsApp o telefono per concordare un orario disponibile.",
  },
  {
    q: "Dove vi trovo a Carmagnola?",
    a: "In Viale Barbaroux 20, a Carmagnola (TO). Nella pagina Contatti trovi la mappa e le indicazioni per raggiungerci.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand page-prima-visita">
 <JsonLd data={breadcrumb} /><JsonLd data={evaluationSchema} /><JsonLd data={faqSchema} />
 <PageHero image={media.method.hero} imageCaption="Il momento della valutazione, illustrato." kicker="Valutazione REBEL · Carmagnola" title="Il tuo percorso. _Comincia da te_." lead="Trenta–quaranta minuti per ascoltarti, osservare la pelle e scegliere insieme come iniziare." bullets={["Trattamenti, frequenza e prezzo spiegati prima di iniziare", "Valutazione iniziale gratuita se scegli il percorso proposto", "Eventuali prodotti per casa non inclusi"]} ctaPrimary={{label:"Chiedi una valutazione",href:"#form"}} ctaSecondary={{label:"Scrivici su WhatsApp",href:siteConfig.social.whatsapp}} meta={["Viale Barbaroux 20 · Carmagnola","Su appuntamento · Mar–sab"]} />
 <EvaluationStory />
 <LandingFormCard kicker="Il primo passo" title="Parliamo del tuo prossimo momento REBEL." lead="Lascia nome e telefono: ti ricontattiamo per concordare un appuntamento. Email e dettagli sono opzionali." source="landing-prima-visita" submitLabel="Richiedi la valutazione" showRitual={false} showMessage={true} />
 <section class="section"><div class="container container--narrow"><p class="kicker">Prima di venire</p><h2 class="section__title">Le informazioni che cerchi.</h2><FaqAccordion items={faqs} kicker="La valutazione REBEL" /></div></section>
 <StickyBookingBar primary={{label:"Richiedi la valutazione",href:"#form"}} />
</BaseLayout>
