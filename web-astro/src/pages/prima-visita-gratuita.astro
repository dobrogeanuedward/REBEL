---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Valutazione e analisi REBEL a Carmagnola | 30–40 minuti",
  description:
    "Prenota la valutazione REBEL a Carmagnola: 30–40 minuti per parlare del risultato desiderato e conoscere trattamenti, frequenza e prezzi.",
  path: "/prima-visita-gratuita",
  keywords: [
    "valutazione estetica Carmagnola",
    "analisi pelle Carmagnola",
    "Percorso Rebel Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Valutazione REBEL", path: "/prima-visita-gratuita" },
]);

const evaluationSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Valutazione e analisi REBEL",
  description:
    "Valutazione di 30–40 minuti per parlare del risultato desiderato, osservare la pelle o l’area da trattare e definire il Percorso REBEL.",
  url: `${siteConfig.siteUrl}/prima-visita-gratuita`,
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
};

const faqs = [
  {
    q: "Quando la valutazione REBEL è gratuita?",
    a: "Se al termine scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Prima di iniziare ti spieghiamo sempre che cosa comprende il trattamento.",
  },
  {
    q: "Cosa succede nei 30–40 minuti?",
    a: "Parliamo del risultato che desideri, osserviamo la pelle o l’area da trattare e definiamo trattamenti, eventuali tecnologie, frequenza e prezzo.",
  },
  {
    q: "I prodotti da usare a casa sono inclusi?",
    a: "No. Gli eventuali prodotti consigliati per casa non sono inclusi nella valutazione né nel prezzo del Percorso e vengono sempre indicati con chiarezza.",
  },
  {
    q: "Quando posso venire?",
    a: "Riceviamo dal martedì al sabato su appuntamento; il mercoledì dalle 14. Ti contattiamo via WhatsApp o telefono per concordare un orario disponibile.",
  },
  {
    q: "Dove vi trovo a Carmagnola?",
    a: "In Viale Barbaroux 20, a Carmagnola (TO). Nella pagina Contatti trovi la mappa e le indicazioni per raggiungerci.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--prima-visita"
  ctaHref="#form"
  ctaLabel="Prenota la valutazione"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={evaluationSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    media={media.method.hero}
    badge="Valutazione · 30–40 minuti"
    kicker="Centro estetico · Carmagnola"
    title="Una valutazione per scegliere il _Percorso REBEL_."
    lead="In 30–40 minuti parliamo del risultato che desideri, osserviamo la pelle o la zona da trattare e ti spieghiamo trattamenti, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita."
    bullets={[
      { text: "Valutazione e analisi di 30–40 minuti." },
      { text: "Trattamenti, frequenza e prezzo spiegati prima di iniziare." },
      { text: "Gratuita se scegli di iniziare il percorso proposto." },
      { text: "Eventuali prodotti per casa non inclusi." },
    ]}
    primaryCta={{ label: "Prenota la valutazione", href: "#form" }}
    secondaryCta={{
      label: "Scrivici su WhatsApp",
      href: siteConfig.social.whatsapp,
      external: true,
    }}
    footnote="Ti contattiamo personalmente negli orari di apertura (mar–sab)."
  />

  <LandingProof
    kicker="Perché Rebel"
    items={[
      {
        title: "Uno studio a Carmagnola",
        body: "Quattro cabine, una postazione manicure e tecnologie professionali in Viale Barbaroux 20.",
      },
      {
        title: "Tecnologia Thory",
        body: "Lumina X1 Pro di THORY integra quattro lunghezze d’onda. Durante l’epilazione, ICE Polar raffredda la pelle a contatto; parametri e zone vengono definiti dopo la valutazione.",
      },
      {
        title: "Linee professionali",
        body: "Utilizziamo Marbellas, Eberlin e RBL Nails nei trattamenti viso, corpo e manicure.",
      },
      {
        title: "Listino sempre online",
        body: "Puoi consultare online il prezzo di ogni servizio prima di contattarci.",
      },
    ]}
  />

  <LandingSteps
    kicker="Come funziona"
    title="La valutazione in quattro passaggi."
    steps={[
      {
        title: "Lascia i tuoi recapiti",
        body: "Bastano nome e numero. Se vuoi, dicci già cosa ti interesserebbe fare.",
      },
      {
        title: "Concordiamo l’appuntamento",
        body: "Ti contattiamo personalmente via WhatsApp o telefono con un orario disponibile.",
      },
      {
        title: "Vieni in studio per 30–40 minuti",
        body: "Parliamo del risultato che desideri, osserviamo la pelle o l’area da trattare e ti spieghiamo trattamenti, tempi e prezzi.",
      },
      {
        title: "Decidi se iniziare",
        body: "Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.",
      },
    ]}
  />

  <FullBleedBand
    image={media.studio.reception}
    height="sm"
    align="center"
    kicker="Da REBEL · Carmagnola"
    quote="Trenta–quaranta minuti per capire insieme _come iniziare_."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Richiedi un appuntamento"
    title="Prenota la valutazione."
    lead="Solo nome e telefono. Email e dettagli sono opzionali — possiamo sentirci anche su WhatsApp."
    source="landing-prima-visita"
    submitLabel="Prenota la valutazione"
    showRitual={false}
    showMessage={true}
  />

  <LandingFaq items={faqs} />
</LandingLayout>
