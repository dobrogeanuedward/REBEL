---
import LaserCampaignLinks from "@/components/LaserCampaignLinks.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import { buildLaserCampaignSchema, campaignWhatsApp } from "@/lib/laser-campaign";
import "@/styles/laser-campaign.css";
import LaserCampaignFilm from "@/components/LaserCampaignFilm.astro";
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { laserOffer, laserOfferContactMessage } from "@/lib/laser-offer";

const meta = createPageMeta({
  title: `Promo epilazione laser Carmagnola — ${laserOffer.zone.price} a zona | REBEL`,
  description:
    `Promo epilazione laser REBEL a Carmagnola: ${laserOffer.zone.price} per zona, per seduta, e Total Body ${laserOffer.totalBody.price} per ${laserOffer.totalBody.detail}, per seduta. Lumina X1 Pro con ICE Polar.`,
  path: laserOffer.landingPath,
  keywords: [
    "promo epilazione laser Carmagnola",
    "offerta laser Carmagnola",
    "promo laser zona Carmagnola",
    "total body laser Carmagnola",
    "ICE Polar Carmagnola",
  ],
  indexable: true,
  image: media.laser.hero.src,
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Promo epilazione laser", path: laserOffer.landingPath },
]);

const serviceSchema = buildLaserCampaignSchema(laserOffer.landingPath);

const faqs = [
  {
    q: "Quali sono i prezzi della promo laser?",
    a: `La promo prevede ${laserOffer.zone.price} per zona, per seduta, oppure Total Body a ${laserOffer.totalBody.price} per ${laserOffer.totalBody.detail}, per seduta. ${laserOffer.validity.label}`,
  },
  {
    q: "Quali zone comprende il Total Body?",
    a: `Il Total Body comprende ${laserOffer.totalBody.detail} per seduta. Le zone da trattare vengono concordate e confermate prima di iniziare, in base alle tue esigenze e a quanto emerge dalla valutazione iniziale.`,
  },
  {
    q: "Come vengono conteggiate le zone?",
    a: laserOffer.zoneCounting.note,
  },
  {
    q: "La promo sostituisce il listino ordinario?",
    a: "No. È un’offerta separata dal listino ordinario del Percorso Libertà. Prima di iniziare ti confermiamo zone, calendario, condizioni della promo e prezzo.",
  },
  {
    q: "Quando posso usare PagoDIL?",
    a: laserOffer.financing.faq,
  },
  {
    q: "Come capisco se l’epilazione laser è adatta a me?",
    a: "Durante la valutazione iniziale osserviamo pelle, fototipo, caratteristiche del pelo e zone. Ti spieghiamo come impostare parametri e calendario prima della prima seduta.",
  },
  {
    q: "Quante sedute servono?",
    a: "Il numero varia in base alla zona, alla pelle, alle caratteristiche del pelo e all’andamento osservato durante il percorso. Dopo la valutazione ti diamo una prima indicazione e la aggiorniamo durante i controlli.",
  },
  {
    q: "A cosa serve ICE Polar?",
    a: "ICE Polar raffredda la pelle a contatto durante la seduta con Lumina X1 Pro. La sensazione può cambiare da persona a persona: durante il trattamento ti chiediamo come stai e adattiamo i parametri se necessario.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--laser page-landing--laser-offer"
  ctaHref="#form"
  ctaLabel="Richiedi la promo"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    media={media.laser.hero}
    badge={`${laserOffer.campaignLabel} · ${laserOffer.discount.value}`}
    kicker="REBEL · Carmagnola"
    title={`Laser a ${laserOffer.zone.price} a zona. Full body _${laserOffer.totalBody.price}._`}
    lead="Lumina X1 Pro di THORY con raffreddamento a contatto ICE Polar. Prima di iniziare valutiamo pelle, pelo e zone e definiamo insieme il percorso."
    bullets={[
      { text: `${laserOffer.zone.price} per zona, per seduta.` },
      { text: `${laserOffer.totalBody.label} ${laserOffer.totalBody.price} · ${laserOffer.totalBody.detail} a seduta.` },
      { text: laserOffer.zoneCounting.shortNote },
      { text: "Valutazione iniziale di 30–40 minuti, gratuita se inizi il Percorso Libertà." },
      { text: `Percorso completo personalizzato dilazionabile con ${laserOffer.financing.provider} fino a ${laserOffer.financing.maxInstallments} rate.` },
    ]}
    primaryCta={{ label: "Richiedi la promo", href: "#form" }}
    secondaryCta={{ label: "Chiedi su WhatsApp", href: campaignWhatsApp(laserOfferContactMessage), external: true }}
    footnote={`${laserOffer.validity.label} ${laserOffer.financing.provider}: servizio soggetto all’approvazione di ${laserOffer.financing.lender}. Zone e condizioni vengono confermate prima di iniziare.`}
  />

  <LaserCampaignFilm />

  <LandingProof
    kicker="Cosa comprende l’offerta"
    items={[
      {
        title: `${laserOffer.zone.price} per zona`,
        body: `Il prezzo promozionale riguarda una singola zona per seduta. ${laserOffer.zoneCounting.note}`,
      },
      {
        title: `Total Body ${laserOffer.totalBody.price}`,
        body: `La formula Total Body comprende ${laserOffer.totalBody.detail} per seduta, definite e confermate prima di iniziare.`,
      },
      {
        title: "Comfort ICE Polar",
        body: "Il raffreddamento a contatto accompagna la seduta. Ti chiediamo come lo percepisci e adattiamo i parametri quando serve.",
      },
      {
        title: "Percorso personalizzato",
        body: "Numero di sedute, intervalli e parametri vengono definiti in base a pelle, pelo, zone e andamento osservato.",
      },
    ]}
  />

  <section class="section">
    <div class="container">
      <SplitFeature image={media.laser.handpiece} side="right" kicker="Meno ricrescita, più libertà"
        title="Il laser incontra il _freddo_."
        body="Lumina X1 Pro di THORY e ICE Polar: il manipolo raffredda la pelle a contatto durante la seduta. Pelle, pelo e zone guidano la scelta dei parametri e il calendario del tuo percorso."
        bullets={["Viso e corpo: scegli le zone durante la valutazione", "Raffreddamento a contatto per accompagnare il trattamento", "Prezzo e numero di zone confermati prima di iniziare"]}
        cta={{ label: "Scopri la tecnologia ICE Polar", href: "/epilazione-laser-ice-polar-carmagnola" }} />
      <LaserCampaignLinks current={laserOffer.landingPath} />
    </div>
  </section>

  <LandingSteps
    kicker="Come iniziare"
    title="Dalla richiesta al tuo percorso laser."
    steps={[
      {
        title: "Richiedi la promo",
        body: "Lascia nome e numero e, se vuoi, indica già le zone che ti interessano.",
      },
      {
        title: "Concordiamo la valutazione",
        body: "Ti contattiamo su WhatsApp o al telefono per scegliere un orario disponibile.",
      },
      {
        title: "Valutiamo pelle, pelo e zone",
        body: "In 30–40 minuti verifichiamo se il trattamento può essere indicato e definiamo parametri iniziali, calendario e prezzo.",
      },
      {
        title: "Scegli come iniziare",
        body: `Ti confermiamo la promo. Se attivi il percorso completo personalizzato, puoi richiedere ${laserOffer.financing.provider} e scegliere il numero di rate disponibile per l’importo.`,
      },
    ]}
  />

  <FullBleedBand
    image={media.laser.mood}
    height="sm"
    align="center"
    kicker="Lumina X1 Pro · ICE Polar"
    quote="Prima definiamo zone, parametri e calendario. Poi inizia il percorso."
    cite="Studio REBEL · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Promo epilazione laser"
    title="Richiedi la promo."
    lead="Bastano nome e numero. Se vuoi, indica già le zone che vorresti trattare: ti ricontattiamo per fissare la valutazione iniziale."
    source="landing-laser-offer"
    defaultMessage={laserOfferContactMessage}
    submitLabel="Richiedi la promo"
    showRitual={false}
    showMessage={true}
  />

  <section class="section"><div class="container">
    <p class="eyebrow">Dove fare il laser in promozione</p>
    <h2>Ti aspettiamo a Carmagnola.</h2>
    <p>REBEL è in Viale Barbaroux 20, Carmagnola (TO). Puoi raggiungerci da Carignano, Racconigi, Poirino, Villastellone, Sommariva del Bosco e Torino sud. Concordiamo l’appuntamento prima della partenza.</p>
    <a class="btn btn--secondary" href={laserOffer.territoryPath}>Località e indicazioni per arrivare</a>
  </div></section>
  <LandingFaq items={faqs} />
</LandingLayout>
