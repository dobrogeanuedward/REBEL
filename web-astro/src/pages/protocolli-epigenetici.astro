---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { protocolCards } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Percorsi viso, corpo e laser a Carmagnola | Rebel",
  description:
    "Glow per luminosità e uniformità, Longevity per tono e pelle matura, Forma per drenaggio e compattezza, Libertà per epilazione Laser Ice Polar.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "percorsi Rebel",
    "estetica epigenetica Carmagnola",
    "protocolli viso Carmagnola",
    "trattamenti corpo Carmagnola",
    "percorso estetico personalizzato Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Percorsi Rebel", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Percorsi viso, corpo e laser Rebel a Carmagnola",
  description: meta.description,
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Percorsi Rebel viso, corpo e laser",
  "Trattamenti personalizzati per luminosità, tono, pelle matura, contorno occhi, drenaggio, compattezza ed epilazione laser.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Glow, Longevity, Forma e Libertà: i percorsi Rebel",
  description: meta.description,
  path: "/protocolli-epigenetici",
  keywords: ["percorsi Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Percorsi",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli professionali Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const journeys = [
  {
    name: "Glow",
    image: media.journeys.glow,
    focus: "Viso · luminosità, idratazione e uniformità",
    body: "Indicato quando la pelle appare spenta, disidratata, opaca o irregolare. Può includere Skin Reset, Catalysis, Cell Regen e attivi epigenetici.",
    tools: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/contatti?percorso=glow",
  },
  {
    name: "Longevity",
    image: media.journeys.longevity,
    focus: "Viso · tono, elasticità e segni del tempo",
    body: "Indicato per perdita di tono, pelle matura, secchezza, minore elasticità o contorno occhi affaticato. Può includere Lift, Collagen, Rebirth 60+ ed Eye Genesis.",
    tools: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/contatti?percorso=longevity",
  },
  {
    name: "Forma",
    image: media.journeys.forma,
    focus: "Corpo · drenaggio, tono e compattezza",
    body: "Indicato per pesantezza, ritenzione, perdita di tono e rimodellamento. Può combinare manualità, LPG e trattamenti corpo scelti dopo la valutazione.",
    tools: ["Manualità", "LPG", "Valutazione", "Controlli"],
    href: "/contatti?percorso=forma",
  },
  {
    name: "Libertà",
    image: media.journeys.liberta,
    focus: "Epilazione laser · viso e corpo",
    body: "Percorso Laser Ice Polar per ridurre progressivamente la ricrescita. La valutazione definisce fototipo, pelo, zone, parametri, frequenza e prezzo.",
    tools: ["Laser a diodo", "Ice Polar", "Viso", "Corpo"],
    href: "/epilazione-laser-carmagnola",
  },
];
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-percorsi-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />

  <section class="rb-hero rb-hero--journeys">
    <div class="rb-hero__media">
      <img src={media.journeys.hero.src} alt={media.journeys.hero.alt} />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">Trattamenti personalizzati · Carmagnola</p>
      <h1>Percorsi per viso, corpo <em>ed epilazione laser.</em></h1>
      <p class="rb-lead">
        Glow è dedicato a luminosità e uniformità del viso; Longevity a tono, pelle matura e contorno occhi; Forma a drenaggio e compattezza del corpo; Libertà al Laser Ice Polar.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la prima visita</a>
        <a class="btn btn--secondary" href="/metodo-rebel">Come scegliamo i trattamenti</a>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Scelta del trattamento</p>
        <h2>Colleghiamo il risultato che desideri alle condizioni di pelle o corpo.</h2>
      </div>
      <div class="rb-copy">
        <p>Durante la valutazione ci racconti che cosa vuoi migliorare. Osserviamo la zona interessata e ti spieghiamo quali trattamenti possono essere adatti.</p>
        <p>Il programma indica prodotti, manualità, tecnologie, numero indicativo di sedute, frequenza iniziale e data del controllo.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Quattro aree di trattamento</p>
        <h2>Che cosa tratta ogni percorso Rebel.</h2>
      </div>
      <div class="rebel-journeys">
        {journeys.map((journey) => (
          <article class="rebel-journey" style={`--journey-image:url(${journey.image.src})`}>
            <div class="rebel-journey__copy">
              <p class="rb-kicker">{journey.focus}</p>
              <h3>{journey.name}</h3>
              <p>{journey.body}</p>
              <div class="rebel-journey__tags">
                {journey.tools.map((tool) => <span>{tool}</span>)}
              </div>
              <div style="margin-top:1.5rem"><a class="btn btn--secondary" href={journey.href}>{journey.name === "Libertà" ? "Prezzi e zone laser" : `Richiedi informazioni su ${journey.name}`}</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Protocolli viso e corpo</p>
        <h2>Trattamenti professionali con obiettivi, prezzo e indicazioni specifiche.</h2>
      </div>
      <div class="rb-protocol-grid">
        {protocolCards.map((protocol, index) => (
          <a class="rb-protocol-card" href={`/protocolli/${protocol.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p class="rb-kicker">{protocol.price}</p>
            <h3>{protocol.name}</h3>
            <p>{protocol.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Prima visita gratuita</p>
        <h2>Ti aiutiamo a scegliere tra trattamenti viso, corpo e laser.</h2>
      </div>
      <div class="rb-copy">
        <p>Non è necessario conoscere già il nome del protocollo. Puoi dirci, per esempio, che desideri più luminosità, meno pesantezza alle gambe, maggiore tono o meno ricrescita.</p>
        <p>Valutiamo la zona e ti presentiamo una proposta con trattamento, frequenza e prezzo.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Raccontaci che cosa vuoi _migliorare_."
        lead="In circa quindici minuti valutiamo la zona interessata e ti spieghiamo quali trattamenti possono essere adatti, con tempi e costi indicativi."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita"
        secondaryHref="/metodo-rebel"
        secondaryLabel="Come lavoriamo"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>
