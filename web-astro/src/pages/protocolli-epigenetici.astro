---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { photographs } from "@/lib/catalog-visuals";
import { getProtocolPhotography } from "@/lib/protocol-photography";
import "@/styles/protocol-editorial.css";
import { protocolCards } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Protocolli viso e corpo REBEL a Carmagnola",
  description:
    "Confronta i protocolli professionali REBEL per viso e corpo: esigenze trattate, prezzi, valutazione iniziale e modalità di prenotazione.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "percorsi Rebel",
    "estetica epigenetica Carmagnola",
    "protocolli viso Carmagnola",
    "trattamenti corpo Carmagnola",
    "percorso estetico personalizzato Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocolli REBEL", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Protocolli viso e corpo REBEL a Carmagnola",
  description: meta.description,
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Protocolli professionali REBEL per viso e corpo",
  "Trattamenti cosmetici per luminosità, tono, pelle matura, contorno occhi, idratazione e compattezza.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Protocolli professionali REBEL per viso e corpo",
  description: meta.description,
  path: "/protocolli-epigenetici",
  keywords: ["percorsi Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Percorsi",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli professionali Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-protocols-hub">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />
  <div class="protocol-editorial">
    <PageHero image={photographs["viso-manualita"]} imageCaption="REBEL · Scene illustrative dei trattamenti"
      kicker="Trattamenti professionali · Carmagnola"
      title="Protocolli viso _e corpo._"
      lead="Luminosità, tono, comfort. Scopri a quali esigenze è dedicato ogni protocollo e trova da dove cominciare: la scelta parte dalla tua pelle."
      ctaPrimary={{ label:"Esplora i protocolli", href:"#protocolli" }}
      ctaSecondary={{ label:"Prenota la valutazione", href:"/contatti" }}
      bullets={["6 protocolli professionali", "Obiettivi e prezzi a confronto"]}
      meta={["Valutazione REBEL · 30–40 minuti", "Viale Barbaroux 20 · Carmagnola"]}
    />

    <section class="pe-section pe-section--paper" id="protocolli" aria-labelledby="protocols-title"><div class="pe-shell">
      <div class="pe-heading"><div><p class="pe-kicker">La scelta comincia da te</p><h2 id="protocols-title">La tua esigenza.<br /><em>Il nostro punto di partenza.</em></h2></div><p>Durante la valutazione osserviamo la zona e parliamo di ciò che desideri migliorare. Ti spieghiamo prodotti, trattamento, sedute e prezzo prima di iniziare.</p></div>
      <div class="pe-protocols">{protocolCards.map((protocol,index)=>{
        const photo=getProtocolPhotography(protocol.slug).hero;
        return <article class:list={["pe-protocol",{"pe-protocol--wide":index<2}]}>
          <a class="pe-protocol__image" href={`/protocolli/${protocol.slug}`} aria-label={`Scopri ${protocol.name}`}><img src={photo.src} srcset={`${photo.preview} 480w, ${photo.src} ${photo.width}w`} sizes={index<2?"(max-width:760px) 100vw, 50vw":"(max-width:760px) 100vw, 33vw"} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /><span class="pe-protocol__number">{String(index+1).padStart(2,"0")}</span><span class="pe-protocol__arrow" aria-hidden="true">↗</span></a>
          <div class="pe-protocol__copy"><p class="pe-kicker">{protocol.price} · Protocollo professionale</p><h3><a href={`/protocolli/${protocol.slug}`}>{protocol.name}</a></h3><p>{protocol.desc}</p><a class="pe-link" href={`/protocolli/${protocol.slug}`}>Scopri il protocollo <span aria-hidden="true">→</span></a></div>
        </article>;
      })}</div>
      <p class="pe-image-note">Scene illustrative dei trattamenti. La scelta del protocollo parte dalla valutazione estetica.</p>
    </div></section>

    <section class="pe-section"><div class="pe-shell pe-explore">
      <div class="pe-explore__pictures"><img src={photographs["percorso-glow"].src} alt={photographs["percorso-glow"].alt} width="1440" height="810" loading="lazy" decoding="async" /><img src={photographs["percorso-forma"].src} alt={photographs["percorso-forma"].alt} width="1440" height="810" loading="lazy" decoding="async" /></div>
      <div><p class="pe-kicker">Percorsi Epigenetici REBEL</p><h2 class="pe-title">Tre aree.<br /><em>Nove modi di cominciare.</em></h2><p>Puoi partire da un’esigenza: più luminosità, meno pesantezza alle gambe, maggiore tono o meno ricrescita. Nei nove percorsi viso, corpo e laser trovi obiettivi, durata e prezzo di partenza.</p><a class="pe-button" href="/percorsi">Esplora i nove percorsi <span aria-hidden="true">↗</span></a></div>
    </div></section>

    <section class="pe-section pe-closing"><div class="pe-shell pe-closing__grid"><div><p class="pe-kicker">Valutazione REBEL · 30–40 minuti</p><h2>Non serve conoscere<br /><em>già il nome.</em></h2></div><div><p>Raccontaci che cosa vuoi migliorare. Osserviamo la zona e ti aiutiamo a capire da dove partire, con trattamento, frequenza e prezzo.</p><p>Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.</p><a class="pe-button" href="/contatti">Prenota la valutazione <span aria-hidden="true">↗</span></a><a class="pe-link" href="/metodo-rebel">Scopri come lavoriamo <span aria-hidden="true">→</span></a></div></div></section>
  </div>
  <StickyBookingBar primary={{ label:"Prenota la valutazione", href:"/contatti" }} />
</BaseLayout>
