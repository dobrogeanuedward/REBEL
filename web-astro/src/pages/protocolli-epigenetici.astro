---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import { protocolCards } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Protocolli viso e corpo REBEL a Carmagnola",
  description:
    "Confronta i protocolli professionali REBEL per viso e corpo: esigenze trattate, prezzi, valutazione iniziale e modalità di prenotazione.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "percorsi Rebel",
    "estetica epigenetica Carmagnola",
    "protocolli viso Carmagnola",
    "trattamenti corpo Carmagnola",
    "percorso estetico personalizzato Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocolli REBEL", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Protocolli viso e corpo REBEL a Carmagnola",
  description: meta.description,
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Protocolli professionali REBEL per viso e corpo",
  "Trattamenti cosmetici per luminosità, tono, pelle matura, contorno occhi, idratazione e compattezza.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Protocolli professionali REBEL per viso e corpo",
  description: meta.description,
  path: "/protocolli-epigenetici",
  keywords: ["percorsi Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Percorsi",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli professionali Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});
const protocolMedia: Record<string, ImageAsset> = {
  "rebel-lift-protocol": media.journeys.longevity,
  "rebirth-60-plus": media.viso.texture,
  "eye-genesis": media.viso.hero,
  "catalysis-ritual": media.viso.products,
  "collagen-code": media.studio.professional,
  "rebel-cell-regeneration": media.journeys.glow,
};
const getProtocolMedia = (slug: string) => protocolMedia[slug] ?? media.studio.professional;

---
<BaseLayout meta={meta} bodyClass="page-rebrand page-percorsi-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />

  <section class="rb-hero rb-hero--journeys">
    <div class="rb-hero__media">
      <img src={media.journeys.hero.src} alt={media.journeys.hero.alt} />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">Trattamenti professionali · Carmagnola</p>
      <h1>Protocolli per viso <em>e corpo.</em></h1>
      <p class="rb-lead">
        Scopri a quali esigenze è dedicato ogni protocollo, come si svolge e quanto costa. La scelta parte dalla valutazione della pelle o della zona.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/metodo-rebel">Come scegliamo i trattamenti</a>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Scelta del trattamento</p>
        <h2>Partiamo da ciò che vuoi migliorare e da come si presenta la zona.</h2>
      </div>
      <div class="rb-copy">
        <p>Durante la valutazione ci racconti che cosa vuoi migliorare. Osserviamo la zona interessata e ti spieghiamo quali trattamenti possono essere adatti.</p>
        <p>Prima di iniziare ti spieghiamo quali prodotti e trattamenti useremo, quante sedute prevediamo e quando faremo il primo controllo.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Protocolli viso e corpo</p>
        <h2>Trattamenti professionali con obiettivi, prezzo e indicazioni specifiche.</h2>
      </div>
      <div class="rb-protocol-grid">
        {protocolCards.map((protocol, index) => {
          const visual = getProtocolMedia(protocol.slug);
          return (
            <a class="rb-protocol-card" href={`/protocolli/${protocol.slug}`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <figure>
                <img
                  src={visual.src}
                  alt={visual.alt}
                  width={visual.width ?? 1200}
                  height={visual.height ?? 900}
                  loading="lazy"
                  decoding="async"
                />
              </figure>
              <div class="rb-protocol-card__copy">
                <p class="rb-kicker">{protocol.price}</p>
                <h3>{protocol.name}</h3>
                <p>{protocol.desc}</p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Valutazione REBEL · 30–40 minuti</p>
        <h2>Ti aiutiamo a scegliere tra trattamenti viso, corpo e laser.</h2>
      </div>
      <div class="rb-copy">
        <p>Non è necessario conoscere già il nome del protocollo. Puoi dirci, per esempio, che desideri più luminosità, meno pesantezza alle gambe, maggiore tono o meno ricrescita.</p>
        <p>Osserviamo la zona e ti aiutiamo a capire da dove partire.</p>
        <p>Per confrontare anche i nove percorsi viso, corpo e laser, consulta la sezione Percorsi REBEL.</p>
        <p><a class="btn btn--secondary" href="/percorsi">Vedi i nove percorsi</a></p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Raccontaci che cosa vuoi _migliorare_."
        lead="In 30–40 minuti valutiamo la zona e ti spieghiamo trattamenti, frequenza e prezzo. Se scegli di iniziare il Percorso REBEL, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/metodo-rebel"
        secondaryLabel="Come lavoriamo"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
