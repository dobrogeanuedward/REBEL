---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { protocolCards } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Percorsi Rebel — Estetica epigenetica viso e corpo a Carmagnola",
  description:
    "Scopri i percorsi Glow, Longevity, Forma e Libertà del Metodo Rebel. Protocolli, attivi epigenetici e tecnologie vengono combinati sulla priorità reale di pelle e corpo.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "percorsi Rebel",
    "estetica epigenetica Carmagnola",
    "protocolli viso Carmagnola",
    "trattamenti corpo Carmagnola",
    "percorso estetico personalizzato Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Percorsi Rebel", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Percorsi Rebel a Carmagnola",
  description: meta.description,
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Percorsi Rebel viso e corpo",
  "Percorsi personalizzati con valutazione, attivi epigenetici, manualità e tecnologie calibrate.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Percorsi Rebel — Glow, Longevity, Forma e Libertà",
  description: meta.description,
  path: "/protocolli-epigenetici",
  keywords: ["percorsi Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Percorsi",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli integrati nei percorsi Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const journeys = [
  {
    name: "Glow",
    focus: "Luce · uniformità · texture",
    body: "Un percorso dedicato alla pelle che vuole ritrovare nitidezza, comfort e presenza. Skin Reset, Catalysis e Cell Regen entrano nella progressione quando servono.",
    tools: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/contatti?percorso=glow",
  },
  {
    name: "Longevity",
    focus: "Tono · densità · qualità",
    body: "La direzione Rebel per accompagnare la pelle nel tempo. Lift, Collagen, Rebirth 60+ ed Eye Genesis vengono scelti e combinati secondo la priorità reale.",
    tools: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/contatti?percorso=longevity",
  },
  {
    name: "Forma",
    focus: "Corpo · drenaggio · compattezza",
    body: "Un percorso corpo costruito su manualità e tecnologie. Lift Body, LPG, pressomassaggio e Tecar dialogano in una sequenza calibrata.",
    tools: ["Lift Body", "LPG", "Pressomassaggio", "Tecar"],
    href: "/contatti?percorso=forma",
  },
  {
    name: "Libertà",
    focus: "Laser · comfort · continuità",
    body: "Il percorso dedicato all’epilazione laser Ice Polar. Valutazione, parametri personalizzati e richiami coerenti trasformano la tecnologia in un’esperienza Rebel.",
    tools: ["Laser a diodo", "Ice Polar", "Valutazione", "Mantenimento"],
    href: "/epilazione-laser-carmagnola",
  },
];
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-percorsi-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />

  <section class="rb-hero rb-hero--journeys">
    <div class="rb-hero__media">
      <img src={media.viso.mood.src ?? media.viso.mood} alt="Percorsi viso e corpo del Metodo Rebel" />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">I percorsi Rebel · Carmagnola</p>
      <h1>Una direzione. <em>Molti strumenti.</em></h1>
      <p class="rb-lead">
        Glow, Longevity, Forma e Libertà sono le quattro grandi direzioni del Metodo Rebel. I protocolli storici non scompaiono: diventano strumenti scelti e interpolati dentro il percorso giusto.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/metodo-rebel">Scopri il Metodo</a>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">La regia Rebel</p>
        <h2>Il nome del protocollo viene dopo <em>la priorità.</em></h2>
      </div>
      <div class="rb-copy">
        <p>Due persone possono desiderare lo stesso risultato e ricevere una progressione diversa. La scelta nasce dalla Mappa Rebel, dalla risposta osservata e dal momento reale della pelle o del corpo.</p>
        <p>Per questo ogni percorso può integrare protocolli, attivi, manualità e tecnologie in modo differente.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">Quattro direzioni</p>
        <h2>Trova la direzione che assomiglia <em>al tuo obiettivo.</em></h2>
      </div>
      <div class="rebel-journeys">
        {journeys.map((journey, index) => (
          <article class="rebel-journey" style={`--journey-image:url(${index % 2 === 0 ? (media.viso.mood.src ?? media.viso.mood) : (media.studio.cabin.src ?? media.studio.cabin)})`}>
            <div class="rebel-journey__copy">
              <p class="rb-kicker">{journey.focus}</p>
              <h3>{journey.name}</h3>
              <p>{journey.body}</p>
              <div class="rebel-journey__tags">
                {journey.tools.map((tool) => <span>{tool}</span>)}
              </div>
              <div style="margin-top:1.5rem"><a class="btn btn--secondary" href={journey.href}>Esplora {journey.name}</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">La biblioteca dei protocolli</p>
        <h2>Rituali e moduli che la Professionista Rebel <em>porta nel percorso.</em></h2>
      </div>
      <div class="rb-protocol-grid">
        {protocolCards.map((protocol, index) => (
          <a class="rb-protocol-card" href={`/protocolli/${protocol.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p class="rb-kicker">{protocol.price}</p>
            <h3>{protocol.name}</h3>
            <p>{protocol.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Scegliere bene</p>
        <h2>La valutazione evita di partire <em>dal nome sbagliato.</em></h2>
      </div>
      <div class="rb-copy">
        <p>La prima scelta non è tra Lift, Catalysis o Cell Regen. È capire quale priorità viene prima e quale ritmo può sostenere davvero il risultato.</p>
        <p>Il protocollo giusto emerge dalla direzione, non il contrario.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="La tua direzione Rebel"
        title="Costruiamo il percorso _intorno a te_."
        lead="Prenota una valutazione e raccontaci ciò che desideri cambiare, ritrovare o preservare."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/metodo-rebel"
        secondaryLabel="Scopri il Metodo Rebel"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
