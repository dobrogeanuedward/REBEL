---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import JsonLd from "@/components/JsonLd.astro";
import { protocolCards } from "@/lib/content";
import { competencePages } from "@/lib/seo-content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Protocolli Viso e Corpo Epigenetici a Carmagnola — Rebel",
  description:
    "Protocolli viso e corpo a Carmagnola con linee professionali Marbellas ed Eberlin: pulizia profonda, tono, densità, drenaggio e luminosità su più sedute.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "protocolli viso Carmagnola",
    "protocolli corpo Carmagnola",
    "estetica avanzata Carmagnola",
    "trattamenti viso epigenetici Carmagnola",
    "Marbellas Carmagnola",
    "Eberlin Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocolli epigenetici", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Protocolli epigenetici a Carmagnola",
  description: "Una panoramica dei protocolli Rebel: viso e corpo, con focus su glow, tono, densità e rigenerazione.",
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Trattamenti epigenetici viso e corpo",
  "Protocolli personalizzati con attivi funzionali e tecnologia calibrata.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Protocolli epigenetici a Carmagnola",
  description: "Cosa sono i protocolli Rebel e come si scelgono: glow, progressione e lettura iniziale.",
  path: "/protocolli-epigenetici",
  keywords: ["protocolli epigenetici", "estetica epigenetica", "Carmagnola"],
  section: "Protocolli",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli epigenetici Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const guideSlugs = [
  "estetica-avanzata-carmagnola",
  "trattamenti-viso-carmagnola",
  "trattamenti-corpo-carmagnola",
  "beauty-routine-carmagnola",
  "pelle-opaca-grana-irregolare-carmagnola",
  "tono-viso-ovale-carmagnola-percorso",
  "contorno-occhi-gonfiore-occhiaie-carmagnola",
];
const guides = guideSlugs
  .map((slug) => competencePages.find((c) => c.slug === slug))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c));
const guidesSchema =
  guides.length > 0
    ? buildItemListSchema({
        name: "Guide utili per scegliere un protocollo epigenetico",
        path: "/protocolli-epigenetici",
        items: guides.map((g) => ({ name: g.title, path: `/competenze/${g.slug}` })),
      })
    : null;
---
<BaseLayout meta={meta} bodyClass="page-protocolli">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />
  {guidesSchema ? <JsonLd data={guidesSchema} /> : null}

  <PageHero
    kicker="Protocolli viso e corpo · Carmagnola"
    title="Quando un singolo trattamento _non basta_."
    lead="I protocolli sono percorsi su più sedute, costruiti per lavorare in profondità su tono, densità, luminosità e drenaggio. Linee professionali Marbellas ed Eberlin in cabina."
    meta={["Marbellas — linea epigenetica", "Eberlin — biocosmetica", "Percorsi su più sedute"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vai al listino", href: "/listino-estetica-laser" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="I protocolli attivi"
        title="Scegli il _risultato_ da cui partire."
        lead="Ogni scheda racconta cosa fa il protocollo, in quante sedute si sviluppa e a chi è davvero adatto. La priorità la decidiamo in prima visita."
      />
      <div class="card-grid card-grid--3">
        {protocolCards.map((p, i) => (
          <FeatureCard
            kicker={p.price}
            title={p.name}
            body={p.desc}
            href={`/protocolli/${p.slug}`}
            ariaLabel={`Apri il protocollo ${p.name}`}
            variant="default"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory">
    <div class="container split">
      <article class="card">
        <p class="kicker">Come si sceglie</p>
        <h2 class="card__title">Si parte dalla pelle, non dal pacchetto.</h2>
        <p class="card__body">
          In prima visita leggiamo insieme pelle, zona e priorità del momento. Ti diciamo
          se ha senso aprire un protocollo o se basta un trattamento singolo, e ti
          consegniamo una proposta scritta con prezzi e tempi reali.
        </p>
      </article>
      <article class="card card--feature">
        <p class="kicker">Cosa cambia davvero</p>
        <h3 class="card__title">Un percorso lavora dove un singolo gesto non arriva.</h3>
        <p class="card__body">
          La differenza fra una pulizia viso e un protocollo viso è il tempo. Più sedute,
          attivi mirati, ritmo costruito sulla tua pelle: la qualità cresce di seduta in
          seduta e il mantenimento diventa più semplice.
        </p>
      </article>
    </div>
  </section>

  {guides.length > 0 ? (
    <section class="section">
      <div class="container">
        <SectionHead
          kicker="Per orientarti"
          title="Guide _utili_ prima di scegliere."
          lead="Approfondimenti su pelle, tono, contorno occhi e routine: spiegano cosa guardare e da quale protocollo ha senso partire."
        />
        <div class="card-grid card-grid--2">
          {guides.map((g, i) => (
            <FeatureCard
              kicker="Guida"
              title={g.title}
              body={g.shortDescription}
              href={`/competenze/${g.slug}`}
              variant="quiet"
              index={i + 1}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Quindici minuti per capire da _dove partire_."
        lead="Vieni in studio, leggiamo la pelle, decidiamo insieme. Senza obbligo di acquisto e con un piccolo regalo a tua scelta."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita gratuita"
        secondaryHref="/listino-estetica-laser"
        secondaryLabel="Vedi listino e prezzi"
      />
    </div>
  </section>
</BaseLayout>
