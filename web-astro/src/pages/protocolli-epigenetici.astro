---
import BaseLayout from "@/layouts/BaseLayout.astro";
import InlineCta from "@/components/InlineCta.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { protocolCards } from "@/lib/content";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Percorsi Rebel — Estetica epigenetica viso e corpo a Carmagnola",
  description:
    "Scopri i percorsi Glow, Longevity, Forma e Libertà del Metodo Rebel. Protocolli, attivi epigenetici e tecnologie vengono scelti in base alle esigenze reali di pelle e corpo.",
  path: "/protocolli-epigenetici",
  openGraphType: "article",
  keywords: [
    "percorsi Rebel",
    "estetica epigenetica Carmagnola",
    "protocolli viso Carmagnola",
    "trattamenti corpo Carmagnola",
    "percorso estetico personalizzato Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Percorsi Rebel", path: "/protocolli-epigenetici" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Percorsi Rebel a Carmagnola",
  description: meta.description,
  path: "/protocolli-epigenetici",
});
const serviceSchema = buildServiceSchema(
  "Percorsi Rebel viso e corpo",
  "Percorsi personalizzati con valutazione, attivi epigenetici, manualità e tecnologie selezionate.",
  "/protocolli-epigenetici",
);
const articleSchema = buildArticleSchema({
  headline: "Percorsi Rebel — Glow, Longevity, Forma e Libertà",
  description: meta.description,
  path: "/protocolli-epigenetici",
  keywords: ["percorsi Rebel", "estetica epigenetica", "Carmagnola"],
  section: "Percorsi",
});
const protocolsSchema = buildItemListSchema({
  name: "Protocolli integrati nei percorsi Rebel",
  path: "/protocolli-epigenetici",
  items: protocolCards.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const journeys = [
  {
    name: "Glow",
    focus: "Luce · uniformità · texture",
    body: "Per una pelle più luminosa, uniforme e vitale. Skin Reset, Catalysis, Cell Regen e attivi epigenetici vengono scelti in base a ciò di cui la pelle ha bisogno oggi.",
    tools: ["Skin Reset", "Catalysis", "Cell Regen", "Attivi epigenetici"],
    href: "/contatti?percorso=glow",
  },
  {
    name: "Longevity",
    focus: "Tono · densità · qualità",
    body: "Per sostenere tono, elasticità, comfort e qualità della pelle nel tempo. Lift, Collagen, Rebirth 60+ ed Eye Genesis entrano nel percorso quando sono davvero utili.",
    tools: ["Lift", "Collagen", "Rebirth 60+", "Eye Genesis"],
    href: "/contatti?percorso=longevity",
  },
  {
    name: "Forma",
    focus: "Corpo · drenaggio · compattezza",
    body: "Per ritrovare leggerezza, tono e armonia. Manualità, Lift Body, LPG, pressomassaggio e Tecar vengono combinati in base alla risposta del corpo.",
    tools: ["Lift Body", "LPG", "Pressomassaggio", "Tecar"],
    href: "/contatti?percorso=forma",
  },
  {
    name: "Libertà",
    focus: "Laser · comfort · continuità",
    body: "Il percorso dedicato all’epilazione laser Ice Polar. Parametri, zone e frequenza vengono definiti sulla persona e aggiornati nel tempo.",
    tools: ["Laser a diodo", "Ice Polar", "Valutazione", "Mantenimento"],
    href: "/epilazione-laser-carmagnola",
  },
];
---
<BaseLayout meta={meta} bodyClass="page-rebrand page-percorsi-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={protocolsSchema} />

  <section class="rb-hero rb-hero--journeys">
    <div class="rb-hero__media">
      <img src={media.viso.mood.src ?? media.viso.mood} alt="Percorsi viso e corpo del Metodo Rebel" />
    </div>
    <div class="rb-hero__veil"></div>
    <div class="container rb-hero__content">
      <p class="rb-kicker">I percorsi Rebel · Carmagnola</p>
      <h1>Quattro percorsi. <em>Uno pensato per te.</em></h1>
      <p class="rb-lead">
        Glow, Longevity, Forma e Libertà raccolgono trattamenti, attivi e tecnologie diverse. La scelta parte sempre da ciò che vuoi migliorare e da ciò di cui pelle o corpo hanno bisogno.
      </p>
      <div class="cluster cluster--stack-mobile">
        <a class="btn btn--primary" href="/contatti">Prenota la valutazione</a>
        <a class="btn btn--secondary" href="/metodo-rebel">Scopri il Metodo</a>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Come scegliamo</p>
        <h2>Prima viene la tua priorità. <em>Poi il trattamento.</em></h2>
      </div>
      <div class="rb-copy">
        <p>Due persone possono desiderare lo stesso risultato e avere bisogno di percorsi diversi. Per questo osserviamo la pelle, ascoltiamo il tuo obiettivo e definiamo insieme da dove partire.</p>
        <p>Il percorso può cambiare nel tempo, seguendo la risposta reale di pelle e corpo.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--plum">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">I percorsi Rebel</p>
        <h2>Trova quello più vicino <em>al tuo obiettivo.</em></h2>
      </div>
      <div class="rebel-journeys">
        {journeys.map((journey, index) => (
          <article class="rebel-journey" style={`--journey-image:url(${index % 2 === 0 ? (media.viso.mood.src ?? media.viso.mood) : (media.studio.cabin.src ?? media.studio.cabin)})`}>
            <div class="rebel-journey__copy">
              <p class="rb-kicker">{journey.focus}</p>
              <h3>{journey.name}</h3>
              <p>{journey.body}</p>
              <div class="rebel-journey__tags">
                {journey.tools.map((tool) => <span>{tool}</span>)}
              </div>
              <div style="margin-top:1.5rem"><a class="btn btn--secondary" href={journey.href}>Scopri {journey.name}</a></div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--ivory">
    <div class="container">
      <div class="rb-section-head">
        <p class="rb-kicker">I protocolli</p>
        <h2>Trattamenti specifici, scelti <em>nel momento giusto.</em></h2>
      </div>
      <div class="rb-protocol-grid">
        {protocolCards.map((protocol, index) => (
          <a class="rb-protocol-card" href={`/protocolli/${protocol.slug}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <p class="rb-kicker">{protocol.price}</p>
            <h3>{protocol.name}</h3>
            <p>{protocol.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--spectrum">
    <div class="container rb-intro-grid">
      <div>
        <p class="rb-kicker">Da dove partire</p>
        <h2>La valutazione aiuta a scegliere <em>con più precisione.</em></h2>
      </div>
      <div class="rb-copy">
        <p>Non devi conoscere già il nome del trattamento. Ti basta raccontarci ciò che vuoi migliorare, ritrovare o mantenere.</p>
        <p>Da lì individuiamo il primo passo più adatto e definiamo insieme il percorso.</p>
      </div>
    </div>
  </section>

  <section class="rb-section rb-section--closing">
    <div class="container">
      <InlineCta
        kicker="Il tuo percorso Rebel"
        title="Partiamo da ciò che vuoi _cambiare davvero_."
        lead="Prenota una valutazione e raccontaci il tuo obiettivo. Ti aiutiamo a capire da dove iniziare."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/metodo-rebel"
        secondaryLabel="Scopri il Metodo Rebel"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
