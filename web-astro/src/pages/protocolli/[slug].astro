---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import { protocolPages } from "@/lib/protocol-pages";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

export async function getStaticPaths() {
  return protocolPages.map((p) => ({
    params: { slug: p.slug },
    props: { protocol: p },
  }));
}

const { protocol } = Astro.props;

const resolveProtocolVisuals = (slug: string): { hero: ImageAsset; editorial: readonly ImageAsset[] } => {
  if (/rebirth|cell-regeneration|lift|collagen/.test(slug)) {
    return {
      hero: media.journeys.longevity,
      editorial: [media.viso.texture, media.viso.products, media.studio.professional],
    };
  }
  if (/eye-genesis/.test(slug)) {
    return {
      hero: media.viso.hero,
      editorial: [media.viso.texture, media.studio.professional],
    };
  }
  return {
    hero: media.journeys.glow,
    editorial: [media.viso.products, media.viso.texture, media.studio.professional],
  };
};
const protocolVisuals = resolveProtocolVisuals(protocol.slug);

const meta = createPageMeta({
  title: `${protocol.name} a Carmagnola`,
  description: protocol.shortDescription,
  path: `/protocolli/${protocol.slug}`,
  keywords: protocol.keywords,
  openGraphType: "article",
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocolli viso e corpo", path: "/protocolli-epigenetici" },
  { name: protocol.name, path: `/protocolli/${protocol.slug}` },
]);
const webPage = buildWebPageSchema({
  name: `${protocol.name} a Carmagnola`,
  description: protocol.shortDescription,
  path: `/protocolli/${protocol.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: `${protocol.name} a Carmagnola`,
  description: protocol.longDescription,
  path: `/protocolli/${protocol.slug}`,
  keywords: protocol.keywords,
  section: "Protocolli",
});
const faqSchema =
  protocol.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: protocol.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
      }
    : null;
const relatedLinksSchema =
  protocol.relatedLinks.length > 0
    ? buildItemListSchema({
        name: `Informazioni utili su ${protocol.name}`,
        path: `/protocolli/${protocol.slug}`,
        items: protocol.relatedLinks
          .filter((l) => l.href.startsWith("/"))
          .map((l) => ({ name: l.label, path: l.href })),
      })
    : null;
---
<BaseLayout meta={meta} bodyClass="page-protocollo-detail">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  {faqSchema ? <JsonLd data={faqSchema} /> : null}
  {relatedLinksSchema ? <JsonLd data={relatedLinksSchema} /> : null}

  <PageHero
    image={protocolVisuals.hero}
    kicker="Protocollo professionale · Carmagnola"
    title={`${protocol.name}: _a chi è dedicato e come funziona_.`}
    lead={protocol.longDescription}
    bullets={[protocol.price, "Valutazione REBEL · 30–40 minuti", "Programma personalizzato"]}
    meta={["Gratuita se inizi il percorso proposto", "Viale Barbaroux 20"]}
    ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Vedi tutti i protocolli", href: "/protocolli-epigenetici" }}
  />

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="A che cosa serve"
        title={`Gli obiettivi principali di _${protocol.name}_.`}
        lead="Prima di consigliarlo valutiamo le condizioni della pelle, il risultato che desideri e le eventuali sensibilità."
      />
      <KeyPointsGrid points={protocol.benefits} title="Obiettivi del trattamento" />
    </div>
  </section>

  {protocol.editorialSections.length > 0 ? (
    <section class="section section--scene-ivory">
      <div class="container">
        <SectionHead
          kicker="Come si svolge"
          title="Valutazione, sedute e mantenimento."
          lead="Il numero di appuntamenti e la frequenza vengono definiti in base alle condizioni della pelle, all’obiettivo e ai cambiamenti osservati durante il trattamento."
        />
        <div class="editorial-flow">
          {protocol.editorialSections.map((s, i) => {
            const mediaIndex = Math.floor(i / 2);
            const sectionMedia = i % 2 === 0
              ? protocolVisuals.editorial[mediaIndex % protocolVisuals.editorial.length]
              : undefined;
            return (
              <EditorialSection
                heading={s.heading}
                paragraphs={s.paragraphs}
                level={3}
                media={sectionMedia}
                mediaSide={mediaIndex % 2 === 0 ? "end" : "start"}
              />
            );
          })}
        </div>
      </div>
    </section>
  ) : null}

  {protocol.faqs.length > 0 ? (
    <section class="section">
      <div class="container">
        <SectionHead
          kicker="Domande frequenti"
          title="Indicazioni utili prima di prenotare."
        />
        <FaqAccordion items={protocol.faqs} kicker={`Domande su ${protocol.name}`} />
      </div>
    </section>
  ) : null}

  {protocol.relatedLinks.length > 0 ? (
    <section class="section">
      <div class="container">
        <SectionHead
          kicker="Potrebbe interessarti anche"
          title="Altri trattamenti e informazioni utili."
        />
        <div class="link-grid">
          {protocol.relatedLinks.map((l) => {
            const isExternal = l.href.startsWith("http");
            return isExternal ? (
              <a class="link-card" href={l.href} target="_blank" rel="noreferrer">
                <span class="link-card__title">{l.label}</span>
                {l.description ? <span class="link-card__desc">{l.description}</span> : null}
              </a>
            ) : (
              <a class="link-card" href={l.href}>
                <span class="link-card__title">{l.label}</span>
                {l.description ? <span class="link-card__desc">{l.description}</span> : null}
              </a>
            );
          })}
        </div>
      </div>
    </section>
  ) : null}

  <FullBleedBand
    image={media.viso.mood}
    height="sm"
    align="left"
    kicker={`${protocol.name} · Rebel Carmagnola`}
    quote="La valutazione iniziale definisce obiettivo, sedute, frequenza e mantenimento."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title={`Scopri se _${protocol.name}_ è adatto a te.`}
        lead="In 30–40 minuti valutiamo la zona e definiamo trattamento, frequenza e prezzo. Se scegli di iniziare il percorso proposto, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
        primaryHref="/contatti"
        primaryLabel="Prenota la valutazione"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Vedi tutti i protocolli"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-flow {
    display: grid;
    gap: clamp(2.8rem, 6vw, 5.2rem);
    margin-top: 1.8rem;
  }
  .link-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
    margin-top: 1.6rem;
  }
  .link-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: linear-gradient(180deg, rgba(31, 26, 58, 0.55), rgba(20, 16, 42, 0.4));
    transition: border-color var(--t-base) var(--ease-soft), transform var(--t-base) var(--ease-cinema);
  }
  .link-card:hover {
    border-color: var(--mauve);
    transform: translateY(-2px);
  }
  .link-card__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--text-strong);
    letter-spacing: -0.01em;
  }
  .link-card__desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
</style>
