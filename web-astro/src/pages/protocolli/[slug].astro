---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { protocolPages } from "@/lib/protocol-pages";
import { getProtocolPhotography } from "@/lib/protocol-photography";
import "@/styles/protocol-editorial.css";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

export async function getStaticPaths() {
  return protocolPages.map((p) => ({
    params: { slug: p.slug },
    props: { protocol: p },
  }));
}

const { protocol } = Astro.props;

const protocolVisuals = getProtocolPhotography(protocol.slug);
const protocolMetaDescription = protocol.shortDescription.length >= 105
  ? protocol.shortDescription
  : `${protocol.shortDescription} Indicazioni utili prima della valutazione a Carmagnola.`;

const meta = createPageMeta({
  title: `${protocol.name} a Carmagnola`,
  description: protocolMetaDescription,
  path: `/protocolli/${protocol.slug}`,
  keywords: protocol.keywords,
  openGraphType: "article",
  image: protocolVisuals.hero.src,
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocolli viso e corpo", path: "/protocolli-epigenetici" },
  { name: protocol.name, path: `/protocolli/${protocol.slug}` },
]);
const webPage = buildWebPageSchema({
  name: `${protocol.name} a Carmagnola`,
  description: protocolMetaDescription,
  path: `/protocolli/${protocol.slug}`,
});
const articleSchema = buildArticleSchema({
  headline: `${protocol.name} a Carmagnola`,
  description: protocol.longDescription,
  path: `/protocolli/${protocol.slug}`,
  keywords: protocol.keywords,
  section: "Protocolli",
});
const faqSchema =
  protocol.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: protocol.faqs.map((faq) => ({
          "@type": "Question",
          name: faq.q,
          acceptedAnswer: { "@type": "Answer", text: faq.a },
        })),
      }
    : null;
const relatedLinksSchema =
  protocol.relatedLinks.length > 0
    ? buildItemListSchema({
        name: `Informazioni utili su ${protocol.name}`,
        path: `/protocolli/${protocol.slug}`,
        items: protocol.relatedLinks
          .filter((l) => l.href.startsWith("/"))
          .map((l) => ({ name: l.label, path: l.href })),
      })
    : null;
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-protocollo-detail">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  {faqSchema ? <JsonLd data={faqSchema} /> : null}
  {relatedLinksSchema ? <JsonLd data={relatedLinksSchema} /> : null}

  <div class="protocol-editorial">
    <PageHero
      image={protocolVisuals.hero}
      imageCaption="Scene illustrative dei trattamenti REBEL"
      kicker="Protocollo professionale · Carmagnola"
      title={protocol.name}
      lead={protocol.shortDescription}
      bullets={[protocol.price, "Valutazione REBEL · 30–40 minuti"]}
      meta={["Trattamento definito dopo la valutazione", "Viale Barbaroux 20 · Carmagnola"]}
      ctaPrimary={{ label: "Prenota la valutazione", href: "/contatti", halo: true }}
      ctaSecondary={{ label: "Come funziona", href: "#il-protocollo" }}
    />

    <section class="pe-section pe-section--paper" aria-labelledby="protocol-objectives">
      <div class="pe-shell">
        <div class="pe-heading"><div><p class="pe-kicker">La tua pelle, al centro</p><h2 id="protocol-objectives">Da ciò che senti.<br /><em>A ciò che scegliamo.</em></h2></div><p>{protocol.longDescription}</p></div>
        <ol class="pe-benefits">{protocol.benefits.map((benefit, index) => <li><span aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><p>{benefit}</p></li>)}</ol>
      </div>
    </section>

    {protocol.editorialSections.length > 0 && <section class="pe-section" id="il-protocollo" aria-labelledby="protocol-story-title"><div class="pe-shell">
      <div class="pe-heading"><div><p class="pe-kicker">Il trattamento, da vicino</p><h2 id="protocol-story-title">Ogni gesto ha<br /><em>il suo perché.</em></h2></div><p>La valutazione, la seduta e la cura a casa: ogni fase viene scelta in base alle condizioni della pelle e ai cambiamenti osservati.</p></div>
      <div class="pe-story">{protocol.editorialSections.map((section, index) => {
        const photo = protocolVisuals.story[index % protocolVisuals.story.length];
        return <article class:list={["pe-story__row", { "pe-story__row--reverse": index % 2 !== 0 }]}>
          <figure><img src={photo.src} srcset={`${photo.preview} 480w, ${photo.src} ${photo.width}w`} sizes="(max-width:760px) 100vw, 50vw" alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /><figcaption>REBEL · Scene illustrative del trattamento</figcaption></figure>
          <div class="pe-story__copy"><span class="pe-story__number" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span><h3>{section.heading}</h3>{section.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
        </article>;
      })}</div>
    </div></section>}

    {protocol.faqs.length > 0 && <section class="pe-section pe-section--paper"><div class="pe-shell pe-faq-layout">
      <div><p class="pe-kicker">Prima di prenotare</p><h2 class="pe-title">Le risposte<br /><em>che cerchi.</em></h2></div>
      <FaqAccordion items={protocol.faqs} kicker={protocol.name} />
    </div></section>}

    {protocol.relatedLinks.length > 0 && <section class="pe-section"><div class="pe-shell">
      <div class="pe-heading"><div><p class="pe-kicker">Continua a esplorare</p><h2>Trova il tuo<br /><em>prossimo passo.</em></h2></div><a class="pe-link" href="/protocolli-epigenetici">Confronta tutti i protocolli <span aria-hidden="true">↗</span></a></div>
      <div class="pe-related">{protocol.relatedLinks.map(link => <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}><span class="pe-related__arrow" aria-hidden="true">↗</span><h3>{link.label}</h3>{link.description && <p>{link.description}</p>}</a>)}</div>
    </div></section>}

    <section class="pe-section pe-closing"><div class="pe-shell pe-closing__grid"><div><p class="pe-kicker">Valutazione REBEL · 30–40 minuti</p><h2>Cominciamo<br /><em>dalla tua pelle.</em></h2></div><div><p>Valutiamo insieme se {protocol.name} è adatto alla tua pelle. In 30–40 minuti definiamo trattamento, frequenza e prezzo.</p><p>Se scegli di iniziare il percorso proposto, la valutazione iniziale è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi.</p><a class="pe-button" href="/contatti">Prenota la valutazione <span aria-hidden="true">↗</span></a></div></div></section>
  </div>
  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>
