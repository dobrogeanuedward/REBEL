---
import LandingLayout from "@/layouts/LandingLayout.astro";
import LandingHero from "@/components/landing/LandingHero.astro";
import LandingProof from "@/components/landing/LandingProof.astro";
import LandingSteps from "@/components/landing/LandingSteps.astro";
import LandingFaq from "@/components/landing/LandingFaq.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { media } from "@/lib/page-media";
import { siteConfig } from "@/lib/site-config";

const meta = createPageMeta({
  title: "Protocollo viso epigenetico Carmagnola — valutazione REBEL | Rebel",
  description:
    "Trattamenti viso con Marbellas ed Eberlin a Carmagnola. Valutazione REBEL di 30–40 minuti, gratuita se inizi il percorso proposto.",
  path: "/protocollo-viso",
  keywords: [
    "protocollo viso Carmagnola",
    "trattamento viso epigenetico Carmagnola",
    "Marbellas Carmagnola",
    "Eberlin Carmagnola",
    "pulizia viso professionale Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocollo viso", path: "/protocollo-viso" },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Protocollo viso epigenetico",
  serviceType: "Trattamento viso professionale",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
  description:
    "Trattamento viso scelto dopo aver osservato la pelle: valutazione di 30–40 minuti, linea cosmetica, frequenza e prezzo.",
};

const faqs = [
  {
    q: "Che cos’è la linea Marbellas?",
    a: "Marbellas è una linea cosmetica professionale utilizzata nei percorsi viso dedicati a luminosità, tono e comfort della pelle.",
  },
  {
    q: "E Eberlin invece?",
    a: "Eberlin è un marchio spagnolo di cosmetica professionale. Scegliamo tra le sue linee in base alla sensibilità e alle esigenze osservate durante la valutazione.",
  },
  {
    q: "Quante sedute servono per un protocollo?",
    a: "Dipende dalla pelle, dall’obiettivo e dai cambiamenti osservati. Dopo la valutazione proponiamo una frequenza iniziale e la aggiorniamo durante i controlli.",
  },
  {
    q: "Cosa succede durante la valutazione?",
    a: "In 30–40 minuti parliamo di ciò che vuoi migliorare, osserviamo la pelle e ti spieghiamo il percorso proposto, con frequenza e prezzo. Se scegli di iniziarlo, la valutazione è gratuita. Gli eventuali prodotti per casa non sono inclusi.",
  },
  {
    q: "Quanto costa un trattamento viso da Rebel?",
    a: "La pulizia viso classica costa €55 e i protocolli Marbellas o Eberlin partono da €75. Puoi consultare i prezzi nel listino online.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<LandingLayout
  meta={meta}
  bodyClass="page-landing--viso"
  ctaHref="#form"
  ctaLabel="Prenota la valutazione"
>
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />

  <LandingHero
    media={media.viso.hero}
    badge="Valutazione · 30–40 minuti"
    kicker="Trattamento viso · Carmagnola"
    title="Un protocollo viso scelto in base alla _tua_ pelle."
    lead="Osserviamo la pelle, scegliamo la linea più adatta tra Marbellas ed Eberlin e definiamo frequenza e prezzo. Se inizi il Percorso REBEL, la valutazione è gratuita."
    bullets={[
      { text: "Valutazione in studio di idratazione, sebo, sensibilità e segni visibili." },
      { text: "Scelta della linea professionale: Marbellas o Eberlin." },
      { text: "Frequenza delle sedute definita dopo la valutazione." },
      { text: "Prezzi pubblici: pulizia viso €55, protocolli avanzati da €75." },
    ]}
    primaryCta={{ label: "Prenota la valutazione", href: "#form" }}
    secondaryCta={{
      label: "Scopri Marbellas / Eberlin",
      href: "/protocolli-epigenetici",
    }}
    footnote="Ti contattiamo personalmente via WhatsApp o telefono."
  />

  <LandingProof
    kicker="Perché Rebel"
    items={[
      {
        title: "Formazione THORY",
        body: "Il team segue la formazione THORY dedicata alle linee e alle tecnologie utilizzate in studio.",
      },
      {
        title: "Linea Marbellas",
        body: "Linea cosmetica professionale utilizzata nei percorsi dedicati a luminosità, tono e comfort della pelle.",
      },
      {
        title: "Linea Eberlin",
        body: "Marchio spagnolo di cosmetica professionale con linee scelte in base alle esigenze della pelle.",
      },
      {
        title: "Tempi e prezzi chiari",
        body: "Prima di iniziare ti spieghiamo la frequenza proposta, il prezzo e quando faremo il controllo.",
      },
    ]}
  />

  <LandingSteps
    kicker="Come funziona"
    title="Dalla valutazione della pelle al trattamento personalizzato."
    steps={[
      {
        title: "Lascia i tuoi recapiti",
        body: "Nome, telefono e — se vuoi — cosa vorresti migliorare (luminosità, segni, sensibilità…).",
      },
      {
        title: "Valutazione di 30–40 minuti",
        body: "Osserviamo la pelle, parliamo di ciò che vuoi migliorare e scegliamo la linea più adatta.",
      },
      {
        title: "Ti spieghiamo il percorso",
        body: "Conosci linea, frequenza e prezzo e puoi decidere con calma se iniziare.",
      },
      {
        title: "Iniziamo e controlliamo i cambiamenti",
        body: "Durante i controlli osserviamo la pelle e aggiorniamo il programma quando serve.",
      },
    ]}
  />

  <FullBleedBand
    image={media.viso.mood}
    height="sm"
    align="center"
    kicker="Estetica viso · Carmagnola"
    quote="Il trattamento parte dalla _tua_ pelle."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <LandingFormCard
    kicker="Valutazione viso"
    title="Prenota la valutazione della pelle."
    lead="Bastano nome e numero. Se vuoi, scrivici già cosa vorresti migliorare (luminosità, idratazione, segni, sensibilità…)."
    source="landing-viso"
    submitLabel="Prenota la valutazione"
    showRitual={false}
    showMessage={true}
  />

  <LandingFaq items={faqs} />
</LandingLayout>
