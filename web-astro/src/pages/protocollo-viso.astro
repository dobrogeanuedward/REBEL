---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import LandingFormCard from "@/components/landing/LandingFormCard.astro";
import JsonLd from "@/components/JsonLd.astro";
import { createPageMeta, buildBreadcrumbSchema } from "@/lib/seo";
import { photographs } from "@/lib/catalog-visuals";
import { siteConfig } from "@/lib/site-config";
import "@/styles/protocol-editorial.css";

const meta = createPageMeta({
  title: "Protocollo viso epigenetico Carmagnola — valutazione REBEL | Rebel",
  description:
    "Trattamenti viso con Marbellas ed Eberlin a Carmagnola. Valutazione iniziale REBEL di 30–40 minuti, gratuita se inizi il percorso proposto.",
  path: "/protocollo-viso",
  keywords: [
    "protocollo viso Carmagnola",
    "trattamento viso epigenetico Carmagnola",
    "Marbellas Carmagnola",
    "Eberlin Carmagnola",
    "pulizia viso professionale Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Protocollo viso", path: "/protocollo-viso" },
]);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Protocollo viso epigenetico",
  serviceType: "Trattamento viso professionale",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: siteConfig.areasServed,
  description:
    "Trattamento viso scelto dopo aver osservato la pelle: valutazione di 30–40 minuti, linea cosmetica, frequenza e prezzo.",
};

const faqs = [
  {
    q: "Che cos’è la linea Marbellas?",
    a: "Marbellas è una linea cosmetica professionale utilizzata nei percorsi viso dedicati a luminosità, tono e comfort della pelle.",
  },
  {
    q: "E Eberlin invece?",
    a: "Eberlin è un marchio spagnolo di cosmetica professionale. Scegliamo tra le sue linee in base alla sensibilità e alle esigenze osservate durante la valutazione.",
  },
  {
    q: "Quante sedute servono per un protocollo?",
    a: "Dipende dalla pelle, dall’obiettivo e dai cambiamenti osservati. Dopo la valutazione proponiamo una frequenza iniziale e la aggiorniamo durante i controlli.",
  },
  {
    q: "Cosa succede durante la valutazione?",
    a: "In 30–40 minuti parliamo di ciò che vuoi migliorare, osserviamo la pelle e ti spieghiamo il percorso proposto, con frequenza e prezzo. Se scegli di iniziarlo, la valutazione iniziale è gratuita. Gli eventuali prodotti per casa non sono inclusi.",
  },
  {
    q: "Quanto costa un trattamento viso da Rebel?",
    a: "Il prezzo dipende dal trattamento scelto. Nel listino online trovi le singole proposte viso; durante la valutazione concordiamo i passaggi e il prezzo del percorso prima di iniziare.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-protocollo-viso">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />
  <div class="protocol-editorial">
    <PageHero image={photographs["percorso-glow"]} imageCaption="REBEL · Scena illustrativa di un trattamento viso"
      kicker="Trattamento viso · Carmagnola"
      title="Un protocollo viso. _La tua pelle._"
      lead="Osserviamo la pelle e scegliamo la linea più adatta tra Marbellas ed Eberlin. Manualità, attivi e frequenza cominciano da ciò che la tua pelle racconta."
      ctaPrimary={{ label:"Prenota la valutazione", href:"#form" }}
      ctaSecondary={{ label:"Esplora i protocolli", href:"/protocolli-epigenetici" }}
      bullets={["Valutazione · 30–40 minuti", "Trattamento e prezzo concordati prima di iniziare"]}
      meta={["Valutazione iniziale gratuita se inizi il Percorso REBEL", "Viale Barbaroux 20 · Carmagnola"]}
    />

    <section class="pe-section pe-section--paper"><div class="pe-shell pe-approach">
      <figure><img src={photographs["viso-preparazione"].src} srcset={`${photographs["viso-preparazione"].preview} 480w, ${photographs["viso-preparazione"].src} 1440w`} sizes="(max-width:760px) 100vw, 50vw" width="1440" height="810" alt={photographs["viso-preparazione"].alt} loading="lazy" decoding="async" /><figcaption class="pe-image-note">Preparazione cosmetica · Scena illustrativa</figcaption></figure>
      <div class="pe-approach__copy"><p class="pe-kicker">La scelta della linea</p><h2 class="pe-title">Attivi e manualità.<br /><em>Scelti per te.</em></h2><p>Idratazione, sebo, sensibilità e segni visibili orientano la valutazione in studio. Scegliamo i cosmetici in base alla tua pelle e definiamo insieme frequenza e prezzo.</p>
        <div class="pe-lines"><article><h3>Marbellas</h3><p>Linea cosmetica professionale utilizzata nei percorsi dedicati a luminosità, tono e comfort della pelle.</p></article><article><h3>Eberlin</h3><p>Marchio spagnolo di cosmetica professionale. Le linee vengono scelte in base alle esigenze osservate.</p></article></div>
        <p>Il team segue la formazione THORY dedicata alle linee e alle tecnologie utilizzate in studio.</p>
      </div>
    </div></section>

    <section class="pe-section"><div class="pe-shell"><div class="pe-heading"><div><p class="pe-kicker">Dal primo contatto alla cura</p><h2>Un percorso chiaro.<br /><em>Un passo alla volta.</em></h2></div><p>Prima di iniziare conosci linea, frequenza e prezzo e puoi scegliere con calma. I controlli ci aiutano ad aggiornare il programma quando serve.</p></div>
      <ol class="pe-face-steps"><li><span aria-hidden="true">01</span><h3>Lascia i tuoi recapiti</h3><p>Nome, telefono e, se vuoi, cosa vorresti migliorare: luminosità, idratazione, segni o sensibilità.</p></li><li><span aria-hidden="true">02</span><h3>Valutiamo la pelle</h3><p>In 30–40 minuti osserviamo la pelle, parliamo del tuo obiettivo e scegliamo la linea più adatta.</p></li><li><span aria-hidden="true">03</span><h3>Definiamo il trattamento</h3><p>Ti spieghiamo la frequenza proposta, il prezzo e quando faremo il primo controllo.</p></li><li><span aria-hidden="true">04</span><h3>Seguiamo i cambiamenti</h3><p>Durante i controlli osserviamo la pelle e aggiorniamo il programma quando necessario.</p></li></ol>
    </div></section>

    <div class="pe-form-wrap"><div class="pe-shell pe-form-intro"><p class="pe-kicker">Il tuo appuntamento REBEL</p><h2 class="pe-title">Cominciamo<br /><em>dalla tua pelle.</em></h2><p>Se scegli di iniziare il Percorso REBEL, la valutazione iniziale è gratuita. Gli eventuali prodotti per casa non sono inclusi.</p></div>
      <LandingFormCard kicker="Valutazione viso · 30–40 minuti" title="Parliamone insieme."
        lead="Lascia nome e numero. Ti contattiamo personalmente via WhatsApp o telefono per concordare il tuo appuntamento."
        source="landing-viso" submitLabel="Prenota la valutazione" showRitual={false} showMessage={true} />
    </div>

    <section class="pe-section"><div class="pe-shell pe-faq-layout"><div><p class="pe-kicker">Prima di prenotare</p><h2 class="pe-title">La cura comincia<br /><em>con una risposta.</em></h2></div><FaqAccordion items={faqs} /></div></section>
  </div>
  <StickyBookingBar primary={{ label:"Prenota la valutazione", href:"#form" }} />
</BaseLayout>
