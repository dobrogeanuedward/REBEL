---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Pulizia viso per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description:
    "Vivi ad Alba o nelle Langhe? Da Rebel a Carmagnola la pulizia viso comprende osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva. Trenta minuti via A33. Prenotazione su WhatsApp.",
  path: "/pulizia-viso-alba",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "pulizia viso Alba",
    "pulizia del viso Alba",
    "estetista viso Alba",
    "trattamento viso Alba",
    "centro estetico viso Alba",
    "pulizia viso Langhe",
    "pulizia viso vicino Alba",
    "cura viso Alba CN",
    "trattamento pelle Alba",
    "pulizia viso profonda Alba",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Pulizia viso Carmagnola", path: "/servizi/pulizia-viso-carmagnola" },
  { name: "Alba e Langhe", path: "/pulizia-viso-alba" },
]);

const webPage = buildWebPageSchema({
  name: "Pulizia viso per chi viene da Alba e dalle Langhe",
  description: meta.description,
  path: "/pulizia-viso-alba",
});

const articleSchema = buildArticleSchema({
  headline: "Pulizia viso per chi viene da Alba — Rebel (Carmagnola, ~30 min)",
  description: meta.description,
  path: "/pulizia-viso-alba",
  keywords: ["pulizia viso Alba", "trattamento viso Alba", "estetista viso Alba"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Pulizia viso per chi viene da Alba",
  "Pulizia viso professionale per clienti provenienti da Alba e dalle Langhe: detersione, esfoliazione, pulizia mirata e fase lenitiva con prodotti professionali (Eberlin, Marbellas).",
  "/pulizia-viso-alba",
  {
    priceFrom: 49,
    keywords: ["pulizia viso Alba", "trattamento viso Langhe", "estetista viso Alba CN"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/pulizia-viso-alba#service-geo`,
  name: "Pulizia viso per chi viene da Alba",
  serviceType: "Facial cleansing",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Alba",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7008, longitude: 8.0354 },
      geoRadius: "8000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "49.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Alba a Rebel?",
    a: "Circa trenta minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Sono 33 km. Lo studio è in centro, Viale Barbaroux 20, possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "La pulizia viso lascia arrossamento? Ho un evento tra qualche giorno.",
    a: "Può comparire un lieve rossore temporaneo, soprattutto sulla pelle reattiva. Lavoriamo in modo graduale e concludiamo con una fase lenitiva. Per un evento importante ti consigliamo di prenotare almeno 3-4 giorni prima.",
  },
  {
    q: "Passo molto tempo all'aperto. Devo segnalarlo?",
    a: "Sì: raccontaci le esposizioni recenti a sole, vento o polvere e i prodotti che usi a casa. Adattiamo intensità e prodotti a come si presenta la pelle il giorno della seduta.",
  },
  {
    q: "Ogni quanto conviene farla?",
    a: "Spesso si valuta un intervallo di 4-6 settimane, ma non c'è una cadenza uguale per tutte. Dopo la prima seduta ne riparliamo in base a come risponde la pelle e alle tue preferenze.",
  },
  {
    q: "Posso abbinarla a un altro trattamento nello stesso giorno?",
    a: "Dicci quali servizi vorresti abbinare: verifichiamo tempi e compatibilità prima di fissare l'appuntamento. Se hai il laser viso programmato, valutiamo insieme se sia meglio distanziare le sedute.",
  },
  {
    q: "Come prenoto da Alba?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Ascolto e osservazione",
    title: "Prima osserviamo la pelle, poi scegliamo i passaggi.",
    body: "Ci racconti i prodotti che usi, le sensibilità e le esposizioni recenti. Da qui scegliamo intensità e prodotti adatti alla seduta.",
  },
  {
    kicker: "02 · Passaggi con senso",
    title: "Nessun gesto inutile.",
    body: "Detersione, esfoliazione calibrata, pulizia mirata e fase lenitiva finale. Manteniamo solo i passaggi utili per come si presenta la pelle quel giorno.",
  },
  {
    kicker: "03 · Prodotti professionali",
    title: "Eberlin e Marbellas in cabina.",
    body: "Usiamo linee professionali Eberlin e Marbellas, scegliendo i prodotti in base alla seduta. Sensazioni e risposta della pelle possono variare da persona a persona.",
  },
  {
    kicker: "04 · Calendario realistico",
    title: "Un ritmo che si riesce a tenere.",
    body: "Dopo il primo appuntamento possiamo suggerirti una frequenza indicativa, tenendo conto della risposta della pelle e della tua agenda. Non sei obbligata ad acquistare un pacchetto.",
  },
];

const combos = [
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Pulizia viso + laminazione ciglia",
    body: "Puoi chiederci di organizzare pulizia viso e laminazione nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Pulizia viso + manicure semipermanente",
    body: "Se vuoi curare viso e mani nello stesso appuntamento, verifichiamo la disponibilità necessaria.",
  },
  {
    href: "/protocolli/rebel-lift-protocol",
    title: "Pulizia viso + protocollo viso",
    body: "Se vuoi conoscere anche i protocolli viso, durante l'appuntamento possiamo spiegarti come si svolgono e valutare se interessano alle tue esigenze.",
  },
];

const nearbyAreas = [
  { city: "Bra", href: "/pulizia-viso-bra", desc: "~22 min da Carmagnola, via SP7." },
  { city: "Canale", href: "/pulizia-viso-canale", desc: "Roero, ~35 min via A33." },
  { city: "Tutte le località", href: "/localita", desc: "Scopri servizi e indicazioni per ogni zona." },
];

const m = getPageMedia("/pulizia-viso-alba");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Viso — da Alba a Carmagnola"
    title="Pulizia viso per chi viene da Alba: _una seduta costruita sulla tua pelle_."
    lead="Vivi ad Alba o nelle Langhe? Da Carmagnola sono trenta minuti via A33. In Rebel la pulizia viso si svolge per passaggi — osservazione, esfoliazione calibrata, pulizia mirata e chiusura lenitiva — scelti in base a come si presenta la pelle."
    bullets={["Passaggi adattati alla pelle", "Prodotti professionali in cabina", "Valutazione REBEL · 30–40 min"]}
    meta={["~33 km da Alba", "~30 min via A33", "Da 49 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Alba", href: "https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Il risultato -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Come si svolge"
          title="Passaggi scelti _in base alla tua pelle_."
          body="Osserviamo come si presenta la pelle e scegliamo intensità e prodotti per la seduta. La risposta può variare da persona a persona."
          bullets={["Detersione ed esfoliazione calibrata", "Pulizia mirata e fase lenitiva finale", "Indicazioni per i giorni successivi"]}
          cta={{ label: "Scopri la pulizia viso", href: "/servizi/pulizia-viso-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Perché chi vive ad Alba sceglie Rebel -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Cosa trovi da Rebel _venendo da Alba_."
        lead="A circa trenta minuti via A33 trovi una pulizia viso organizzata per passaggi, con prodotti professionali Eberlin e Marbellas e indicazioni chiare prima della seduta."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la prima seduta</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Alba a Rebel: trenta minuti _tra Langhe e pianura_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Alba a Rebel sono circa 33 chilometri. Il percorso più rapido è
            l'<strong>A33 in direzione Torino</strong>, uscita Marene, poi
            <strong>SP661 fino a Carmagnola</strong>: in condizioni normali sei in studio
            in trenta minuti. Chi preferisce la provinciale può prendere SP7 e SP661
            (cinque minuti in più, ma panorama più rilassato tra le colline del Roero).
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Alba&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Alba in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Alba&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Alba a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Ottimizza la visita -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Una sola sosta"
        title="Se desideri abbinare un altro _trattamento_."
        lead="Se vuoi aggiungere un altro servizio allo stesso appuntamento, diccelo quando prenoti: verifichiamo disponibilità, tempi e compatibilità."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Protocolli avanzati -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Oltre la pulizia"
        title="Vuoi conoscere anche _gli altri percorsi viso_?"
        lead="Se cerchi un trattamento diverso dalla pulizia viso, possiamo illustrarti i protocolli disponibili e aiutarti a capire quale appuntamento approfondire."
      />
      <p class="body-p">
        Da Rebel lavoriamo con protocolli Eberlin come il <strong>Rebel Lift Protocol</strong>,
        il <strong>Collagen Code</strong> e il <strong>Catalysis Ritual</strong>, disponibili
        in studio. Ti spieghiamo passaggi, tempi e costi prima di decidere se fissare
        un appuntamento dedicato.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/protocolli-epigenetici">Tutti i protocolli</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Langhe -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Alba a Carmagnola"
      quote="La pelle curata si nota prima di ogni parola."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Alba e dalle _Langhe_: le risposte oneste."
      />
      <FaqAccordion items={faqs} kicker="FAQ Pulizia Viso Alba" />
    </div>
  </section>

  <!-- SEZIONE 6 — Pagina panoramica -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="La pulizia viso non è l'unico motivo per venire a Carmagnola _dalle Langhe_."
        lead="Se ti interessa anche il laser, la manicure semipermanente, i protocolli corpo o la laminazione ciglia, la guida ai servizi per chi arriva da Alba li raccoglie in un’unica pagina."
        primaryHref="/localita/alba"
        primaryLabel="Scopri i servizi REBEL da Alba"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i percorsi viso"
      />
    </div>
  </section>

  <!-- SEZIONE 7 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino ad Alba"
        title="Comuni vicini: _pagine dedicate_ per la pulizia viso."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Valutiamo insieme la _pulizia viso_."
        lead="Ti ascoltiamo, leggiamo la pelle, facciamo la seduta. Poi, se ha senso, costruiamo un ritmo insieme. Nessun obbligo di pacchetti."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la pulizia viso"
        secondaryHref="/servizi/pulizia-viso-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
