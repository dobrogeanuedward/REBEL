---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Pulizia viso per chi viene da Bra | REBEL",
  description:
    "Per chi arriva da Bra: pulizia viso a Carmagnola con osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva. Prenota su WhatsApp.",
  path: "/pulizia-viso-bra",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "pulizia viso Bra",
    "pulizia del viso Bra",
    "estetista viso Bra",
    "trattamento viso Bra",
    "centro estetico viso Bra",
    "pulizia viso vicino Bra",
    "cura viso Bra CN",
    "trattamento pelle Bra",
    "pulizia viso profonda Bra",
    "estetica viso Bra Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Pulizia viso Carmagnola", path: "/servizi/pulizia-viso-carmagnola" },
  { name: "Bra", path: "/pulizia-viso-bra" },
]);

const webPage = buildWebPageSchema({
  name: "Pulizia viso per chi viene da Bra",
  description: meta.description,
  path: "/pulizia-viso-bra",
});

const articleSchema = buildArticleSchema({
  headline: "Pulizia viso per chi viene da Bra — Rebel Carmagnola",
  description: meta.description,
  path: "/pulizia-viso-bra",
  keywords: ["pulizia viso Bra", "trattamento viso Bra", "estetista viso Bra CN"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Pulizia viso per chi viene da Bra",
  "Pulizia viso professionale per clienti di Bra e zona: detersione, esfoliazione calibrata, pulizia mirata e chiusura lenitiva. Prodotti Eberlin e Marbellas.",
  "/pulizia-viso-bra",
  {
    priceFrom: 49,
    keywords: ["pulizia viso Bra", "trattamento viso Bra CN", "estetista viso Bra"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/pulizia-viso-bra#service-geo`,
  name: "Pulizia viso per chi viene da Bra",
  serviceType: "Facial cleansing",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Bra",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.6968, longitude: 7.8558 },
      geoRadius: "6000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "49.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Come arrivo da Bra a Rebel?",
    a: "Lo studio è in Viale Barbaroux 20 a Carmagnola. Apri Google Maps per controllare il percorso da Bra, il traffico e i tempi aggiornati prima di partire.",
  },
  {
    q: "È una pulizia viso delicata o aggressiva?",
    a: "Delicata e precisa. Ogni passaggio ha una logica: osserviamo prima, poi scegliamo intensità di esfoliazione, tipo di pulizia e prodotti in base a come si presenta la pelle quel giorno. Non esiste una pulizia viso uguale per tutte.",
  },
  {
    q: "Ho la pelle secca e sensibile. Va bene comunque?",
    a: "Possiamo adattare la seduta. Sulla pelle secca o sensibile valutiamo un'esfoliazione più lieve, evitiamo passaggi inutilmente aggressivi e curiamo la fase lenitiva finale. La risposta può variare da persona a persona.",
  },
  {
    q: "Ogni quanto dovrei farla?",
    a: "Non c'è una cadenza uguale per tutte. Dopo la seduta ti suggeriamo quando potrebbe essere utile ripeterla, in base a come si presenta e risponde la pelle.",
  },
  {
    q: "Posso venire da Bra e abbinare più trattamenti?",
    a: "Dicci quali servizi vorresti abbinare: prima di fissare l'appuntamento verifichiamo disponibilità, tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Bra?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Seduta personalizzata",
    title: "I passaggi si scelgono dopo aver osservato la pelle.",
    body: "Prima di iniziare parliamo della tua routine e delle sensibilità che hai notato, così possiamo scegliere prodotti e intensità per la seduta.",
  },
  {
    kicker: "02 · Lettura della pelle",
    title: "Partiamo dall'osservazione.",
    body: "Stagione, routine a casa, esposizioni e sensibilità possono cambiare il modo in cui lavoriamo. Adattiamo i passaggi a come si presenta la pelle quel giorno.",
  },
  {
    kicker: "03 · Prodotti e metodo",
    title: "Eberlin, Marbellas e una progressione chiara.",
    body: "Usiamo linee professionali Eberlin e Marbellas, scegliendo i prodotti in base alla seduta. Sensazioni e risposta della pelle possono variare da persona a persona.",
  },
  {
    kicker: "04 · Dopo la seduta",
    title: "Ti suggeriamo quando potrebbe essere utile ripeterla.",
    body: "Valutiamo la risposta della pelle e le tue preferenze. Sarai poi libera di decidere se e quando fissare un altro appuntamento.",
  },
];

const combos = [
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Pulizia viso + laminazione ciglia",
    body: "Puoi chiederci di organizzare pulizia viso e laminazione nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Pulizia viso + manicure semipermanente",
    body: "Se vuoi curare viso e mani nello stesso appuntamento, verifichiamo la disponibilità necessaria.",
  },
  {
    href: "/protocolli/collagen-code",
    title: "Pulizia viso + Collagen Code",
    body: "Se vuoi conoscere anche Collagen Code, possiamo spiegarti come si svolge e valutare un eventuale appuntamento dedicato.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/pulizia-viso-alba", desc: "Scopri la pagina dedicata ad Alba." },
  { city: "Canale", href: "/pulizia-viso-canale", desc: "Scopri la pagina dedicata a Canale." },
  { city: "Tutte le località", href: "/localita", desc: "Scopri servizi e indicazioni per ogni zona." },
];

const m = getPageMedia("/pulizia-viso-bra");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Viso — da Bra a Carmagnola"
    title="Pulizia viso per chi viene da Bra: _una seduta costruita sulla tua pelle_."
    lead="Se vieni da Bra, da Rebel trovi una pulizia viso svolta per passaggi: osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva, con prodotti scelti in base a come si presenta la pelle."
    bullets={["Passaggi adattati alla pelle", "Prodotti professionali in cabina", "Confronto iniziale"]}
    meta={["Studio a Carmagnola", "Indicazioni su Google Maps", "Da 49 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Bra in Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Il risultato -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Come si svolge"
          title="Passaggi scelti _in base alla tua pelle_."
          body="Osserviamo come si presenta la pelle e scegliamo intensità e prodotti per la seduta. La risposta può variare da persona a persona."
          bullets={["Detersione ed esfoliazione calibrata", "Pulizia mirata e fase lenitiva finale", "Indicazioni per i giorni successivi"]}
          cta={{ label: "Scopri la pulizia viso", href: "/servizi/pulizia-viso-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Cosa trovi da Rebel _venendo da Bra_."
        lead="La seduta segue passaggi scelti in base a come si presenta la pelle, con prodotti professionali Eberlin e Marbellas e indicazioni chiare prima di iniziare."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la prima seduta</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Bra a Rebel: _controlla il percorso su Maps_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            REBEL è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Apri Google Maps per controllare il percorso da Bra, il traffico e i tempi
            aggiornati prima di partire.
          </p>
          <p class="body-p">
            Per informazioni aggiornate sui parcheggi disponibili in zona, consulta Maps.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Bra&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Bra in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Bra&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Bra a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Servizi abbinabili"
        title="Se desideri abbinare un altro _trattamento_."
        lead="Se vuoi aggiungere un altro servizio allo stesso appuntamento, diccelo quando prenoti: verifichiamo disponibilità, tempi e compatibilità."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Protocolli avanzati -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Altri trattamenti viso"
        title="Scopri i protocolli disponibili _da Rebel_."
        lead="Se ti interessa un trattamento diverso dalla pulizia viso, ti spieghiamo come si svolge e quanto costa prima di fissare un appuntamento."
      />
      <p class="body-p">
        Tra i protocolli Eberlin disponibili da Rebel ci sono il <strong>Rebel Lift Protocol</strong>,
        il <strong>Collagen Code</strong> e il <strong>Catalysis Ritual</strong>. Prima di prenotare
        ti spieghiamo passaggi, tempi e costi.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/protocolli-epigenetici">Scopri i protocolli</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Bra -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Bra a Carmagnola"
      quote="Ogni seduta viene adattata a come si presenta la pelle."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Informazioni utili sulla pulizia viso per chi viene da _Bra_."
      />
      <FaqAccordion items={faqs} kicker="FAQ Pulizia Viso Bra" />
    </div>
  </section>

  <!-- SEZIONE 6 — Pagina panoramica -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Altri servizi"
        title="Scopri gli altri trattamenti disponibili da _Rebel_."
        lead="Nella pagina dedicata a Bra trovi anche laser, manicure semipermanente, protocolli corpo e laminazione ciglia."
        primaryHref="/localita/bra"
        primaryLabel="Vedi i servizi per Bra"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i percorsi viso"
      />
    </div>
  </section>

  <!-- SEZIONE 7 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Altre località"
        title="Cerchi informazioni per _un'altra zona_?"
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Altra località"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Prima della seduta"
        title="Valutiamo insieme la _pulizia viso_."
        lead="Parliamo delle tue abitudini e osserviamo come si presenta la pelle, poi scegliamo i passaggi della seduta. Al termine possiamo suggerirti una frequenza indicativa."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la pulizia viso"
        secondaryHref="/servizi/pulizia-viso-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
