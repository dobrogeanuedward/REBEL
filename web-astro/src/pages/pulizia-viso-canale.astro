---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Pulizia viso per chi viene da Canale e dal Roero — Rebel (Carmagnola, ~35 min)",
  description:
    "Vivi a Canale o nel Roero? Da Rebel a Carmagnola trovi una pulizia viso con prodotti Eberlin e Marbellas, a circa 35 minuti via A33. Prenotazione su WhatsApp.",
  path: "/pulizia-viso-canale",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "pulizia viso Canale",
    "pulizia del viso Canale",
    "estetista viso Canale",
    "trattamento viso Canale",
    "pulizia viso Roero",
    "pulizia viso vicino Canale",
    "cura viso Canale CN",
    "trattamento pelle Roero",
    "pulizia viso profonda Canale",
    "centro estetico Roero",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Pulizia viso Carmagnola", path: "/servizi/pulizia-viso-carmagnola" },
  { name: "Canale e Roero", path: "/pulizia-viso-canale" },
]);

const webPage = buildWebPageSchema({
  name: "Pulizia viso per chi viene da Canale e dal Roero",
  description: meta.description,
  path: "/pulizia-viso-canale",
});

const articleSchema = buildArticleSchema({
  headline: "Pulizia viso per chi viene da Canale e dal Roero — Rebel (Carmagnola, ~35 min)",
  description: meta.description,
  path: "/pulizia-viso-canale",
  keywords: ["pulizia viso Canale", "trattamento viso Roero", "estetista viso Canale CN"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Pulizia viso per chi viene da Canale e dal Roero",
  "Pulizia viso professionale per clienti di Canale d'Alba e del Roero: osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva con prodotti Eberlin e Marbellas.",
  "/pulizia-viso-canale",
  {
    priceFrom: 49,
    keywords: ["pulizia viso Canale", "trattamento viso Roero", "centro estetico Canale CN"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/pulizia-viso-canale#service-geo`,
  name: "Pulizia viso per chi viene da Canale e dal Roero",
  serviceType: "Facial cleansing",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Canale",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7864, longitude: 8.0281 },
      geoRadius: "9000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "49.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Quanto ci vuole da Canale a Rebel?",
    a: "Circa 35 minuti via A33 uscita Marene, poi SP661 fino a Carmagnola. Sono circa 37 km. Lo studio è in centro, Viale Barbaroux 20, con possibilità di parcheggio nelle vicinanze.",
  },
  {
    q: "Quali prodotti e passaggi usate per la pulizia viso?",
    a: "Usiamo prodotti professionali Eberlin e Marbellas. La seduta comprende osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva, con passaggi scelti in base a come si presenta la pelle.",
  },
  {
    q: "Passo molto tempo all'aperto. Devo segnalarlo?",
    a: "Sì: raccontaci le esposizioni recenti a sole e vento e i prodotti che usi a casa. Adattiamo intensità e prodotti a come si presenta la pelle il giorno della seduta.",
  },
  {
    q: "Ogni quanto conviene farla?",
    a: "Spesso si valuta un intervallo di 4-6 settimane, ma non c'è una cadenza uguale per tutte. Dopo la prima seduta ne riparliamo in base a come risponde la pelle e alle tue preferenze.",
  },
  {
    q: "Posso abbinare la pulizia viso a qualcos'altro nello stesso giorno?",
    a: "Dicci quali servizi vorresti abbinare: prima di fissare l'appuntamento verifichiamo disponibilità, tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Canale?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const points = [
  {
    kicker: "01 · Da Canale a Carmagnola",
    title: "Rebel è a circa 35 minuti.",
    body: "Da Canale raggiungi lo studio a Carmagnola percorrendo circa 37 chilometri via A33 e SP661. Quando prenoti, ti indichiamo durata e disponibilità della seduta.",
  },
  {
    kicker: "02 · Osservazione iniziale",
    title: "Una seduta adattata a come si presenta la pelle.",
    body: "Prima del trattamento parliamo dei prodotti usati a casa, delle sensibilità e delle esposizioni recenti. Da qui scegliamo intensità e prodotti per la seduta.",
  },
  {
    kicker: "03 · Prodotti professionali",
    title: "Eberlin e Marbellas in cabina.",
    body: "Usiamo linee professionali Eberlin e Marbellas, scegliendo i prodotti in base alla seduta. Sensazioni e risposta della pelle possono variare da persona a persona.",
  },
  {
    kicker: "04 · Un piano che si porta avanti",
    title: "Una frequenza da decidere insieme.",
    body: "Dopo il primo appuntamento possiamo suggerirti una cadenza indicativa, spesso ogni 4-6 settimane, tenendo conto della risposta della pelle e della tua agenda.",
  },
];

const combos = [
  {
    href: "/servizi/laminazione-ciglia-sopracciglia-carmagnola",
    title: "Pulizia viso + laminazione ciglia",
    body: "Puoi chiederci di organizzare pulizia viso e laminazione nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
  {
    href: "/servizi/manicure-semipermanente-carmagnola",
    title: "Pulizia viso + manicure semipermanente",
    body: "Se vuoi curare viso e mani nello stesso appuntamento, verifichiamo la disponibilità necessaria.",
  },
  {
    href: "/epilazione-laser-canale",
    title: "Pulizia viso + epilazione laser",
    body: "Se hai già in programma il laser, segnalalo quando prenoti: valutiamo zone e date per capire se sia meglio separare gli appuntamenti.",
  },
];

const nearbyAreas = [
  { city: "Alba", href: "/pulizia-viso-alba", desc: "Langhe, ~30 min via A33." },
  { city: "Bra", href: "/pulizia-viso-bra", desc: "~22 min da Carmagnola." },
  { city: "Tutte le località", href: "/localita", desc: "Scopri servizi e indicazioni per ogni zona." },
];

const m = getPageMedia("/pulizia-viso-canale");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Viso — da Canale a Carmagnola"
    title="Pulizia viso per chi viene da Canale e dal Roero: _a circa 35 minuti_."
    lead="Da Rebel a Carmagnola la pulizia viso si svolge per passaggi — osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva — scelti in base a come si presenta la pelle."
    bullets={["Passaggi adattati alla pelle", "Prodotti professionali in cabina", "Valutazione REBEL · 30–40 min"]}
    meta={["~37 km da Canale", "~35 min via A33", "Da 49 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Canale in Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Il risultato -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Come si svolge"
          title="Passaggi scelti _in base alla tua pelle_."
          body="Osserviamo come si presenta la pelle e scegliamo intensità e prodotti per la seduta. La risposta può variare da persona a persona."
          bullets={["Detersione ed esfoliazione calibrata", "Pulizia mirata e fase lenitiva finale", "Indicazioni per i giorni successivi"]}
          cta={{ label: "Scopri la pulizia viso", href: "/servizi/pulizia-viso-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Il metodo Rebel"
        title="Cosa trovi da Rebel _venendo da Canale_."
        lead="A circa 35 minuti via A33 e SP661 trovi una pulizia viso organizzata per passaggi, con prodotti professionali Eberlin e Marbellas e indicazioni chiare prima della seduta."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la prima seduta</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Canale a Rebel: _35 minuti_ tra il Roero e la pianura torinese."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            Da Canale a Carmagnola il percorso più rapido è via
            <strong>A33 in direzione Torino</strong>, con uscita Marene, poi
            <strong>SP661 fino a Carmagnola</strong>: circa 35-37 minuti in condizioni
            normali. In alternativa si può percorrere la provinciale SP3 fino ad Alba
            e poi risalire verso Carmagnola (qualche minuto in più, ma senza autostrada).
          </p>
          <p class="body-p">
            Lo studio è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Possibilità di parcheggio nelle vicinanze.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Canale+CN&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Canale in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Canale+CN&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Canale a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Una sola sosta"
        title="Se desideri abbinare un altro _trattamento_."
        lead="Se vuoi aggiungere un altro servizio allo stesso appuntamento, diccelo quando prenoti: verifichiamo disponibilità, tempi e compatibilità."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Protocolli avanzati -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Oltre la pulizia"
        title="Vuoi conoscere anche _gli altri percorsi viso_?"
        lead="Se cerchi un trattamento diverso dalla pulizia viso, possiamo illustrarti i protocolli disponibili e aiutarti a capire quale appuntamento approfondire."
      />
      <p class="body-p">
        I protocolli Eberlin che utilizziamo — <strong>Rebel Lift Protocol</strong>,
        <strong>Collagen Code</strong> e <strong>Catalysis Ritual</strong>, disponibili
        in studio. Ti spieghiamo passaggi, tempi e costi prima di decidere se fissare
        un appuntamento dedicato.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/protocolli-epigenetici">Tutti i protocolli</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Roero -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Dal Roero a Carmagnola"
      quote="La pelle curata si nota prima di ogni parola."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Da Canale e dal _Roero_: le risposte che servono."
      />
      <FaqAccordion items={faqs} kicker="FAQ Pulizia Viso Canale" />
    </div>
  </section>

  <!-- SEZIONE 6 — Pagina panoramica -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Vuoi un piano più ampio?"
        title="La pulizia viso non è l'unico motivo per venire a Carmagnola _dal Roero_."
        lead="Se ti interessa anche il laser, la manicure semipermanente, i protocolli corpo o la laminazione ciglia, la guida ai servizi per chi arriva da Canale li raccoglie in un’unica pagina."
        primaryHref="/localita/canale"
        primaryLabel="Scopri i servizi REBEL da Canale"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i percorsi viso"
      />
    </div>
  </section>

  <!-- SEZIONE 7 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Vicino a Canale"
        title="Comuni vicini: _pagine dedicate_ per la pulizia viso."
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Zona vicina"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Valutazione REBEL · 30–40 minuti"
        title="Valutiamo insieme la _pulizia viso_."
        lead="Ti ascoltiamo, leggiamo la pelle, facciamo la seduta. Poi, se ha senso, costruiamo un ritmo insieme. Nessun obbligo di pacchetti."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la pulizia viso"
        secondaryHref="/servizi/pulizia-viso-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
