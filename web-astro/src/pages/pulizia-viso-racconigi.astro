---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import InlineCta from "@/components/InlineCta.astro";
import SplitFeature from "@/components/SplitFeature.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import {
  buildBreadcrumbSchema,
  buildServiceSchema,
  buildWebPageSchema,
  buildArticleSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";
import { getPageMedia } from "@/lib/page-media";

const meta = createPageMeta({
  title: "Pulizia viso per chi viene da Racconigi | REBEL",
  description:
    "Per chi arriva da Racconigi: pulizia viso a Carmagnola con osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva. Prenota su WhatsApp.",
  path: "/pulizia-viso-racconigi",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
  openGraphType: "article",
  keywords: [
    "pulizia viso Racconigi",
    "pulizia del viso Racconigi",
    "estetista viso Racconigi",
    "trattamento viso Racconigi",
    "centro estetico viso Racconigi",
    "pulizia viso vicino Racconigi",
    "cura viso Racconigi CN",
    "trattamento pelle Racconigi",
    "pulizia viso profonda Racconigi",
    "estetica viso Racconigi Cuneo",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Pulizia viso Carmagnola", path: "/servizi/pulizia-viso-carmagnola" },
  { name: "Racconigi", path: "/pulizia-viso-racconigi" },
]);

const webPage = buildWebPageSchema({
  name: "Pulizia viso per chi viene da Racconigi",
  description: meta.description,
  path: "/pulizia-viso-racconigi",
});

const articleSchema = buildArticleSchema({
  headline: "Pulizia viso per chi viene da Racconigi — Rebel Carmagnola",
  description: meta.description,
  path: "/pulizia-viso-racconigi",
  keywords: ["pulizia viso Racconigi", "trattamento viso Racconigi", "estetista viso Racconigi CN"],
  section: "Trattamenti viso",
  image: "https://www.rebelepigenetica.it/img/generated/pulizia-viso-rebel-editorial.png",
});

const serviceSchema = buildServiceSchema(
  "Pulizia viso per chi viene da Racconigi",
  "Pulizia viso professionale per clienti di Racconigi e zona: detersione, esfoliazione calibrata, pulizia mirata e chiusura lenitiva con prodotti Eberlin e Marbellas.",
  "/pulizia-viso-racconigi",
  {
    priceFrom: 49,
    keywords: ["pulizia viso Racconigi", "trattamento viso Racconigi CN", "estetista viso Racconigi"],
  },
);

const geoServiceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "@id": `${siteConfig.siteUrl}/pulizia-viso-racconigi#service-geo`,
  name: "Pulizia viso per chi viene da Racconigi",
  serviceType: "Facial cleansing",
  provider: { "@id": `${siteConfig.siteUrl}/#beauty-salon` },
  areaServed: [
    {
      "@type": "City",
      name: "Racconigi",
      containedInPlace: { "@type": "AdministrativeArea", name: "Provincia di Cuneo" },
    },
    {
      "@type": "GeoCircle",
      geoMidpoint: { "@type": "GeoCoordinates", latitude: 44.7676, longitude: 7.6786 },
      geoRadius: "7000",
    },
  ],
  offers: {
    "@type": "Offer",
    priceCurrency: "EUR",
    price: "49.00",
    url: `${siteConfig.siteUrl}/contatti`,
    availability: "https://schema.org/InStock",
  },
};

const faqs = [
  {
    q: "Come arrivo da Racconigi a Rebel?",
    a: "Lo studio è in Viale Barbaroux 20 a Carmagnola. Apri Google Maps per controllare il percorso da Racconigi, il traffico e i tempi aggiornati prima di partire.",
  },
  {
    q: "È una pulizia viso delicata o aggressiva?",
    a: "Delicata e precisa. Ogni passaggio ha una logica: osserviamo prima, poi scegliamo intensità di esfoliazione, tipo di pulizia e prodotti in base a come si presenta la pelle quel giorno. Non esiste una pulizia viso uguale per tutte.",
  },
  {
    q: "Ho la pelle secca e sensibile. Va bene comunque?",
    a: "Possiamo adattare la seduta. Sulla pelle secca o sensibile valutiamo un'esfoliazione più lieve, evitiamo passaggi inutilmente aggressivi e curiamo la fase lenitiva finale. La risposta può variare da persona a persona.",
  },
  {
    q: "Ogni quanto dovrei farla?",
    a: "Non c'è una cadenza uguale per tutte. Dopo la seduta ti suggeriamo quando potrebbe essere utile ripeterla, in base a come si presenta e risponde la pelle.",
  },
  {
    q: "Posso venire da Racconigi e abbinare più trattamenti?",
    a: "Dicci quali servizi vorresti abbinare: prima di fissare l'appuntamento verifichiamo disponibilità, tempi e compatibilità.",
  },
  {
    q: "Come prenoto da Racconigi?",
    a: "Scrivici su WhatsApp indicando il giorno preferito: verifichiamo insieme le disponibilità.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const speakableSchema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": `${siteConfig.siteUrl}/pulizia-viso-racconigi#speakable`,
  name: "Pulizia viso per chi viene da Racconigi",
  speakable: {
    "@type": "SpeakableSpecification",
    cssSelector: [".page-hero__title", ".page-hero__lead"],
  },
  url: `${siteConfig.siteUrl}/pulizia-viso-racconigi`,
};

const points = [
  {
    kicker: "01 · Da Racconigi a Carmagnola",
    title: "Indicazioni per raggiungere REBEL.",
    body: "Lo studio è a Carmagnola. Per percorso, traffico e tempi aggiornati da Racconigi, consulta Google Maps prima di partire.",
  },
  {
    kicker: "02 · Lettura della pelle",
    title: "Partiamo dall'osservazione.",
    body: "Stagione, routine a casa, esposizioni e sensibilità possono cambiare il modo in cui lavoriamo. Adattiamo i passaggi a come si presenta la pelle quel giorno.",
  },
  {
    kicker: "03 · Prodotti e metodo",
    title: "Eberlin, Marbellas e una progressione chiara.",
    body: "Usiamo linee professionali Eberlin e Marbellas, scegliendo i prodotti in base alla seduta. Sensazioni e risposta della pelle possono variare da persona a persona.",
  },
  {
    kicker: "04 · Dopo la seduta",
    title: "Ti suggeriamo quando potrebbe essere utile ripeterla.",
    body: "Valutiamo la risposta della pelle e le tue preferenze. Sarai poi libera di decidere se e quando fissare un altro appuntamento.",
  },
];

const combos = [
  {
    href: "/laminazione-racconigi",
    title: "Pulizia viso + laminazione ciglia",
    body: "Puoi chiederci di organizzare pulizia viso e laminazione nella stessa visita: prima confermiamo tempi e compatibilità.",
  },
  {
    href: "/manicure-semipermanente-racconigi",
    title: "Pulizia viso + manicure semipermanente",
    body: "Se vuoi curare viso e mani nello stesso appuntamento, verifichiamo la disponibilità necessaria.",
  },
  {
    href: "/protocolli/collagen-code",
    title: "Pulizia viso + Collagen Code",
    body: "Se vuoi conoscere anche Collagen Code, possiamo spiegarti come si svolge e valutare un eventuale appuntamento dedicato.",
  },
];

const nearbyAreas = [
  { city: "Caramagna Piemonte", href: "/localita/caramagna-piemonte", desc: "Scopri i servizi per chi arriva da Caramagna Piemonte." },
  { city: "Carignano", href: "/localita/carignano", desc: "Scopri i servizi per chi arriva da Carignano." },
  { city: "Savigliano", href: "/localita/savigliano", desc: "Scopri i servizi per chi arriva da Savigliano." },
];

const m = getPageMedia("/pulizia-viso-racconigi");
---

<BaseLayout meta={meta}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={articleSchema} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={geoServiceSchema} />
  <JsonLd data={faqSchema} />
  <JsonLd data={speakableSchema} />

  <PageHero
    image={m.hero}
    kicker="Rebel Viso — da Racconigi a Carmagnola"
    title="Pulizia viso per chi viene da Racconigi: _passaggi scelti sulla tua pelle_."
    lead="Da Rebel la pulizia viso si svolge per passaggi: osservazione, esfoliazione calibrata, pulizia mirata e fase lenitiva, scelti in base a come si presenta la pelle."
    bullets={["Passaggi adattati alla pelle", "Prodotti professionali in cabina", "Confronto iniziale"]}
    meta={["Studio a Carmagnola", "Indicazioni su Google Maps", "Da 49 € a seduta"]}
    ctaPrimary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp, halo: true }}
    ctaSecondary={{ label: "Apri il percorso da Racconigi in Maps", href: "https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving" }}
  />

  <!-- SPLIT — Il risultato -->
  {m.splitA ? (
    <section class="section section--tight">
      <div class="container">
        <SplitFeature
          image={m.splitA}
          side="right"
          kicker="Come si svolge"
          title="Passaggi scelti _in base alla tua pelle_."
          body="Osserviamo come si presenta la pelle e scegliamo intensità e prodotti per la seduta. La risposta può variare da persona a persona."
          bullets={["Detersione ed esfoliazione calibrata", "Pulizia mirata e fase lenitiva finale", "Indicazioni per i giorni successivi"]}
          cta={{ label: "Scopri la pulizia viso", href: "/servizi/pulizia-viso-carmagnola" }}
        />
      </div>
    </section>
  ) : null}

  <!-- SEZIONE 1 — Il metodo -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Da Racconigi"
        title="Una pulizia viso _adattata a come si presenta la pelle_."
        lead="Dopo la prima seduta possiamo suggerirti una frequenza indicativa, tenendo conto della risposta della pelle e delle tue preferenze."
      />
      <div class="card-grid card-grid--2">
        {points.map((p, i) => (
          <FeatureCard
            kicker={p.kicker}
            title={p.title}
            body={p.body}
            variant={i === 0 ? "feature" : "default"}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster" style="margin-top:2rem;">
        <a class="btn btn--primary" href="/contatti">Prenota la prima seduta</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
        <a class="btn btn--secondary" href="/listino-estetica-laser">Listino e prezzi</a>
      </div>
    </div>
  </section>

  <!-- SEZIONE 2 — Come arrivare -->
  <section class="section section--scene-ivory">
    <div class="container">
      <SectionHead
        kicker="Come arrivare"
        title="Da Racconigi a Rebel: _controlla il percorso su Maps_."
      />
      <div class="directions-grid">
        <div>
          <p class="body-p">
            REBEL è in <strong>Viale Barbaroux 20</strong>, nel centro di Carmagnola.
            Apri Google Maps per controllare il percorso da Racconigi, il traffico e i tempi
            aggiornati prima di partire.
          </p>
          <p class="body-p">
            Per informazioni aggiornate sui parcheggi disponibili in zona, consulta Maps.
          </p>
          <div class="cluster" style="margin-top:1.4rem;">
            <a
              class="btn btn--secondary btn--sm"
              href="https://www.google.com/maps/dir/?api=1&origin=Racconigi&destination=Viale+Barbaroux+20,+10022+Carmagnola+TO&travelmode=driving"
              target="_blank"
              rel="noreferrer"
            >
              Apri il percorso da Racconigi in Maps
            </a>
            <a class="btn btn--secondary btn--sm" href="/contatti">Contatti e mappa</a>
          </div>
        </div>
        <div class="map-frame">
          <iframe
            src="https://www.google.com/maps?f=d&source=s_d&saddr=Racconigi&daddr=Viale+Barbaroux+20,+10022+Carmagnola+TO&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Percorso da Racconigi a Rebel Carmagnola"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- SEZIONE 3 — Abbinamenti -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Servizi abbinabili"
        title="Se desideri abbinare un altro _trattamento_."
        lead="Se vuoi aggiungere un altro servizio allo stesso appuntamento, diccelo quando prenoti: verifichiamo disponibilità, tempi e compatibilità."
      />
      <div class="card-grid card-grid--3" style="margin-top:2rem;">
        {combos.map((c) => (
          <FeatureCard
            title={c.title}
            body={c.body}
            href={c.href}
            variant="quiet"
          />
        ))}
      </div>
    </div>
  </section>

  <!-- SEZIONE 4 — Protocolli avanzati -->
  <section class="section section--scene-ivory">
    <div class="container container--narrow">
      <SectionHead
        kicker="Altri trattamenti viso"
        title="Scopri i protocolli disponibili _da Rebel_."
        lead="Se ti interessa un trattamento diverso dalla pulizia viso, ti spieghiamo come si svolge e quanto costa prima di fissare un appuntamento."
      />
      <p class="body-p">
        Tra i protocolli Eberlin disponibili da Rebel ci sono il <strong>Rebel Lift Protocol</strong>,
        il <strong>Collagen Code</strong> e il <strong>Catalysis Ritual</strong>. Prima di prenotare
        ti spieghiamo passaggi, tempi e costi.
      </p>
      <div class="cluster" style="margin-top:1.6rem;">
        <a class="btn btn--primary" href="/protocolli-epigenetici">Scopri i protocolli</a>
        <a class="btn btn--secondary" href="/servizi/pulizia-viso-carmagnola">Scopri la pulizia viso</a>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED — mood Racconigi -->
  {m.mood ? (
    <FullBleedBand
      image={m.mood}
      height="md"
      align="left"
      kicker="Da Racconigi a Carmagnola"
      quote="Una pulizia viso costruita in base a come si presenta la tua pelle."
      cta={{ label: "Prenota la valutazione", href: "/contatti" }}
    />
  ) : null}

  <!-- SEZIONE 5 — FAQ -->
  <section class="section">
    <div class="container container--narrow">
      <SectionHead
        kicker="Domande frequenti"
        title="Le domande più comuni per chi arriva da _Racconigi_."
      />
      <FaqAccordion items={faqs} kicker="FAQ Pulizia Viso Racconigi" />
    </div>
  </section>

  <!-- SEZIONE 6 — Pagina panoramica -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Altri servizi"
        title="Scopri gli altri trattamenti disponibili da _Rebel_."
        lead="Nella pagina dedicata a Racconigi trovi anche laser, manicure semipermanente, protocolli corpo e laminazione ciglia."
        primaryHref="/localita/racconigi"
        primaryLabel="Vedi i servizi per Racconigi"
        secondaryHref="/protocolli-epigenetici"
        secondaryLabel="Scopri i percorsi viso"
      />
    </div>
  </section>

  <!-- SEZIONE 7 — Comuni vicini -->
  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Altre località"
        title="Cerchi informazioni per _un'altra zona_?"
      />
      <div class="card-grid card-grid--3">
        {nearbyAreas.map((a, i) => (
          <FeatureCard
            kicker="Altra località"
            title={a.city}
            body={a.desc}
            href={a.href}
            variant="quiet"
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="section section--scene-ivory">
    <div class="container">
      <InlineCta
        kicker="Prima della seduta"
        title="Valutiamo insieme la _pulizia viso_."
        lead="Parliamo delle tue abitudini e osserviamo come si presenta la pelle, poi scegliamo i passaggi della seduta. Al termine possiamo suggerirti una frequenza indicativa."
        primaryLabel="Prenota su WhatsApp"
        primaryHref={siteConfig.social.whatsapp}
        secondaryLabel="Scopri la pulizia viso"
        secondaryHref="/servizi/pulizia-viso-carmagnola"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .editorial-image-frame {
    border-radius: var(--r-lg);
    overflow: hidden;
    max-height: 520px;
  }
  .editorial-image-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .section--tight { padding-block: 1.5rem; }
  .directions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 1.6rem;
    align-items: start;
  }
  @media (max-width: 760px) {
    .directions-grid { grid-template-columns: 1fr; }
  }
  .map-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
    background: rgba(7, 5, 14, 0.5);
  }
  .map-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .body-p {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--text);
    margin: 0 0 0.9rem;
    max-width: 70ch;
  }
  .cluster { display: flex; flex-wrap: wrap; gap: 0.6rem; }
</style>
