---
import RblNailEditorial from "@/components/RblNailEditorial.astro";
import { rblVariantForService } from "@/lib/rbl-nails";
import ServiceCatalogChoices from "@/components/ServiceCatalogChoices.astro";
import { getServiceSearchCopy } from "@/lib/service-search-content";
import { serviceContactPath, serviceWhatsApp } from "@/lib/service-booking";
import JourneyCarousel from "@/components/JourneyCarousel.astro";
import laminazioneCarousel from "@/data/laminazione-carousel.json";
import { servicePhotography } from "@/lib/beauty-editorial";
import { photographs } from "@/lib/catalog-visuals";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import ServiceAreaDiscovery from "@/components/ServiceAreaDiscovery.astro";
import LaserOffer from "@/components/LaserOffer.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import {
  servicePages,
  competencePages,
} from "@/lib/seo-content-refined";
import { protocolPages } from "@/lib/protocol-pages";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { laserOffer } from "@/lib/laser-offer";

export async function getStaticPaths() {
  return servicePages.map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service: originalService } = Astro.props;
const selectedPhotos = (originalService.slug === "ceretta-carmagnola"
  ? [photographs["cera-gamba"], photographs["cera-preparazione"]]
  : servicePhotography[originalService.slug]?.map(key => photographs[key]));
const service = { ...originalService, heroImage: selectedPhotos?.[0] ?? originalService.heroImage };
const isLamination = service.slug === "laminazione-ciglia-sopracciglia-carmagnola";
const isColorPedicure = ["pedicure-estetico-con-smalto-carmagnola", "pedicure-semipermanente-carmagnola"].includes(service.slug);
const rblVariant = rblVariantForService(service.slug);
const hasRblEditorial = Boolean(rblVariant);
const contactPath = serviceContactPath(service.slug);
const whatsappPath = serviceWhatsApp(service.slug);


const resolveEditorialMedia = (slug: string): readonly ImageAsset[] => {
  if (/laser/.test(slug)) return [media.laser.handpiece, media.laser.consult];
  if (/laminazione/.test(slug)) return [media.lamina.detail, media.lamina.hero];
  if (/manicure|semipermanente/.test(slug) && !/pedicure/.test(slug)) {
    return [media.manicure.detail, media.manicure.hero];
  }
  if (/pedicure|unghie-piedi/.test(slug)) return [media.pedicure.detail, media.pedicure.hero];
  if (/linfodrenante/.test(slug)) return [media.drenante.detail, media.drenante.hero];
  if (/massaggio/.test(slug)) return [media.massaggio.detail, media.massaggio.hero];
  if (/pulizia-viso/.test(slug)) return [media.viso.texture, media.viso.products];
  if (/scrub-corpo/.test(slug)) return [media.corpo.detail, media.corpo.hero];
  return [media.studio.professional, media.studio.reception];
};
const editorialMedia = selectedPhotos?.slice(1) ?? resolveEditorialMedia(service.slug);
const introductionImage = editorialMedia[0] ?? service.heroImage;
const photoForService = (slug: string, fallback?: ImageAsset) => {
  const key = servicePhotography[slug]?.[0];
  return key ? photographs[key] : fallback;
};

const fallbackImage =
  service.category === "laser"
    ? "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public"
    : "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";

const baseServiceName = service.name.replace(/\s+a Carmagnola$/i, "").trim();
const serviceNameLower = `${baseServiceName.charAt(0).toLocaleLowerCase("it-IT")}${baseServiceName.slice(1)}`;
const priceFromMatch = service.priceHint.match(/(\d+(?:[.,]\d+)?)/);
const priceFrom = priceFromMatch ? Number(priceFromMatch[1].replace(",", ".")) : undefined;
const formatPrice = (value: string) =>
  value
    .replace(/\bEUR\s*(\d+(?:[.,]\d+)?)/gi, "€$1")
    .replace(/€\s+(\d+(?:[.,]\d+)?)/g, "€$1")
    .replace(/(\d+)\.(\d{2})\b/g, "$1,$2")
    .replace(/(€\d+(?:,\d+)?)\s+a\s+(\d+(?:,\d+)?)(?!\s*€)/g, "$1 a €$2")
    .replace(/\s*\/\s*/g, " / ")
    .replace(/\s{2,}/g, " ")
    .trim();
const displayPrice = formatPrice(service.priceHint);
const serviceMetaDescription = service.shortDescription.length >= 105
  ? service.shortDescription
  : `${service.shortDescription} Durata, prezzo e prenotazioni nel centro REBEL di Carmagnola.`;
const searchCopy = getServiceSearchCopy(service.slug);
const priceIntentKeywords = [
  `${baseServiceName} prezzi Carmagnola`,
  `prezzi ${baseServiceName} Carmagnola`,
  `${baseServiceName} Carmagnola`,
  `${baseServiceName} vicino a me`,
  `${baseServiceName} Carmagnola vicino a me`,
];

const meta = createPageMeta({
  title: searchCopy?.title ?? service.name,
  description: searchCopy?.description ?? serviceMetaDescription,
  path: `/servizi/${service.slug}`,
  keywords: [...service.keywords, ...priceIntentKeywords],
  openGraphType: "article",
  image: service.heroImage?.src ?? fallbackImage,
});

const slugifyId = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[’']/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, "-")
    .replace(/-+/g, "-")
    .replace(/(^-|-$)/g, "");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Servizi", path: "/servizi" },
  { name: service.name, path: `/servizi/${service.slug}` },
]);
const webPage = buildWebPageSchema({
  name: service.name,
  description: serviceMetaDescription,
  path: `/servizi/${service.slug}`,
});
const serviceSchema = buildServiceSchema(
  service.name,
  service.longDescription,
  `/servizi/${service.slug}`,
  {
    priceFrom: service.category === "laser" ? undefined : priceFrom,
    keywords: [...service.keywords, ...priceIntentKeywords],
  },
);
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const relatedCompetences = competencePages.filter((c) =>
  service.relatedCompetenceSlugs.includes(c.slug),
);
const relatedProtocols = (service.relatedProtocolSlugs ?? [])
  .map((sl) => protocolPages.find((p) => p.slug === sl))
  .filter((p): p is (typeof protocolPages)[number] => Boolean(p))
  .slice(0, 4);
const explicitRelatedServices = service.relatedServiceSlugs ?? [];
const siblingServices = servicePages
  .filter((i) => i.slug !== service.slug && i.category === service.category)
  .map((i) => ({
    item: i,
    score: (explicitRelatedServices.includes(i.slug) ? 100 : 0) + i.relatedCompetenceSlugs.filter((rs) =>
      service.relatedCompetenceSlugs.includes(rs),
    ).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ item }) => item);


const relatedCompetencesSchema =
  relatedCompetences.length > 0
    ? buildItemListSchema({
        name: `Guide correlate a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: relatedCompetences.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
      })
    : null;
const relatedProtocolsSchema =
  relatedProtocols.length > 0
    ? buildItemListSchema({
        name: `Protocolli professionali collegati a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: relatedProtocols.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
      })
    : null;
const siblingServicesSchema =
  siblingServices.length > 0
    ? buildItemListSchema({
        name: `Altri servizi collegati a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: siblingServices.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })),
      })
    : null;
const editorialSections = service.editorialSections ?? [];
const sourceLinks = service.sourceLinks ?? [];

const tocItems = [
  { id: "benefici", label: "Obiettivi" },
  ...(!isColorPedicure ? [{ id: "prezzi", label: "Prezzo" }] : []),
  ...(hasRblEditorial ? [{ id: "rbl-colori", label: "Colori RBL Nails" }] : []),
  ...(editorialSections.length > 0 ? [{ id: "dettagli", label: "Come si svolge" }] : []),
  { id: "faq", label: "Domande frequenti" },
  ...(relatedCompetences.length > 0 ? [{ id: "guide", label: "Approfondimenti" }] : []),
  ...(sourceLinks.length > 0 ? [{ id: "fonti", label: "Fonti" }] : []),
  ...(relatedProtocols.length > 0 ? [{ id: "protocolli", label: "Protocolli REBEL" }] : []),
  ...(siblingServices.length > 0 ? [{ id: "anche", label: "Altri trattamenti" }] : []),
  { id: "raggiungerci", label: "Come raggiungerci" },
];
---
<BaseLayout meta={meta} bodyClass={`rebel-rebrand rebel-shell page-servizio-detail ${service.category === "laser" ? "page-servizio-laser" : "page-servizio-classica"}`}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={faqSchema} />
  {relatedCompetencesSchema ? <JsonLd data={relatedCompetencesSchema} /> : null}
  {relatedProtocolsSchema ? <JsonLd data={relatedProtocolsSchema} /> : null}
  {siblingServicesSchema ? <JsonLd data={siblingServicesSchema} /> : null}

  <PageHero
    image={service.heroImage}
    imageCaption="Immagine editoriale illustrativa del trattamento."
    kicker={service.category === "laser" ? "Epilazione laser · Carmagnola" : "Beauty REBEL · Carmagnola"}
    title={service.name.replace(/Carmagnola/i, "_Carmagnola_")}
    lead={service.shortDescription}
    bullets={isColorPedicure
      ? ["Cura del piede e scelta del colore", "Su appuntamento · REBEL"]
      : [service.category === "laser" ? `Listino ordinario · ${displayPrice}` : displayPrice, "Su appuntamento · REBEL"]}
    meta={["Viale Barbaroux 20", "Da martedì a sabato"]}
    ctaPrimary={{ label: "Chiedi un appuntamento", href: contactPath, halo: true }}
    ctaSecondary={{ label: "Scopri il trattamento", href: "#benefici" }}
  />

  <div class="service-editorial">
    <div class="detail-shell detail-navigation">
      <nav class="detail-jumpnav" aria-label="In questa pagina"><span>Esplora</span>{tocItems.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}</nav>
    </div>

    <section class="detail-section detail-section--intro" id="benefici" aria-labelledby="service-intro-title">
      <div class="detail-shell detail-intro">
        <div class="detail-intro__copy">
          <p class="detail-kicker">Il tuo appuntamento REBEL</p>
          <h2 id="service-intro-title">Il trattamento.<br /><em>Con cura, dall’inizio.</em></h2>
          <p class="detail-lead">{service.longDescription}</p>
          <KeyPointsGrid points={service.benefits} variant="quiet" />
        </div>
        {introductionImage && <figure class="detail-intro__photo"><img src={introductionImage.src} alt={introductionImage.alt} width={introductionImage.width ?? 1200} height={introductionImage.height ?? 900} loading="lazy" decoding="async" /><figcaption>Un dettaglio del trattamento · immagine illustrativa.</figcaption></figure>}
      </div>
    </section>

    {rblVariant && <RblNailEditorial variant={rblVariant} bookingHref={contactPath} />}
    {isLamination && <JourneyCarousel carousel={laminazioneCarousel} slug="laminazione" service />}

    {service.category === "laser" && <section class="detail-section detail-section--promo" aria-label="La promozione laser REBEL"><div class="detail-shell"><LaserOffer compact /></div></section>}

    {!isColorPedicure && <section id="prezzi" class="detail-section detail-section--paper" aria-labelledby="service-price-title">
      <div class="detail-shell">
        <div class="detail-heading-row"><div><p class="detail-kicker">Il menu, in chiaro</p><h2 id="service-price-title">Scegli la tua seduta.<br /><em>Confronta le varianti.</em></h2></div><p>{isLamination ? "Ciglia, sopracciglia o il trattamento combinato: confronta i prezzi ordinari e le durate." : service.category === "laser" ? "Qui trovi il listino ordinario per zona. Le condizioni della promozione laser sono riportate nella sezione dedicata." : "Trovi le varianti del trattamento, i prezzi ordinari e le durate. Scegli la proposta più vicina a ciò che desideri."}</p></div>
        <ServiceCatalogChoices slug={service.slug} />
        <div class="detail-price-note"><p><span>{service.category === "laser" ? "Listino ordinario" : "Prezzo del servizio"}</span><strong>{displayPrice}</strong></p><a class="detail-link" href="/listino-estetica-laser">Esplora tutto il listino <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>}

    {editorialSections.length > 0 && <section id="dettagli" class="detail-section" aria-labelledby="service-steps-title"><div class="detail-shell">
      <header class="detail-heading"><p class="detail-kicker">Prima, durante, dopo</p><h2 id="service-steps-title">I gesti, i tempi.<br /><em>Quello che vuoi sapere.</em></h2><p>Come prepararti, che cosa succede durante l’appuntamento e come prenderti cura della zona dopo.</p></header>
      <div class="editorial-flow">{editorialSections.map((s, i) => <EditorialSection id={slugifyId(s.heading)} heading={s.heading} paragraphs={s.paragraphs} level={3} sequence={i + 1} media={i % 2 === 0 ? editorialMedia[Math.floor(i / 2) % editorialMedia.length] : undefined} mediaSide={Math.floor(i / 2) % 2 === 0 ? "end" : "start"} />)}</div>
    </div></section>}

    <section id="faq" class="detail-section detail-section--paper" aria-labelledby="service-faq-title"><div class="detail-shell detail-questions">
      <header><p class="detail-kicker">Prima di scegliere</p><h2 id="service-faq-title">Le domande<br /><em>pratiche.</em></h2><p>Indicazioni utili su {serviceNameLower}, per arrivare al tuo appuntamento con le idee più chiare.</p></header>
      <div><FaqAccordion items={service.faqs} kicker={`Domande su ${baseServiceName}`} /></div>
    </div></section>

    <section class="detail-section detail-section--booking" aria-labelledby="service-booking-title"><div class="detail-shell detail-booking">
      <div><p class="detail-kicker">Il prossimo passo</p><h2 id="service-booking-title">Parliamo del tuo<br /><em>appuntamento.</em></h2></div>
      <div><p>{isColorPedicure ? "Dal colore alla finitura, scegliamo insieme i dettagli del tuo prossimo pedicure. Raccontaci il risultato che desideri e quando vorresti venire." : "Scrivici indicando il trattamento e quando vorresti venire: ti aiutiamo a scegliere la variante e ti confermiamo disponibilità, durata e prezzo."}</p><div class="detail-actions"><a class="btn btn--primary" href={contactPath}>Chiedi un appuntamento <span aria-hidden="true">↗</span></a><a class="detail-link" href={whatsappPath}>Scrivici su WhatsApp</a></div><p class="detail-booking__address">REBEL · Viale Barbaroux 20 · Carmagnola</p></div>
    </div></section>

    {relatedCompetences.length > 0 && <section id="guide" class="detail-section" aria-labelledby="service-guides-title"><div class="detail-shell detail-reading">
      <header><p class="detail-kicker">Il tempo di capire</p><h2 id="service-guides-title">Approfondisci,<br /><em>poi scegli.</em></h2></header>
      <div class="detail-reading__list">{relatedCompetences.map((c, i) => <a href={`/competenze/${c.slug}`}><span class="detail-reading__index">{String(i + 1).padStart(2, "0")}</span><div><span class="detail-kicker">Guida REBEL</span><h3>{c.title}</h3><p>{c.shortDescription}</p></div><span aria-hidden="true">↗</span></a>)}</div>
    </div></section>}

    {relatedProtocols.length > 0 && <section id="protocolli" class="detail-section detail-section--paper" aria-labelledby="service-protocols-title"><div class="detail-shell">
      <header class="detail-heading"><p class="detail-kicker">Protocolli REBEL</p><h2 id="service-protocols-title">Quando la cura<br /><em>diventa un percorso.</em></h2><p>Obiettivi e modalità dei protocolli collegati a questo trattamento.</p></header>
      <div class="detail-protocols">{relatedProtocols.map((p, i) => <a href={`/protocolli/${p.slug}`}><span class="detail-kicker">{String(i + 1).padStart(2,"0")} · {formatPrice(p.price)}</span><h3>{p.name}</h3><p>{p.shortDescription}</p><span class="detail-link">Conosci il protocollo <span aria-hidden="true">↗</span></span></a>)}</div>
    </div></section>}

    {siblingServices.length > 0 && <section id="anche" class="detail-section" aria-labelledby="service-related-title"><div class="detail-shell">
      <header class="detail-heading"><p class="detail-kicker">Il mondo beauty REBEL</p><h2 id="service-related-title">Un’altra idea<br /><em>di cura.</em></h2></header>
      <div class="detail-related">{siblingServices.map((s) => { const photo = photoForService(s.slug, s.heroImage); const hidePrice = ["pedicure-estetico-con-smalto-carmagnola", "pedicure-semipermanente-carmagnola"].includes(s.slug); return <a href={`/servizi/${s.slug}`}>{photo && <div class="detail-related__photo"><img src={photo.src} alt={photo.alt} width={photo.width ?? 1200} height={photo.height ?? 800} loading="lazy" decoding="async" /></div>}<div class="detail-related__copy"><p class="detail-kicker">{hidePrice ? "Cura e colore" : formatPrice(s.priceHint)}</p><h3>{s.name.replace(/ a Carmagnola$/i, "")}<span aria-hidden="true"> ↗</span></h3><p>{s.shortDescription}</p></div></a>; })}</div>
    </div></section>}

    {sourceLinks.length > 0 && <section id="fonti" class="detail-section detail-section--sources" aria-labelledby="service-sources-title"><div class="detail-shell"><details class="detail-sources"><summary id="service-sources-title">Fonti e riferimenti tecnici <span aria-hidden="true">＋</span></summary><p>Le fonti consultate per le informazioni tecniche di questa pagina.</p><ul>{sourceLinks.map((s) => <li><a href={s.url} target="_blank" rel="noreferrer">{s.label} <span aria-hidden="true">↗</span></a></li>)}</ul></details></div></section>}

    <ServiceAreaDiscovery />
  </div>
  <StickyBookingBar priceHint={service.category === "laser" ? laserOffer.stickyLabel : isColorPedicure ? undefined : displayPrice} promo={service.category === "laser"} primary={service.category === "laser" ? { label: "Richiedi la promo", href: laserOffer.contactPath } : { label: "Chiedi un appuntamento", href: contactPath }} whatsappHref={whatsappPath} />
</BaseLayout>

<style>
  .service-editorial { color-scheme: light; --text: #301b3e; --text-strong: #301b3e; --text-muted: #685471; --line: #e2d6e7; background: #f8f3ed; color: #301b3e; }
  .detail-shell { width: min(1240px,calc(100% - 2 * clamp(1.2rem,4vw,3.5rem))); margin-inline: auto; }
  .service-editorial :is(h2,h3,p,figure) { margin: 0; }
  .service-editorial :is(h2,h3) { color: #301b3e; overflow-wrap: normal; }
  .service-editorial h2 { font: 500 clamp(2.15rem,4.2vw,4rem)/1.09 var(--font-display); letter-spacing: -.035em; }
  .service-editorial em { color: #70428b; font-weight: 400; }
  .service-editorial p { color: #685471; line-height: 1.75; }
  .service-editorial .detail-kicker { color: #a51e58; font: 650 .73rem/1.6 var(--font-body); letter-spacing: .13em; text-transform: uppercase; margin-bottom: 1rem; }
  .detail-navigation { padding-block: 1rem; }
  .detail-jumpnav { display: flex; gap: .6rem 1.35rem; align-items: center; overflow-x: auto; padding-bottom: .35rem; border-bottom: 1px solid #dfd0e6; }
  .detail-jumpnav>span { color: #a51e58; font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; padding-right: .3rem; }
  .detail-jumpnav a { flex-shrink: 0; display: inline-flex; align-items: center; min-height: 44px; color: #70428b; font-size: .78rem; text-decoration: none; }
  .detail-jumpnav a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .detail-section { padding-block: clamp(3.5rem,7vw,6.5rem); scroll-margin-top: 6rem; }
  .detail-section--paper { background: #fffdf9; }
  .detail-section--intro { padding-top: clamp(2rem,4vw,4rem); }
  .detail-section--promo { padding-top: 0; }
  .detail-intro { display: grid; grid-template-columns: 1.05fr 1fr; gap: clamp(2rem,5vw,5rem); align-items: center; }
  .detail-intro__copy { min-width: 0; }
  .service-editorial .detail-lead { margin-top: 1.5rem; font-size: 1.02rem; max-width: 62ch; }
  .detail-intro__photo { min-width: 0; }
  .detail-intro__photo img { width: 100%; height: auto; aspect-ratio: 4/5; display: block; object-fit: cover; border-radius: 3rem .4rem 3rem .4rem; }
  .detail-intro__photo figcaption { color: #786981; font-size: .7rem; line-height: 1.5; margin-top: .65rem; }
  .detail-heading { max-width: 800px; margin-bottom: clamp(2rem,4vw,3.5rem); }
  .detail-heading>p:last-child:not(.detail-kicker) { margin-top: 1.3rem; max-width: 64ch; }
  .detail-heading-row { display: grid; grid-template-columns: 1.2fr .8fr; gap: clamp(1.5rem,5vw,5rem); align-items: end; margin-bottom: 2rem; }
  .detail-price-note { display: flex; justify-content: space-between; align-items: center; gap: 1.5rem; flex-wrap: wrap; border-top: 1px solid #dfd0e6; padding-top: 1.5rem; margin-top: 2rem; }
  .detail-price-note p>span { display: block; font-size: .74rem; }
  .detail-price-note strong { color: #70428b; font-weight: 600; display: block; font-size: 1.15rem; }
  .service-editorial .detail-link { display: inline-flex; align-items: center; gap: .7rem; min-height: 44px; color: #70428b; font-size: .83rem; font-weight: 650; text-underline-offset: .3em; }
  .editorial-flow { display: grid; gap: clamp(2.5rem,6vw,5.5rem); }
  .detail-questions { display: grid; grid-template-columns: .75fr 1.25fr; gap: clamp(2rem,6vw,6rem); align-items: start; }
  .detail-questions header>p:last-child { margin-top: 1.5rem; font-size: .92rem; }
  .detail-questions>div { min-width: 0; }
  .detail-section--booking { background: #eee4f0; }
  .detail-booking { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem,6vw,6rem); align-items: center; }
  .detail-actions { display: flex; align-items: center; gap: 1rem 1.6rem; flex-wrap: wrap; margin-top: 1.5rem; }
  .detail-actions .btn { gap: .8rem; }
  .service-editorial .detail-booking__address { font-size: .75rem; margin-top: 1rem; }
  .detail-reading { display: grid; grid-template-columns: .7fr 1.3fr; gap: clamp(2rem,6vw,6rem); align-items: start; }
  .detail-reading__list { min-width: 0; }
  .detail-reading__list>a { display: grid; grid-template-columns: auto minmax(0,1fr) auto; gap: 1.2rem; padding-block: 1.5rem; border-top: 1px solid #dac9e2; color: #70428b; text-decoration: none; }
