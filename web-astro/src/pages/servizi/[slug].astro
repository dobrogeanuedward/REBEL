---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FaqAccordion from "@/components/FaqAccordion.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import KeyPointsGrid from "@/components/KeyPointsGrid.astro";
import EditorialSection from "@/components/EditorialSection.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import NearMeBlock from "@/components/NearMeBlock.astro";
import { media, type ImageAsset } from "@/lib/page-media";
import {
  servicePages,
  competencePages,
} from "@/lib/seo-content-refined";
import { protocolPages } from "@/lib/protocol-pages";
import { localAreaPages } from "@/lib/local-pages";
import {
  buildArticleSchema,
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildServiceSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";
import { siteConfig } from "@/lib/site-config";

export async function getStaticPaths() {
  return servicePages.map((s) => ({
    params: { slug: s.slug },
    props: { service: s },
  }));
}

const { service } = Astro.props;

const moodImage = service.category === "laser" ? media.laser.mood : media.studio.cabin;

const resolveEditorialMedia = (slug: string): readonly ImageAsset[] => {
  if (/laser/.test(slug)) return [media.laser.handpiece, media.laser.consult];
  if (/laminazione/.test(slug)) return [media.lamina.detail, media.lamina.hero];
  if (/manicure|semipermanente/.test(slug) && !/pedicure/.test(slug)) {
    return [media.manicure.detail, media.manicure.hero];
  }
  if (/pedicure|unghie-piedi/.test(slug)) return [media.pedicure.detail, media.pedicure.hero];
  if (/linfodrenante/.test(slug)) return [media.drenante.detail, media.drenante.hero];
  if (/massaggio/.test(slug)) return [media.massaggio.detail, media.massaggio.hero];
  if (/pulizia-viso/.test(slug)) return [media.viso.texture, media.viso.products];
  if (/scrub-corpo/.test(slug)) return [media.drenante.detail, media.viso.products];
  return [media.studio.professional, media.studio.reception];
};
const editorialMedia = resolveEditorialMedia(service.slug);

const fallbackImage =
  service.category === "laser"
    ? "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public"
    : "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/7dc5354b-33e1-4a9e-a21d-ff321ecf4500/public";

const baseServiceName = service.name.replace(/\s+a Carmagnola$/i, "").trim();
const priceFromMatch = service.priceHint.match(/(\d+(?:[.,]\d+)?)/);
const priceFrom = priceFromMatch ? Number(priceFromMatch[1].replace(",", ".")) : undefined;
const formatPrice = (value: string) =>
  value
    .replace(/\bEUR\s*(\d+(?:[.,]\d+)?)/gi, "€$1")
    .replace(/€\s+(\d+(?:[.,]\d+)?)/g, "€$1")
    .replace(/(\d+)\.(\d{2})\b/g, "$1,$2")
    .replace(/(€\d+(?:,\d+)?)\s+a\s+(\d+(?:,\d+)?)(?!\s*€)/g, "$1 a €$2")
    .replace(/\s*\/\s*/g, " / ")
    .replace(/\s{2,}/g, " ")
    .trim();
const displayPrice = formatPrice(service.priceHint);
const priceIntentKeywords = [
  `${baseServiceName} prezzi Carmagnola`,
  `prezzi ${baseServiceName} Carmagnola`,
  `${baseServiceName} Carmagnola`,
  `${baseServiceName} vicino a me`,
  `${baseServiceName} Carmagnola vicino a me`,
];

const meta = createPageMeta({
  title: service.name,
  description: service.shortDescription,
  path: `/servizi/${service.slug}`,
  keywords: [...service.keywords, ...priceIntentKeywords],
  openGraphType: "article",
  image: service.heroImage?.src ?? fallbackImage,
});

const slugifyId = (value: string) =>
  value
    .toLowerCase()
    .trim()
    .replace(/[’']/g, "")
    .replace(/[^\p{L}\p{N}]+/gu, "-")
    .replace(/-+/g, "-")
    .replace(/(^-|-$)/g, "");

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Servizi", path: "/servizi" },
  { name: service.name, path: `/servizi/${service.slug}` },
]);
const webPage = buildWebPageSchema({
  name: service.name,
  description: service.shortDescription,
  path: `/servizi/${service.slug}`,
});
const serviceSchema = buildServiceSchema(
  service.name,
  service.longDescription,
  `/servizi/${service.slug}`,
  {
    priceFrom,
    keywords: [...service.keywords, ...priceIntentKeywords],
  },
);
const articleSchema = buildArticleSchema({
  headline: service.name,
  description: service.longDescription,
  path: `/servizi/${service.slug}`,
  keywords: service.keywords,
  section: service.category === "laser" ? "Laser" : "Estetica classica",
  image: service.heroImage?.src,
});
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faqs.map((faq) => ({
    "@type": "Question",
    name: faq.q,
    acceptedAnswer: { "@type": "Answer", text: faq.a },
  })),
};

const relatedCompetences = competencePages.filter((c) =>
  service.relatedCompetenceSlugs.includes(c.slug),
);
const relatedProtocols = (service.relatedProtocolSlugs ?? [])
  .map((sl) => protocolPages.find((p) => p.slug === sl))
  .filter((p): p is (typeof protocolPages)[number] => Boolean(p))
  .slice(0, 4);
const siblingServices = servicePages
  .filter((i) => i.slug !== service.slug && i.category === service.category)
  .map((i) => ({
    item: i,
    score: i.relatedCompetenceSlugs.filter((rs) =>
      service.relatedCompetenceSlugs.includes(rs),
    ).length,
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(({ item }) => item);
const featuredAreas = localAreaPages.filter((a) => a.cluster === "asse-carmagnola").slice(0, 4);

const relatedCompetencesSchema =
  relatedCompetences.length > 0
    ? buildItemListSchema({
        name: `Guide correlate a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: relatedCompetences.map((c) => ({ name: c.title, path: `/competenze/${c.slug}` })),
      })
    : null;
const relatedProtocolsSchema =
  relatedProtocols.length > 0
    ? buildItemListSchema({
        name: `Protocolli professionali collegati a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: relatedProtocols.map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
      })
    : null;
const siblingServicesSchema =
  siblingServices.length > 0
    ? buildItemListSchema({
        name: `Altri servizi collegati a ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: siblingServices.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })),
      })
    : null;
const featuredAreasSchema =
  featuredAreas.length > 0
    ? buildItemListSchema({
        name: `Indicazioni dai comuni vicini per ${service.name}`,
        path: `/servizi/${service.slug}`,
        items: featuredAreas.map((a) => ({ name: a.city, path: `/localita/${a.slug}` })),
      })
    : null;

const editorialSections = service.editorialSections ?? [];
const sourceLinks = service.sourceLinks ?? [];

const moneySlugs = new Set([
  "manicure-semipermanente-carmagnola",
  "laminazione-ciglia-sopracciglia-carmagnola",
  "pedicure-carmagnola",
  "pulizia-viso-carmagnola",
  "massaggio-rilassante-carmagnola",
  "epilazione-laser-viso-carmagnola",
  "epilazione-laser-corpo-carmagnola",
]);
const showNearMe = moneySlugs.has(service.slug);
const nearMeLabel = baseServiceName
  .replace(/\s+a\s+Carmagnola$/i, "")
  .replace(/\s+ciglia\s+e\s+sopracciglia$/i, " ciglia/sopracciglia");

const nearMeHrefOverridesMap: Record<string, Record<string, string>> = {
  "pulizia-viso-carmagnola": {
    alba: "/pulizia-viso-alba",
    bra: "/pulizia-viso-bra",
    canale: "/pulizia-viso-canale",
    racconigi: "/pulizia-viso-racconigi",
  },
  "manicure-semipermanente-carmagnola": {
    alba: "/manicure-semipermanente-alba",
    bra: "/manicure-semipermanente-bra",
    canale: "/manicure-semipermanente-canale",
    racconigi: "/manicure-semipermanente-racconigi",
  },
  "laminazione-ciglia-sopracciglia-carmagnola": {
    alba: "/laminazione-alba",
    bra: "/laminazione-bra",
    canale: "/laminazione-canale",
    racconigi: "/laminazione-racconigi",
  },
  "massaggio-rilassante-carmagnola": {
    alba: "/massaggio-rilassante-alba",
    bra: "/massaggio-rilassante-bra",
    canale: "/massaggio-rilassante-canale",
    racconigi: "/massaggio-rilassante-racconigi",
  },
  "massaggio-linfodrenante-carmagnola": {
    alba: "/massaggio-linfodrenante-alba",
    bra: "/massaggio-linfodrenante-bra",
    canale: "/massaggio-linfodrenante-canale",
    racconigi: "/massaggio-linfodrenante-racconigi",
  },
  "pedicure-carmagnola": {
    alba: "/pedicure-alba",
    bra: "/pedicure-bra",
    canale: "/pedicure-canale",
    racconigi: "/pedicure-racconigi",
  },
  "epilazione-laser-viso-carmagnola": {
    alba: "/epilazione-laser-alba",
    bra: "/epilazione-laser-bra",
    canale: "/epilazione-laser-canale",
    racconigi: "/epilazione-laser-racconigi",
  },
  "epilazione-laser-corpo-carmagnola": {
    alba: "/epilazione-laser-alba",
    bra: "/epilazione-laser-bra",
    canale: "/epilazione-laser-canale",
    racconigi: "/epilazione-laser-racconigi",
  },
};
const nearMeHrefOverrides = nearMeHrefOverridesMap[service.slug] ?? {};

const tocItems = [
  { id: "benefici", label: "Obiettivi" },
  { id: "prezzi", label: "Prezzo" },
  ...(editorialSections.length > 0 ? [{ id: "dettagli", label: "Come si svolge" }] : []),
  { id: "faq", label: "Domande frequenti" },
  { id: "guide", label: "Approfondimenti" },
  ...(sourceLinks.length > 0 ? [{ id: "fonti", label: "Fonti" }] : []),
  ...(relatedProtocols.length > 0 ? [{ id: "protocolli", label: "Percorsi REBEL" }] : []),
  { id: "anche", label: "Altri trattamenti" },
  ...(featuredAreas.length > 0 ? [{ id: "localita", label: "Come raggiungerci" }] : []),
];
---
<BaseLayout meta={meta} bodyClass={`page-servizio-detail ${service.category === "laser" ? "page-servizio-laser" : "page-servizio-classica"}`}>
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={serviceSchema} />
  <JsonLd data={articleSchema} />
  <JsonLd data={faqSchema} />
  {relatedCompetencesSchema ? <JsonLd data={relatedCompetencesSchema} /> : null}
  {relatedProtocolsSchema ? <JsonLd data={relatedProtocolsSchema} /> : null}
  {siblingServicesSchema ? <JsonLd data={siblingServicesSchema} /> : null}
  {featuredAreasSchema ? <JsonLd data={featuredAreasSchema} /> : null}

  <PageHero
    image={service.heroImage}
    kicker={service.category === "laser" ? "Epilazione laser · Carmagnola" : "Trattamento estetico · Carmagnola"}
    title={service.name.replace(/Carmagnola/i, "_Carmagnola_")}
    lead={service.longDescription}
    bullets={[displayPrice, "Come si svolge e che cosa sapere", "Su appuntamento · Carmagnola"]}
    meta={[
      "Viale Barbaroux 20",
      "Da martedì a sabato",
    ]}
    ctaPrimary={{ label: "Chiedi un appuntamento", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: siteConfig.social.whatsapp }}
  />

  <section class="section">
    <div class="container detail-grid">
      <article class="detail-main">
        <div id="benefici">
          <SectionHead
            kicker="Obiettivi del trattamento"
            title={`A che cosa serve _${baseServiceName}_.`}
            lead="Scopri a quale esigenza è dedicato e come si svolge."
          />
          <p class="detail-lead">{service.shortDescription}</p>
          <KeyPointsGrid points={service.benefits} />
        </div>

        <div id="prezzi" class="detail-section">
          <SectionHead
            kicker="Prezzo"
            title={`Quanto costa _${baseServiceName}_ a Carmagnola.`}
            lead={`Il prezzo indicato è ${displayPrice}. Se varia per zona o durata, te lo confermiamo prima.`}
          />
          <div class="card-grid card-grid--2">
            <FeatureCard
              kicker="Prezzo indicato"
              title={displayPrice}
              body="Se il servizio prevede varianti per zona, durata o tipologia, ti confermiamo il prezzo prima dell’appuntamento."
            />
            <FeatureCard
              kicker="Tutti i prezzi"
              title="Listino completo Rebel"
              body="Prezzi di trattamenti viso e corpo, manicure, pedicure, laminazione, epilazione laser e percorsi REBEL."
              href="/listino-estetica-laser"
            />
          </div>
        </div>

        {editorialSections.length > 0 ? (
          <div id="dettagli" class="detail-section">
            <SectionHead
              kicker="Come si svolge"
              title={`Preparazione, seduta e indicazioni per _${baseServiceName}_.`}
              lead="Qui trovi che cosa succede prima, durante e dopo l’appuntamento."
            />
            <div class="editorial-flow">
              {editorialSections.map((s, i) => {
                const mediaIndex = Math.floor(i / 2);
                const sectionMedia = i % 2 === 0
                  ? editorialMedia[mediaIndex % editorialMedia.length]
                  : undefined;
                return (
                  <EditorialSection
                    id={slugifyId(s.heading)}
                    heading={s.heading}
                    paragraphs={s.paragraphs}
                    level={3}
                    media={sectionMedia}
                    mediaSide={mediaIndex % 2 === 0 ? "end" : "start"}
                  />
                );
              })}
            </div>
          </div>
        ) : null}

        <div id="faq" class="detail-section">
          <SectionHead
            kicker="Domande frequenti"
            title={`Le domande più comuni su _${baseServiceName}_.`}
          />
          <FaqAccordion items={service.faqs} kicker={`Domande su ${baseServiceName}`} />
        </div>

        {sourceLinks.length > 0 ? (
          <div id="fonti" class="detail-section">
            <SectionHead
              kicker="Fonti e riferimenti"
              title="Le fonti consultate per le informazioni tecniche."
            />
            <ul class="source-list">
              {sourceLinks.map((s) => (
                <li>
                  <a href={s.url} target="_blank" rel="noreferrer">{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ) : null}

        {relatedCompetences.length > 0 ? (
          <div id="guide" class="detail-section">
            <SectionHead
              kicker="Per approfondire"
              title={`Approfondimenti pratici su _${baseServiceName}_.`}
              lead="Preparazione, frequenza e indicazioni dopo il trattamento."
            />
            <div class="card-grid card-grid--2">
              {relatedCompetences.map((c, i) => (
                <FeatureCard
                  kicker="Guida"
                  title={c.title}
                  body={c.shortDescription}
                  href={`/competenze/${c.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}

        {relatedProtocols.length > 0 ? (
          <div id="protocolli" class="detail-section">
            <SectionHead
              kicker="Percorsi REBEL"
              title="Percorsi che possono includere questo trattamento."
              lead="In ogni scheda trovi obiettivo, prezzo e indicazioni utili prima di prenotare."
            />
            <div class="card-grid card-grid--2">
              {relatedProtocols.map((p, i) => (
                <FeatureCard
                  kicker={formatPrice(p.price)}
                  title={p.name}
                  body={p.shortDescription}
                  href={`/protocolli/${p.slug}`}
                  variant="feature"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}

        <div id="anche" class="detail-section">
          <SectionHead
            kicker="Altri trattamenti"
            title="Altri servizi per esigenze vicine."
          />
          <div class="card-grid card-grid--2">
            {siblingServices.map((s, i) => (
              <FeatureCard
                kicker={formatPrice(s.priceHint)}
                title={s.name}
                body={s.shortDescription}
                href={`/servizi/${s.slug}`}
                index={i + 1}
              />
            ))}
          </div>
        </div>

        {featuredAreas.length > 0 ? (
          <div id="localita" class="detail-section">
            <SectionHead
              kicker="Come raggiungerci"
              title="Indicazioni per chi arriva dai comuni vicini."
              lead="Apri la pagina del tuo comune per vedere la mappa e il percorso verso Viale Barbaroux 20 a Carmagnola."
            />
            <div class="card-grid card-grid--2">
              {featuredAreas.map((a, i) => (
                <FeatureCard
                  kicker="Località"
                  title={a.city}
                  body={`Indicazioni e contatti per organizzare la visita da ${a.city}.`}
                  href={`/localita/${a.slug}`}
                  variant="quiet"
                  index={i + 1}
                />
              ))}
            </div>
          </div>
        ) : null}
      </article>

      <aside class="detail-aside">
        <TableOfContents items={tocItems} />
        <InlineCta
          kicker="Appuntamenti REBEL · Carmagnola"
          title={`Vuoi prenotare _${baseServiceName}_?`}
          lead="Scrivici: ti confermiamo disponibilità, durata e prezzo. Se prima è utile una valutazione REBEL, dura 30–40 minuti; se scegli di iniziare il percorso proposto, la valutazione è gratuita. Gli eventuali prodotti consigliati per casa non sono inclusi."
          primaryHref="/contatti"
          primaryLabel="Chiedi un appuntamento"
          secondaryHref="/listino-estetica-laser"
          secondaryLabel="Consulta il listino"
        />
      </aside>
    </div>
  </section>

  <FullBleedBand
    image={moodImage}
    height="sm"
    align="left"
    kicker={`${baseServiceName} · Rebel Carmagnola`}
    title={`Chiedi un appuntamento per _${baseServiceName}_.`}
    lead="Ti confermiamo disponibilità, durata e prezzo prima dell’appuntamento. Se serve una valutazione REBEL, ti spieghiamo subito come funziona."
    cta={{ label: "Contattaci", href: "/contatti" }}
  />

  {showNearMe ? (
    <NearMeBlock
      serviceLabel={nearMeLabel}
      kicker={`${nearMeLabel} vicino a te`}
      anchorPattern={(s, c) => `${s} a ${c}`}
      clusters={["asse-carmagnola", "torino-sud", "cuneo"]}
      limit={14}
      hrefOverrides={nearMeHrefOverrides}
    />
  ) : null}

  <StickyBookingBar priceHint={displayPrice} primary={{ label: "Chiedi un appuntamento", href: "/contatti" }} />
</BaseLayout>

<style>
  .detail-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: start;
  }
  @media (max-width: 980px) {
    .detail-grid { grid-template-columns: 1fr; }
    .detail-aside { order: -1; position: relative; }
  }
  .detail-main { min-width: 0; }
  .detail-section { margin-top: clamp(3rem, 6vw, 5rem); }
  .detail-cover {
    margin: 1.4rem 0;
    border-radius: var(--r-md);
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .detail-cover img { width: 100%; height: auto; display: block; }
  .detail-lead {
    font-size: var(--t-lead);
    color: var(--text-muted);
    line-height: var(--leading-body);
    max-width: 64ch;
    margin: 1rem 0 0;
  }
  .editorial-flow { display: grid; gap: clamp(2.6rem, 6vw, 5rem); margin-top: 1.6rem; }
  .source-list {
    list-style: none;
    margin: 1.2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }
  .source-list a {
    color: var(--text);
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.4rem;
    display: inline-block;
    transition: color var(--t-fast) var(--ease-soft), border-color var(--t-fast) var(--ease-soft);
  }
  .source-list a:hover {
    color: var(--ivory-1);
    border-bottom-color: var(--mauve);
  }
  .detail-aside { display: grid; gap: 1.4rem; }
</style>
