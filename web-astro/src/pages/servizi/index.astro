---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SectionHead from "@/components/SectionHead.astro";
import FeatureCard from "@/components/FeatureCard.astro";
import InlineCta from "@/components/InlineCta.astro";
import FullBleedBand from "@/components/FullBleedBand.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { media } from "@/lib/page-media";
import { protocolCards } from "@/lib/content";
import { competencePages, servicePages } from "@/lib/seo-content";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Servizi — Centro Estetico Rebel a Carmagnola",
  description:
    "Tutti i servizi Rebel a Carmagnola: pulizia viso, manicure, ceretta, massaggi, epilazione laser Ice Polar e protocolli viso/corpo. Schede chiare con prezzi.",
  path: "/servizi",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  keywords: [
    "servizi centro estetico Carmagnola",
    "trattamenti estetici Carmagnola",
    "estetista Carmagnola",
    "epilazione laser Carmagnola",
    "pulizia viso Carmagnola",
    "manicure semipermanente Carmagnola",
    "ceretta Carmagnola",
    "massaggio Carmagnola",
    "pedicure Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Servizi", path: "/servizi" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Servizi Rebel a Carmagnola",
  description:
    "Panoramica dei servizi Rebel: bellezza viso e corpo, laser e protocolli epigenetici da scegliere e prenotare.",
  path: "/servizi",
});
const serviceListSchema = buildItemListSchema({
  name: "Servizi Rebel Carmagnola",
  path: "/servizi",
  items: servicePages.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })),
});
const protocolListSchema = buildItemListSchema({
  name: "Protocolli epigenetici Rebel (selezione)",
  path: "/servizi",
  items: protocolCards.slice(0, 6).map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const estetica = servicePages.filter((s) => s.category === "estetica-classica");
const esteticaSorted = estetica.slice().sort((a, b) => {
  const score = (slug: string) => {
    if (slug === "pulizia-viso-carmagnola") return 6;
    if (slug === "manicure-semipermanente-carmagnola") return 5;
    if (slug === "laminazione-ciglia-sopracciglia-carmagnola") return 4;
    if (slug === "pedicure-carmagnola") return 3;
    if (slug === "massaggio-rilassante-carmagnola") return 2;
    if (slug === "massaggio-linfodrenante-carmagnola") return 1;
    return 0;
  };
  return score(b.slug) - score(a.slug);
});
const laser = servicePages.filter((s) => s.category === "laser");
const featuredProtocols = protocolCards.slice(0, 6);

const editorialSlugs = [
  "epilazione-laser-ascelle-carmagnola-guida-pratica",
  "epilazione-laser-inguine-carmagnola-guida-pratica",
  "laser-uomo-carmagnola-guida-pratica",
  "epilazione-laser-estate-sole-carmagnola",
  "peli-incarniti-laser-carmagnola",
  "pulizia-viso-carmagnola-frequenza-benefici",
  "manicure-semipermanente-carmagnola-durata-rimozione",
  "laminazione-ciglia-sopracciglia-carmagnola-durata-cura",
];
const featuredEditorials = editorialSlugs
  .map((s) => competencePages.find((c) => c.slug === s))
  .filter((c): c is (typeof competencePages)[number] => Boolean(c));

const switchItems = [
  { href: "#estetica", label: "Estetica & benessere", glyph: "✦" },
  { href: "#laser", label: "Epilazione laser", glyph: "◉" },
  { href: "#epigenetica", label: "Estetica epigenetica", glyph: "⬡" },
  { href: "#guide", label: "Guide beauty", glyph: "❖" },
];
---
<BaseLayout meta={meta} bodyClass="page-servizi">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceListSchema} />
  <JsonLd data={protocolListSchema} />
  <JsonLd data={webPageSchema} />

  <PageHero
    image={media.studio.cabin}
    kicker="Servizi · Carmagnola"
    title="Tutto quello che _facciamo_ in studio."
    lead="Estetica classica, epilazione laser Ice Polar e protocolli viso/corpo. Ogni scheda dice cosa fa il trattamento, quanto dura e quanto costa. La prima visita è gratuita."
    bullets={["Schede chiare con prezzi", "Epilazione laser Ice Polar", "Prima visita gratuita"]}
    meta={["Estetica & benessere", "Epilazione laser Ice Polar", "Protocolli viso e corpo"]}
    ctaPrimary={{ label: "Prenota la prima visita gratuita", href: "/contatti", halo: true }}
    ctaSecondary={{ label: "Scrivici su WhatsApp", href: "https://wa.me/393516919416" }}
  />

  <section class="section section--tight">
    <div class="container">
      <nav class="listino-switch" aria-label="Vai alla categoria">
        {switchItems.map((it) => (
          <a class="listino-switch__btn" href={it.href}>
            <span aria-hidden="true">{it.glyph}</span>
            {it.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="section" id="estetica">
    <div class="container">
      <SectionHead
        kicker="Estetica & benessere"
        title="I trattamenti _classici_, fatti come si deve."
        lead="Pulizia viso, manicure, ceretta, massaggi: i servizi su cui contare ogni mese, con tempi sensati e prodotti professionali."
      />
      <div class="card-grid card-grid--2">
        {esteticaSorted.map((s, i) => (
          <FeatureCard
            kicker={s.priceHint}
            title={s.name}
            body={s.shortDescription}
            href={`/servizi/${s.slug}`}
            ariaLabel={`Apri scheda servizio ${s.name}`}
            index={i + 1}
          />
        ))}
      </div>
    </div>
  </section>

  <section class="section section--scene-ivory" id="laser">
    <div class="container">
      <SectionHead
        kicker="Epilazione laser"
        title="Laser Thory + manipolo _Ice Polar_."
        lead="Diodo a tre lunghezze d'onda con raffreddamento attivo. Più comodo anche su ascelle e inguine. Valutazione iniziale gratuita."
      />
      <div class="card-grid card-grid--2">
        {laser.map((s, i) => (
          <FeatureCard
            kicker={s.priceHint}
            title={s.name}
            body={s.shortDescription}
            href={`/servizi/${s.slug}`}
            ariaLabel={`Apri scheda laser ${s.name}`}
            variant="feature"
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem; justify-content:center;">
        <a class="btn btn--primary btn--halo" href="/epilazione-laser-carmagnola">Vedi il percorso laser</a>
        <a class="btn btn--secondary" href="/competenze/laser-uomo-carmagnola-guida-pratica">Laser uomo</a>
      </div>
    </div>
  </section>

  <section class="section" id="epigenetica">
    <div class="container">
      <SectionHead
        kicker="Protocolli avanzati"
        title="Estetica _epigenetica_ viso e corpo."
        lead="Percorsi su più sedute con linee Marbellas ed Eberlin. Quando vuoi un risultato che lavori in profondità: tono, densità, luminosità."
      />
      <div class="card-grid card-grid--3">
        {featuredProtocols.map((p, i) => (
          <FeatureCard
            kicker={p.price}
            title={p.name}
            body={p.desc}
            href={`/protocolli/${p.slug}`}
            ariaLabel={`Apri il protocollo ${p.name}`}
            index={i + 1}
          />
        ))}
      </div>
      <div class="cluster cluster--stack-mobile" style="margin-top:2rem; justify-content:center;">
        <a class="btn btn--primary btn--halo" href="/protocolli-epigenetici">Vedi tutti i protocolli</a>
        <a class="btn btn--secondary" href="/contatti">Prenota la prima visita</a>
      </div>
    </div>
  </section>

  {featuredEditorials.length > 0 ? (
    <section class="section section--scene-ivory" id="guide">
      <div class="container">
        <SectionHead
          kicker="Approfondimenti"
          title="Guide _utili_ prima di scegliere."
          lead="Spiegano cosa fa un trattamento, quando ha senso e cosa aspettarsi: prepari meglio la prima visita e sai già cosa chiedere."
        />
        <div class="card-grid card-grid--2">
          {featuredEditorials.map((e, i) => (
            <FeatureCard
              kicker="Guida"
              title={e.title}
              body={e.shortDescription}
              href={`/competenze/${e.slug}`}
              variant="quiet"
              index={i + 1}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <FullBleedBand
    image={media.studio.cabin}
    height="sm"
    align="left"
    kicker="Da Rebel, a Carmagnola"
    quote="Si parte da quello che ti serve adesso, non dal pacchetto più costoso."
    cite="Studio Rebel · Viale Barbaroux 20"
  />

  <section class="section">
    <div class="container">
      <InlineCta
        kicker="Prima visita gratuita"
        title="Vieni in studio per _quindici minuti_, gratis."
        lead="Capiamo da dove ha senso partire, ti facciamo una proposta scritta e scegli un piccolo regalo. Senza obbligo di acquisto."
        primaryHref="/contatti"
        primaryLabel="Prenota la prima visita gratuita"
        secondaryHref="/listino-estetica-laser"
        secondaryLabel="Vedi listino e prezzi"
      />
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota gratis", href: "/contatti" }} />
</BaseLayout>

<style>
  .listino-switch {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    justify-content: center;
  }
  .listino-switch__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border-radius: var(--r-pill);
    border: 1px solid var(--line-strong);
    color: var(--text);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    transition: border-color var(--t-fast) var(--ease-soft), background var(--t-fast) var(--ease-soft);
    background: rgba(7, 5, 14, 0.4);
  }
  .listino-switch__btn:hover {
    border-color: var(--mauve);
    background: rgba(91, 43, 216, 0.12);
    color: var(--ivory-1);
  }
  .listino-switch__btn span {
    color: var(--mauve);
    font-size: 0.95rem;
  }
</style>
