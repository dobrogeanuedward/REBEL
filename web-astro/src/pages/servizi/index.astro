---
import ServicesHub from "@/components/ServicesHub.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import JsonLd from "@/components/JsonLd.astro";
import { serviceCategoryDestinations } from "@/lib/service-navigation";
import { serviceCategories } from "@/lib/service-categories";
import { menu } from "@/lib/treatment-catalog";
import { protocolCards } from "@/lib/content";
import { servicePages } from "@/lib/seo-content-refined";
import {
  buildBreadcrumbSchema,
  buildItemListSchema,
  buildWebPageSchema,
  createPageMeta,
} from "@/lib/seo";

const meta = createPageMeta({
  title: "Servizi viso, corpo, laser e beauty | Rebel Carmagnola",
  description:
    "Scopri i trattamenti REBEL a Carmagnola per viso e corpo, epilazione laser, manicure, pedicure, laminazione e massaggi, con prezzi e durata.",
  path: "/servizi",
  image: "https://imagedelivery.net/8Z69WIPvPk97iU4IP5m1ig/e3635dd7-e046-46af-56a5-cf36d8239c00/public",
  keywords: [
    "servizi centro estetico Carmagnola",
    "trattamenti estetici Carmagnola",
    "estetista Carmagnola",
    "epilazione laser Carmagnola",
    "pulizia viso Carmagnola",
    "manicure semipermanente Carmagnola",
    "ceretta Carmagnola",
    "massaggio Carmagnola",
    "pedicure Carmagnola",
  ],
});

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Servizi", path: "/servizi" },
]);
const webPageSchema = buildWebPageSchema({
  name: "Servizi Rebel a Carmagnola",
  description:
    "Trattamenti viso, corpo, laser e beauty con prezzi, durata indicativa e modalità di prenotazione.",
  path: "/servizi",
});
const serviceListSchema = buildItemListSchema({
  name: "Servizi Rebel Carmagnola",
  path: "/servizi",
  items: [...servicePages.map((s) => ({ name: s.name, path: `/servizi/${s.slug}` })), ...serviceCategories.map(s => ({ name: s.name, path: `/servizi/${s.slug}` }))],
});
const protocolListSchema = buildItemListSchema({
  name: "Protocolli professionali Rebel",
  path: "/servizi",
  items: protocolCards.slice(0, 6).map((p) => ({ name: p.name, path: `/protocolli/${p.slug}` })),
});

const catalogListSchema = buildItemListSchema({
  name: "Categorie dei trattamenti REBEL",
  path: "/servizi",
  items: menu.categories.map((category) => ({
    name: category.name,
    path: serviceCategoryDestinations[category.id] ?? `/listino-estetica-laser#${category.id}`,
  })),
});
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-servizi">
  <JsonLd data={breadcrumb} />
  <JsonLd data={serviceListSchema} />
  <JsonLd data={protocolListSchema} />
  <JsonLd data={webPageSchema} />
  <JsonLd data={catalogListSchema} />
  <ServicesHub />
  <StickyBookingBar primary={{ label: "Scegli il tuo trattamento", href: "#menu-completo" }} />
</BaseLayout>