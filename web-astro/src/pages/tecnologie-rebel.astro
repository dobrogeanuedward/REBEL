---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import PageHero from "@/components/PageHero.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import TechnologyTheatre from "@/components/TechnologyTheatre.astro";
import { thoryTechnologies } from "@/lib/rebel-technologies";
import { buildBreadcrumbSchema, buildItemListSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";
import "@/styles/technology-showcase.css";

const meta = createPageMeta({
  title: "Tecnologie estetiche REBEL a Carmagnola — viso, corpo e laser",
  description: "Scopri come REBEL utilizza Lumina, Aura, CryoShape, InfraPress, Tecar, ICE Polar e LPG nei percorsi viso, corpo ed epilazione.",
  path: "/tecnologie-rebel",
  openGraphType: "article",
  keywords: ["tecnologie estetiche Carmagnola", "THORY Carmagnola", "Lumina X1 Pro", "LPG Carmagnola", "ICE Polar"],
});

const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const portfolio = thoryTechnologies.slice(1);
const clientFrames: Record<string, { focus: string; title: string; tone: string }> = {
  "lumina-x3": {
    focus: "Epilazione e analisi della pelle",
    title: "Tre funzioni, utilizzate solo quando servono.",
    tone: "violet",
  },
  "lumina-k3": {
    focus: "Epilazione, analisi della pelle e trattamento con luce",
    title: "Tre funzioni, scelte dopo aver osservato la pelle.",
    tone: "prism",
  },
  "aura-q2": {
    focus: "Percorsi viso Structure",
    title: "Due modalità al plasma, scelte in base alla pelle.",
    tone: "rose",
  },
  "cryoshape-x2": {
    focus: "Percorsi corpo Forma",
    title: "Applicatori diversi per zone diverse.",
    tone: "ice",
  },
  "infrapress-x2": {
    focus: "Pressomassaggio e percorsi corpo",
    title: "Pressione progressiva e calore a infrarossi per i percorsi corpo.",
    tone: "air",
  },
  "tecar-448-revolution": {
    focus: "Tono e compattezza",
    title: "Due modalità scelte in base ai tessuti e alla zona.",
    tone: "warm",
  },
};

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Tecnologie REBEL", path: "/tecnologie-rebel" },
]);
const webPage = buildWebPageSchema({
  name: "Tecnologie estetiche REBEL",
  description: meta.description,
  path: "/tecnologie-rebel",
});
const list = buildItemListSchema({
  name: "Tecnologie nei percorsi REBEL",
  path: "/tecnologie-rebel",
  items: [
    ...thoryTechnologies.map((item) => ({ name: item.name, path: `/tecnologie-rebel#${item.slug}` })),
    { name: "ICE Polar", path: "/tecnologie-rebel#ice-polar" },
    { name: "LPG endomassaggio", path: "/tecnologie-rebel#lpg" },
  ],
});
---

<BaseLayout meta={meta} bodyClass="rebel-rebrand rebel-shell page-tecnologie-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={list} />

  <div class="tech-showcase" data-tech-showcase>
    <PageHero
      image={{ src:"/img/studio-treatwell/15432121.jpg", alt:"La cabina REBEL di Carmagnola con il lettino e la tecnologia THORY", width:1080, height:720 }}
      imageCaption="La cabina REBEL · Viale Barbaroux 20, Carmagnola"
      imagePosition="54% 50%"
      kicker="Viso, corpo e laser · Carmagnola"
      title="La tecnologia. Quando _serve a te._"
      lead="Partiamo da ciò che vuoi migliorare. Dopo la valutazione scegliamo il trattamento e, se utile, la tecnologia da inserire nel tuo percorso."
      meta={["Tecnologie nel Metodo REBEL", "Scelte dopo la valutazione"]}
      ctaPrimary={{ label:"Esplora le tecnologie", href:"#showcase-tecnologie" }}
      ctaSecondary={{ label:"La seduta laser, da vicino", href:"#laser-liberta" }}
    />
    <nav class="tech-paths rebel-container" aria-label="Percorsi collegati alle tecnologie">
      <a href="/percorsi/liberta"><span>01 / Epilazione</span>Libertà <span aria-hidden="true">↗</span></a>
      <a href="/percorsi/structure"><span>02 / Viso</span>Structure <span aria-hidden="true">↗</span></a>
      <a href="/percorsi/forma"><span>03 / Corpo</span>Forma <span aria-hidden="true">↗</span></a>
    </nav>

    <div id="laser-liberta"><div id="lumina-x1-pro"><TechnologyTheatre /></div></div>

    <section class="rebel-section tech-showroom" id="showcase-tecnologie" aria-labelledby="showroom-title">
      <div class="rebel-container">
        <header class="tech-showroom__head">
          <div>
            <p class="rebel-kicker">Le tecnologie REBEL</p>
            <h2 class="rebel-title" id="showroom-title">Scopri a cosa serve ogni tecnologia.</h2>
          </div>
          <p>Apri ogni scheda per capire come funziona e in quali percorsi utilizziamo la tecnologia.</p>
        </header>

        <nav class="tech-showroom__index" aria-label="Indice delle tecnologie">
          {portfolio.map((tech, index) => (
            <a href={`#${tech.slug}`} data-showroom-nav={index} aria-current={index === 0 ? "true" : undefined}>
              <span>{String(index + 1).padStart(2, "0")}</span>{tech.name}
            </a>
          ))}
        </nav>

        <div class="tech-showroom__scenes">
          {portfolio.map((tech, index) => {
            const frame = clientFrames[tech.slug];
            return (
              <article id={tech.slug} class="tech-showroom__scene" data-tech-scene={index} data-tone={frame?.tone ?? "violet"}>
                <div class="tech-showroom__media">
                  <span class="tech-showroom__serial">{String(index + 1).padStart(2, "0")}</span>
                  <img src={siteAsset(tech.imageSlot)} alt={tech.imageAlt} width={tech.imageWidth} height={tech.imageHeight} loading="lazy" decoding="async" />
                  <p>THORY · {tech.descriptor}</p>
                </div>
                <div class="tech-showroom__copy">
                  <p class="rebel-kicker">{frame?.focus}</p>
                  <h3>{tech.name}</h3>
                  <em>{frame?.title ?? tech.headline}</em>
                  <p>{tech.summary}</p>
                  <details>
                    <summary>Come funziona</summary>
                    <ul>{tech.highlights.map((item) => <li><b>{item.value}</b><span>{item.label}</span></li>)}</ul>
                  </details>
                  <div class="tech-showroom__journeys">
                    <small>La utilizziamo nei percorsi</small>
                    {tech.journeyLinks.map((journey) => <a href={journey.href}>{journey.label} <span>→</span></a>)}
                  </div>
                  <a class="tech-showroom__contact" href={`/contatti?source=tecnologie&tecnologia=${encodeURIComponent(tech.slug)}`}>Chiedi una valutazione <span>→</span></a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper tech-in-cabin" aria-labelledby="in-cabin-title">
      <div class="rebel-container">
        <header class="tech-in-cabin__head">
          <p class="rebel-kicker">Durante la seduta</p>
          <h2 class="rebel-title" id="in-cabin-title">Come utilizziamo le tecnologie durante il trattamento.</h2>
        </header>
        <div class="tech-in-cabin__grid">
          <article id="ice-polar">
            <figure><img src={siteAsset("services.laser.handpiece.desktop")} alt="Il manipolo laser a contatto con la pelle" width="1536" height="1024" loading="lazy" decoding="async" /><figcaption>Il contatto del manipolo. · Scena illustrativa</figcaption></figure>
            <div>
              <p class="rebel-kicker">Nel percorso Libertà</p>
              <h3>ICE Polar</h3>
              <em>Raffreddamento a contatto durante il trattamento.</em>
              <p>Il contatto fresco del manipolo aiuta a rendere più confortevole la seduta. Ti chiediamo come stai e adattiamo i parametri zona per zona.</p>
              <a href="/percorsi/liberta">Scopri Libertà <span>→</span></a>
            </div>
          </article>
          <article id="lpg">
            <figure><img src="/img/studio-treatwell/15432127.jpg" alt="Una cabina dedicata ai trattamenti dello studio REBEL" width="1080" height="720" loading="lazy" decoding="async" /><figcaption>Lo spazio della cura. · Fotografia dello studio REBEL</figcaption></figure>
            <div>
              <p class="rebel-kicker">Nel percorso Forma</p>
              <h3>LPG endomassaggio</h3>
              <em>Un massaggio meccanico con intensità regolata durante la seduta.</em>
              <p>Nel percorso Forma, LPG può essere abbinato al massaggio manuale, ai prodotti corpo e, se utile, ad altre tecnologie. Prima di iniziare scegliamo le zone e regoliamo intensità e frequenza in base alle tue sensazioni.</p>
              <a href="/percorsi/forma">Scopri Forma <span>→</span></a>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section class="rebel-section tech-method" aria-labelledby="tech-method-title">
      <div class="rebel-container">
        <header class="tech-method__head">
          <p class="rebel-kicker">Come scegliamo</p>
          <h2 class="rebel-title" id="tech-method-title">Dalla valutazione al trattamento.</h2>
        </header>
        <div class="tech-method__strip">
          <div><span>01</span><strong>Ti ascoltiamo</strong><p>Ci racconti cosa vuoi migliorare e quali sono le tue esigenze.</p></div>
          <div><span>02</span><strong>Valutiamo</strong><p>Osserviamo la zona da trattare.</p></div>
          <div><span>03</span><strong>Definiamo</strong><p>Ti spieghiamo trattamento, tecnologia e frequenza.</p></div>
          <div><span>04</span><strong>Controlliamo</strong><p>Osserviamo i cambiamenti e aggiorniamo il programma quando serve.</p></div>
        </div>
      </div>
    </section>

    <section class="rebel-section tech-closing">
      <div class="rebel-container">
        <p class="rebel-kicker">Scegliamo insieme</p>
        <h2>Ogni scelta<br /><em>comincia da te.</em></h2>
        <p>Durante la valutazione ti spieghiamo cosa consigliamo, come si svolge il trattamento, con quale frequenza e a quale prezzo.</p>
        <div class="rebel-hero__actions" style="justify-content:center">
          <a class="btn btn--primary" href="/contatti">Prenota la valutazione REBEL</a>
          <a class="btn btn--secondary" href="/percorsi">Esplora i percorsi REBEL</a>
        </div>
      </div>
    </section>
  </div>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />

<script>
  const initTechnologyShowcase = () => {
    document.querySelectorAll<HTMLElement>("[data-tech-showcase]").forEach((root) => {
      if (root.dataset.showcaseReady === "true") return;
      root.dataset.showcaseReady = "true";
      const scenes = Array.from(root.querySelectorAll<HTMLElement>("[data-tech-scene]"));
      const links = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-showroom-nav]"));
      if (scenes.length === 0) return;

      const activate = (index: number) => {
        scenes.forEach((scene, sceneIndex) => scene.toggleAttribute("data-active", sceneIndex === index));
        links.forEach((link, linkIndex) => {
          if (linkIndex === index) link.setAttribute("aria-current", "true");
          else link.removeAttribute("aria-current");
        });
      };

      const observer = new IntersectionObserver((entries) => {
        const current = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!current) return;
        activate(Number((current.target as HTMLElement).dataset.techScene ?? 0));
      }, { rootMargin: "-22% 0px -48%", threshold: [0, .2, .5, .8] });

      scenes.forEach((scene) => observer.observe(scene));
      activate(0);
      document.addEventListener("astro:before-swap", () => observer.disconnect(), { once: true });
    });
  };
  initTechnologyShowcase();
  document.addEventListener("astro:page-load", initTechnologyShowcase);
</script>
</BaseLayout>
