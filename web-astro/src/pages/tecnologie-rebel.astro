---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import { buildBreadcrumbSchema, buildItemListSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";

const meta = createPageMeta({
  title: "Tecnologie estetiche a Carmagnola — Laser, Tecar, LPG e Pressomassaggio | Rebel",
  description: "Scopri le tecnologie disponibili da Rebel a Carmagnola: Laser Ice Polar, Tecar 448Revolution, LPG, Lumina K3, InfraPress X2 e CryoShape X2, con funzioni e utilizzi spiegati chiaramente.",
  path: "/tecnologie-rebel",
  openGraphType: "article",
  keywords: ["tecnologie estetiche Carmagnola", "Tecar Carmagnola", "LPG Carmagnola", "pressoterapia Carmagnola", "crioterapia estetica Carmagnola", "Laser Ice Polar Carmagnola"],
});

const technologies = [
  {
    code: "01",
    name: "Laser Ice Polar",
    family: "Epilazione viso e corpo",
    focus: "Riduzione progressiva della ricrescita",
    copy: "Laser a diodo con tre lunghezze d’onda e raffreddamento attivo. La valutazione stabilisce fototipo, caratteristiche del pelo, zone, parametri e distanza tra le sedute.",
    href: "/epilazione-laser-carmagnola",
  },
  {
    code: "02",
    name: "Tecar 448Revolution",
    family: "Trattamenti viso e corpo",
    focus: "Tono, qualità dei tessuti e comfort",
    copy: "Tecnologia a radiofrequenza utilizzabile nei programmi dedicati a tono e qualità cutanea. Intensità, durata e abbinamento con manualità o cosmetici dipendono dalla zona trattata.",
  },
  {
    code: "03",
    name: "LPG",
    family: "Rimodellamento corpo",
    focus: "Stimolazione meccanica, tonicità e leggerezza",
    copy: "Trattamento meccanico dei tessuti inserito nei programmi corpo per lavorare su tonicità, compattezza e sensazione di leggerezza. Frequenza e intensità vengono definite dopo la valutazione.",
  },
  {
    code: "04",
    name: "Lumina K3 3-in-1",
    family: "Trattamenti viso e corpo",
    focus: "Piattaforma con funzioni selezionabili",
    copy: "Piattaforma multifunzione per protocolli viso e corpo. La funzione utilizzata viene scelta in base alla zona, alle condizioni osservate e al risultato concordato.",
  },
  {
    code: "05",
    name: "InfraPress X2",
    family: "Pressomassaggio",
    focus: "Gambe pesanti, drenaggio e microcircolo",
    copy: "Pressomassaggio utilizzato nei programmi dedicati a pesantezza, ritenzione e drenaggio. La seduta può essere abbinata a manualità e altri trattamenti corpo.",
  },
  {
    code: "06",
    name: "CryoShape X2",
    family: "Crioterapia estetica localizzata",
    focus: "Trattamento di aree specifiche del corpo",
    copy: "Tecnologia localizzata inserita nei programmi corpo dopo la valutazione della zona e dell’obiettivo. Il piano specifica area trattata, numero indicativo di sedute e controlli.",
  },
];

const breadcrumb = buildBreadcrumbSchema([
  { name: "Home", path: "/" },
  { name: "Tecnologie Rebel", path: "/tecnologie-rebel" },
]);
const webPage = buildWebPageSchema({ name: "Tecnologie estetiche Rebel a Carmagnola", description: meta.description, path: "/tecnologie-rebel" });
const list = buildItemListSchema({
  name: "Tecnologie disponibili nello studio Rebel",
  path: "/tecnologie-rebel",
  items: technologies.map((item) => ({ name: item.name, path: item.href || "/tecnologie-rebel" })),
});
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand page-tecnologie-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={list} />

  <section class="tech-hero">
    <div class="rebel-container tech-hero__grid">
      <div>
        <p class="rebel-kicker">Tecnologie estetiche · Carmagnola</p>
        <h1 class="rebel-display">Laser, Tecar, LPG, pressomassaggio e crioterapia.</h1>
      </div>
      <div class="tech-hero__copy">
        <p class="rebel-lead">Nello studio Rebel utilizziamo tecnologie per epilazione, trattamenti viso, drenaggio, tono e rimodellamento corpo. La valutazione definisce quale utilizzare, su quale zona, con quali parametri e con quale frequenza.</p>
        <div class="rebel-spectrum-rule"></div>
        <a class="btn btn--primary" href="/contatti">Prenota la prima visita</a>
      </div>
    </div>
  </section>

  <section class="rebel-section rebel-section--paper">
    <div class="rebel-container">
      <p class="rebel-kicker">Come viene definito il trattamento</p>
      <h2 class="rebel-title">Obiettivo, zona, parametri e controllo dei risultati.</h2>
      <div class="tech-principles">
        <article><span>01</span><h3>Obiettivo</h3><p>Stabiliamo che cosa vuoi migliorare: ricrescita dei peli, pesantezza, drenaggio, tono, compattezza o qualità della pelle.</p></article>
        <article><span>02</span><h3>Zona e parametri</h3><p>Valutiamo l’area interessata e definiamo intensità, durata, modalità e precauzioni specifiche.</p></article>
        <article><span>03</span><h3>Abbinamenti</h3><p>Quando utile, associamo la tecnologia a manualità, cosmetici professionali o altri trattamenti compatibili.</p></article>
        <article><span>04</span><h3>Controllo</h3><p>Verifichiamo la risposta durante gli appuntamenti e aggiorniamo parametri o frequenza quando necessario.</p></article>
      </div>
    </div>
  </section>

  <section class="rebel-section rebel-section--plum">
    <div class="rebel-container">
      <p class="rebel-kicker">Tecnologie disponibili</p>
      <h2 class="rebel-title">Che cosa fanno e in quali trattamenti vengono utilizzate.</h2>
      <div class="tech-list">
        {technologies.map((tech) => (
          <article class="tech-card">
            <div class="tech-card__index">{tech.code}</div>
            <div class="tech-card__main">
              <p class="rebel-kicker">{tech.family}</p>
              <h3>{tech.name}</h3>
              <strong>{tech.focus}</strong>
              <p>{tech.copy}</p>
              {tech.href ? <a href={tech.href}>Scopri prezzi e zone del laser →</a> : null}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="rebel-section">
    <div class="rebel-container tech-close">
      <div>
        <p class="rebel-kicker">Prima visita gratuita</p>
        <h2 class="rebel-title">Ti spieghiamo quale tecnologia può essere adatta al tuo obiettivo.</h2>
      </div>
      <div>
        <p class="rebel-lead">Durante la valutazione osserviamo la zona, raccogliamo le informazioni utili e ti presentiamo un programma con trattamento consigliato, frequenza indicativa e prezzo.</p>
        <div class="rebel-hero__actions"><a class="btn btn--primary" href="/metodo-rebel">Come lavoriamo</a><a class="btn btn--secondary" href="/contatti">Prenota la prima visita</a></div>
      </div>
    </div>
  </section>

  <StickyBookingBar primary={{ label: "Prenota la prima visita", href: "/contatti" }} />
</BaseLayout>

<style>
  .tech-hero{padding:clamp(9rem,14vw,13rem) 0 clamp(5rem,9vw,8rem);background:radial-gradient(circle at 82% 18%,rgba(112,71,255,.2),transparent 27rem),radial-gradient(circle at 15% 86%,rgba(233,59,136,.13),transparent 25rem),var(--rebel-porcelain)}
  .tech-hero__grid,.tech-close{display:grid;grid-template-columns:1.15fr .85fr;gap:clamp(2rem,7vw,7rem);align-items:end}.tech-hero__copy{padding-bottom:.7rem}.tech-principles{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:3rem;background:var(--rebel-line);border:1px solid var(--rebel-line);border-radius:28px;overflow:hidden}.tech-principles article{padding:2rem;background:var(--rebel-paper)}.tech-principles span{color:var(--rebel-pink);font-weight:800}.tech-principles h3{margin:2.5rem 0 .6rem;font-size:1.5rem}.tech-principles p{margin:0;color:var(--text-muted);line-height:1.6}.tech-list{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem;margin-top:3rem}.tech-card{display:grid;grid-template-columns:4rem 1fr;gap:1.2rem;padding:clamp(1.5rem,3vw,2.5rem);border:1px solid rgba(255,255,255,.14);border-radius:28px;background:rgba(255,255,255,.055)}.tech-card__index{font-size:2rem;font-weight:800;color:var(--rebel-pink)}.tech-card h3{margin:.2rem 0 .7rem;font-size:clamp(2rem,4vw,3.8rem);line-height:.92;letter-spacing:-.055em}.tech-card strong{display:block;color:#fff}.tech-card p:not(.rebel-kicker){color:rgba(255,255,255,.68);line-height:1.6}.tech-card a{color:#fff;font-weight:800}.tech-close{align-items:start}@media(max-width:900px){.tech-hero__grid,.tech-close,.tech-list{grid-template-columns:1fr}.tech-principles{grid-template-columns:1fr 1fr}.tech-hero{padding-top:8.5rem}}@media(max-width:560px){.tech-principles{grid-template-columns:1fr}.tech-card{grid-template-columns:1fr}.tech-card__index{font-size:1rem}}
</style>
