---
import BaseLayout from "@/layouts/BaseLayout.astro";
import JsonLd from "@/components/JsonLd.astro";
import StickyBookingBar from "@/components/StickyBookingBar.astro";
import TechnologyTheatre from "@/components/TechnologyTheatre.astro";
import { thoryTechnologies } from "@/lib/rebel-technologies";
import { buildBreadcrumbSchema, buildItemListSchema, buildWebPageSchema, createPageMeta } from "@/lib/seo";

const meta = createPageMeta({
  title: "Tecnologie REBEL e portfolio THORY a Carmagnola",
  description: "Lumina X1 Pro, Lumina X3, Lumina K3, Aura Q2, CryoShape X2, InfraPress X2 e Tecar 448Revolution, più ICE Polar e LPG nei percorsi REBEL.",
  path: "/tecnologie-rebel",
  openGraphType: "article",
  keywords: ["tecnologie estetiche Carmagnola", "THORY Carmagnola", "Lumina X1 Pro", "LPG Carmagnola", "ICE Polar"],
});
const siteAsset = (slot: string) => `/api/site-asset?slot=${encodeURIComponent(slot)}`;
const portfolio = thoryTechnologies.slice(1);
const breadcrumb = buildBreadcrumbSchema([{ name: "Home", path: "/" }, { name: "Tecnologie REBEL", path: "/tecnologie-rebel" }]);
const webPage = buildWebPageSchema({ name: "Tecnologie REBEL e portfolio THORY", description: meta.description, path: "/tecnologie-rebel" });
const list = buildItemListSchema({ name: "Tecnologie raccontate da REBEL", path: "/tecnologie-rebel", items: [...thoryTechnologies.map((item) => ({ name: item.name, path: `/tecnologie-rebel#${item.slug}` })), { name: "ICE Polar", path: "/tecnologie-rebel#ice-polar" }, { name: "LPG", path: "/tecnologie-rebel#lpg" }] });
---
<BaseLayout meta={meta} bodyClass="rebel-rebrand page-tecnologie-rebel">
  <JsonLd data={breadcrumb} />
  <JsonLd data={webPage} />
  <JsonLd data={list} />

  <main>
    <section class="tech-new-hero">
      <div class="rebel-container tech-new-hero__grid">
        <div class="tech-new-hero__copy">
          <p class="rebel-kicker">Tecnologia, dentro un metodo</p>
          <h1 class="rebel-display">Non scegliamo una macchina.<br/>Costruiamo un percorso.</h1>
          <p class="rebel-lead">Lumina X1 Pro è il cuore tecnologico di Libertà. Il portfolio THORY amplia ciò che possiamo attivare quando la Mappa, la priorità e la valutazione lo rendono pertinente.</p>
          <div class="rebel-hero__actions"><a class="btn btn--primary" href="#lumina-x1-pro">Entra nel Technology Theatre</a><a class="btn btn--secondary" href="/contatti">Prenota la valutazione</a></div>
        </div>
        <div class="tech-new-hero__visual">
          <span>THORY · Lumina Pro Series</span>
          <img src={siteAsset("technologies.thory.luminaX1Pro")} alt="Lumina X1 Pro THORY con display e manipolo" width="1280" height="725" fetchpriority="high" decoding="async" />
        </div>
      </div>
    </section>

    <div id="lumina-x1-pro"><TechnologyTheatre /></div>

    <section class="rebel-section tech-portfolio">
      <div class="rebel-container">
        <header class="tech-portfolio__head"><div><p class="rebel-kicker">Portfolio THORY · attivabile su valutazione</p><h2 class="rebel-title">Altre piattaforme, quando servono davvero.</h2></div><p>Pertinenza, configurazione e disponibilità vengono confermate prima di inserire una tecnologia nella proposta REBEL.</p></header>
        <div class="tech-portfolio__grid">
          {portfolio.map((tech, index) => (
            <article id={tech.slug} class="tech-portfolio__card" data-review={tech.reviewLevel}>
              <div class="tech-portfolio__media"><span>{String(index + 2).padStart(2,"0")}</span><img src={siteAsset(tech.imageSlot)} alt={tech.imageAlt} width={tech.imageWidth} height={tech.imageHeight} loading="lazy" decoding="async" /></div>
              <div class="tech-portfolio__copy">
                <p class="rebel-kicker">{tech.descriptor}</p>
                <h3>{tech.name}</h3>
                <strong>{tech.technicalDescriptor}</strong>
                <p>{tech.summary}</p>
                <ul>{tech.highlights.map((item) => <li><b>{item.value}</b><span>{item.label}</span></li>)}</ul>
                <div class="tech-portfolio__links">{tech.journeyLinks.map((journey) => <a href={journey.href}>{journey.label} →</a>)}</div>
                <small>{tech.note}</small>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="rebel-section rebel-section--paper tech-rebel-tools">
      <div class="rebel-container">
        <p class="rebel-kicker">Tecnologie REBEL · non THORY</p>
        <h2 class="rebel-title">ICE Polar e LPG restano capitoli separati.</h2>
        <div class="tech-rebel-tools__grid">
          <article id="ice-polar" style={`--tool-image:url('${siteAsset("services.laser.handpiece.desktop")}')`}>
            <div><p class="rebel-kicker">Comfort durante il laser</p><h3>ICE Polar</h3><p>Nel percorso Libertà, ICE Polar è il nome commerciale REBEL per il comfort del freddo che accompagna la seduta. La scheda Lumina X1 Pro documenta separatamente il raffreddamento a contatto in zaffiro.</p><a href="/percorsi/liberta">Scopri Libertà →</a></div>
          </article>
          <article id="lpg" style={`--tool-image:url('${siteAsset("journeys.forma.hero.desktop")}')`}>
            <div><p class="rebel-kicker">Tecnologia meccanica corpo</p><h3>LPG endomassaggio</h3><p>Può entrare nei programmi Forma insieme a manualità e altre tecnologie. Configurazione e frequenza vengono definite dopo la valutazione.</p><a href="/percorsi/forma">Scopri Forma →</a></div>
          </article>
        </div>
      </div>
    </section>

    <section class="rebel-section">
      <div class="rebel-container tech-method-strip">
        <div><span>01</span><strong>Mappa</strong><p>Area, priorità e condizioni iniziali.</p></div>
        <div><span>02</span><strong>Scelta</strong><p>Materia, manualità e tecnologia pertinente.</p></div>
        <div><span>03</span><strong>Parametri</strong><p>Configurazione e frequenza leggibili.</p></div>
        <div><span>04</span><strong>Controllo</strong><p>La proposta cambia con la risposta osservata.</p></div>
      </div>
    </section>

    <section class="rebel-campaign"><div class="rebel-container"><strong>Prima la priorità.<br/><span>Poi la tecnologia.</span></strong><p>Durante la valutazione ti spieghiamo quale strumento può entrare nel percorso, con quale logica e a quale prezzo.</p><div class="rebel-hero__actions" style="justify-content:center"><a class="btn btn--primary" href="/contatti">Prenota la valutazione REBEL</a><a class="btn btn--secondary" href="/percorsi">Esplora i nove percorsi</a></div></div></section>
  </main>

  <StickyBookingBar primary={{ label: "Prenota la valutazione", href: "/contatti" }} />
</BaseLayout>

<style>
  .tech-new-hero{padding:clamp(9rem,14vw,13rem) 0 clamp(4rem,8vw,7rem);overflow:hidden;background:radial-gradient(circle at 78% 20%,rgba(111,76,220,.22),transparent 30rem),radial-gradient(circle at 13% 90%,rgba(233,59,136,.14),transparent 25rem),#f8f3ed}.tech-new-hero__grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(28rem,1.1fr);gap:clamp(2rem,6vw,6rem);align-items:center}.tech-new-hero__copy .rebel-display{max-width:12ch;font-size:clamp(4.2rem,6vw,6.5rem);line-height:.86}.tech-new-hero__visual{position:relative;min-height:clamp(25rem,46vw,43rem);display:grid;place-items:center;border:1px solid rgba(49,27,68,.12);border-radius:2rem;background:radial-gradient(circle,rgba(255,255,255,.97),rgba(233,224,237,.72));box-shadow:0 2rem 5rem rgba(46,25,61,.12)}.tech-new-hero__visual::after{content:"";position:absolute;inset:auto 12% 9%;height:7%;background:#3a2d42;filter:blur(28px);opacity:.2;border-radius:50%}.tech-new-hero__visual>span{position:absolute;top:1.25rem;left:1.25rem;color:#6d5b75;font-size:.72rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.tech-new-hero__visual img{position:relative;z-index:1;width:92%;height:auto;object-fit:contain}.tech-portfolio{background:#f8f3ed}.tech-portfolio__head{display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(2rem,7vw,7rem);align-items:end}.tech-portfolio__head>p{margin:0;color:#6b5c71;line-height:1.7}.tech-portfolio__grid{display:grid;gap:1.2rem;margin-top:3rem}.tech-portfolio__card{display:grid;grid-template-columns:minmax(20rem,.88fr) minmax(0,1.12fr);gap:clamp(1.5rem,5vw,5rem);overflow:hidden;border:1px solid rgba(49,29,69,.13);border-radius:2rem;background:rgba(255,255,255,.75)}.tech-portfolio__card:nth-child(even){grid-template-columns:minmax(0,1.12fr) minmax(20rem,.88fr)}.tech-portfolio__card:nth-child(even) .tech-portfolio__media{order:2}.tech-portfolio__media{position:relative;min-height:36rem;display:grid;place-items:center;background:radial-gradient(circle,white 12%,#eee9ef 72%)}.tech-portfolio__media>span{position:absolute;top:1.25rem;left:1.25rem;z-index:1;color:#b61f64;font-size:1.2rem;font-weight:900}.tech-portfolio__media img{width:min(82%,31rem);max-height:32rem;object-fit:contain;filter:drop-shadow(0 1.6rem 1.3rem rgba(45,26,58,.16))}.tech-portfolio__copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(1.5rem,4vw,3.5rem)}.tech-portfolio__copy h3{margin:.15rem 0 .5rem;font-size:clamp(2.7rem,6vw,5.5rem);line-height:.84;letter-spacing:-.065em}.tech-portfolio__copy>strong{color:#6d3b87}.tech-portfolio__copy>p{color:#695b70;line-height:1.65}.tech-portfolio__copy ul{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;margin:1.25rem 0;padding:0;list-style:none}.tech-portfolio__copy li{padding:.85rem;border:1px solid rgba(49,29,69,.13);border-radius:.8rem;background:#fff}.tech-portfolio__copy li b,.tech-portfolio__copy li span{display:block}.tech-portfolio__copy li b{font-size:.9rem}.tech-portfolio__copy li span{margin-top:.25rem;color:#77687d;font-size:.72rem;line-height:1.4}.tech-portfolio__links{display:flex;flex-wrap:wrap;gap:.5rem}.tech-portfolio__links a{padding:.55rem .7rem;border-radius:999px;background:#2c183b;color:white;text-decoration:none;font-size:.77rem;font-weight:800}.tech-portfolio__copy>small{margin-top:1.2rem;color:#75677b;line-height:1.5}.tech-portfolio__card[data-review="descriptive-only"]{border-style:dashed}.tech-rebel-tools__grid{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-top:2.5rem}.tech-rebel-tools__grid article{--tool-image:none;position:relative;min-height:38rem;display:flex;align-items:end;overflow:hidden;border-radius:2rem;color:white;isolation:isolate;background:#1b0d29}.tech-rebel-tools__grid article::before{content:"";position:absolute;inset:0;z-index:-2;background-image:var(--tool-image);background-size:cover;background-position:center}.tech-rebel-tools__grid article::after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(180deg,rgba(12,6,20,.05),rgba(12,6,20,.91) 88%)}.tech-rebel-tools__grid article>div{padding:clamp(1.5rem,4vw,3rem)}.tech-rebel-tools h3{margin:.2rem 0 .8rem;color:white;font-size:clamp(2.8rem,6vw,5rem);line-height:.86;letter-spacing:-.06em}.tech-rebel-tools article p:not(.rebel-kicker){max-width:38rem;color:rgba(255,255,255,.78);line-height:1.65}.tech-rebel-tools article a{color:white;font-weight:850}.tech-method-strip{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;padding:1px;border-radius:1.5rem;overflow:hidden;background:rgba(50,28,69,.14)}.tech-method-strip>div{padding:1.5rem;background:#fff}.tech-method-strip span{color:#b61f64;font-weight:900}.tech-method-strip strong{display:block;margin:2rem 0 .5rem;font-size:1.4rem}.tech-method-strip p{margin:0;color:#6a5b70;line-height:1.5}@media(max-width:960px){.tech-new-hero__grid,.tech-portfolio__head,.tech-portfolio__card,.tech-portfolio__card:nth-child(even){grid-template-columns:1fr}.tech-portfolio__card:nth-child(even) .tech-portfolio__media{order:0}.tech-rebel-tools__grid{grid-template-columns:1fr}.tech-method-strip{grid-template-columns:1fr 1fr}.tech-portfolio__media{min-height:30rem}}@media(max-width:620px){.tech-new-hero__grid{display:block}.tech-new-hero__copy .rebel-display{font-size:clamp(3.1rem,15vw,5rem)}.tech-new-hero__visual{min-height:23rem;margin-top:2rem}.tech-portfolio__media{min-height:24rem}.tech-portfolio__copy ul{grid-template-columns:1fr}.tech-method-strip{grid-template-columns:1fr}.tech-rebel-tools__grid article{min-height:32rem}}
</style>
